@model LMSWebUI.Models.Customer.CustomerAdvanceDto
@{
    ViewData["Title"] = "Customer Advances";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
}

<style>
.adv-page,
.adv-page input,
.adv-page select,
.adv-page button,
.adv-page label,
.adv-page textarea,
.adv-page table {
    font-family: Arial, Helvetica, sans-serif;
}

.adv-page {
    padding: 20px;
}

.adv-box {
    max-width: 1040px;
    margin: 0 auto;
    background: var(--els-surface);
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    overflow: hidden;
}

.adv-title {
    background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
    color: #fff;
    padding: 14px 20px;
    font-size: 20px;
    font-weight: 600;
}

.adv-summary-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(4, minmax(160px, 1fr));
    gap: 10px;
}

.adv-summary-card {
    border: 1px solid var(--els-border);
    border-radius: 8px;
    padding: 10px;
    background: var(--els-surface);
}

.adv-summary-label {
    font-size: 12px;
    color: var(--els-text-muted, #6b7280);
    margin-bottom: 4px;
}

.adv-summary-value {
    font-size: 18px;
    font-weight: 700;
    color: var(--els-text);
}

.adv-summary-value.small {
    font-size: 14px;
    font-weight: 600;
}

.adv-help {
    margin-top: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: var(--els-accent, #f3f7ff);
    padding: 10px 12px;
    font-size: 12px;
    color: var(--els-text);
}

.adv-help ul {
    margin: 6px 0 0 18px;
    padding: 0;
}

.adv-help li {
    margin-bottom: 4px;
}

.adv-mode-hint {
    margin-top: 6px;
    font-size: 12px;
    color: var(--els-text-muted, #6b7280);
}

.adv-history-toolbar {
    display: flex;
    align-items: end;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px;
    border-bottom: 1px solid var(--els-border);
    background: #f8fbff;
}

.adv-history-filter {
    display: flex;
    flex-direction: column;
    min-width: 160px;
}

.adv-history-filter label {
    font-size: 12px;
    margin-bottom: 4px;
    color: var(--els-text);
}

.adv-history-filter input {
    border: 1px solid var(--els-border);
    border-radius: 6px;
    padding: 8px;
    background: var(--els-surface);
    color: var(--els-text);
}

.adv-muted {
    color: var(--els-text-muted, #6b7280);
}

.adv-amount-positive {
    color: #2f8f46;
    font-weight: 700;
}

.adv-amount-negative {
    color: #b63838;
    font-weight: 700;
}

.adv-balance-strong {
    font-weight: 700;
}

.adv-legend {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--els-border);
    border-radius: 6px;
    background: var(--els-surface);
    padding: 6px 10px;
    font-size: 12px;
    color: var(--els-text);
}

.adv-body {
    padding: 20px;
}

.adv-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(280px, 1fr));
    gap: 14px;
}

.adv-field {
    display: flex;
    flex-direction: column;
}

.adv-field label {
    font-size: 13px;
    margin-bottom: 6px;
    color: var(--els-text);
}

.adv-hint {
    margin-top: 6px;
    font-size: 12px;
    color: var(--els-text-muted, #6b7280);
}

.adv-field input,
.adv-field select,
.adv-field textarea {
    border: 1px solid var(--els-border);
    border-radius: 6px;
    padding: 10px;
    background: var(--els-surface);
    color: var(--els-text);
}

.adv-field textarea {
    resize: vertical;
    min-height: 74px;
}

.adv-balance {
    margin-top: 16px;
    padding: 12px 14px;
    border-radius: 8px;
    background: rgba(54, 107, 202, 0.12);
    color: var(--els-text);
    font-size: 16px;
    font-weight: 600;
}

.adv-actions {
    margin-top: 20px;
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.adv-btn {
    min-width: 150px;
    min-height: 44px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
}

.adv-btn.secondary {
    background: linear-gradient(180deg, #8f99a4 0%, #6f7a86 100%);
}

.adv-btn.tertiary {
    background: linear-gradient(180deg, #3f8f7b 0%, #2b6f5e 100%);
}

.adv-history {
    margin-top: 18px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    overflow: hidden;
}

.adv-history table {
    width: 100%;
    border-collapse: collapse;
    background: var(--els-surface);
}

.adv-history th,
.adv-history td {
    border-bottom: 1px solid var(--els-border);
    padding: 10px;
    font-size: 13px;
    color: var(--els-text);
    text-align: left;
}

.adv-history th {
    background: rgba(48, 96, 189, 0.12);
    font-weight: 700;
}

.toast-message {
    position: fixed;
    right: 24px;
    top: 80px;
    z-index: 9999;
    min-width: 260px;
    max-width: 380px;
    padding: 12px 16px;
    border-radius: 8px;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    font-weight: 600;
    display: none;
}

.toast-message.success {
    background: #2f8f46;
}

.toast-message.error {
    background: #b63838;
}

@@media (max-width: 768px) {
    .adv-grid {
        grid-template-columns: 1fr;
    }

    .adv-summary-grid {
        grid-template-columns: repeat(2, minmax(140px, 1fr));
    }

    .adv-actions {
        justify-content: stretch;
        flex-direction: column;
    }

    .adv-btn {
        width: 100%;
    }
}
</style>

<div id="customerAdvToast" class="toast-message"></div>
@if (TempData["CustomerAdvancesToast"] != null)
{
    <script type="text/javascript">
        window.customerAdvToastMessage = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(TempData["CustomerAdvancesToast"])))';
    </script>
}

<section class="adv-page">
    <div class="adv-box">
        <div class="adv-title">Customer Advances - Balance Adjustments</div>
        <div class="adv-body">
            @using (Html.BeginForm("CustomerAdvances", "Customer", FormMethod.Post, new { id = "customerAdvancesForm" }))
            {
                @Html.HiddenFor(m => m.CustCode, new { id = "custCode" })
                <div class="adv-grid">
                    <div class="adv-field">
                        <label for="customerName">Customer Name</label>
                        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", id = "customerName", placeholder = "Choose customer", list = "customerNameList", autocomplete = "off" })
                        <datalist id="customerNameList"></datalist>
                        <div class="adv-hint">Select a customer from your logged-in store list, then click Load History.</div>
                    </div>

                    <div class="adv-field">
                        <label for="customerCodeDisplay">Customer Code</label>
                        <input type="text" id="customerCodeDisplay" value="@(Model?.CustCode ?? string.Empty)" readonly="readonly" />
                    </div>

                    <div class="adv-field">
                        <label for="advanceAmount">Amount</label>
                        @Html.TextBoxFor(m => m.AdvanceAmount, new { @class = "form-control", id = "advanceAmount", type = "number", min = "0.01", step = "0.01" })
                        <div class="adv-hint">Enter amount greater than zero.</div>
                    </div>

                    <div class="adv-field">
                        <label for="transactionType">Transaction Type</label>
                        @Html.DropDownListFor(m => m.TransactionType, new SelectList(new[] { "Credit", "Debit" }), new { @class = "form-control", id = "transactionType" })
                        <div class="adv-mode-hint" id="transactionTypeHint">Credit adds a new advance amount to customer balance.</div>
                    </div>

                    <div class="adv-field" style="grid-column: 1 / -1;">
                        <label for="notes">Notes</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", id = "notes", maxlength = "500", placeholder = "Reason for adjustment" })
                    </div>
                </div>

                <div class="adv-balance">Current Balance: <span id="advanceBalance">@Model.Balance.ToString("0.00")</span></div>

                <div class="adv-summary-grid">
                    <div class="adv-summary-card">
                        <div class="adv-summary-label">Customer</div>
                        <div class="adv-summary-value small" id="summaryCustomerName">@(Model?.CustomerName ?? "-")</div>
                    </div>
                    <div class="adv-summary-card">
                        <div class="adv-summary-label">Customer Code</div>
                        <div class="adv-summary-value small" id="summaryCustomerCode">@(Model?.CustCode ?? "-")</div>
                    </div>
                    <div class="adv-summary-card">
                        <div class="adv-summary-label">Total Advances (Credits)</div>
                        <div class="adv-summary-value" id="summaryTotalAdvances">0.00</div>
                    </div>
                    <div class="adv-summary-card">
                        <div class="adv-summary-label">Amount Used / Adjusted</div>
                        <div class="adv-summary-value" id="summaryUsedAdjusted">0.00</div>
                        <div class="adv-hint" id="summaryUsedAdjustedHint">Shown only when usage data is available.</div>
                    </div>
                </div>

                <div class="adv-help">
                    <strong>Help:</strong>
                    <ul>
                        <li><strong>Total Advances</strong>: Sum of credit entries returned in advance history.</li>
                        <li><strong>Amount Used / Adjusted</strong>: Calculated from valid Debit transactions only when transaction history reconciles with available balance.</li>
                        <li><strong>Available Balance</strong>: Current balance returned by the advance API for this customer, store, and tenant.</li>
                        <li><strong>Add Advance</strong>: Use <em>Credit</em> transaction type.</li>
                        <li><strong>Balance Adjustment</strong>: Use <em>Debit</em> transaction type. Debit amount should not exceed available balance.</li>
                    </ul>
                </div>

                <div class="adv-actions">
                    <button type="button" class="adv-btn tertiary" id="loadAdvanceBtn">Load History</button>
                    <button type="button" class="adv-btn secondary" onclick="window.location.href='@Url.Action("Index", "Customer")'">Back to Customer</button>
                    <button type="submit" class="adv-btn" id="saveAdvanceBtn">Save Entry</button>
                </div>
            }

            <div class="adv-history">
                <div class="adv-history-toolbar">
                    <div class="adv-history-filter">
                        <label for="historyFromDate">From Date</label>
                        <input type="date" id="historyFromDate" />
                    </div>
                    <div class="adv-history-filter">
                        <label for="historyToDate">To Date</label>
                        <input type="date" id="historyToDate" />
                    </div>
                    <div class="adv-legend" aria-label="Transaction sign legend">
                        <span><span class="adv-amount-positive">+ Credit</span></span>
                        <span><span class="adv-amount-negative">− Debit</span></span>
                    </div>
                    <div class="adv-hint">History is shown latest-first based on transaction date.</div>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Date (UTC)</th>
                            <th>Type</th>
                            <th>Reference / Invoice</th>
                            <th>Advance Amount</th>
                            <th>Used / Adjusted</th>
                            <th>Remaining Balance</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="advanceHistoryBody">
                        @if (Model.Transactions != null && Model.Transactions.Count > 0)
                        {
                            foreach (var txn in Model.Transactions)
                            {
                                <tr>
                                    <td>@txn.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(string.Equals(txn.TransactionType, "Credit", StringComparison.OrdinalIgnoreCase) ? "Advance Added" : string.Equals(txn.TransactionType, "Debit", StringComparison.OrdinalIgnoreCase) ? "Balance Adjustment" : txn.TransactionType)</td>
                                    <td class="adv-muted">-</td>
                                    <td class="@(string.Equals(txn.TransactionType, "Debit", StringComparison.OrdinalIgnoreCase) ? "adv-amount-negative" : "adv-amount-positive")">
                                        @(string.Equals(txn.TransactionType, "Debit", StringComparison.OrdinalIgnoreCase) ? "−" : "+")@txn.AdvanceAmount.ToString("0.00")
                                    </td>
                                    <td class="@(string.Equals(txn.TransactionType, "Debit", StringComparison.OrdinalIgnoreCase) ? "adv-amount-negative" : "adv-muted")">
                                        @(string.Equals(txn.TransactionType, "Debit", StringComparison.OrdinalIgnoreCase) ? "−" + txn.AdvanceAmount.ToString("0.00") : "-")
                                    </td>
                                    <td class="adv-balance-strong adv-muted">-</td>
                                    <td class="adv-muted">-</td>
                                    <td>@txn.Notes</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">No transactions found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    (function () {
        var historyRows = [];

        function parseAmount(value) {
            var amount = Number(value);
            return isNaN(amount) ? 0 : amount;
        }

        function parseDateUtc(value) {
            if (!value) {
                return null;
            }

            var parsed = new Date(value);
            return isNaN(parsed.getTime()) ? null : parsed;
        }

        function formatDateDisplay(value) {
            if (!value) {
                return "-";
            }

            return value.toString().replace("T", " ").substring(0, 16);
        }

        function escapeHtml(value) {
            var input = value === undefined || value === null ? "" : value.toString();
            return input
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function normalizeType(type) {
            if (!type) {
                return "-";
            }

            var normalized = type.toString().trim().toLowerCase();
            if (normalized === "credit") {
                return "Advance Added";
            }

            if (normalized === "debit") {
                return "Balance Adjustment";
            }

            return type;
        }

        function isDebitTransaction(txn) {
            var type = (txn.TransactionType || txn.transactionType || "").toString().trim().toLowerCase();
            return type === "debit";
        }

        function formatSignedAmount(amount, isDebit) {
            var sign = isDebit ? "−" : "+";
            return sign + roundMoney(amount).toFixed(2);
        }

        function getAdjustmentAmount(txn) {
            var explicitUsed = txn.AmountUsed || txn.amountUsed || txn.AdjustedAmount || txn.adjustedAmount;
            if (explicitUsed !== undefined && explicitUsed !== null && explicitUsed !== "") {
                return parseAmount(explicitUsed);
            }

            var type = (txn.TransactionType || txn.transactionType || "").toString().trim().toLowerCase();
            var amount = parseAmount(txn.AdvanceAmount || txn.advanceAmount || 0);
            return type === "debit" ? amount : 0;
        }

        function roundMoney(value) {
            return Math.round(parseAmount(value) * 100) / 100;
        }

        function tryBuildRunningBalances(transactions, authoritativeBalance) {
            var txns = Array.isArray(transactions) ? transactions.slice() : [];
            var chronological = txns.slice().sort(function (a, b) {
                var ad = parseDateUtc(a.CreatedDate || a.createdDate);
                var bd = parseDateUtc(b.CreatedDate || b.createdDate);
                var at = ad ? ad.getTime() : 0;
                var bt = bd ? bd.getTime() : 0;
                return at - bt;
            });

            var running = 0;
            var debitTotal = 0;
            var canCompute = chronological.length > 0;

            chronological.forEach(function (txn) {
                var type = (txn.TransactionType || txn.transactionType || "").toString().trim().toLowerCase();
                var amount = roundMoney(txn.AdvanceAmount || txn.advanceAmount || 0);

                if (amount <= 0) {
                    canCompute = false;
                    txn.__computedRemainingBalance = null;
                    return;
                }

                if (type === "credit") {
                    running = roundMoney(running + amount);
                } else if (type === "debit") {
                    running = roundMoney(running - amount);
                    debitTotal = roundMoney(debitTotal + amount);
                } else {
                    canCompute = false;
                }

                txn.__computedRemainingBalance = canCompute ? roundMoney(running) : null;
            });

            var availableBalance = roundMoney(authoritativeBalance);
            var reconciles = canCompute && roundMoney(running) === availableBalance;

            if (!reconciles) {
                chronological.forEach(function (txn) {
                    txn.__computedRemainingBalance = null;
                });
            }

            return {
                canComputeRunningBalance: reconciles,
                debitTotal: reconciles ? debitTotal : null
            };
        }

        function updateSummaryCards(transactions, balance) {
            var totalCredits = 0;
            (transactions || []).forEach(function (txn) {
                var type = (txn.TransactionType || txn.transactionType || "").toString().trim().toLowerCase();
                var amount = parseAmount(txn.AdvanceAmount || txn.advanceAmount || 0);
                if (type === "credit") {
                    totalCredits += amount;
                }
            });

            totalCredits = roundMoney(totalCredits);
            var runningCalc = tryBuildRunningBalances(transactions || [], balance);
            var usedAdjusted = runningCalc.debitTotal;

            var totalEl = document.getElementById("summaryTotalAdvances");
            var usedEl = document.getElementById("summaryUsedAdjusted");
            var customerNameEl = document.getElementById("summaryCustomerName");
            var customerCodeEl = document.getElementById("summaryCustomerCode");
            var usedHintEl = document.getElementById("summaryUsedAdjustedHint");
            var customerNameInput = document.getElementById("customerName");
            var customerCodeDisplay = document.getElementById("customerCodeDisplay");

            if (totalEl) {
                totalEl.textContent = totalCredits.toFixed(2);
            }
            if (usedEl) {
                usedEl.textContent = usedAdjusted === null ? "-" : usedAdjusted.toFixed(2);
            }
            if (usedHintEl) {
                usedHintEl.textContent = usedAdjusted === null
                    ? "Not shown because history does not fully reconcile with current balance."
                    : "Calculated from valid Debit transactions in reconciled history.";
            }
            if (customerNameEl) {
                customerNameEl.textContent = (customerNameInput && customerNameInput.value ? customerNameInput.value.trim() : "") || "-";
            }
            if (customerCodeEl) {
                customerCodeEl.textContent = (customerCodeDisplay && customerCodeDisplay.value ? customerCodeDisplay.value.trim() : "") || "-";
            }
        }

        function applyHistoryFiltersAndRender() {
            var tbody = document.getElementById("advanceHistoryBody");
            if (!tbody) {
                return;
            }

            var fromDateEl = document.getElementById("historyFromDate");
            var toDateEl = document.getElementById("historyToDate");
            var fromDate = fromDateEl && fromDateEl.value ? new Date(fromDateEl.value + "T00:00:00") : null;
            var toDate = toDateEl && toDateEl.value ? new Date(toDateEl.value + "T23:59:59") : null;

            var filtered = (historyRows || []).filter(function (txn) {
                var dt = parseDateUtc(txn.CreatedDate || txn.createdDate);
                if (!dt) {
                    return !fromDate && !toDate;
                }

                if (fromDate && dt < fromDate) {
                    return false;
                }

                if (toDate && dt > toDate) {
                    return false;
                }

                return true;
            });

            filtered.sort(function (a, b) {
                var ad = parseDateUtc(a.CreatedDate || a.createdDate);
                var bd = parseDateUtc(b.CreatedDate || b.createdDate);
                var at = ad ? ad.getTime() : 0;
                var bt = bd ? bd.getTime() : 0;
                return bt - at;
            });

            tbody.innerHTML = "";
            if (!filtered.length) {
                tbody.innerHTML = "<tr><td colspan='8'>No transactions found.</td></tr>";
                return;
            }

            filtered.forEach(function (txn) {
                var row = document.createElement("tr");
                var createdDate = txn.CreatedDate || txn.createdDate || "";
                var type = txn.TransactionType || txn.transactionType || "";
                var amount = parseAmount(txn.AdvanceAmount || txn.advanceAmount || 0);
                var isDebit = isDebitTransaction(txn);
                var reference = txn.TransactionReference || txn.transactionReference || txn.ReferenceNo || txn.referenceNo || txn.InvoiceNo || txn.invoiceNo || "-";
                var remainingBalance = txn.RemainingBalance;
                if (remainingBalance === undefined || remainingBalance === null || remainingBalance === "") {
                    remainingBalance = txn.remainingBalance;
                }
                if (remainingBalance === undefined || remainingBalance === null || remainingBalance === "") {
                    remainingBalance = txn.__computedRemainingBalance;
                }
                var status = txn.Status || txn.status || "-";
                var notes = txn.Notes || txn.notes || "";
                var adjusted = getAdjustmentAmount(txn);
                var signedAdvanceAmount = formatSignedAmount(amount, isDebit);
                var signedAdjustedAmount = isDebit && adjusted > 0 ? formatSignedAmount(adjusted, true) : "-";
                var remainingBalanceDisplay = (remainingBalance === undefined || remainingBalance === null || remainingBalance === "")
                    ? "-"
                    : roundMoney(remainingBalance).toFixed(2);
                var advanceAmountClass = isDebit ? "adv-amount-negative" : "adv-amount-positive";
                var adjustedAmountClass = isDebit && adjusted > 0 ? "adv-amount-negative" : "adv-muted";

                row.innerHTML = "<td>" + formatDateDisplay(createdDate) + "</td>"
                    + "<td>" + escapeHtml(normalizeType(type)) + "</td>"
                    + "<td>" + escapeHtml(reference || "-") + "</td>"
                    + "<td class='" + advanceAmountClass + "'>" + signedAdvanceAmount + "</td>"
                    + "<td class='" + adjustedAmountClass + "'>" + signedAdjustedAmount + "</td>"
                    + "<td class='adv-balance-strong'>" + remainingBalanceDisplay + "</td>"
                    + "<td>" + escapeHtml(status) + "</td>"
                    + "<td>" + escapeHtml(notes) + "</td>";
                tbody.appendChild(row);
            });
        }

        function showToast(message, isSuccess) {
            var toast = document.getElementById("customerAdvToast");
            if (!toast) {
                window.alert(message || "Operation completed.");
                return;
            }

            toast.classList.remove("success", "error");
            toast.classList.add(isSuccess ? "success" : "error");
            toast.textContent = message || "Operation completed.";
            toast.style.display = "block";

            if (window.__advToastTimer) {
                clearTimeout(window.__advToastTimer);
            }

            window.__advToastTimer = setTimeout(function () {
                toast.style.display = "none";
            }, 3200);
        }

        function renderHistoryRows(transactions) {
            historyRows = Array.isArray(transactions) ? transactions.slice() : [];
            applyHistoryFiltersAndRender();
        }

        function loadHistory() {
            var customerNameInput = document.getElementById("customerName");
            var customerName = customerNameInput ? customerNameInput.value.trim() : "";
            var customerCode = document.getElementById("custCode") ? document.getElementById("custCode").value.trim() : "";

            if (!customerName) {
                showToast("Please enter customer name.", false);
                return;
            }

            fetch('@Url.Action("GetCustomerAdvances", "Customer")' + '?customerName=' + encodeURIComponent(customerName) + '&customerCode=' + encodeURIComponent(customerCode), {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data || !data.success) {
                        showToast((data && data.message) || "Unable to fetch customer advances.", false);
                        renderHistoryRows([]);
                        document.getElementById("advanceBalance").textContent = "0.00";
                        document.getElementById("custCode").value = "";
                        document.getElementById("customerCodeDisplay").value = "";
                        updateSummaryCards([], 0);
                        return;
                    }

                    var balance = data.balance || 0;
                    document.getElementById("advanceBalance").textContent = Number(balance).toFixed(2);
                    document.getElementById("custCode").value = data.customerCode || "";
                    document.getElementById("customerCodeDisplay").value = data.customerCode || "";
                    updateSummaryCards(data.transactions || [], balance);
                    renderHistoryRows(data.transactions || []);
                })
                .catch(function (error) {
                    var message = error && error.message ? error.message : "Unable to fetch customer advances.";
                    showToast(message, false);
                });
        }

        function loadCustomerSuggestions() {
            fetch('@Url.Action("GetCustomers", "Customer")', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(function (response) { return response.json(); })
                .then(function (customers) {
                    var list = document.getElementById("customerNameList");
                    if (!list) {
                        return;
                    }

                    list.innerHTML = "";
                    (customers || []).forEach(function (name) {
                        if (!name) {
                            return;
                        }

                        var option = document.createElement("option");
                        option.value = name;
                        list.appendChild(option);
                    });
                })
                .catch(function () {
                    // keep manual typing as fallback
                });
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (!window.location.search && !window.customerAdvToastMessage) {
                var customerNameInput = document.getElementById("customerName");
                var advanceAmountInput = document.getElementById("advanceAmount");
                var notesInput = document.getElementById("notes");
                var customerCodeDisplay = document.getElementById("customerCodeDisplay");
                var custCodeHidden = document.getElementById("custCode");
                var transactionTypeSelect = document.getElementById("transactionType");
                var fromDateInput = document.getElementById("historyFromDate");
                var toDateInput = document.getElementById("historyToDate");

                if (customerNameInput) customerNameInput.value = "";
                if (advanceAmountInput) advanceAmountInput.value = "";
                if (notesInput) notesInput.value = "";
                if (customerCodeDisplay) customerCodeDisplay.value = "";
                if (custCodeHidden) custCodeHidden.value = "";
                if (transactionTypeSelect) transactionTypeSelect.selectedIndex = 0;
                if (fromDateInput) fromDateInput.value = "";
                if (toDateInput) toDateInput.value = "";
            }

            if (window.customerAdvToastMessage) {
                showToast(window.customerAdvToastMessage, true);
            }

            var loadBtn = document.getElementById("loadAdvanceBtn");
            if (loadBtn) {
                loadBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    loadHistory();
                });
            }

            var fromDateInput = document.getElementById("historyFromDate");
            if (fromDateInput) {
                fromDateInput.addEventListener("change", applyHistoryFiltersAndRender);
            }

            var toDateInput = document.getElementById("historyToDate");
            if (toDateInput) {
                toDateInput.addEventListener("change", applyHistoryFiltersAndRender);
            }

            var transactionTypeEl = document.getElementById("transactionType");
            var transactionTypeHintEl = document.getElementById("transactionTypeHint");
            function updateTransactionTypeHint() {
                if (!transactionTypeEl || !transactionTypeHintEl) {
                    return;
                }

                var selectedType = (transactionTypeEl.value || "").trim().toLowerCase();
                if (selectedType === "debit") {
                    transactionTypeHintEl.textContent = "Debit applies a balance adjustment from existing available advance.";
                    return;
                }

                transactionTypeHintEl.textContent = "Credit adds a new advance amount to customer balance.";
            }

            if (transactionTypeEl) {
                transactionTypeEl.addEventListener("change", updateTransactionTypeHint);
                updateTransactionTypeHint();
            }

            loadCustomerSuggestions();

            var form = document.getElementById("customerAdvancesForm");
            var saveBtn = document.getElementById("saveAdvanceBtn");
            if (form && saveBtn) {
                form.addEventListener("submit", function (e) {
                    var customerNameValue = (document.getElementById("customerName").value || "").trim();
                    var amountValue = parseAmount(document.getElementById("advanceAmount").value || 0);
                    var selectedType = (document.getElementById("transactionType").value || "").trim().toLowerCase();
                    var availableBalance = parseAmount(document.getElementById("advanceBalance").textContent || 0);

                    if (!customerNameValue) {
                        e.preventDefault();
                        showToast("Please enter customer name.", false);
                        return;
                    }

                    if (amountValue <= 0) {
                        e.preventDefault();
                        showToast("Advance amount should be greater than zero.", false);
                        return;
                    }

                    if (selectedType === "debit" && amountValue > availableBalance) {
                        e.preventDefault();
                        showToast("Debit adjustment cannot be greater than available balance.", false);
                        return;
                    }

                    saveBtn.disabled = true;
                    saveBtn.textContent = "Saving...";
                });
            }

            var customerNameInput = document.getElementById("customerName");
            if (customerNameInput) {
                customerNameInput.addEventListener("change", function () {
                    var custCode = document.getElementById("custCode");
                    var custCodeDisplay = document.getElementById("customerCodeDisplay");
                    var balance = document.getElementById("advanceBalance");
                    var historyBody = document.getElementById("advanceHistoryBody");

                    if (custCode) {
                        custCode.value = "";
                    }

                    if (custCodeDisplay) {
                        custCodeDisplay.value = "";
                    }

                    if (balance) {
                        balance.textContent = "0.00";
                    }

                    if (historyBody) {
                        historyBody.innerHTML = "<tr><td colspan='8'>No transactions found.</td></tr>";
                    }

                    updateSummaryCards([], 0);
                });
            }

            var hasCustomer = document.getElementById("customerName") && document.getElementById("customerName").value;
            if (hasCustomer) {
                loadHistory();
            }
        });
    })();
</script>
