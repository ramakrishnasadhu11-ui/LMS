@{
    ViewData["Title"] = "Store Users Setup";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
    var tenantName = Convert.ToString(ViewData["TenantName"] ?? "-");
    var storeCode = Convert.ToString(ViewData["StoreCode"] ?? "-");
    var allowedStores = ((IEnumerable<string>)(ViewData["ActiveStores"] ?? ViewData["AllowedStores"] ?? Enumerable.Empty<string>()))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var noActiveStores = Convert.ToBoolean(ViewData["NoActiveStores"] ?? false);
    var storesLoadError = Convert.ToString(ViewData["StoreUsersSetupStoresLoadError"] ?? string.Empty);
}

<style>
:root {
    --els-primary: #173B70;
    --els-primary-dark: #173B70;
    --els-primary-light: #2878C8;
    --els-accent: #EAF2FC;
    --els-background: #F5F7FA;
    --els-surface: #FFFFFF;
    --els-text: #1E293B;
    --els-text-muted: #64748B;
    --els-border: #E2E8F0;
    --els-success: #16A36A;
    --els-warning: #D99520;
    --els-danger: #D94848;
}

.admin-setup-page,
.admin-setup-page input,
.admin-setup-page button,
.admin-setup-page label,
.admin-setup-page textarea,
.admin-setup-page select {
    font-family: Arial, Helvetica, sans-serif;
}

.admin-setup-page {
    padding: 24px;
    background: var(--els-background);
}

.admin-setup-box {
    max-width: 1080px;
    margin: 0 auto;
}

.admin-page-header {
    border: 1px solid var(--els-border);
    border-radius: 14px;
    background: linear-gradient(120deg, #f8fbff 0%, #edf4fd 100%);
    box-shadow: 0 8px 22px rgba(23, 59, 112, 0.08);
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.admin-page-header-title {
    margin: 0;
    color: var(--els-primary);
    font-size: 24px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.admin-page-header-subtitle {
    margin: 6px 0 0;
    color: var(--els-text-muted);
    font-size: 13px;
}

.admin-context-wrap {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: flex-start;
}

.admin-context-chip {
    border: 1px solid var(--els-border);
    border-radius: 999px;
    background: #fff;
    color: var(--els-primary);
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
}

.admin-setup-card {
    border: 1px solid var(--els-border);
    border-radius: 12px;
    background: var(--els-surface);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    padding: 16px;
    margin-bottom: 14px;
}

.admin-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.admin-card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--els-text);
}

.admin-card-subtitle {
    margin: 3px 0 0;
    font-size: 12px;
    color: var(--els-text-muted);
}

.store-user-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.store-user-form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.store-user-form-field.full {
    grid-column: 1 / -1;
}

.store-user-label {
    margin: 0;
    font-size: 12px;
    color: var(--els-text);
    font-weight: 700;
}

.store-user-input-wrap {
    position: relative;
}

.store-user-input {
    width: 100%;
    height: 40px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    padding: 0 12px;
    color: var(--els-text);
    background: #fff;
}

.store-user-input:focus {
    outline: none;
    border-color: var(--els-primary-light);
    box-shadow: 0 0 0 3px rgba(40, 120, 200, 0.16);
}

.store-user-input.with-toggle {
    padding-right: 42px;
}

.store-user-password-toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: 1px solid var(--els-border);
    border-radius: 6px;
    background: #fff;
    color: var(--els-text-muted);
    cursor: pointer;
}

.store-user-password-toggle:hover {
    background: var(--els-accent);
}

.store-assignment-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.store-choice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: #fff;
    padding: 6px 10px;
    font-size: 12px;
    color: var(--els-text);
    transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
}

.store-choice.selected {
    border-color: var(--els-primary-light);
    background: var(--els-accent);
    box-shadow: 0 0 0 1px rgba(40, 120, 200, 0.15);
}

.store-choice input {
    margin: 0;
}

.admin-inline-message {
    margin-top: 8px;
    font-size: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    padding: 8px 10px;
    display: none;
}

.admin-inline-message.success {
    color: var(--els-success);
    background: #f1fbf6;
    border-color: #c5efd8;
    display: block;
}

.admin-inline-message.error {
    color: var(--els-danger);
    background: #fff4f4;
    border-color: #f2c7c7;
    display: block;
}

.store-users-table-wrap {
    border: 1px solid var(--els-border);
    border-radius: 10px;
    overflow: auto;
    background: #fff;
}

.store-users-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 720px;
}

.store-users-table th,
.store-users-table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--els-border);
    text-align: left;
    font-size: 12px;
    color: var(--els-text);
}

.store-users-table th {
    background: #f8fbff;
    color: var(--els-text-muted);
    font-weight: 700;
}

.store-users-empty {
    border: 1px dashed var(--els-border);
    border-radius: 8px;
    background: #fff;
    padding: 12px;
    color: var(--els-text-muted);
    font-size: 12px;
}

.admin-setup-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.admin-btn {
    min-width: 170px;
    min-height: 40px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--els-primary-light);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

.admin-btn:hover:not(:disabled) {
    filter: brightness(0.96);
}

.admin-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(40, 120, 200, 0.18);
}

.admin-btn.secondary {
    background: #fff;
    border-color: var(--els-border);
    color: var(--els-primary-dark);
}

.admin-btn:disabled {
    opacity: .6;
    cursor: not-allowed;
}

.admin-users-count {
    font-size: 12px;
    color: var(--els-text-muted);
    font-weight: 700;
}

.store-users-card-head-right {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.admin-warning-text {
    margin-top: 6px;
    font-size: 12px;
    color: var(--els-danger);
}

@@media (max-width: 900px) {
    .store-user-form-grid {
        grid-template-columns: 1fr;
    }

    .admin-page-header {
        padding: 14px;
    }
}
</style>

<section class="admin-setup-page">
    <div class="admin-setup-box">
        <div class="admin-page-header">
            <div>
                <h2 class="admin-page-header-title"><i class="fa fa-users" aria-hidden="true"></i> Store Users</h2>
                <p class="admin-page-header-subtitle">Manage staff access and store assignments.</p>
            </div>
            <div class="admin-context-wrap">
                <span class="admin-context-chip">Tenant: @tenantName</span>
                <span class="admin-context-chip">Store: @storeCode</span>
            </div>
        </div>

        <div class="admin-setup-card">
            <div class="admin-card-head">
                <div>
                    <h3 class="admin-card-title">Create Store User</h3>
                    <p class="admin-card-subtitle">Add a staff account and assign one or more stores.</p>
                </div>
            </div>

            <div class="store-user-form-grid">
                <div class="store-user-form-field full">
                    <label class="store-user-label"><b>Assign Stores</b></label>
                    @if (noActiveStores)
                    {
                        <div class="admin-warning-text">No active stores are available. Create a store before creating store users.</div>
                        <div style="margin-top:8px;">
                            <a href="@Url.Action("NewStoreCreation", "Customer")">Go to New Store Creation</a>
                        </div>
                    }
                    else
                    {
                        <div id="targetStoreCodes" class="store-assignment-grid">
                            @foreach (var code in allowedStores)
                            {
                                var isDefaultChecked = string.Equals(code, storeCode, StringComparison.OrdinalIgnoreCase);
                                <label class="store-choice @(isDefaultChecked ? "selected" : string.Empty)">
                                    <input type="checkbox" class="target-store-code" value="@code" @(isDefaultChecked ? "checked" : null) />
                                    <span>@code</span>
                                </label>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(storesLoadError))
                    {
                        <div class="admin-warning-text">@storesLoadError</div>
                    }
                </div>

                <div class="store-user-form-field">
                    <label class="store-user-label" for="storeUserEmail"><b>Store User Email</b></label>
                    <input type="email" id="storeUserEmail" class="form-control store-user-input" placeholder="name@yourstore.com" />
                </div>

                <div class="store-user-form-field">
                    <label class="store-user-label" for="storeUserPassword"><b>Password</b></label>
                    <div class="store-user-input-wrap">
                        <input type="password" id="storeUserPassword" class="form-control store-user-input with-toggle" placeholder="Enter password" />
                        <button type="button" class="store-user-password-toggle" id="toggleStoreUserPasswordBtn" aria-label="Show password"><i class="fa fa-eye" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>

            <div style="margin-top:12px; display:flex; justify-content:flex-end;">
                <button type="button" class="admin-btn" id="createStoreUserBtn" @(noActiveStores ? "disabled" : null)><i class="fa fa-user-plus" aria-hidden="true"></i> Create Store User</button>
            </div>
            <div id="storeUserCreateStatus" class="admin-inline-message" role="status" aria-live="polite"></div>
        </div>

        <div class="admin-setup-card">
            <div class="admin-card-head">
                <div>
                    <h3 class="admin-card-title">Existing Store Users</h3>
                    <p class="admin-card-subtitle">View and refresh store-level user access.</p>
                </div>
                <div class="store-users-card-head-right">
                    <span class="admin-users-count" id="storeUsersCount">0 users</span>
                    <button type="button" class="admin-btn secondary" id="refreshStoreUsersBtn"><i class="fa fa-refresh" aria-hidden="true"></i> Refresh</button>
                </div>
            </div>
            <div id="storeUsersList" class="store-users-empty">No store users yet. Create your first store user to start managing staff access.</div>
        </div>

        <div class="admin-setup-actions">
            <button type="button" class="admin-btn secondary" onclick="window.location.href='@Url.Action("SetupCreateOrder", "Customer", new { setupOnly = true })'"><i class="fa fa-tags" aria-hidden="true"></i> Go to Store Price Configuration</button>
            <button type="button" class="admin-btn secondary" onclick="window.location.href='@Url.Action("Index", "Dashboard")'"><i class="fa fa-arrow-left" aria-hidden="true"></i> Back to Dashboard</button>
        </div>
    </div>
</section>

<script>
(function () {
    var createRequestInProgress = false;
    var statusRequestsInProgressByUser = new Set();

    function setCreateStatus(type, text) {
        var statusEl = document.getElementById("storeUserCreateStatus");
        if (!statusEl) {
            return;
        }

        statusEl.className = "admin-inline-message" + (type ? (" " + type) : "");
        statusEl.textContent = text || "";
    }

    function updateStoreChoiceVisual() {
        var wrappers = document.querySelectorAll('#targetStoreCodes .store-choice');
        wrappers.forEach(function (wrapper) {
            var input = wrapper.querySelector('input.target-store-code');
            if (!input) {
                return;
            }
            if (input.checked) {
                wrapper.classList.add('selected');
            } else {
                wrapper.classList.remove('selected');
            }
        });
    }

    function updateUsersCount(users) {
        var countEl = document.getElementById("storeUsersCount");
        if (!countEl) {
            return;
        }
        var count = (users && users.length) ? users.length : 0;
        countEl.textContent = count + (count === 1 ? " user" : " users");
    }

    function getSelectedStoreCodes() {
        var selected = [];
        var checkboxes = document.querySelectorAll('.target-store-code');
        checkboxes.forEach(function (cb) {
            if (cb && cb.checked) {
                var code = (cb.value || '').trim();
                if (code && selected.indexOf(code) < 0) {
                    selected.push(code);
                }
            }
        });
        return selected;
    }

    function renderUsers(users) {
        var host = document.getElementById("storeUsersList");
        if (!host) return;

        if (!users || !users.length) {
            updateUsersCount([]);
            host.className = "store-users-empty";
            host.textContent = "No store users yet. Create your first store user to start managing staff access.";
            return;
        }

        updateUsersCount(users);
        host.className = "store-users-table-wrap";

        var html = "<table class='store-users-table'><thead><tr>"
            + "<th>Email</th>"
            + "<th>Role</th>"
            + "<th>Active</th>"
            + "<th>Created Date</th>"
            + "<th>Assigned Store</th>"
            + "<th>Action</th>"
            + "</tr></thead><tbody>";

        users.forEach(function (u) {
            var email = (u.email || u.Email || "");
            var isActive = !!(u.isActive ?? u.IsActive);
            var actionText = isActive ? "Deactivate" : "Activate";

            html += "<tr>"
                + "<td>" + email + "</td>"
                + "<td>" + (u.role || u.Role || "StoreUser") + "</td>"
                + "<td>" + (isActive ? "Yes" : "No") + "</td>"
                + "<td>" + (u.createdDate || u.CreatedDate || "") + "</td>"
                + "<td>" + (u.storeCode || u.StoreCode || "") + "</td>"
                + "<td>"
                + "<button type='button' class='admin-btn secondary toggle-store-user-status-btn'"
                + " data-email='" + encodeURIComponent(email) + "'"
                + " data-active='" + (isActive ? "true" : "false") + "'"
                + " style='min-width:120px; min-height:34px;'>" + actionText + "</button>"
                + "</td>"
                + "</tr>";
        });

        html += "</tbody></table>";
        host.innerHTML = html;

        var actionButtons = host.querySelectorAll('.toggle-store-user-status-btn');
        actionButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                var encodedEmail = btn.getAttribute('data-email') || '';
                var currentActive = (btn.getAttribute('data-active') || '').toLowerCase() === 'true';
                var nextActive = !currentActive;
                var userEmail = decodeURIComponent(encodedEmail);
                var normalizedEmail = (userEmail || '').trim().toLowerCase();

                if (!userEmail) {
                    setCreateStatus("error", 'User email is required.');
                    return;
                }

                if (statusRequestsInProgressByUser.has(normalizedEmail)) {
                    return;
                }

                var body = new URLSearchParams();
                var selectedStores = getSelectedStoreCodes();
                var selectedStore = selectedStores.length > 0 ? selectedStores[0] : "";
                body.append('userEmail', userEmail);
                body.append('isActive', nextActive ? 'true' : 'false');
                body.append('storeCode', selectedStore);

                var originalText = btn.textContent;
                statusRequestsInProgressByUser.add(normalizedEmail);
                btn.disabled = true;
                btn.textContent = nextActive ? 'Activating...' : 'Deactivating...';

                fetch('@Url.Action("SetStoreUserActiveStatus", "Login")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || !data.success) {
                        setCreateStatus("error", (data && data.message) || 'Unable to update store user status.');
                        return;
                    }

                    setCreateStatus("success", data.message || 'Store user status updated successfully.');
                    loadUsers();
                })
                .catch(function () {
                    setCreateStatus("error", 'Unable to update store user status.');
                })
                .finally(function () {
                    statusRequestsInProgressByUser.delete(normalizedEmail);
                    btn.disabled = false;
                    btn.textContent = originalText;
                });
            });
        });
    }

    function loadUsers() {
        var selectedStores = getSelectedStoreCodes();
        var selectedStore = selectedStores.length > 0 ? selectedStores[0] : "";
        if (!selectedStore) {
            renderUsers([]);
            return;
        }

        var requestUrl = '@Url.Action("GetStoreUsers", "Customer")';
        if (selectedStore) {
            requestUrl += "?storeCode=" + encodeURIComponent(selectedStore);
        }

        fetch(requestUrl, {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data || !data.success) {
                renderUsers([]);
                return;
            }
            renderUsers(data.users || []);
        })
        .catch(function () { renderUsers([]); });
    }

    var createBtn = document.getElementById("createStoreUserBtn");
    if (createBtn) {
        createBtn.addEventListener("click", function () {
            if (createRequestInProgress) {
                return;
            }

            var emailInput = document.getElementById("storeUserEmail");
            var passwordInput = document.getElementById("storeUserPassword");
            var email = (emailInput || {}).value || "";
            var password = (passwordInput || {}).value || "";
            var selectedStores = getSelectedStoreCodes();

            if (selectedStores.length === 0) {
                setCreateStatus("error", "Please select at least one active store.");
                return;
            }

            if (!email.trim()) {
                setCreateStatus("error", "Store user email is required.");
                if (emailInput) {
                    emailInput.focus();
                }
                return;
            }

            if (emailInput && !emailInput.checkValidity()) {
                setCreateStatus("error", "Enter a valid email address.");
                emailInput.focus();
                return;
            }

            if (!password.trim()) {
                setCreateStatus("error", "Password is required.");
                if (passwordInput) {
                    passwordInput.focus();
                }
                return;
            }

            var body = new URLSearchParams();
            body.append("email", email);
            body.append("password", password);
            body.append("role", "StoreUser");
            body.append("storeCode", selectedStores[0]);
            selectedStores.forEach(function (code) {
                body.append("storeCodes", code);
            });

            var originalText = createBtn.textContent;
            createRequestInProgress = true;
            createBtn.disabled = true;
            createBtn.innerHTML = "<i class='fa fa-spinner fa-spin' aria-hidden='true'></i> Creating...";
            setCreateStatus("", "");

            fetch('@Url.Action("CreateStoreUser", "Customer")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body.toString()
            })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    setCreateStatus("error", (data && data.message) || "Unable to create store user.");
                    return;
                }
                setCreateStatus("success", data.message || "Store user created successfully.");
                var pwd = document.getElementById("storeUserPassword");
                if (pwd) pwd.value = "";
                loadUsers();
            })
            .catch(function () { setCreateStatus("error", "Unable to create store user."); })
            .finally(function () {
                createRequestInProgress = false;
                createBtn.disabled = false;
                createBtn.textContent = originalText;
            });
        });
    }

    var refreshBtn = document.getElementById("refreshStoreUsersBtn");
    if (refreshBtn) {
        refreshBtn.addEventListener("click", function () { refreshStoresAndUsers(); });
    }

    var storeCheckboxes = document.querySelectorAll('.target-store-code');
    if (storeCheckboxes && storeCheckboxes.length > 0) {
        storeCheckboxes.forEach(function (cb) {
            cb.addEventListener("change", function () {
                updateStoreChoiceVisual();
                loadUsers();
            });
        });
    }

    var togglePasswordBtn = document.getElementById("toggleStoreUserPasswordBtn");
    var passwordInputEl = document.getElementById("storeUserPassword");
    if (togglePasswordBtn && passwordInputEl) {
        togglePasswordBtn.addEventListener("click", function () {
            var visible = passwordInputEl.type === "text";
            passwordInputEl.type = visible ? "password" : "text";
            togglePasswordBtn.innerHTML = visible
                ? "<i class='fa fa-eye' aria-hidden='true'></i>"
                : "<i class='fa fa-eye-slash' aria-hidden='true'></i>";
            togglePasswordBtn.setAttribute("aria-label", visible ? "Show password" : "Hide password");
        });
    }

    function refreshStoresAndUsers() {
        var storeContainer = document.getElementById("targetStoreCodes");
        if (!storeContainer) {
            loadUsers();
            return;
        }

        var currentSelected = getSelectedStoreCodes();
        fetch('@Url.Action("GetNewStoreCreationStoreStatuses", "Customer")', {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data || !data.success) {
                loadUsers();
                return;
            }

            var activeStores = (data.stores || [])
                .filter(function (x) { return !!(x && (x.isActive ?? x.IsActive)); })
                .map(function (x) { return (x.storeCode || x.StoreCode || '').trim(); })
                .filter(function (x) { return !!x; });

            var distinctStores = [];
            activeStores.forEach(function (item) {
                if (distinctStores.indexOf(item) < 0) {
                    distinctStores.push(item);
                }
            });

            storeContainer.innerHTML = "";

            distinctStores.forEach(function (code) {
                var wrapper = document.createElement("label");
                wrapper.className = "store-choice";

                var input = document.createElement("input");
                input.type = "checkbox";
                input.className = "target-store-code";
                input.value = code;
                input.checked = currentSelected.indexOf(code) >= 0;
                input.addEventListener("change", function () {
                    updateStoreChoiceVisual();
                    loadUsers();
                });

                var span = document.createElement("span");
                span.textContent = code;

                wrapper.appendChild(input);
                wrapper.appendChild(span);
                storeContainer.appendChild(wrapper);
            });

            updateStoreChoiceVisual();

            var createButton = document.getElementById("createStoreUserBtn");
            if (createButton) {
                createButton.disabled = distinctStores.length === 0;
            }

            loadUsers();
        })
        .catch(function () {
            loadUsers();
        });
    }

    refreshStoresAndUsers();
    updateStoreChoiceVisual();
})();
</script>
