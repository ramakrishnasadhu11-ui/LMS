    function wfLoad() {
        wfState("Loading orders...");
        var statusEl = wfById("wfStatusFilter");
        var searchEl = wfById("wfSearchText");
        var status = statusEl ? (statusEl.value || "") : "";
        var search = searchEl ? (searchEl.value || "") : "";
        var url = '@Url.Action("GetStoreWorkflowOrders", "Customer")'
            + "?status=" + encodeURIComponent(status)
            + "&searchText=" + encodeURIComponent(search)
            + "&_ts=" + new Date().getTime();
        wfReq(url, "GET", null, function (data) {
            if (!data || !data.success) {
                wfCounters({});
                wfUpdatePriorityStrip({});
                wfState((data && data.message) || "Unable to load workflow orders.");
                return;
            }
            var orders = data.orders || [];
            var c = { total: orders.length, received: 0, processing: 0, ready: 0, delivered: 0 };
            var p = { ready: 0, open: 0, payment: 0, stale: 0 };
            var i;
            for (i = 0; i < orders.length; i++) {
                var item = orders[i] || {};
                var s = String((item.Status || item.status) || "").toLowerCase();
                var pendingAmount = wfNum(item.PendingAmount || item.pendingAmount || item.NetPayable || item.netPayable || 0);
                var ageHours = wfHoursSince(item.CreatedDate || item.createdDate || "");
                if (s === "received") c.received++;
                else if (s === "processing" || s === "in process") c.processing++;
                else if (s === "ready" || s === "ready for delivery") c.ready++;
                else if (s === "delivered") c.delivered++;

                if (s === "ready" || s === "ready for delivery") p.ready++;
                if (s === "received" || s === "processing" || s === "in process") p.open++;
                if (pendingAmount > 0) p.payment++;
                if (ageHours >= 24 && s !== "delivered" && s !== "cancelled") p.stale++;
            }
            wfCounters(c);
            wfUpdatePriorityStrip(p);
            wfUpdateOwnerSummary(orders, p);
            wfSyncToolbarState();
            wfRenderRows(wfFilterByFocus(orders));
        }, function (m) {
            wfCounters({});
            wfUpdatePriorityStrip({});
            wfUpdateOwnerSummary([], {});
            wfState("Unable to load workflow orders. " + (m || ""));
        });
    }
