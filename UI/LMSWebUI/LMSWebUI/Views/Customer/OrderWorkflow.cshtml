    function wfFilterByFocus(orders) {
        var mode = (wfFocusMode || "all").toLowerCase();
        if (mode === "all") return orders;

        return (orders || []).filter(function (item) {
            var status = String((item && (item.Status || item.status)) || "").toLowerCase();
            var pendingAmount = wfNum(item && (item.PendingAmount || item.pendingAmount || item.NetPayable || item.netPayable || 0));
            var ageHours = wfHoursSince(item && (item.CreatedDate || item.createdDate || ""));
            if (mode === "ready") return status === "ready" || status === "ready for delivery";
            if (mode === "open") return status === "received" || status === "processing" || status === "in process";
            if (mode === "payment") return pendingAmount > 0;
            if (mode === "stale") return ageHours >= 24 && status !== "delivered" && status !== "cancelled";
            return true;
