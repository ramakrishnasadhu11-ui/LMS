    function wfUpdateOwnerSummary(orders, priorityStats) {
        orders = orders || [];
        priorityStats = priorityStats || {};

        var totalAmount = 0;
        var totalPending = 0;
        var activeOrders = 0;
        for (var i = 0; i < orders.length; i++) {
            var o = orders[i] || {};
            var status = String((o.Status || o.status) || "").toLowerCase();
            var amount = wfNum(o.OrderAmount || o.orderAmount || 0);
            var pending = wfNum(o.PendingAmount || o.pendingAmount || o.NetPayable || o.netPayable || 0);
            totalAmount += amount;
            totalPending += pending;
            if (status !== "delivered" && status !== "cancelled") {
                activeOrders += 1;
            }
        }

        var collected = Math.max(totalAmount - totalPending, 0);
        var stale = wfNum(priorityStats.stale);
        var slaHealth = activeOrders > 0 ? Math.max(0, ((activeOrders - stale) / activeOrders) * 100) : 100;

        wfSetText("wfOwnerGross", wfFormatAmount(totalAmount));
        wfSetText("wfOwnerCollected", wfFormatAmount(collected));
        wfSetText("wfOwnerPending", wfFormatAmount(totalPending));
        wfSetText("wfOwnerSla", slaHealth.toFixed(0) + "%");
    }
