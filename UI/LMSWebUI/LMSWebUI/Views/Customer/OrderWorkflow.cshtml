@{
    ViewData["Title"] = "Order Workflow";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
    var tenantName = Convert.ToString(ViewData["WorkflowTenantName"] ?? "-");
    var storeCode = Convert.ToString(ViewData["WorkflowStoreCode"] ?? "-");
    var workflowStatusesJson = Convert.ToString(ViewData["WorkflowStatusesJson"] ?? "[]");
}

<style>
    .wf-page {
        padding: 20px;
    }

    .wf-shell {
        max-width: 1320px;
        margin: 0 auto;
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-surface);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .wf-title {
        background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
        color: #fff;
        padding: 14px 18px;
        font-size: 20px;
        font-weight: 700;
    }

    .wf-body {
        padding: 14px;
    }

    .wf-meta {
        font-size: 12px;
        margin-bottom: 12px;
        color: #475467;
    }

    .wf-counters {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .wf-priority-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(140px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .wf-priority-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        padding: 10px;
        background: var(--els-background);
    }

    .wf-priority-label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 2px;
    }

    .wf-priority-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--els-text);
    }

    .wf-priority-card.alert .wf-priority-value {
        color: #b63838;
    }

    .wf-priority-card.warn .wf-priority-value {
        color: #8a5a00;
    }

    .wf-priority-card.success .wf-priority-value {
        color: #2f8f46;
    }

    .wf-priority-insight {
        margin: -4px 0 12px;
        font-size: 12px;
        color: #475467;
    }

    .wf-owner-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(160px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .wf-owner-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        padding: 10px;
        background: var(--els-background);
    }

    .wf-owner-label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 3px;
    }

    .wf-owner-value {
        font-size: 17px;
        font-weight: 700;
        color: var(--els-text);
    }

    .wf-owner-value.alert { color: #b63838; }
    .wf-owner-value.success { color: #2f8f46; }

    .wf-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 10px;
        padding: 8px;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-background);
    }

    .wf-tool-btn {
        border: 1px solid var(--els-border);
        border-radius: 999px;
        padding: 5px 12px;
        background: #fff;
        font-size: 12px;
        color: #334155;
        cursor: pointer;
    }

    .wf-tool-btn:hover { background: var(--els-accent); }

    .wf-tool-btn.active {
        background: var(--els-primary);
        border-color: var(--els-primary);
        color: #fff;
    }

    .wf-tool-spacer {
        flex: 1;
        min-width: 20px;
    }

    .wf-aging-tag {
        display: inline-block;
        margin-top: 2px;
        font-size: 10px;
        color: #9a6700;
        font-weight: 700;
    }

    .wf-counter-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        padding: 10px;
        background: var(--els-background);
    }

    .wf-counter-label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 2px;
    }

    .wf-counter-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--els-text);
    }

    .wf-filters {
        display: grid;
        grid-template-columns: 180px 1fr auto;
        gap: 8px;
        margin-bottom: 12px;
        align-items: center;
    }

    .wf-grid-wrap {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        overflow: auto;
        max-height: 620px;
        background: var(--els-surface);
    }

    .wf-grid {
        margin: 0;
        width: 100%;
        font-size: 12px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .wf-grid thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--els-accent);
        white-space: nowrap;
        padding: 10px 12px;
        font-weight: 700;
    }

    .wf-grid tbody td {
        padding: 10px 12px;
        vertical-align: middle;
    }

    .wf-grid tbody tr:nth-child(even) td {
        background: #fcfdff;
    }

    .wf-grid tbody tr.wf-row-attention td {
        background: #fff8e1 !important;
    }

    .wf-grid tbody tr.wf-row-payment td {
        background: #fdeeee !important;
    }

    .wf-grid tbody tr.wf-row-stale td {
        background: #fef3c7 !important;
    }

    .wf-status-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .wf-status-received { background: #e8f1ff; color: #1f4e79; }
    .wf-status-processing { background: #fff6dc; color: #8a5a00; }
    .wf-status-ready { background: #e5faf2; color: #0f6b43; }
    .wf-status-delivered { background: #e9f5ee; color: #23653f; }

    .wf-mode-pill {
        display: inline-block;
        border: 1px solid var(--els-border);
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        color: #475467;
        background: var(--els-background);
    }

    .wf-pending-red { color: #b63838 !important; }
    .wf-pending-green { color: #2f8f46 !important; }

    .wf-actions {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    #wfOrdersBody .btn {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    .wf-quick-btn {
        background: var(--els-accent);
        color: var(--els-text);
        border: 1px solid var(--els-border);
    }

    .wf-quick-btn:hover { filter: brightness(0.98); }

    .wf-completed-label {
        color: #2f8f46;
        font-weight: 700;
    }

    .wf-state {
        text-align: center;
        color: #64748b;
        padding: 26px 12px !important;
        font-weight: 600;
    }

    @@media (max-width: 1100px) {
        .wf-filters {
            grid-template-columns: 1fr;
        }

        .wf-counters {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }
    }
</style>

<section class="wf-page">
    @Html.AntiForgeryToken()
    <div class="wf-shell">
        <div class="wf-title">
            Store Order Workflow
        </div>
        <div class="wf-body">
            <div class="wf-meta">
                <b>Tenant:</b> @tenantName &nbsp; | &nbsp; <b>Store:</b> @storeCode
            </div>

            <div id="wfCounters" class="wf-counters"></div>

            <div id="wfPriorityStrip" class="wf-priority-strip">
                <div class="wf-priority-card alert">
                    <div class="wf-priority-label">Ready to deliver</div>
                    <div id="wfPriorityReady" class="wf-priority-value">0</div>
                </div>
                <div class="wf-priority-card warn">
                    <div class="wf-priority-label">Need processing</div>
                    <div id="wfPriorityOpen" class="wf-priority-value">0</div>
                </div>
                <div class="wf-priority-card alert">
                    <div class="wf-priority-label">Pending payment</div>
                    <div id="wfPriorityPayment" class="wf-priority-value">0</div>
                </div>
                <div class="wf-priority-card success">
                    <div class="wf-priority-label">Older than 24h</div>
                    <div id="wfPriorityStale" class="wf-priority-value">0</div>
                </div>
            </div>

            <div id="wfPriorityInsight" class="wf-priority-insight">Focus now: Review ready and overdue orders first.</div>

            <div id="wfOwnerStrip" class="wf-owner-strip">
                <div class="wf-owner-card">
                    <div class="wf-owner-label">Gross Revenue (View)</div>
                    <div id="wfOwnerGross" class="wf-owner-value">₹0.00</div>
                </div>
                <div class="wf-owner-card">
                    <div class="wf-owner-label">Collected (View)</div>
                    <div id="wfOwnerCollected" class="wf-owner-value success">₹0.00</div>
                </div>
                <div class="wf-owner-card">
                    <div class="wf-owner-label">Pending Collection</div>
                    <div id="wfOwnerPending" class="wf-owner-value alert">₹0.00</div>
                </div>
                <div class="wf-owner-card">
                    <div class="wf-owner-label">SLA Health (&lt; 24h)</div>
                    <div id="wfOwnerSla" class="wf-owner-value">100%</div>
                </div>
            </div>

            <div id="wfToolbar" class="wf-toolbar">
                <button type="button" class="wf-tool-btn active" data-focus="all">All</button>
                <button type="button" class="wf-tool-btn" data-focus="ready">Ready</button>
                <button type="button" class="wf-tool-btn" data-focus="open">Need Processing</button>
                <button type="button" class="wf-tool-btn" data-focus="payment">Pending Payment</button>
                <button type="button" class="wf-tool-btn" data-focus="stale">Older 24h</button>
                <div class="wf-tool-spacer"></div>
                <button type="button" class="wf-tool-btn" id="wfClearSearchBtn">Clear Search</button>
            </div>

            <div class="wf-filters">
                <select id="wfStatusFilter" class="form-control">
                    <option value="">All statuses</option>
                </select>
                <input type="text" id="wfSearchText" class="form-control" placeholder="Search by Order No / Invoice No / Customer / Customer Code" autocomplete="off" />
                <button type="button" id="wfRefreshBtn" class="btn btn-primary">Refresh</button>
            </div>

            <div class="wf-grid-wrap">
                <table class="table table-bordered table-striped wf-grid">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Date (UTC)</th>
                            <th>Status</th>
                            <th>Mode</th>
                            <th style="text-align:right;">Pieces</th>
                            <th style="text-align:right;">Amount</th>
                            <th style="text-align:right;">Pending Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="wfOrdersBody">
                        <tr><td class="wf-state" colspan="10">Loading orders...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
    var configuredWorkflowStatuses = @Html.Raw(workflowStatusesJson);
    if (typeof configuredWorkflowStatuses === "string") {
        try {
            configuredWorkflowStatuses = JSON.parse(configuredWorkflowStatuses);
        } catch (_) {
            configuredWorkflowStatuses = [];
        }
    }

    function wfConfiguredStatusList() {
        if (Array.isArray(configuredWorkflowStatuses)) {
            return configuredWorkflowStatuses;
        }

        if (configuredWorkflowStatuses && Array.isArray(configuredWorkflowStatuses.statuses)) {
            return configuredWorkflowStatuses.statuses;
        }

        if (configuredWorkflowStatuses && Array.isArray(configuredWorkflowStatuses.Statuses)) {
            return configuredWorkflowStatuses.Statuses;
        }

        return [];
    }

    function wfById(id) { return document.getElementById(id); }
    var wfFocusMode = "all";
    function wfEsc(v) {
        return String(v || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }
    function wfState(message) {
        var body = wfById("wfOrdersBody");
        if (!body) return;
        body.innerHTML = "<tr><td class='wf-state' colspan='10'>" + wfEsc(message) + "</td></tr>";
    }
    function wfCounters(c) {
        var box = wfById("wfCounters");
        if (!box) return;
        c = c || {};
        function n(x) { x = Number(x); return isNaN(x) ? 0 : x; }
        box.innerHTML =
            "<div class='wf-counter-card'><div class='wf-counter-label'>Total</div><div class='wf-counter-value'>" + n(c.total) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Received</div><div class='wf-counter-value'>" + n(c.received) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Processing</div><div class='wf-counter-value'>" + n(c.processing) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Ready</div><div class='wf-counter-value'>" + n(c.ready) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Completed</div><div class='wf-counter-value'>" + n(c.delivered) + "</div></div>";
    }
    function wfReq(url, method, body, ok, fail) {
        var antiForgeryInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var antiForgeryToken = antiForgeryInput ? antiForgeryInput.value : "";
        var xhr = new XMLHttpRequest();
        xhr.open(method, url, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        if (method === "POST") {
            xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
            xhr.setRequestHeader("RequestVerificationToken", antiForgeryToken);
        }
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            if (xhr.status < 200 || xhr.status >= 300) {
                if (fail) fail("HTTP " + xhr.status);
                return;
            }
            var data;
            try {
                data = JSON.parse(xhr.responseText || "{}");
            } catch (e) {
                if (fail) fail("Invalid JSON");
                return;
            }
            if (ok) ok(data);
        };
        xhr.onerror = function () { if (fail) fail("Network error"); };
        xhr.send(body || null);
    }
    function wfStatusClass(status) {
        var s = String(status || "").toLowerCase();
        if (s === "received") return "wf-status-received";
        if (s === "processing" || s === "in process") return "wf-status-processing";
        if (s === "ready" || s === "ready for delivery") return "wf-status-ready";
        if (s === "delivered") return "wf-status-delivered";
        if (s === "cancelled") return "wf-status-delivered";
        return "wf-status-processing";
    }
    function wfStatusKey(status) {
        var s = String(status || "").trim().toLowerCase();
        var compact = s.replace(/[^a-z0-9]/g, "");
        if (!s) return "";
        if (compact === "inprocess" || compact === "processing") return "processing";
        if (compact === "readyfordelivery" || compact === "ready") return "ready";
        if (compact === "completed" || compact === "delivered") return "delivered";
        if (compact === "cancelled" || compact === "canceled") return "cancelled";
        if (compact === "received") return "received";
        return compact;
    }
    function wfFindConfiguredStatus(status) {
        var list = wfConfiguredStatusList();
        var current = wfStatusKey(status);
        for (var i = 0; i < list.length; i++) {
            var item = list[i] || {};
            var name = wfStatusKey(item.name || item.statusName || item.StatusName || "");
            if (name && name === current) {
                return item;
            }
        }
        return null;
    }
    function wfNormalizeHexColor(value) {
        var v = String(value || "").trim();
        if (!v) return "";
        if (v.charAt(0) !== "#") v = "#" + v;
        if (/^#[0-9a-fA-F]{3}$/.test(v)) {
            return "#" + v.charAt(1) + v.charAt(1) + v.charAt(2) + v.charAt(2) + v.charAt(3) + v.charAt(3);
        }
        if (!/^#[0-9a-fA-F]{6}$/.test(v)) {
            return "";
        }
        return v;
    }
    function wfStatusStyleAttr(status) {
        var configured = wfFindConfiguredStatus(status);
        if (!configured) {
            return "";
        }

        var hex = wfNormalizeHexColor(configured.color || configured.colorCode || configured.ColorCode);
        if (!hex) {
            return "";
        }

        var r = parseInt(hex.substr(1, 2), 16);
        var g = parseInt(hex.substr(3, 2), 16);
        var b = parseInt(hex.substr(5, 2), 16);
        var luminance = (0.299 * r + 0.587 * g + 0.114 * b);
        var textColor = luminance >= 160 ? "#111827" : "#ffffff";
        return " style='background:" + hex + ";color:" + textColor + ";border:1px solid " + hex + ";text-shadow:none'";
    }
    function wfApplyConfiguredStatusTheme() {
        var list = wfConfiguredStatusList();
        if (!list.length) {
            return;
        }

        var styles = [];
        for (var i = 0; i < list.length; i++) {
            var item = list[i] || {};
            var key = wfStatusKey(item.name || item.statusName || item.StatusName || "");
            var hex = wfNormalizeHexColor(item.color || item.colorCode || item.ColorCode);
            if (!key || !hex) {
                continue;
            }

            var r = parseInt(hex.substr(1, 2), 16);
            var g = parseInt(hex.substr(3, 2), 16);
            var b = parseInt(hex.substr(5, 2), 16);
            var luminance = (0.299 * r + 0.587 * g + 0.114 * b);
            var textColor = luminance >= 160 ? "#111827" : "#ffffff";
            var background = hex;

            if (key === "received" || key === "processing" || key === "ready" || key === "delivered" || key === "cancelled") {
                var className = key === "cancelled" ? "wf-status-delivered" : ("wf-status-" + key);
                styles.push("." + className + "{background:" + background + " !important;color:" + textColor + " !important;border:1px solid " + hex + " !important;text-shadow:none !important;}");
            }
        }

        if (!styles.length) {
            return;
        }

        var existing = document.getElementById("wfDynamicStatusColors");
        if (!existing) {
            existing = document.createElement("style");
            existing.id = "wfDynamicStatusColors";
            document.head.appendChild(existing);
        }
        existing.textContent = styles.join("\n");
    }
    function wfNext(status) {
        var list = wfConfiguredStatusList();
        var currentKey = wfStatusKey(status);
        if (!list.length) {
            if (currentKey === "received") return "Processing";
            if (currentKey === "processing") return "Ready";
            if (currentKey === "ready") return "Delivered";
            return "";
        }

        if (currentKey === "delivered" || currentKey === "cancelled") {
            return "";
        }

        for (var i = 0; i < list.length; i++) {
            var item = list[i] || {};
            var name = wfStatusKey(item.name || item.statusName || item.StatusName || "");
            if (name === currentKey) {
                var isFinal = !!item.isFinal;
                if (isFinal || i >= list.length - 1) {
                    return "";
                }

                for (var j = i + 1; j < list.length; j++) {
                    var nextItem = list[j] || {};
                    var nextName = String(nextItem.name || nextItem.statusName || nextItem.StatusName || "").trim();
                    var nextKey = wfStatusKey(nextName);
                    if (!nextName || nextKey === "cancelled") {
                        continue;
                    }

                    return nextName;
                }

                return "";
            }
        }

        return list.length
            ? String(list[0].name || list[0].statusName || list[0].StatusName || "")
            : "";
    }

    function populateWorkflowStatusFilterOptions() {
        var statusEl = wfById("wfStatusFilter");
        if (!statusEl) {
            return;
        }

        var selected = (statusEl.value || "").trim();
        var options = ["<option value=''>All statuses</option>"];
        var list = wfConfiguredStatusList();

        if (list.length) {
            for (var i = 0; i < list.length; i++) {
                var item = list[i] || {};
                var name = String(item.name || item.statusName || item.StatusName || "").trim();
                if (!name) {
                    continue;
                }

                options.push("<option value='" + wfEsc(name) + "'>" + wfEsc(name) + "</option>");
            }
        } else {
            options.push("<option value='Received'>Received</option>");
            options.push("<option value='Processing'>Processing</option>");
            options.push("<option value='Ready'>Ready</option>");
            options.push("<option value='Delivered'>Delivered</option>");
        }

        statusEl.innerHTML = options.join("");
        if (selected) {
            statusEl.value = selected;
        }
    }
    function wfNum(v) { v = Number(v); return isNaN(v) ? 0 : v; }
    function wfPieces(o) {
        var p = parseInt(o.TotalPieces || o.totalPieces || 0, 10);
        if (!isNaN(p) && p > 0) return p;
        var items = o.Items || o.items || [];
        var i, sum = 0;
        for (i = 0; i < items.length; i++) {
            var q = parseInt((items[i] && (items[i].Quantity || items[i].quantity)) || 0, 10);
            if (!isNaN(q) && q > 0) sum += q;
        }
        if (sum > 0) return sum;

        p = parseInt(o.Quantity || o.quantity || 0, 10);
        return (!isNaN(p) && p > 0) ? p : 0;
    }
    function wfBody(obj) {
        var k, parts = [];
        for (k in obj) {
            if (Object.prototype.hasOwnProperty.call(obj, k)) {
                parts.push(encodeURIComponent(k) + "=" + encodeURIComponent(String(obj[k] == null ? "" : obj[k])));
            }
        }
        return parts.join("&");
    }
    function wfHoursSince(dateValue) {
        var dt = new Date(dateValue || "");
        if (isNaN(dt.getTime())) return 0;
        return (new Date().getTime() - dt.getTime()) / 3600000;
    }
    function wfUpdatePriorityStrip(stats) {
        stats = stats || {};
        var ready = wfById("wfPriorityReady");
        var open = wfById("wfPriorityOpen");
        var payment = wfById("wfPriorityPayment");
        var stale = wfById("wfPriorityStale");
        var insight = wfById("wfPriorityInsight");

        if (ready) ready.textContent = String(wfNum(stats.ready));
        if (open) open.textContent = String(wfNum(stats.open));
        if (payment) payment.textContent = String(wfNum(stats.payment));
        if (stale) stale.textContent = String(wfNum(stats.stale));

        if (insight) {
            if (wfNum(stats.ready) > 0) {
                insight.textContent = "Focus now: " + wfNum(stats.ready) + " ready order(s) are waiting for delivery.";
            } else if (wfNum(stats.stale) > 0) {
                insight.textContent = "Focus now: " + wfNum(stats.stale) + " order(s) are older than 24h.";
            } else if (wfNum(stats.payment) > 0) {
                insight.textContent = "Focus now: collect payment on " + wfNum(stats.payment) + " pending order(s).";
            } else {
                insight.textContent = "Focus now: Review ready and overdue orders first.";
            }
        }
    }
    function wfFormatAmount(value) {
        try {
            return formatCurrency(wfNum(value));
        } catch (_) {
            return wfNum(value).toFixed(2);
        }
    }
    function wfSetText(id, text) {
        var el = wfById(id);
        if (el) {
            el.textContent = text;
        }
    }
    function wfSyncToolbarState() {
