@{
    ViewData["Title"] = "Order Workflow";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
    var tenantName = Convert.ToString(ViewData["WorkflowTenantName"] ?? "-");
    var storeCode = Convert.ToString(ViewData["WorkflowStoreCode"] ?? "-");
}

<style>
    .wf-page {
        padding: 20px;
    }

    .wf-shell {
        max-width: 1320px;
        margin: 0 auto;
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-surface);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .wf-title {
        background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
        color: #fff;
        padding: 14px 18px;
        font-size: 20px;
        font-weight: 700;
    }

    .wf-body {
        padding: 14px;
    }

    .wf-meta {
        font-size: 12px;
        margin-bottom: 12px;
        color: #475467;
    }

    .wf-counters {
        display: grid;
        grid-template-columns: repeat(5, minmax(120px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .wf-counter-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        padding: 10px;
        background: var(--els-background);
    }

    .wf-counter-label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 2px;
    }

    .wf-counter-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--els-text);
    }

    .wf-filters {
        display: grid;
        grid-template-columns: 180px 1fr auto;
        gap: 8px;
        margin-bottom: 12px;
        align-items: center;
    }

    .wf-grid-wrap {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        overflow: auto;
        max-height: 620px;
        background: var(--els-surface);
    }

    .wf-grid {
        margin: 0;
        width: 100%;
        font-size: 12px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .wf-grid thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--els-accent);
        white-space: nowrap;
        padding: 10px 12px;
        font-weight: 700;
    }

    .wf-grid tbody td {
        padding: 10px 12px;
        vertical-align: middle;
    }

    .wf-grid tbody tr:nth-child(even) td {
        background: #fcfdff;
    }

    .wf-status-pill {
        display: inline-block;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .wf-status-received { background: #e8f1ff; color: #1f4e79; }
    .wf-status-processing { background: #fff6dc; color: #8a5a00; }
    .wf-status-ready { background: #e5faf2; color: #0f6b43; }
    .wf-status-delivered { background: #e9f5ee; color: #23653f; }

    .wf-mode-pill {
        display: inline-block;
        border: 1px solid var(--els-border);
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        color: #475467;
        background: var(--els-background);
    }

    .wf-pending-red { color: #b63838 !important; }
    .wf-pending-green { color: #2f8f46 !important; }

    .wf-actions {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    #wfOrdersBody .btn {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    .wf-quick-btn {
        background: var(--els-accent);
        color: var(--els-text);
        border: 1px solid var(--els-border);
    }

    .wf-quick-btn:hover { filter: brightness(0.98); }

    .wf-completed-label {
        color: #2f8f46;
        font-weight: 700;
    }

    .wf-state {
        text-align: center;
        color: #64748b;
        padding: 26px 12px !important;
        font-weight: 600;
    }

    @@media (max-width: 1100px) {
        .wf-filters {
            grid-template-columns: 1fr;
        }

        .wf-counters {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }
    }
</style>

<section class="wf-page">
    <div class="wf-shell">
        <div class="wf-title">
            Store Order Workflow
        </div>
        <div class="wf-body">
            <div class="wf-meta">
                <b>Tenant:</b> @tenantName &nbsp; | &nbsp; <b>Store:</b> @storeCode
            </div>

            <div id="wfCounters" class="wf-counters"></div>

            <div class="wf-filters">
                <select id="wfStatusFilter" class="form-control">
                    <option value="">All statuses</option>
                    <option value="Received">Received</option>
                    <option value="Processing">Processing</option>
                    <option value="Ready">Ready</option>
                    <option value="Delivered">Delivered</option>
                </select>
                <input type="text" id="wfSearchText" class="form-control" placeholder="Search by Order No / Invoice No / Customer / Customer Code" />
                <button type="button" id="wfRefreshBtn" class="btn btn-primary">Refresh</button>
            </div>

            <div class="wf-grid-wrap">
                <table class="table table-bordered table-striped wf-grid">
                    <thead>
                        <tr>
                            <th>Order No</th>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Date (UTC)</th>
                            <th>Status</th>
                            <th>Mode</th>
                            <th style="text-align:right;">Pieces</th>
                            <th style="text-align:right;">Amount</th>
                            <th style="text-align:right;">Pending Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="wfOrdersBody">
                        <tr><td class="wf-state" colspan="10">Loading orders...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
    function wfById(id) { return document.getElementById(id); }
    function wfEsc(v) {
        return String(v || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }
    function wfState(message) {
        var body = wfById("wfOrdersBody");
        if (!body) return;
        body.innerHTML = "<tr><td class='wf-state' colspan='10'>" + wfEsc(message) + "</td></tr>";
    }
    function wfCounters(c) {
        var box = wfById("wfCounters");
        if (!box) return;
        c = c || {};
        function n(x) { x = Number(x); return isNaN(x) ? 0 : x; }
        box.innerHTML =
            "<div class='wf-counter-card'><div class='wf-counter-label'>Total</div><div class='wf-counter-value'>" + n(c.total) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Received</div><div class='wf-counter-value'>" + n(c.received) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Processing</div><div class='wf-counter-value'>" + n(c.processing) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Ready</div><div class='wf-counter-value'>" + n(c.ready) + "</div></div>" +
            "<div class='wf-counter-card'><div class='wf-counter-label'>Completed</div><div class='wf-counter-value'>" + n(c.delivered) + "</div></div>";
    }
    function wfReq(url, method, body, ok, fail) {
        var xhr = new XMLHttpRequest();
        xhr.open(method, url, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        if (method === "POST") {
            xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
        }
        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) return;
            if (xhr.status < 200 || xhr.status >= 300) {
                if (fail) fail("HTTP " + xhr.status);
                return;
            }
            var data;
            try {
                data = JSON.parse(xhr.responseText || "{}");
            } catch (e) {
                if (fail) fail("Invalid JSON");
                return;
            }
            if (ok) ok(data);
        };
        xhr.onerror = function () { if (fail) fail("Network error"); };
        xhr.send(body || null);
    }
    function wfStatusClass(status) {
        var s = String(status || "").toLowerCase();
        if (s === "received") return "wf-status-received";
        if (s === "processing") return "wf-status-processing";
        if (s === "ready") return "wf-status-ready";
        if (s === "delivered") return "wf-status-delivered";
        return "wf-status-received";
    }
    function wfNext(status) {
        var s = String(status || "").toLowerCase();
        if (s === "received") return "Processing";
        if (s === "processing") return "Ready";
        if (s === "ready") return "Delivered";
        return "";
    }
    function wfNum(v) { v = Number(v); return isNaN(v) ? 0 : v; }
    function wfPieces(o) {
        var p = parseInt(o.TotalPieces || o.totalPieces || 0, 10);
        if (!isNaN(p) && p > 0) return p;
        var items = o.Items || o.items || [];
        var i, sum = 0;
        for (i = 0; i < items.length; i++) {
            var q = parseInt((items[i] && (items[i].Quantity || items[i].quantity)) || 0, 10);
            if (!isNaN(q) && q > 0) sum += q;
        }
        if (sum > 0) return sum;

        p = parseInt(o.Quantity || o.quantity || 0, 10);
        return (!isNaN(p) && p > 0) ? p : 0;
    }
    function wfBody(obj) {
        var k, parts = [];
        for (k in obj) {
            if (Object.prototype.hasOwnProperty.call(obj, k)) {
                parts.push(encodeURIComponent(k) + "=" + encodeURIComponent(String(obj[k] == null ? "" : obj[k])));
            }
        }
        return parts.join("&");
    }
    function wfBindActions() {
        var i, btns;
        btns = document.querySelectorAll(".wf-move-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    var target = btn.getAttribute("data-target") || "";
                    if (!orderNo || !target) return;
                    wfReq('@Url.Action("UpdateStoreWorkflowOrderStatus", "Customer")', "POST", wfBody({ orderNo: orderNo, status: target }), function () {
                        wfLoad();
                    }, function (m) {
                        wfState("Unable to update workflow status. " + (m || ""));
                    });
                };
            })(btns[i]);
        }

        btns = document.querySelectorAll(".wf-settle-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    var pendingValue = wfNum(btn.getAttribute("data-pending") || 0);
                    var mode = (btn.getAttribute("data-mode") || "Cash").trim() || "Cash";
                    if (!orderNo || pendingValue <= 0) return;

                    var amountText = window.prompt("Enter settle amount for order " + orderNo + " (max " + pendingValue.toFixed(2) + "):", pendingValue.toFixed(2));
                    if (amountText === null) {
                        return;
                    }

                    var paidAmount = wfNum(amountText);
                    if (!isFinite(paidAmount) || paidAmount <= 0 || paidAmount > pendingValue) {
                        window.alert("Settle amount must be greater than zero and not more than pending amount.");
                        return;
                    }

                    btn.disabled = true;
                    var oldText = btn.textContent;
                    btn.textContent = "Settling...";

                    wfReq('@Url.Action("SettleOrderPendingPayment", "Customer")', "POST", wfBody({
                        orderNo: orderNo,
                        paidAmount: paidAmount.toFixed(2),
                        paymentMode: mode,
                        notes: "Settled from Store Order Workflow"
                    }), function (data) {
                        if (!data || !data.success) {
                            window.alert((data && data.message) || "Unable to settle pending payment.");
                            btn.disabled = false;
                            btn.textContent = oldText;
                            return;
                        }

                        wfLoad();
                    }, function (m) {
                        window.alert("Unable to settle pending payment. " + (m || ""));
                        btn.disabled = false;
                        btn.textContent = oldText;
                    });
                };
            })(btns[i]);
        }

        btns = document.querySelectorAll(".wf-print-tags-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    if (!orderNo) return;
                    window.open('@Url.Action("PrintOrderTags", "Customer")?orderNo=' + encodeURIComponent(orderNo), "_blank");
                };
            })(btns[i]);
        }

        btns = document.querySelectorAll(".wf-print-bill-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    if (!orderNo) return;
                    window.open('@Url.Action("PrintOrderBill", "Customer")?orderNo=' + encodeURIComponent(orderNo) + '&autoPrint=true', "_blank");
                };
            })(btns[i]);
        }

        btns = document.querySelectorAll(".wf-download-pdf-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    if (!orderNo) return;
                    window.open('@Url.Action("DownloadOrderBillPdf", "Customer")?orderNo=' + encodeURIComponent(orderNo), "_blank");
                };
            })(btns[i]);
        }

        btns = document.querySelectorAll(".wf-email-bill-btn");
        for (i = 0; i < btns.length; i++) {
            (function (btn) {
                btn.onclick = function () {
                    var orderNo = btn.getAttribute("data-order") || "";
                    if (!orderNo) return;

                    if (!window.confirm("Send bill to customer email now?")) {
                        return;
                    }

                    var email = (btn.getAttribute("data-email") || "").trim();
                    if (!email) {
                        email = (window.prompt("Customer email is missing. Please enter email to continue:", "") || "").trim();
                        if (!email) {
                            window.alert("Email sending skipped. Customer email not provided.");
                            return;
                        }
                    }

                    wfReq('@Url.Action("SendOrderBillEmail", "Customer")', "POST", wfBody({ orderNo: orderNo, email: email }), function (data) {
                        if (!data || !data.success) {
                            window.alert((data && data.message) || "Unable to send bill email.");
                            return;
                        }

                        btn.setAttribute("data-email", email);
                        window.alert(data.message || "Bill emailed successfully.");
                    }, function (m) {
                        window.alert("Unable to send bill email. " + (m || ""));
                    });
                };
            })(btns[i]);
        }
    }
    function wfRenderRows(orders) {
        var body = wfById("wfOrdersBody");
        if (!body) return;
        if (!orders || !orders.length) {
            wfState("No orders found for selected filter.");
            return;
        }
        var i, html = "";
        for (i = 0; i < orders.length; i++) {
            var o = orders[i] || {};
            var status = o.Status || o.status || "Received";
            var mode = String(o.OrderMode || o.orderMode || "pieces").toLowerCase();
            var ordNo = wfEsc(o.OrderNo || o.orderNo || "");
            var invNo = wfEsc(o.InvoiceNo || o.invoiceNo || o.OrderNo || o.orderNo || "");
            var customer = wfEsc(o.CustomerName || o.customerName || "");
            var created = wfEsc(String(o.CreatedDate || o.createdDate || "").replace("T", " ").substring(0, 16));
            var pending = wfNum(o.PendingAmount || o.pendingAmount || o.NetPayable || o.netPayable || 0);
            var amount = wfNum(o.OrderAmount || o.orderAmount || 0);
            var pcs = mode === "weight" ? "-" : String(wfPieces(o));
            var target = wfNext(status);
            var customerEmail = wfEsc(o.CustomerEmail || o.customerEmail || "");
            var actions = "<div class='wf-actions'>";
            if (target) {
                actions += "<button type='button' class='btn btn-xs btn-success wf-move-btn' data-order='" + ordNo + "' data-target='" + wfEsc(target) + "'>Next: " + wfEsc(target) + "</button>";
            } else {
                actions += "<span class='wf-completed-label'>Completed</span>";
            }

            if (pending > 0) {
                actions += "<button type='button' class='btn btn-xs wf-settle-btn' style='background:#1f4e79; color:#fff; border:1px solid #1f4e79;' data-order='" + ordNo + "' data-pending='" + pending.toFixed(2) + "' data-mode='" + wfEsc(o.PaymentMode || o.paymentMode || "Cash") + "'>Settle</button>";
            }

            actions += "<button type='button' class='btn btn-xs wf-quick-btn wf-print-tags-btn' data-order='" + ordNo + "'>Tags</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-print-bill-btn' data-order='" + ordNo + "'>Print Bill</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-download-pdf-btn' data-order='" + ordNo + "'>PDF</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-email-bill-btn' data-order='" + ordNo + "' data-email='" + customerEmail + "'>Email Bill</button>"
                + "</div>";
            html += "<tr>"
                + "<td>" + ordNo + "</td>"
                + "<td>" + invNo + "</td>"
                + "<td>" + customer + "</td>"
                + "<td>" + created + "</td>"
                + "<td><span class='wf-status-pill " + wfStatusClass(status) + "'>" + wfEsc(status) + "</span></td>"
                + "<td><span class='wf-mode-pill'>" + (mode === "weight" ? "Weight" : "Pieces") + "</span></td>"
                + "<td style='text-align:right; font-weight:600; color:#1f4e79;'>" + wfEsc(pcs) + "</td>"
                + "<td style='text-align:right;'>" + amount.toFixed(2) + "</td>"
                + "<td class='" + (pending > 0 ? "wf-pending-red" : "wf-pending-green") + "' style='text-align:right; font-weight:700;'>" + pending.toFixed(2) + "</td>"
                + "<td>" + actions + "</td>"
                + "</tr>";
        }
        body.innerHTML = html;
        wfBindActions();
    }
    function wfLoad() {
        wfState("Loading orders...");
        var statusEl = wfById("wfStatusFilter");
        var searchEl = wfById("wfSearchText");
        var status = statusEl ? (statusEl.value || "") : "";
        var search = searchEl ? (searchEl.value || "") : "";
        var url = '@Url.Action("GetStoreWorkflowOrders", "Customer")'
            + "?status=" + encodeURIComponent(status)
            + "&searchText=" + encodeURIComponent(search)
            + "&_ts=" + new Date().getTime();
        wfReq(url, "GET", null, function (data) {
            if (!data || !data.success) {
                wfCounters({});
                wfState((data && data.message) || "Unable to load workflow orders.");
                return;
            }
            var orders = data.orders || [];
            var c = { total: orders.length, received: 0, processing: 0, ready: 0, delivered: 0 };
            var i;
            for (i = 0; i < orders.length; i++) {
                var s = String((orders[i] && (orders[i].Status || orders[i].status)) || "").toLowerCase();
                if (s === "received") c.received++;
                else if (s === "processing") c.processing++;
                else if (s === "ready") c.ready++;
                else if (s === "delivered") c.delivered++;
            }
            wfCounters(c);
            wfRenderRows(orders);
        }, function (m) {
            wfCounters({});
            wfState("Unable to load workflow orders. " + (m || ""));
        });
    }
    var oldOnError = window.onerror;
    window.onerror = function (message, source, lineno, colno) {
        wfState("Workflow script error: " + (message || "Unknown error") + (lineno ? (" (line " + lineno + ")") : ""));
        if (typeof oldOnError === "function") {
            try { oldOnError(message, source, lineno, colno); } catch (e) { }
        }
        return false;
    };
    try {
        var refreshBtn = wfById("wfRefreshBtn");
        if (refreshBtn) refreshBtn.onclick = wfLoad;
        var statusFilter = wfById("wfStatusFilter");
        if (statusFilter) statusFilter.onchange = wfLoad;
        var searchInput = wfById("wfSearchText");
        if (searchInput) {
            searchInput.onkeydown = function (e) {
                e = e || window.event;
                var key = e.key || e.keyCode;
                if (key === "Enter" || key === 13) {
                    if (e.preventDefault) e.preventDefault();
                    wfLoad();
                    return false;
                }
                return true;
            };
        }
        wfLoad();
    } catch (e) {
        wfState("Workflow script error: " + (e && e.message ? e.message : e));
    }
    return;
    /*
    function nextStatus(current) {
        var v = (current || "").toLowerCase();
        if (v === "received") return "Processing";
        if (v === "processing") return "Ready";
        if (v === "ready") return "Delivered";
        return null;
    }

    function toStatusClass(statusText) {
        var status = (statusText || "").toLowerCase();
        if (status === "received") return "wf-status-received";
        if (status === "processing") return "wf-status-processing";
        if (status === "ready") return "wf-status-ready";
        if (status === "delivered") return "wf-status-delivered";
        return "wf-status-received";
    }

    function esc(text) {
        return (text || "").toString()
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function firstDefined() {
        for (var i = 0; i < arguments.length; i++) {
            if (arguments[i] !== undefined && arguments[i] !== null) {
                return arguments[i];
            }
        }

        return null;
    }

    function toFormBody(values) {
        var parts = [];
        var key;

        for (key in values) {
            if (!Object.prototype.hasOwnProperty.call(values, key)) {
                continue;
            }

            var value = values[key];
            if (value === undefined || value === null) {
                value = "";
            }

            parts.push(encodeURIComponent(key) + "=" + encodeURIComponent(String(value)));
        }

        return parts.join("&");
    }

    function getQueryParam(name) {
        function safeDecode(value) {
            try {
                return decodeURIComponent((value || "").replace(/\+/g, " "));
            } catch (e) {
                return (value || "").replace(/\+/g, " ");
            }
        }

        var query = (window.location && window.location.search ? window.location.search : "") || "";
        if (!query) {
            return "";
        }

        var raw = query.charAt(0) === "?" ? query.substring(1) : query;
        var parts = raw.split("&");
        var i;

        for (i = 0; i < parts.length; i++) {
            var pair = parts[i].split("=");
            var key = pair.length > 0 ? safeDecode(pair[0] || "") : "";
            if (key !== name) {
                continue;
            }

            var value = pair.length > 1 ? pair.slice(1).join("=") : "";
            return safeDecode(value || "");
        }

        return "";
    }

    function requestJson(url, method, body, onSuccess, onError) {
        var xhr = new XMLHttpRequest();
        xhr.open(method, url, true);
        xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");

        if (method === "POST") {
            xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
        }

        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) {
                return;
            }

            if (xhr.status < 200 || xhr.status >= 300) {
                if (onError) {
                    onError();
                }
                return;
            }

            var data = null;
            try {
                data = JSON.parse(xhr.responseText || "{}");
            } catch (e) {
                if (onError) {
                    onError();
                }
                return;
            }

            if (onSuccess) {
                onSuccess(data);
            }
        };

        xhr.onerror = function () {
            if (onError) {
                onError();
            }
        };

        xhr.send(body || null);
    }

    function renderCounters(counters) {
        var box = document.getElementById("wfCounters");
        if (!box) return;
        counters = counters || {};
        var cards = [
            { k: "total", t: "Total" },
            { k: "received", t: "Received" },
            { k: "processing", t: "Processing" },
            { k: "ready", t: "Ready" },
            { k: "delivered", t: "Completed" }
        ];

        box.innerHTML = cards.map(function (c) {
            return "<div class='wf-counter-card'>"
                + "<div class='wf-counter-label'>" + c.t + "</div>"
                + "<div class='wf-counter-value'>" + Number(counters[c.k] || 0) + "</div>"
                + "</div>";
        }).join("");
    }

    function setBodyState(message) {
        var body = document.getElementById("wfOrdersBody");
        if (!body) return;
        body.innerHTML = "<tr><td class='wf-state' colspan='10'>" + esc(message) + "</td></tr>";
    }

    function resolveWorkflowTotalPieces(order) {
        var explicitPieces = Number(firstDefined(order.TotalPieces, order.totalPieces, 0));
        if (!isNaN(explicitPieces) && explicitPieces > 0) {
            return Math.floor(explicitPieces);
        }

        var items = order.Items || order.items || [];
        if (Array.isArray(items) && items.length) {
            var qtyFromItems = items.reduce(function (sum, x) {
                var q = Number((x && firstDefined(x.Quantity, x.quantity, 0)) || 0);
                return sum + (!isNaN(q) && q > 0 ? q : 0);
            }, 0);

            if (qtyFromItems > 0) {
                return qtyFromItems;
            }
        }

        return 0;
    }

    function renderRows(orders) {
        var body = document.getElementById("wfOrdersBody");
        if (!body) return;
        body.innerHTML = "";

        if (!orders || !orders.length) {
            setBodyState("No orders found for selected filter.");
            return;
        }

        orders.forEach(function (o) {
            var created = (o.CreatedDate || o.createdDate || "").toString().replace("T", " ").substring(0, 16);
            var status = o.Status || o.status || "Received";
            var target = nextStatus(status);
            var pendingAmount = Number(firstDefined(o.PendingAmount, o.pendingAmount, o.NetPayable, o.netPayable, 0));
            var orderNo = esc(o.OrderNo || o.orderNo || "");
            var customerEmail = esc(o.CustomerEmail || o.customerEmail || "");
            var orderMode = String((o.OrderMode || o.orderMode || "pieces") || "pieces").toLowerCase();
            var totalPieces = resolveWorkflowTotalPieces(o);
            var totalPiecesText = orderMode === "weight" ? "-" : String(totalPieces);
            var actionHtml = "<div class='wf-actions'>";

            if (!target) {
                actionHtml += "<span class='wf-completed-label'>Completed</span>";
            } else {
                actionHtml += "<button type='button' class='btn btn-xs btn-success wf-move-btn' data-order='" + orderNo + "' data-target='" + esc(target) + "'>Next: " + esc(target) + "</button>";
            }

            if (pendingAmount > 0) {
                actionHtml += "<button type='button' class='btn btn-xs wf-settle-btn' style='background:#1f4e79; color:#fff; border:1px solid #1f4e79;' data-order='" + orderNo + "' data-pending='" + pendingAmount.toFixed(2) + "'>Settle</button>";
            }

            actionHtml += "<button type='button' class='btn btn-xs wf-quick-btn wf-print-tags-btn' data-order='" + orderNo + "'>Tags</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-print-bill-btn' data-order='" + orderNo + "'>Print Bill</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-download-pdf-btn' data-order='" + orderNo + "'>PDF</button>"
                + "<button type='button' class='btn btn-xs wf-quick-btn wf-email-bill-btn' data-order='" + orderNo + "' data-email='" + customerEmail + "'>Email Bill</button>"
                + "</div>";

            var tr = document.createElement("tr");
            var pendingClass = pendingAmount > 0 ? "wf-pending-red" : "wf-pending-green";
            var statusClass = toStatusClass(status);
            tr.innerHTML = "<td>" + orderNo + "</td>"
                + "<td>" + esc(o.InvoiceNo || o.invoiceNo || o.OrderNo || o.orderNo || "") + "</td>"
                + "<td>" + esc(o.CustomerName || o.customerName || "") + "</td>"
                + "<td>" + esc(created) + "</td>"
                + "<td><span class='wf-status-pill " + statusClass + "'>" + esc(status) + "</span></td>"
                + "<td><span class='wf-mode-pill'>" + (orderMode === "weight" ? "Weight" : "Pieces") + "</span></td>"
                + "<td style='text-align:right; font-weight:600; color:#1f4e79;">" + totalPiecesText + "</td>"
                + "<td style='text-align:right;'>" + Number(o.OrderAmount || o.orderAmount || 0).toFixed(2) + "</td>"
                + "<td class='" + pendingClass + "' style='text-align:right; font-weight:700;'>" + pendingAmount.toFixed(2) + "</td>"
                + "<td>" + actionHtml + "</td>";
            body.appendChild(tr);
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-move-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                var target = btn.getAttribute("data-target") || "";
                if (!orderNo || !target) return;

                btn.disabled = true;
                btn.textContent = "Updating...";

                var body = toFormBody({
                    orderNo: orderNo,
                    status: target
                });

                requestJson('@Url.Action("UpdateStoreWorkflowOrderStatus", "Customer")', 'POST', body, function (data) {
                    if (!data || !data.success) {
                        window.alert((data && data.message) || "Unable to update workflow status.");
                        loadWorkflowOrders();
                        btn.disabled = false;
                        btn.textContent = "Next: " + target;
                        return;
                    }

                    loadWorkflowOrders();
                }, function () {
                    window.alert("Unable to update workflow status.");
                    btn.disabled = false;
                    btn.textContent = "Next: " + target;
                });
            });
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-settle-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                var pendingValue = Number(btn.getAttribute("data-pending") || "0");
                if (!orderNo || pendingValue <= 0) {
                    return;
                }

                var amountText = window.prompt("Enter settle amount for order " + orderNo + " (max " + pendingValue.toFixed(2) + "):", pendingValue.toFixed(2));
                if (amountText === null) {
                    return;
                }

                var paidAmount = Number(amountText);
                if (!isFinite(paidAmount) || paidAmount <= 0 || paidAmount > pendingValue) {
                    window.alert("Settle amount must be greater than zero and not more than pending amount.");
                    return;
                }

                btn.disabled = true;
                btn.textContent = "Settling...";

                var body = toFormBody({
                    orderNo: orderNo,
                    paidAmount: paidAmount.toFixed(2),
                    paymentMode: "Cash",
                    notes: "Settled from Store Order Workflow"
                });

                requestJson('@Url.Action("SettleOrderPendingPayment", "Customer")', 'POST', body, function (data) {
                    if (!data || !data.success) {
                        window.alert((data && data.message) || "Unable to settle pending payment.");
                        btn.disabled = false;
                        btn.textContent = "Settle";
                        return;
                    }

                    loadWorkflowOrders();
                }, function () {
                    window.alert("Unable to settle pending payment.");
                    btn.disabled = false;
                    btn.textContent = "Settle";
                });
            });
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-print-tags-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                if (!orderNo) {
                    return;
                }

                window.open('@Url.Action("PrintOrderTags", "Customer")?orderNo=' + encodeURIComponent(orderNo), '_blank');
            });
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-print-bill-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                if (!orderNo) {
                    return;
                }

                window.open('@Url.Action("PrintOrderBill", "Customer")?orderNo=' + encodeURIComponent(orderNo) + '&autoPrint=true', '_blank');
            });
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-download-pdf-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                if (!orderNo) {
                    return;
                }

                window.open('@Url.Action("DownloadOrderBillPdf", "Customer")?orderNo=' + encodeURIComponent(orderNo), '_blank');
            });
        });

        Array.prototype.slice.call(document.querySelectorAll(".wf-email-bill-btn")).forEach(function (btn) {
            btn.addEventListener("click", function () {
                var orderNo = btn.getAttribute("data-order") || "";
                if (!orderNo) {
                    return;
                }

                if (!window.confirm('Send bill to customer email now?')) {
                    return;
                }

                var email = (btn.getAttribute("data-email") || "").trim();
                if (!email) {
                    email = (window.prompt('Customer email is missing. Please enter email to continue:', '') || '').trim();
                    if (!email) {
                        window.alert('Email sending skipped. Customer email not provided.');
                        return;
                    }
                }

                var body = toFormBody({
                    orderNo: orderNo,
                    email: email
                });

                btn.disabled = true;
                var oldText = btn.textContent;
                btn.textContent = 'Sending...';

                requestJson('@Url.Action("SendOrderBillEmail", "Customer")', 'POST', body, function (data) {
                    if (!data || !data.success) {
                        window.alert((data && data.message) || 'Unable to send bill email.');
                        btn.disabled = false;
                        btn.textContent = oldText;
                        return;
                    }

                    btn.setAttribute('data-email', email);
                    window.alert(data.message || 'Bill emailed successfully.');
                    btn.disabled = false;
                    btn.textContent = oldText;
                }, function () {
                    window.alert('Unable to send bill email.');
                    btn.disabled = false;
                    btn.textContent = oldText;
                });
            });
        });
    }

    function loadWorkflowOrders() {
        setBodyState("Loading orders...");

        var status = (document.getElementById("wfStatusFilter").value || "").trim();
        var search = (document.getElementById("wfSearchText").value || "").trim();
        var url = '@Url.Action("GetStoreWorkflowOrders", "Customer")'
            + '?status=' + encodeURIComponent(status)
            + '&searchText=' + encodeURIComponent(search)
            + '&_ts=' + Date.now();

        requestJson(url, 'GET', null, function (data) {
            if (!data || !data.success) {
                renderCounters({});
                setBodyState((data && data.message) || "Unable to load workflow orders.");
                return;
            }

            var orders = data.orders || [];
            var counters = {
                total: orders.length,
                received: 0,
                processing: 0,
                ready: 0,
                delivered: 0
            };

            orders.forEach(function (o) {
                var status = (o.Status || o.status || "").toString().toLowerCase();
                var pendingAmount = Number(firstDefined(o.PendingAmount, o.pendingAmount, o.NetPayable, o.netPayable, 0));

                if (status === "received") {
                    counters.received += 1;
                    return;
                }

                if (status === "processing") {
                    counters.processing += 1;
                    return;
                }

                if (status === "ready") {
                    if (pendingAmount > 0) {
                        counters.ready += 1;
                    } else {
                        counters.delivered += 1;
                    }
                    return;
                }

                if (status === "delivered") {
                    counters.delivered += 1;
                }
            });

            renderCounters(counters);
            renderRows(orders);
        }, function () {
            renderCounters({});
            setBodyState("Unable to load workflow orders.");
        });
    }

    try {
