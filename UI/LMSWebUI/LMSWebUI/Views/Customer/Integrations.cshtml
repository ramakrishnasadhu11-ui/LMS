@model LMSWebUI.Models.Admin.IntegrationsViewModel
@{
    ViewData["Title"] = "Integrations";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
}

<style>
    .integrations-page { padding: 20px; }
    .integrations-wrap { max-width: 1180px; margin: 0 auto; }
    .integrations-title {
        background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
        color: #fff;
        padding: 14px 20px;
        border-radius: 10px 10px 0 0;
        font-size: 20px;
        font-weight: 600;
    }
    .integrations-note {
        border: 1px solid var(--els-border);
        border-top: none;
        border-radius: 0 0 10px 10px;
        background: var(--els-surface);
        padding: 12px 16px;
        margin-bottom: 16px;
    }
    .integration-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 14px;
    }
    .category-card {
        background: var(--els-surface);
        border: 1px solid var(--els-border);
        border-radius: 10px;
        margin-bottom: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        min-height: 100%;
    }
    .category-title {
        padding: 10px 14px;
        font-size: 16px;
        font-weight: 700;
        border-bottom: 1px solid var(--els-border);
    }
    .provider-card {
        padding: 14px;
    }
    .provider-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }
    .provider-name { font-weight: 700; color: var(--els-text); }
    .provider-status { font-size: 12px; padding: 4px 8px; border-radius: 99px; background: var(--els-accent); }
    .provider-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px;
    }
    .integration-field label { font-weight: 600; margin-bottom: 4px; display: block; }
    .integration-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 4px;
    }
    .integration-field input,
    .integration-field select {
        width: 100%;
        min-height: 38px;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        padding: 8px 10px;
        background: var(--els-background);
        color: var(--els-text);
    }
    .integration-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }
    .integration-btn {
        min-height: 38px;
        min-width: 140px;
        border: 1px solid transparent;
        border-radius: 8px;
        padding: 0 12px;
        color: #fff;
        background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
        font-weight: 600;
    }
    .integration-btn.secondary { background: linear-gradient(180deg, #8f99a4 0%, #6f7a86 100%); }
    .integration-btn.warning { background: linear-gradient(180deg, #e5a83d 0%, #d08818 100%); }
    .integration-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        filter: grayscale(0.3);
    }
    .integration-help {
        margin-top: 12px;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-background);
    }
    .integration-help summary {
        cursor: pointer;
        padding: 10px 12px;
        font-weight: 600;
        color: var(--els-text);
    }
    .integration-help-content {
        border-top: 1px solid var(--els-border);
        padding: 10px 12px;
        font-size: 13px;
        color: var(--els-text);
        line-height: 1.5;
    }
    .integration-help-content h5 {
        margin: 10px 0 6px;
        font-size: 13px;
        font-weight: 700;
    }
    .integration-help-content ul {
        margin: 0 0 8px 16px;
        padding: 0;
    }
    .integration-help-content p {
        margin: 0 0 8px;
    }
    .integration-field-hint {
        margin-top: 4px;
        font-size: 12px;
        color: var(--els-text-muted);
        line-height: 1.4;
    }
    .integration-example {
        margin: 8px 0;
        padding: 8px 10px;
        border: 1px solid var(--els-border);
        border-radius: 6px;
        background: var(--els-surface);
    }
    .integration-example ul {
        margin-bottom: 0;
    }
    .integration-action-hint {
        margin-top: 8px;
        font-size: 12px;
        color: var(--els-text-muted);
        line-height: 1.4;
    }
    .integration-help-link {
        font-size: 12px;
        color: var(--els-primary);
        text-decoration: underline;
        cursor: pointer;
    }
    .integration-inline-help {
        margin-top: 6px;
        border: 1px solid var(--els-border);
        border-radius: 6px;
        background: var(--els-surface);
    }
    .integration-inline-help summary {
        padding: 8px 10px;
        font-size: 12px;
        color: var(--els-primary);
        text-decoration: underline;
        cursor: pointer;
        font-weight: 600;
    }
    .integration-inline-help-content {
        border-top: 1px solid var(--els-border);
        padding: 10px;
        font-size: 12px;
        color: var(--els-text);
        line-height: 1.45;
    }
    .integration-inline-help-content ol,
    .integration-inline-help-content ul {
        margin: 0 0 8px 16px;
        padding: 0;
    }
    .integration-validation {
        margin-top: 8px;
        font-size: 12px;
        color: #b0302b;
        line-height: 1.4;
    }
    .integration-validation ul {
        margin: 0;
        padding-left: 16px;
    }
    .smtp-setup-panel {
        margin-top: 12px;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-background);
        padding: 10px 12px;
    }
    .smtp-setup-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--els-text);
    }
    .smtp-setup-panel ol {
        margin: 0;
        padding-left: 18px;
        font-size: 12px;
        color: var(--els-text);
        line-height: 1.45;
    }
    .smtp-setup-link {
        display: inline-block;
        margin-top: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--els-primary);
        text-decoration: underline;
    }
    .integration-status {
        margin-top: 8px;
        padding: 8px 10px;
        border-radius: 6px;
        font-size: 12px;
        line-height: 1.4;
    }
    .integration-status.success {
        background: #e7f6ec;
        border: 1px solid #8bc49b;
        color: #1f6b34;
    }
    .integration-status.error {
        background: #fdecec;
        border: 1px solid #e5a0a0;
        color: #8d1f1f;
    }
    .integration-status.info {
        background: var(--els-background);
        border: 1px solid var(--els-border);
        color: var(--els-text-muted);
    }
    @@media (max-width: 768px) {
        .integration-help-content {
            font-size: 12px;
        }
        .integration-field-hint,
        .integration-action-hint {
            font-size: 11px;
        }
        .integration-inline-help-content,
        .integration-inline-help summary,
        .integration-help-link {
            font-size: 11px;
        }
    }
</style>

<section class="integrations-page">
    <div class="integrations-wrap">
        <div class="integrations-title">Integrations Management Center</div>
        <div class="integrations-note">
            <div><b>Tenant:</b> @Model.TenantName</div>
            <div><b>Store:</b> @Model.StoreCode</div>
            <div style="margin-top:6px;">Configure Email, SMS, WhatsApp, Payments, and future connectors securely per tenant/store. Secrets are masked and not returned in plain text.</div>
        </div>

        <div class="integration-grid">
        @foreach (var provider in Model.Providers)
        {
            var lastTestStatus = string.IsNullOrWhiteSpace(provider.LastTestStatus) ? "NotTested" : provider.LastTestStatus;
            var canEnable = string.Equals(lastTestStatus, "Success", StringComparison.OrdinalIgnoreCase);
            var isEmailSmtp = string.Equals(provider.Category, "Email", StringComparison.OrdinalIgnoreCase)
                && string.Equals(provider.ProviderKey, "smtp", StringComparison.OrdinalIgnoreCase);
            var isPaymentsCategory = string.Equals(provider.Category, "Payments", StringComparison.OrdinalIgnoreCase);
            var providerNameValue = provider.PublicSettings != null && provider.PublicSettings.ContainsKey("Provider")
                ? provider.PublicSettings["Provider"]
                : provider.ProviderDisplayName;
            var isRazorpayProvider = isPaymentsCategory
                && (string.Equals(provider.ProviderKey, "razorpay", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(providerNameValue, "Razorpay", StringComparison.OrdinalIgnoreCase));
            var hasSavedPassword = provider.SecretKeys != null
                && provider.SecretKeys.Any(key =>
                    string.Equals(key, "Password", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(key, "Token", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(key, "Secret", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(key, "SecretKey", StringComparison.OrdinalIgnoreCase));
            var hasSavedWebhookSecret = provider.SecretKeys != null
                && provider.SecretKeys.Any(key => string.Equals(key, "WebhookSecret", StringComparison.OrdinalIgnoreCase));
            <div class="category-card">
                <div class="category-title">@provider.Category — @provider.ProviderDisplayName</div>
                <div class="provider-card">
                    <div class="provider-head">
                        <div class="provider-name">@provider.ProviderDisplayName</div>
                        <div class="provider-status">
                            @(provider.IsEnabled ? "Enabled" : "Disabled")
                            | Last Test: @lastTestStatus
                        </div>
                    </div>

                    @{ 
                        var hasSavedIntegrationRecord = provider.HasSavedRecord
                            || provider.HasSecretsConfigured
                            || !string.Equals(lastTestStatus, "NotTested", StringComparison.OrdinalIgnoreCase);
                    }
                    <form asp-action="SaveIntegration" asp-controller="Customer" method="post" class="integration-form" data-category="@provider.Category" data-provider-key="@provider.ProviderKey" data-last-test-status="@lastTestStatus" data-secret-keys="@(provider.SecretKeys == null ? string.Empty : string.Join(",", provider.SecretKeys))" data-has-saved-record="@(hasSavedIntegrationRecord ? "true" : "false")" data-has-secrets-configured="@(provider.HasSecretsConfigured ? "true" : "false")" data-reveal-url="@Url.Action("RevealWebhookSecret", "Customer")" data-rotate-url="@Url.Action("RotateWebhookSecret", "Customer")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Category" value="@provider.Category" />
                            <input type="hidden" name="ProviderKey" value="@provider.ProviderKey" />
                            <input type="hidden" name="ProviderDisplayName" value="@provider.ProviderDisplayName" />
                            <input type="hidden" name="TenantName" value="@provider.TenantName" />
                            <input type="hidden" name="StoreCode" value="@provider.StoreCode" />
                            <input type="hidden" name="IsEnabled" value="@(provider.IsEnabled ? "true" : "false")" />

                            <div class="provider-grid">
                                <div class="integration-field">
                                    <label>Provider</label>
                                    <input name="PublicSettings[Provider]" value="@(provider.PublicSettings.ContainsKey("Provider") ? provider.PublicSettings["Provider"] : provider.ProviderDisplayName)" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Use <b>Gmail SMTP</b>.</div>
                                    }
                                </div>
                                <div class="integration-field">
                                    <label>@(isEmailSmtp ? "SMTP Host" : (isRazorpayProvider ? "Endpoint / Host (Optional)" : "Endpoint / Host"))</label>
                                    <input name="PublicSettings[Host]" value="@(provider.PublicSettings.ContainsKey("Host") ? provider.PublicSettings["Host"] : string.Empty)" placeholder="@(isEmailSmtp ? "smtp.gmail.com" : string.Empty)" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Recommended: <b>smtp.gmail.com</b>.</div>
                                    }
                                </div>
                                <div class="integration-field">
                                    <label>@(isEmailSmtp ? "Port" : (isRazorpayProvider ? "Port / Account ID (Optional)" : "Port / Account ID"))</label>
                                    <input name="PublicSettings[Port]" value="@(provider.PublicSettings.ContainsKey("Port") ? provider.PublicSettings["Port"] : string.Empty)" placeholder="@(isEmailSmtp ? "587" : string.Empty)" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Recommended: <b>587</b> with STARTTLS.</div>
                                    }
                                </div>
                                <div class="integration-field">
                                    <label>@(isEmailSmtp ? "Sender Email" : (isRazorpayProvider ? "Sender / From / Sender ID (Optional)" : "Sender / From / Sender ID"))</label>
                                    <input name="PublicSettings[From]" value="@(provider.PublicSettings.ContainsKey("From") ? provider.PublicSettings["From"] : string.Empty)" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Use the same Gmail address as the username.</div>
                                    }
                                </div>
                                @if (!isEmailSmtp)
                                {
                                    <div class="integration-field">
                                        <label>@(isRazorpayProvider ? "Webhook URL (Auto-generated)" : "Webhook URL")</label>
                                        <input name="PublicSettings[WebhookUrl]" value="@(provider.PublicSettings.ContainsKey("WebhookUrl") ? provider.PublicSettings["WebhookUrl"] : string.Empty)" @(isRazorpayProvider ? "readonly=\"readonly\"" : string.Empty) />
                                        @if (isRazorpayProvider)
                                        {
                                            <div class="integration-field-hint">Webhook URL is generated and managed by the platform API.</div>
                                        }
                                    </div>
                                }
                                <div class="integration-field">
                                    <label>Mode</label>
                                    <select name="IsTestMode">
                                        @if (provider.IsTestMode)
                                        {
                                            <option value="true" selected>Test / Sandbox</option>
                                            <option value="false">Live</option>
                                        }
                                        else
                                        {
                                            <option value="true">Test / Sandbox</option>
                                            <option value="false" selected>Live</option>
                                        }
                                    </select>
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Use <b>Live</b> for real sending.</div>
                                    }
                                </div>
                                <div class="integration-field">
                                    <label>@(isEmailSmtp ? "Username" : (isRazorpayProvider ? "Razorpay Key ID" : "Username / API Key"))</label>
                                    <input name="SecretSettings[Username]" value="@(provider.SecretSettings.ContainsKey("Username") ? provider.SecretSettings["Username"] : string.Empty)" placeholder="Enter new value (kept encrypted)" autocomplete="off" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Enter your full Gmail address.</div>
                                    }
                                </div>
                                <div class="integration-field">
                                    <label>@(isEmailSmtp ? "Password / App Password" : (isRazorpayProvider ? "Razorpay Key Secret" : "Password / Token / Secret"))</label>
                                    <input name="SecretSettings[Password]" value="" placeholder="@(hasSavedPassword ? "Saved securely" : "********")" autocomplete="off" />
                                    @if (isEmailSmtp)
                                    {
                                        <div class="integration-field-hint">Use a Google App Password, not your normal Gmail password. Saved passwords are never shown.</div>
                                    }
                                </div>
                                @if (isPaymentsCategory)
                                {
                                    <div class="integration-field">
                                        <label>Webhook Secret</label>
                                        <input type="password" name="SecretSettings[WebhookSecret]" value="" placeholder="@(hasSavedWebhookSecret ? "Saved securely" : "********")" autocomplete="off" />
                                        @if (isRazorpayProvider)
                                        {
                                            <div class="integration-field-hint">Required for Razorpay webhook signature verification.</div>
                                        }
                                    </div>
                                }
                            </div>

                            @if (isRazorpayProvider)
                            {
                                <div class="webhook-secret-panel" data-role="webhook-secret-panel">
                                    <p>
                                        Use <b>Reveal Webhook Secret</b> only during Razorpay Dashboard webhook setup.
                                        The revealed secret is shown once and must be copied immediately.
                                    </p>
                                    <p>
                                        Use <b>Rotate Secret</b> only when required. Rotation disables this integration until webhook configuration is updated, tested, and re-enabled.
                                    </p>
                                    <div class="integration-actions" style="margin-top:0;">
                                        <button type="button" class="integration-btn secondary" data-role="reveal-webhook-secret">Reveal Webhook Secret</button>
                                        <button type="button" class="integration-btn warning" data-role="rotate-webhook-secret">Rotate Secret</button>
                                        <button type="button" class="integration-btn" data-role="copy-webhook-secret" style="display:none;">Copy</button>
                                    </div>
                                    <div class="integration-status info" data-role="webhook-secret-message" style="display:none;"></div>
                                    <div class="webhook-secret-output" data-role="webhook-secret-output" aria-live="polite">
                                        <div class="integration-actions" style="margin-top:0; justify-content:space-between; align-items:center;">
                                            <strong>One-time Webhook Secret (visible until closed)</strong>
                                            <button type="button" class="integration-btn secondary" data-role="close-webhook-secret">Close</button>
                                        </div>
                                        <input type="text" class="webhook-secret-value" value="" readonly data-role="webhook-secret-value" autocomplete="off" />
                                    </div>
                                </div>
                            }

                            @if (isEmailSmtp)
                            {
                                <div class="smtp-setup-panel">
                                    <div class="smtp-setup-title">Gmail SMTP Setup</div>
                                    <ol>
                                        <li>Enable 2-Step Verification on your Google account.</li>
                                        <li>Generate an App Password for Gmail.</li>
                                        <li>Enter credentials here, then click Save and Test Connection.</li>
                                    </ol>
                                    <a class="smtp-setup-link" href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer">Get Google App Password</a>
                                </div>
                            }

                            <div class="integration-actions">
                                <button class="integration-btn" type="submit" formaction="@Url.Action("SaveIntegration", "Customer")" formmethod="post" data-action="save" data-role="save">Save</button>
                                <button class="integration-btn warning" type="submit" formaction="@Url.Action("TestIntegration", "Customer")" formmethod="post" name="category" value="@provider.Category" data-role="test">Test Connection</button>
                                @if (isEmailSmtp)
                                {
                                    <button class="integration-btn secondary" type="submit" formaction="@Url.Action("SendTestEmail", "Customer")" formmethod="post" name="category" value="@provider.Category" data-role="send-test-email" disabled>Send Test Email</button>
                                    <input type="hidden" name="recipientEmail" value="" data-role="recipient-email" />
                                }
                                <input type="hidden" name="providerKey" value="@provider.ProviderKey" />
                            </div>
                            <div class="integration-validation" data-role="validation"></div>

                            @if (!string.IsNullOrWhiteSpace(provider.LastTestMessage))
                            {
                                var statusClass = string.Equals(lastTestStatus, "Success", StringComparison.OrdinalIgnoreCase)
                                    ? "success"
                                    : (string.Equals(lastTestStatus, "Failed", StringComparison.OrdinalIgnoreCase) ? "error" : "info");
                                <div class="integration-status @statusClass">@provider.LastTestMessage</div>
                            }
                    </form>
                </div>
            </div>
        }
        </div>
    </div>
</section>

<script>
    (function () {
        if (window.__integrationStateInit) {
            return;
        }
        window.__integrationStateInit = true;

        function normalize(v) { return (v || '').trim().toLowerCase(); }
        function hasValue(v) { return (v || '').trim().length > 0; }
        function get(form, name) {
            var el = form.querySelector('[name="' + name + '"]');
            return el ? (el.value || '').trim() : '';
        }
        function hasSavedSecret(form, aliases) {
            var raw = form.getAttribute('data-secret-keys') || '';
            var map = {};
            raw.split(',').forEach(function (k) { if (normalize(k)) map[normalize(k)] = true; });
            for (var i = 0; i < aliases.length; i++) {
                if (map[normalize(aliases[i])]) return true;
            }
            return false;
        }
        function hasSecret(form, aliases) {
            for (var i = 0; i < aliases.length; i++) {
                if (hasValue(get(form, 'SecretSettings[' + aliases[i] + ']'))) return true;
            }
            return hasSavedSecret(form, aliases);
        }
        function hasPublic(form, names) {
            for (var i = 0; i < names.length; i++) {
                if (hasValue(get(form, 'PublicSettings[' + names[i] + ']'))) return true;
            }
            return false;
        }
        function initializeFieldBaselines(form) {
            var fields = form.querySelectorAll('input[name^="PublicSettings["],input[name^="SecretSettings["],select[name="IsTestMode"]');
            for (var i = 0; i < fields.length; i++) {
                var field = fields[i];
                var name = field.getAttribute('name') || '';
                if (name === 'SecretSettings[Password]') {
                    field.setAttribute('data-initial-value', '');
                    continue;
                }

                field.setAttribute('data-initial-value', (field.value || '').trim());
            }
        }
        function isDirty(form) {
            var fields = form.querySelectorAll('input[name^="PublicSettings["],input[name^="SecretSettings["],select[name="IsTestMode"]');
            for (var i = 0; i < fields.length; i++) {
                var f = fields[i];
                var name = f.getAttribute('name') || '';
                var current = (f.value || '').trim();
                if (name === 'SecretSettings[Password]') {
                    if (current.length > 0) {
                        return true;
                    }

                    continue;
                }

                var baseline = (f.getAttribute('data-initial-value') || '').trim();
                if (current !== baseline) return true;
            }
            return false;
        }
        function validate(form) {
            var errors = [];
            var category = normalize(form.getAttribute('data-category'));
            var providerKey = normalize(form.getAttribute('data-provider-key'));
            var providerName = normalize(get(form, 'PublicSettings[Provider]'));
            var isRazorpay = category === 'payments' && (providerKey === 'razorpay' || providerName === 'razorpay');
            if (category === 'email') {
                if (!hasPublic(form, ['Host', 'Endpoint'])) errors.push('Email host is required.');
                var port = get(form, 'PublicSettings[Port]') || get(form, 'PublicSettings[AccountId]');
                if (!hasValue(port) || isNaN(parseInt(port, 10)) || parseInt(port, 10) <= 0) errors.push('Email port is required and must be valid.');
                if (!hasPublic(form, ['From', 'SenderId'])) errors.push('Email sender is required.');
                if (!hasSecret(form, ['Username', 'ApiKey'])) errors.push('Email username/API key is required.');
                if (!hasSecret(form, ['Password', 'Token', 'Secret', 'SecretKey'])) errors.push('Email password/token/secret is required.');
            } else if (category === 'sms') {
                if (!hasPublic(form, ['Provider'])) errors.push('SMS provider is required.');
                if (!hasPublic(form, ['SenderId', 'From'])) errors.push('SMS sender ID is required.');
                if (!hasSecret(form, ['ApiKey', 'AuthToken', 'Username', 'Password', 'Token', 'Secret'])) errors.push('SMS API credentials are required.');
            } else if (category === 'whatsapp') {
                if (!hasPublic(form, ['Provider'])) errors.push('WhatsApp provider is required.');
                if (!hasPublic(form, ['PhoneNumberId', 'Port', 'AccountId'])) errors.push('WhatsApp phone number/account ID is required.');
                if (!hasSecret(form, ['AccessToken', 'Token', 'Password', 'Secret'])) errors.push('WhatsApp access token/secret is required.');
            } else if (category === 'payments') {
                if (!hasPublic(form, ['Provider'])) errors.push('Payment provider is required.');
                if (isRazorpay) {
                    if (!hasSecret(form, ['ApiKey', 'Username', 'Token'])) errors.push('Razorpay Key ID is required.');
                    if (!hasSecret(form, ['SecretKey', 'Password', 'Secret'])) errors.push('Razorpay Key Secret is required.');
                } else {
                    if (!hasPublic(form, ['MerchantId', 'AccountId', 'Port'])) errors.push('Merchant/account ID is required.');
                    if (!hasPublic(form, ['WebhookUrl'])) errors.push('Webhook URL is required.');
                    if (!hasSecret(form, ['ApiKey', 'Username', 'Token'])) errors.push('Payment API key/username is required.');
                    if (!hasSecret(form, ['SecretKey', 'Password', 'Secret'])) errors.push('Payment secret key/password is required.');
                }
            }
            return errors;
        }
        function update(form) {
            var errors = validate(form);
            var dirty = isDirty(form);
            var submitting = form.getAttribute('data-submitting') === 'true';
            var saveBtn = form.querySelector('[data-role="save"]');
            var testBtn = form.querySelector('[data-role="test"]');
            var sendTestEmailBtn = form.querySelector('[data-role="send-test-email"]');
            var message = form.querySelector('[data-role="validation"]');

            var hasSavedConfig = normalize(form.getAttribute('data-has-saved-record')) === 'true';
            var hasSecretsConfiguredFlag = normalize(form.getAttribute('data-has-secrets-configured')) === 'true';
            var hasSavedPassword = hasSavedSecret(form, ['Password', 'Token', 'Secret', 'SecretKey']);
            var hasConfiguredSecrets = hasSecretsConfiguredFlag || hasSavedPassword;
            var isEmailCategory = normalize(form.getAttribute('data-category')) === 'email';
            var isEmailSmtp = isEmailCategory && normalize(form.getAttribute('data-provider-key')) === 'smtp';
            var lastTestStatusValue = normalize(form.getAttribute('data-last-test-status'));
            var hasSuccessfulConnectionTest = lastTestStatusValue.indexOf('success') >= 0;
            if (!hasSuccessfulConnectionTest) {
                var providerCard = form.closest('.provider-card');
                var providerStatus = providerCard ? providerCard.querySelector('.provider-status') : null;
                var providerStatusText = normalize(providerStatus ? providerStatus.textContent : '');
                hasSuccessfulConnectionTest = providerStatusText.indexOf('last test: success') >= 0;
            }
            var canSendTestEmail = false;
            if (isEmailSmtp && !submitting && errors.length === 0 && !dirty && hasSavedConfig && hasConfiguredSecrets && hasSuccessfulConnectionTest) {
                canSendTestEmail = true;
            }

            var canSaveNewSmtpConfig = isEmailSmtp && !hasSavedPassword && errors.length === 0;
            if (saveBtn) saveBtn.disabled = submitting || errors.length > 0 || (!dirty && !canSaveNewSmtpConfig);
            if (testBtn) testBtn.disabled = submitting || errors.length > 0 || dirty;
            if (sendTestEmailBtn) sendTestEmailBtn.disabled = !canSendTestEmail;

            var info = [];
            if (errors.length > 0) info = info.concat(errors);
            else if (dirty) info.push('Save changes before Test Connection.');
            if (isEmailSmtp && !hasSavedConfig) {
                info.push('Save SMTP configuration before sending a test email.');
            }
            if (normalize(form.getAttribute('data-category')) === 'email' && !hasConfiguredSecrets && !hasValue(get(form, 'SecretSettings[Password]'))) {
                info.push('Enter and save SMTP password/token to enable Test Connection.');
            }
            if (isEmailSmtp && errors.length === 0 && !dirty && !hasSuccessfulConnectionTest) {
                info.push('Run Test Connection successfully to enable Send Test Email.');
            }

            if (message) {
                message.innerHTML = info.length ? ('<ul><li>' + info.join('</li><li>') + '</li></ul>') : '';
            }
        }

        async function postJson(url, payload, token) {
            var response = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'RequestVerificationToken': token || ''
                },
                body: payload
            });
            return await response.json();
        }

        function setWebhookSecretMessage(form, message, isError) {
            var messageEl = form.querySelector('[data-role="webhook-secret-message"]');
            if (!messageEl) return;
            messageEl.style.display = message ? 'block' : 'none';
            messageEl.className = 'integration-status ' + (isError ? 'error' : 'info');
            messageEl.textContent = message || '';
        }

        function clearWebhookSecretDisplay(form) {
            var out = form.querySelector('[data-role="webhook-secret-output"]');
            var secretInput = form.querySelector('[data-role="webhook-secret-value"]');
            var copyBtn = form.querySelector('[data-role="copy-webhook-secret"]');
            if (secretInput) secretInput.value = '';
            if (out) out.classList.remove('visible');
            if (copyBtn) copyBtn.style.display = 'none';
        }

        function clearAllWebhookSecretDisplays() {
            document.querySelectorAll('.integration-form').forEach(function (integrationForm) {
                clearWebhookSecretDisplay(integrationForm);
            });
        }

        var forms = document.querySelectorAll('.integration-form');
        forms.forEach(function (form) {
            initializeFieldBaselines(form);
            form.querySelectorAll('input,select').forEach(function (field) {
                field.addEventListener('input', function () { update(form); });
                field.addEventListener('change', function () { update(form); });
            });

            form.addEventListener('submit', function (e) {
                var submitter = e.submitter;
                if (!submitter) return;

                var submitRole = submitter.getAttribute('data-role') || '';
                var recipientField = form.querySelector('[data-role="recipient-email"]');
                var message = form.querySelector('[data-role="validation"]');
                if (submitRole === 'send-test-email') {
                    var entered = window.prompt('Enter recipient email address for test email:');
                    if (entered === null) {
                        e.preventDefault();
                        return;
                    }

                    entered = (entered || '').trim();
                    var atChar = String.fromCharCode(64);
                    var atIndex = entered.indexOf(atChar);
                    var lastAtIndex = entered.lastIndexOf(atChar);
                    var dotIndex = entered.indexOf('.', atIndex + 2);
                    var isValidEmail = entered.length > 3
                        && entered.indexOf(' ') === -1
                        && atIndex > 0
                        && atIndex === lastAtIndex
                        && dotIndex > atIndex + 1;
                    if (!isValidEmail) {
                        if (message) {
                            message.innerHTML = '<ul><li>Please enter a valid recipient email address.</li></ul>';
                        }

                        e.preventDefault();
                        return;
                    }

                    if (recipientField) {
                        recipientField.value = entered;
                    }
                }
                else if (recipientField) {
                    recipientField.value = '';
                }

                update(form);
                if (submitter.disabled) {
                    e.preventDefault();
                    return;
                }

                if (submitRole === 'save' && isRazorpayForm(form)) {
                    var webhookSecretField = form.querySelector('[name="SecretSettings[WebhookSecret]"]');
                    if (webhookSecretField && !hasValue(webhookSecretField.value)) {
                        webhookSecretField.disabled = true;
                    }
                }

                form.setAttribute('data-submitting', 'true');
                update(form);
            });

            var revealBtn = form.querySelector('[data-role="reveal-webhook-secret"]');
            var rotateBtn = form.querySelector('[data-role="rotate-webhook-secret"]');
            var copyBtn = form.querySelector('[data-role="copy-webhook-secret"]');
            var closeBtn = form.querySelector('[data-role="close-webhook-secret"]');
            var secretOutput = form.querySelector('[data-role="webhook-secret-output"]');
            var secretValue = form.querySelector('[data-role="webhook-secret-value"]');
            var antiForgery = form.querySelector('input[name="__RequestVerificationToken"]');
            var antiForgeryToken = antiForgery ? antiForgery.value : '';
            var category = get(form, 'Category') || form.getAttribute('data-category') || '';
            var providerKey = get(form, 'ProviderKey') || form.getAttribute('data-provider-key') || '';
            var revealInFlight = false;

            if (closeBtn) {
                closeBtn.addEventListener('click', function () {
                    clearWebhookSecretDisplay(form);
                    setWebhookSecretMessage(form, '', false);
                });
            }

            if (copyBtn) {
                copyBtn.addEventListener('click', async function () {
                    if (!secretValue || !secretValue.value) return;
                    try {
                        await navigator.clipboard.writeText(secretValue.value);
                        setWebhookSecretMessage(form, 'Webhook secret copied. Paste it immediately in Razorpay Dashboard webhook configuration.', false);
                    } catch (err) {
                        setWebhookSecretMessage(form, 'Copy failed. Please manually select and copy the secret now.', true);
                    }
                });
            }

            if (revealBtn) {
                revealBtn.addEventListener('click', async function () {
                    if (revealInFlight) {
                        return;
                    }

                    revealInFlight = true;
                    revealBtn.disabled = true;
                    clearWebhookSecretDisplay(form);
                    setWebhookSecretMessage(form, 'Revealing one-time webhook secret...', false);
                    var payload = new URLSearchParams();
                    payload.append('category', category);
                    payload.append('providerKey', providerKey);

                    try {
                        var result = await postJson(form.getAttribute('data-reveal-url'), payload, antiForgeryToken);
                        if (result && result.success && result.webhookSecret) {
                            if (secretValue) secretValue.value = result.webhookSecret;
                            if (secretOutput) secretOutput.classList.add('visible');
                            if (copyBtn) copyBtn.style.display = 'inline-block';
                            setWebhookSecretMessage(form, result.message || 'Webhook secret revealed once. Copy it immediately.', false);
                        } else {
                            setWebhookSecretMessage(form, (result && result.message) ? result.message : 'Unable to reveal webhook secret.', true);
                        }
                    } catch (err) {
                        setWebhookSecretMessage(form, 'Unable to reveal webhook secret.', true);
                    } finally {
                        revealInFlight = false;
                        revealBtn.disabled = false;
                    }
                });
            }

            if (rotateBtn) {
                rotateBtn.addEventListener('click', async function () {
                    var confirmed = window.confirm('Rotate Razorpay webhook secret? This will disable the integration until webhook setup is updated, tested, and re-enabled.');
                    if (!confirmed) return;

                    clearWebhookSecretDisplay(form);
                    setWebhookSecretMessage(form, 'Rotating webhook secret...', false);
                    var payload = new URLSearchParams();
                    payload.append('category', category);
                    payload.append('providerKey', providerKey);

                    try {
                        var result = await postJson(form.getAttribute('data-rotate-url'), payload, antiForgeryToken);
                        if (result && result.success) {
                            setWebhookSecretMessage(form, result.message || 'Webhook secret rotated. Reveal and copy the new secret, then update Razorpay Dashboard.', false);
                            form.setAttribute('data-last-test-status', 'NotTested');
                            var statusPill = form.closest('.provider-card') ? form.closest('.provider-card').querySelector('.provider-status') : null;
                            if (statusPill) {
                                statusPill.textContent = 'Disabled | Last Test: NotTested';
                            }
                            update(form);
                        } else {
                            setWebhookSecretMessage(form, (result && result.message) ? result.message : 'Unable to rotate webhook secret.', true);
                        }
                    } catch (err) {
                        setWebhookSecretMessage(form, 'Unable to rotate webhook secret.', true);
                    }
                });
            }

            update(form);
        });

        window.addEventListener('pagehide', function () {
            clearAllWebhookSecretDisplays();
        });
    })();
</script>
