@model LMSWebUI.Models.Admin.PaymentSettingsViewModel
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Payment Settings";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";

    var paymentModeOptions = new[] { "Cash", "UPI", "Card", "Wallet" };
}

<style>
.payment-settings-page,
.payment-settings-page input,
.payment-settings-page button,
.payment-settings-page label,
.payment-settings-page textarea,
.payment-settings-page select {
    font-family: Arial, Helvetica, sans-serif;
}

.payment-settings-page { padding: 20px; }
.payment-settings-box {
    max-width: 980px;
    margin: 0 auto;
    background: var(--els-surface);
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    overflow: hidden;
}
.payment-settings-title {
    background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
    color: #fff;
    padding: 14px 20px;
    font-size: 20px;
    font-weight: 600;
}
.payment-settings-body { padding: 20px; }
.payment-settings-note {
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: var(--els-accent);
    padding: 12px;
    margin-bottom: 16px;
    color: var(--els-text);
}
.payment-section-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--els-text);
    margin: 18px 0 8px;
}
.payment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
}
.payment-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.payment-field label { font-weight: 600; color: var(--els-text); }
.payment-input,
.payment-select,
.payment-textarea {
    border: 1px solid var(--els-border);
    border-radius: 8px;
    min-height: 40px;
    padding: 8px 10px;
    background: var(--els-background);
    color: var(--els-text);
}
.payment-textarea { min-height: 88px; resize: vertical; }
.payment-check { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
.validation-summary-errors,
.field-validation-error { color: #b91c1c; font-size: 13px; }
.payment-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
}
.payment-btn {
    min-width: 180px;
    min-height: 42px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
}
.payment-btn.secondary { background: linear-gradient(180deg, #8f99a4 0%, #6f7a86 100%); }

.toast-message {
    position: fixed;
    right: 24px;
    top: 80px;
    z-index: 9999;
    min-width: 260px;
    max-width: 380px;
    padding: 12px 16px;
    border-radius: 8px;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    font-weight: 600;
    display: none;
}

.toast-message.success {
    background: #2f8f46;
}

.toast-message.error {
    background: #b63838;
}
</style>

@if (TempData["UserMessage"] != null)
{
    var paymentSettingsMessage = JsonConvert.DeserializeObject<LMSWebUI.Models.MessageDto>(Convert.ToString(TempData["UserMessage"]));
    var isSuccessMessage = (paymentSettingsMessage.CssClassName ?? string.Empty).Contains("success");

    @* This page shows the message as a floating toast, so drop it from TempData to stop
       the shared _LayoutStatus partial from rendering a duplicate alert bar. *@
    TempData.Remove("UserMessage");

    <script type="text/javascript">
        window.paymentSettingsToastMessage = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(paymentSettingsMessage.DisplayMessage ?? string.Empty))';
        window.paymentSettingsToastIsSuccess = @(isSuccessMessage ? "true" : "false");
    </script>
}

<div id="paymentSettingsToast" class="toast-message"></div>

<section class="payment-settings-page">
    <div class="payment-settings-box">
        <div class="payment-settings-title">Payment Settings</div>
        <div class="payment-settings-body">
            <div class="payment-settings-note">
                <div><b>Tenant:</b> @Model.TenantName</div>
                <div><b>Store:</b> @Model.StoreCode</div>
                <div style="margin-top:6px;">Choose the payment modes this store accepts and how payments are collected. Only enabled modes appear while creating an order.</div>
            </div>

            <form asp-action="PaymentSettings" asp-controller="Customer" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="payment-section-title">Accepted Payment Modes</div>

                <div class="payment-check">
                    <input asp-for="EnableCash" class="payment-mode-toggle" data-mode="Cash" />
                    <label asp-for="EnableCash"></label>
                </div>

                <div class="payment-check">
                    <input asp-for="EnableUpi" class="payment-mode-toggle" data-mode="UPI" />
                    <label asp-for="EnableUpi"></label>
                </div>

                <div class="payment-check">
                    <input asp-for="EnableCard" class="payment-mode-toggle" data-mode="Card" />
                    <label asp-for="EnableCard"></label>
                </div>

                <div class="payment-check">
                    <input asp-for="EnableWallet" class="payment-mode-toggle" data-mode="Wallet" />
                    <label asp-for="EnableWallet"></label>
                </div>

                <div class="payment-section-title">Collection Preferences</div>

                <div class="payment-grid">
                    <div class="payment-field">
                        <label asp-for="DefaultPaymentMode"></label>
                        <select asp-for="DefaultPaymentMode" id="defaultPaymentMode" class="payment-select"
                                asp-items="@(new SelectList(paymentModeOptions, Model.DefaultPaymentMode))"></select>
                        <span asp-validation-for="DefaultPaymentMode"></span>
                    </div>

                    <div class="payment-field">
                        <label asp-for="CreditLimitAmount"></label>
                        <input asp-for="CreditLimitAmount" id="creditLimitAmount" class="payment-input" type="number" step="0.01" min="0" />
                        <span asp-validation-for="CreditLimitAmount"></span>
                    </div>
                </div>

                <div class="payment-check">
                    <input asp-for="AllowPartialPayment" />
                    <label asp-for="AllowPartialPayment"></label>
                </div>

                <div class="payment-check">
                    <input asp-for="AllowCredit" id="allowCredit" />
                    <label asp-for="AllowCredit"></label>
                </div>

                <div class="payment-check">
                    <input asp-for="RoundOffPayableAmount" />
                    <label asp-for="RoundOffPayableAmount"></label>
                </div>

                <div class="payment-field" style="margin-top:12px;">
                    <label asp-for="Notes"></label>
                    <textarea asp-for="Notes" class="payment-textarea" maxlength="300"></textarea>
                    <span asp-validation-for="Notes"></span>
                </div>

                <div class="payment-actions">
                    <button type="submit" class="payment-btn">Save Payment Settings</button>
                    <button type="button" class="payment-btn secondary" onclick="window.location.href='@Url.Action("MyDashboard", "Dashboard")'">Back to My Dashboard</button>
                </div>
            </form>
        </div>
    </div>
</section>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        var hasValidationErrors = document.querySelector(".validation-summary-errors li, .field-validation-error:not(:empty)") !== null;

        if (!window.location.search && !hasValidationErrors) {
            var paymentSettingsForm = document.querySelector("form");
            if (paymentSettingsForm) {
                paymentSettingsForm.reset();
            }
        }

        var defaultModeSelect = document.getElementById("defaultPaymentMode");
        var modeToggles = Array.prototype.slice.call(document.querySelectorAll(".payment-mode-toggle"));
        var allowCredit = document.getElementById("allowCredit");
        var creditLimit = document.getElementById("creditLimitAmount");

        function refreshDefaultModes() {
            if (!defaultModeSelect) {
                return;
            }

            var selected = defaultModeSelect.value;
            var enabledModes = modeToggles
                .filter(function (toggle) { return toggle.checked; })
                .map(function (toggle) { return toggle.getAttribute("data-mode"); });

            defaultModeSelect.innerHTML = "";
            enabledModes.forEach(function (mode) {
                var option = document.createElement("option");
                option.value = mode;
                option.textContent = mode;
                defaultModeSelect.appendChild(option);
            });

            if (enabledModes.indexOf(selected) >= 0) {
                defaultModeSelect.value = selected;
            }
        }

        function refreshCreditLimit() {
            if (!allowCredit || !creditLimit) {
                return;
            }

            creditLimit.disabled = !allowCredit.checked;
            if (!allowCredit.checked) {
                creditLimit.value = "0";
            }
        }

        modeToggles.forEach(function (toggle) {
            toggle.addEventListener("change", refreshDefaultModes);
        });

        if (allowCredit) {
            allowCredit.addEventListener("change", refreshCreditLimit);
        }

        refreshDefaultModes();
        refreshCreditLimit();

        if (!window.paymentSettingsToastMessage) {
            return;
        }

        var toast = document.getElementById("paymentSettingsToast");
        if (!toast) {
            return;
        }

        var isSuccess = window.paymentSettingsToastIsSuccess === true;
        toast.classList.remove(isSuccess ? "error" : "success");
        toast.classList.add(isSuccess ? "success" : "error");
        toast.textContent = window.paymentSettingsToastMessage;
        toast.style.display = "block";

        setTimeout(function () {
            toast.style.display = "none";
        }, 3200);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
