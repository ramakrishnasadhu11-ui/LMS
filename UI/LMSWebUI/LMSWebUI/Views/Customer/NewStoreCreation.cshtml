@{
    ViewData["Title"] = "New Store Creation";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
    var tenantName = Convert.ToString(ViewData["TenantName"] ?? "-");
    var currentStoreCode = Convert.ToString(ViewData["StoreCode"] ?? "-");
    var existingStores = ViewData["ExistingStores"] as IEnumerable<string> ?? Array.Empty<string>();
    var existingStoreStatuses = ViewData["ExistingStoreStatuses"] ?? Array.Empty<object>();
    var existingStoresLoadError = Convert.ToString(ViewData["ExistingStoresLoadError"] ?? string.Empty);
}

<style>
:root {
    --els-primary: #173B70;
    --els-primary-dark: #173B70;
    --els-primary-light: #2878C8;
    --els-accent: #EAF2FC;
    --els-background: #F5F7FA;
    --els-surface: #FFFFFF;
    --els-text: #1E293B;
    --els-text-muted: #64748B;
    --els-border: #E2E8F0;
    --els-success: #16A36A;
    --els-warning: #D99520;
    --els-danger: #D94848;
}

.admin-setup-page,
.admin-setup-page input,
.admin-setup-page button,
.admin-setup-page label,
.admin-setup-page div,
.admin-setup-page span {
    font-family: Arial, Helvetica, sans-serif;
}

.admin-setup-page {
    padding: 24px;
    background: var(--els-background);
}

.admin-setup-box {
    max-width: 1080px;
    margin: 0 auto;
}

.admin-page-header {
    border: 1px solid var(--els-border);
    border-radius: 14px;
    background: linear-gradient(120deg, #f8fbff 0%, #edf4fd 100%);
    box-shadow: 0 8px 22px rgba(23, 59, 112, 0.08);
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.admin-setup-title {
    margin: 0;
    color: var(--els-primary);
    font-size: 24px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.admin-setup-subtitle {
    margin: 6px 0 0;
    color: var(--els-text-muted);
    font-size: 13px;
}

.admin-context-wrap {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.admin-context-chip {
    border: 1px solid var(--els-border);
    border-radius: 999px;
    background: #fff;
    color: var(--els-primary);
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
}

.admin-setup-body {
    display: grid;
    gap: 14px;
}

.admin-setup-note {
    border: 1px solid var(--els-border);
    border-radius: 12px;
    background: var(--els-accent);
    padding: 12px;
    color: var(--els-text);
}

.admin-setup-card {
    border: 1px solid var(--els-border);
    border-radius: 12px;
    background: var(--els-surface);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    padding: 16px;
}

.admin-card-head {
    margin-bottom: 10px;
}

.admin-card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--els-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.admin-card-title i {
    color: var(--els-primary);
}

.admin-card-subtitle {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--els-text-muted);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: end;
}
.form-row label {
    display: block;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--els-text);
}

.form-row input {
    width: 100%;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    min-height: 40px;
    padding: 8px 10px;
    font-size: 14px;
    background: #fff;
    color: var(--els-text);
}

.form-row input:focus {
    outline: none;
    border-color: var(--els-primary-light);
    box-shadow: 0 0 0 3px rgba(40, 120, 200, 0.16);
}

.admin-setup-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
.admin-btn {
    min-width: 180px;
    min-height: 42px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--els-primary-light);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

.admin-btn:hover:not(:disabled) {
    filter: brightness(0.96);
}

.admin-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(40, 120, 200, 0.18);
}

.admin-btn.secondary {
    background: #fff;
    border-color: var(--els-border);
    color: var(--els-primary-dark);
}

.admin-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.result-box {
    margin-top: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    padding: 10px;
    display: none;
    background: #f8fafc;
    color: var(--els-text);
}
.result-box.error {
    border-color: #d9a4a4;
    background: #fff5f5;
}
.result-box.success {
    border-color: #9cc6a8;
    background: #f4fff7;
}
.stores-list-box {
    border: 1px solid var(--els-border);
    border-radius: 10px;
    background: var(--els-surface);
    padding: 12px;
}

.stores-list-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--els-text);
    margin-bottom: 8px;
}

.stores-list-state {
    color: var(--els-text-muted);
    font-size: 12px;
}

.stores-list-state.error {
    color: var(--els-danger);
}

.stores-list {
    margin: 0;
    padding-left: 0;
    color: var(--els-text);
    list-style: none;
}
.store-list-item {
    border: 1px solid var(--els-border);
    border-radius: 8px;
    margin-top: 8px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
}

.store-list-item:first-child {
    margin-top: 0;
}

.store-item-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.store-item-label {
    font-size: 11px;
    color: var(--els-text-muted);
    font-weight: 700;
}

.store-code {
    font-weight: 700;
    color: var(--els-text);
}

.store-currency {
    font-size: 12px;
    color: var(--els-text-muted);
}

.store-status-wrap {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--els-text-muted);
    font-weight: 700;
}

.store-status-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
}
.store-status-pill.active {
    background: rgba(22, 163, 74, 0.12);
    color: #15803d;
    border: 1px solid #15803d;
}
.store-status-pill.inactive {
    background: rgba(201, 48, 44, 0.10);
    color: var(--els-danger);
    border: 1px solid var(--els-danger);
}

@@media (max-width: 900px) {
    .admin-setup-page {
        padding: 16px;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    .admin-btn {
        width: 100%;
    }

    .store-list-item {
        flex-direction: column;
        align-items: flex-start;
    }
}
</style>

<section class="admin-setup-page">
    <div class="admin-setup-box">
        <div class="admin-page-header">
            <div>
                <h2 class="admin-setup-title"><i class="fa fa-plus-square-o" aria-hidden="true"></i> New Store Creation</h2>
                <p class="admin-setup-subtitle">Create and manage store codes for your tenant.</p>
            </div>
            <div class="admin-context-wrap">
                <span class="admin-context-chip">Tenant: @tenantName</span>
                <span class="admin-context-chip">Current Store: @currentStoreCode</span>
            </div>
        </div>

        <div class="admin-setup-body">
            <div class="admin-setup-note">
                <div style="margin-top:6px;">Use this screen to create a new store code for admin login setup. Additional details can be configured in Store Configuration.</div>
            </div>

            <div class="admin-setup-card">
                <div class="admin-card-head">
                    <h3 class="admin-card-title"><i class="fa fa-building-o" aria-hidden="true"></i> Create New Store</h3>
                    <p class="admin-card-subtitle">Enter a unique store code to create a new store setup entry.</p>
                </div>

                <div class="form-row">
                    <div>
                        <label for="newStoreCode">New Store Code</label>
                        <input type="text" id="newStoreCode" maxlength="50" placeholder="For example: HYD01" />
                    </div>
                    <div>
                        <button type="button" class="admin-btn" id="createStoreBtn"><i class="fa fa-plus" aria-hidden="true"></i> Create Store</button>
                    </div>
                </div>
                <div id="createStoreResult" class="result-box"></div>
            </div>

            <div class="admin-setup-card">
                <div class="stores-list-box">
                    <div class="stores-list-title"><i class="fa fa-list-ul" aria-hidden="true"></i> Existing Stores</div>
                    <div id="existingStoresLoading" class="stores-list-state" style="display:none;">Loading existing stores...</div>
                    <div id="existingStoresError" class="stores-list-state error" style="display:none;"></div>
                    <div id="existingStoresEmpty" class="stores-list-state" style="display:none;">No stores available.</div>
                    <ul id="existingStoresList" class="stores-list" style="display:none;"></ul>
                </div>
            </div>

            <div class="admin-setup-actions">
                <button type="button" class="admin-btn secondary" onclick="window.location.href='@Url.Action("StoreUsersSetup", "Customer")'"><i class="fa fa-users" aria-hidden="true"></i> Go to Store Users Setup</button>
                <button type="button" class="admin-btn secondary" onclick="window.location.href='@Url.Action("Index", "Dashboard")'"><i class="fa fa-arrow-left" aria-hidden="true"></i> Back to Dashboard</button>
            </div>
        </div>
    </div>
</section>

<script>
(function () {
    var createBtn = document.getElementById("createStoreBtn");
    var storeCodeInput = document.getElementById("newStoreCode");
    var resultBox = document.getElementById("createStoreResult");
    var storesLoading = document.getElementById("existingStoresLoading");
    var storesError = document.getElementById("existingStoresError");
    var storesEmpty = document.getElementById("existingStoresEmpty");
    var storesList = document.getElementById("existingStoresList");
    var existingStores = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(existingStores));
    var existingStoreStatuses = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(existingStoreStatuses));
    var existingStoresLoadError = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(existingStoresLoadError));
    var createStoreInProgress = false;
    var storeStatusesLoadRequestId = 0;

    if (createBtn && createBtn.getAttribute("data-handler-bound") === "true") {
        return;
    }

    if (!window.location.search && storeCodeInput) {
        storeCodeInput.value = "";
    }

    function renderStoreStatusPill(isActive) {
        return isActive
            ? "<span class='store-status-pill active'>Enabled</span>"
            : "<span class='store-status-pill inactive'>Disabled</span>";
    }

    function getStoreCode(item) {
        if (!item) {
            return "";
        }

        var value = item.storeCode;
        if (!value && value !== 0) {
            value = item.StoreCode;
        }

        return (value || "").toString().trim();
    }

    function getStoreIsActive(item) {
        if (!item) {
            return false;
        }

        var value = item.isActive;
        if (typeof value === "undefined") {
            value = item.IsActive;
        }

        if (typeof value === "string") {
            var v = value.toLowerCase();
            // Accept multiple truthy representations from API/back-end: boolean true, string "true",
            // or legacy string values like "Active"/"InActive" that may be returned by some endpoints.
            return v === "true" || v === "active" || v === "1" || v === "yes";
        }

        return !!value;
    }

    function setStoresState(showLoading, errorMessage, stores) {
        if (!storesLoading || !storesError || !storesEmpty || !storesList) {
            return;
        }

        storesLoading.style.display = showLoading ? "block" : "none";

        if (errorMessage) {
            storesError.textContent = errorMessage;
            storesError.style.display = "block";
            storesEmpty.style.display = "none";
            storesList.style.display = "none";
            storesList.innerHTML = "";
            return;
        }

        storesError.style.display = "none";
        storesError.textContent = "";

        if (!stores || !stores.length) {
            storesEmpty.style.display = "block";
            storesList.style.display = "none";
            storesList.innerHTML = "";
            return;
        }

        storesEmpty.style.display = "none";
        storesList.style.display = "block";
        storesList.innerHTML = stores.map(function (store) {
            var storeCode = getStoreCode(store);
            var isActive = getStoreIsActive(store);

        var currencyDisplay = "Not configured";
        if (store && (store.currencySymbol || store.currencyCode)) {
            var sym = store.currencySymbol || "";
            var code = store.currencyCode || "";
            currencyDisplay = (sym ? sym + " " : "") + (code ? "(" + code + ")" : "");
        }

        return "<li class='store-list-item'>"
                + "<div class='store-item-main'>"
                + "<div class='store-item-label'>Store Code</div>"
                + "<div class='store-code'>" + storeCode + "</div>"
                + "<div class='store-item-label'>Currency</div>"
                + "<div class='store-currency'>" + currencyDisplay + "</div>"
                + "</div>"
                + "<div class='store-status-wrap'><span>Status</span>" + renderStoreStatusPill(isActive) + "</div>"
                + "</div>"
                + "</li>";
        }).join("");
    }

    function normalizeStoreStatusList(stores) {
        if (!Array.isArray(stores)) {
            return [];
        }

        var normalized = [];
        var lookup = {};

        stores.forEach(function (item) {
            var value = "";
            var isActive = false;
            var currencyCode = null;
            var currencySymbol = null;
            var currencyLocale = null;
            var currencyDecimalDigits = null;

            if (typeof item === "string") {
                value = item.trim();
            } else {
                value = getStoreCode(item);
                isActive = getStoreIsActive(item);
                currencyCode = item.currencyCode || item.CurrencyCode || null;
                currencySymbol = item.currencySymbol || item.CurrencySymbol || null;
                currencyLocale = item.currencyLocale || item.CurrencyLocale || null;
                currencyDecimalDigits = (typeof item.currencyDecimalDigits !== 'undefined') ? item.currencyDecimalDigits : (item.currencyDecimalDigits || null);
            }

            if (!value) {
                return;
            }

            var key = value.toLowerCase();
            if (!lookup[key]) {
                lookup[key] = { storeCode: value, isActive: isActive, currencyCode: currencyCode, currencySymbol: currencySymbol, currencyLocale: currencyLocale, currencyDecimalDigits: currencyDecimalDigits };
                normalized.push(lookup[key]);
                return;
            }

            // Merge: prefer explicit currency fields when available
            lookup[key].isActive = isActive || lookup[key].isActive;
            if (!lookup[key].currencyCode && currencyCode) lookup[key].currencyCode = currencyCode;
            if (!lookup[key].currencySymbol && currencySymbol) lookup[key].currencySymbol = currencySymbol;
            if (!lookup[key].currencyLocale && currencyLocale) lookup[key].currencyLocale = currencyLocale;
            if (!lookup[key].currencyDecimalDigits && currencyDecimalDigits) lookup[key].currencyDecimalDigits = currencyDecimalDigits;
        });

        normalized.sort(function (a, b) {
            return a.storeCode.localeCompare(b.storeCode);
        });

        return normalized;
    }

    function loadStoreStatuses() {
        var requestId = ++storeStatusesLoadRequestId;
        setStoresState(true, "", []);

        fetch('@Url.Action("GetNewStoreCreationStoreStatuses", "Customer")', {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (requestId !== storeStatusesLoadRequestId) {
                return;
            }

            if (!data || !data.success) {
                setStoresState(false, (data && data.message) || "Unable to load existing stores.", []);
                return;
            }

            existingStoreStatuses = normalizeStoreStatusList(data.stores || []);
            setStoresState(false, "", existingStoreStatuses);
        })
        .catch(function () {
            if (requestId !== storeStatusesLoadRequestId) {
                return;
            }

            setStoresState(false, "Unable to load existing stores.", []);
        });
    }

    setStoresState(true, "", []);
    existingStoreStatuses = normalizeStoreStatusList(existingStoreStatuses);

    if (existingStoreStatuses.length === 0 && Array.isArray(existingStores) && existingStores.length > 0) {
        existingStoreStatuses = normalizeStoreStatusList(existingStores);
    }

    setStoresState(false, existingStoresLoadError, existingStoreStatuses);
    loadStoreStatuses();

    function showResult(message, isSuccess) {
        if (!resultBox) {
            return;
        }

        resultBox.textContent = message || "Operation completed.";
        resultBox.classList.remove("error", "success");
        resultBox.classList.add(isSuccess ? "success" : "error");
        resultBox.style.display = "block";
    }

    function createStore() {
        if (createStoreInProgress) {
            return;
        }

        var code = (storeCodeInput && storeCodeInput.value ? storeCodeInput.value : "").trim();
        if (!code) {
            showResult("Please enter store code.", false);
            if (storeCodeInput && typeof storeCodeInput.focus === "function") {
                storeCodeInput.focus();
            }
            return;
        }

        if (createBtn) {
            createStoreInProgress = true;
            createBtn.disabled = true;
            createBtn.textContent = "Creating Store...";
        }

        var body = new URLSearchParams();
        body.append("newStoreCode", code);

        fetch('@Url.Action("CreateNewStore", "Customer")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: body.toString()
        })
        .then(function (response) { return response.json(); })
        .then(function (data) {
            if (!data || !data.success) {
                showResult((data && data.message) || "Unable to create store.", false);
                return;
            }

            showResult(data.message || "Store code captured.", true);
            if (Array.isArray(data.allowedStores) && data.allowedStores.length) {
                existingStoreStatuses = normalizeStoreStatusList(data.allowedStores.map(function (storeCode) {
                    var existing = existingStoreStatuses.find(function (x) {
                        return x.storeCode && x.storeCode.toLowerCase() === (storeCode || "").toString().toLowerCase();
                    });

                    return {
                        storeCode: storeCode,
                        isActive: existing ? !!existing.isActive : false
                    };
                }));
            } else if (data.storeCode) {
                existingStoreStatuses = normalizeStoreStatusList(existingStoreStatuses.concat([{ storeCode: data.storeCode, isActive: false }]));
            }

            setStoresState(false, "", existingStoreStatuses);
            loadStoreStatuses();

            if (storeCodeInput) {
                storeCodeInput.value = "";
            }
        })
        .catch(function () {
            showResult("Unable to create store.", false);
        })
        .finally(function () {
            createStoreInProgress = false;
            if (createBtn) {
                createBtn.disabled = false;
                createBtn.textContent = "Create Store";
            }
        });
    }

    if (createBtn) {
        createBtn.setAttribute("data-handler-bound", "true");
        createBtn.addEventListener("click", function (e) {
            e.preventDefault();
            createStore();
        });
    }

    if (storeCodeInput && storeCodeInput.getAttribute("data-handler-bound") !== "true") {
        storeCodeInput.setAttribute("data-handler-bound", "true");
        storeCodeInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                createStore();
            }
        });
    }
})();
</script>
