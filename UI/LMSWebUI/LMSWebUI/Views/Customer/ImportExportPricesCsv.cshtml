@{
    ViewData["Title"] = "Import/Export Prices (CSV)";
    Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
    var tenantName = Convert.ToString(ViewData["TenantName"] ?? "-");
    var storeCode = Convert.ToString(ViewData["StoreCode"] ?? "-");
}

<section class="customer-page">
    <div class="customer-box">
        <div class="customer-header">
            <div class="customer-header-copy">
                <h2 class="customer-title"><i class="fa fa-file-text-o" aria-hidden="true"></i> Import/Export Prices (CSV)</h2>
                <p class="customer-subtitle">Manage your store price catalog using CSV files.</p>
            </div>
            <div class="customer-context-wrap">
                <span class="customer-context-chip">Tenant: @tenantName</span>
                <span class="customer-context-chip">Store: @storeCode</span>
            </div>
        </div>
        <div class="customer-body">
            <div class="customer-card">
                <div class="customer-card-title"><i class="fa fa-bar-chart" aria-hidden="true"></i> Current Price Catalog</div>
                <div id="catalogStatusBox" class="catalog-status-box loading">
                    <div id="catalogStatusText" class="catalog-status-text">Checking whether this store already has prices...</div>
                    <div id="catalogStatusCounts" class="import-summary-grid" style="display:none;">
                        <div class="import-summary-chip"><span>Priced Items</span><b id="statActive">0</b></div>
                        <div class="import-summary-chip"><span>Removed Items</span><b id="statInactive">0</b></div>
                        <div class="import-summary-chip"><span>Service Types</span><b id="statServices">0</b></div>
                    </div>
                    <div id="catalogStatusBreakdown" class="catalog-status-breakdown"></div>
                </div>
            </div>

            <div class="customer-card">
                <div class="customer-card-title"><i class="fa fa-picture-o" aria-hidden="true"></i> Default Laundry Items (Visual Reference)</div>
                <div id="catalogImageDiagnostics" class="catalog-image-diagnostics" role="status" aria-live="polite"></div>
                <div id="visualCatalogWrap" class="visual-catalog-wrap">
                    <div class="catalog-loading">Loading default catalogue items...</div>
                </div>
            </div>

            <div class="customer-card">
                <div class="customer-card-title"><i class="fa fa-exchange" aria-hidden="true"></i> CSV Import/Export</div>
                <div class="bulk-import-grid">
                    <div class="bulk-import-file-wrap">
                        <label class="bulk-import-label" for="customItemsCsvFile">Import CSV File</label>
                        <input type="file" id="customItemsCsvFile" accept=".csv,text/csv" />
                        <div id="selectedCsvFileLabel" class="bulk-file-label">No file selected.</div>
                    </div>
                    <div class="bulk-import-actions">
                        <button type="button" class="action-btn tertiary" id="importUploadedItemsBtn"><i class="fa fa-upload" aria-hidden="true"></i> Import CSV File</button>
                        <button type="button" class="action-btn" id="downloadItemsTemplateBtn"><i class="fa fa-download" aria-hidden="true"></i> Export CSV File</button>
                        <button type="button" class="action-btn secondary" id="openCsvRulesBtn"><i class="fa fa-info-circle" aria-hidden="true"></i> CSV Format Rules</button>
                    </div>
                </div>

                <div class="bulk-import-row" style="margin-top:8px;">
                    <label for="overwriteExistingPricesChk" class="overwrite-check-label">
                        <input type="checkbox" id="overwriteExistingPricesChk" />
                        Overwrite existing prices when <b>ServiceType + Category + ItemName</b> matches.
                    </label>
                </div>
            </div>

            <div id="csvImportPreviewCard" class="customer-card" style="display:none;">
                <div class="customer-card-title"><i class="fa fa-eye" aria-hidden="true"></i> CSV Import Preview</div>
                <div class="import-preview-summary">
                    <div class="import-summary-chip"><span>Total Rows</span><b id="previewTotalRows">0</b></div>
                    <div class="import-summary-chip"><span>Valid Rows</span><b id="previewValidRows">0</b></div>
                    <div class="import-summary-chip"><span>Invalid Rows</span><b id="previewInvalidRows">0</b></div>
                    <div class="import-summary-chip"><span>Price Changes</span><b id="previewChangedRows">0</b></div>
                </div>
                <div id="importPreviewHint" class="field-hint"></div>
                <div class="import-preview-table-wrap">
                    <table class="import-preview-table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Service Type</th>
                                <th>Category</th>
                                <th>Item Name</th>
                                <th>Current Price</th>
                                <th>Imported Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="importPreviewBody"></tbody>
                    </table>
                </div>
                <div class="bulk-import-actions" style="margin-top:10px;">
                    <button type="button" class="action-btn tertiary" id="applyPreviewImportBtn"><i class="fa fa-check" aria-hidden="true"></i> Apply Valid Price Updates</button>
                    <button type="button" class="action-btn secondary" id="clearPreviewBtn"><i class="fa fa-times" aria-hidden="true"></i> Clear Preview</button>
                </div>
            </div>

            <div class="customer-card info-card">
                <div class="customer-card-title"><i class="fa fa-list-alt" aria-hidden="true"></i> CSV Format Rules</div>
                <ul class="csv-rules-list">
                    <li>Exporting downloads the existing price rows for this store.</li>
                    <li><b>Importing overwrites item price</b> when <span class="csv-rules-code">ServiceType + Category + ItemName</span> matches.</li>
                    <li>Required columns: <span class="csv-rules-code">ServiceType</span>, <span class="csv-rules-code">Category</span>, <span class="csv-rules-code">ItemName</span>, <span class="csv-rules-code">UnitPrice</span>.</li>
                    <li>Export the template, edit values, then import it back.</li>
                </ul>
            </div>

            <div id="csvImportSummary" class="import-summary-box">
                <div class="import-summary-title">Last Import Summary</div>
                <div class="import-summary-overall" id="sumOverallResult"></div>
                <div class="import-summary-grid">
                    <div class="import-summary-chip"><span>Imported</span><b id="sumImported">0</b></div>
                    <div class="import-summary-chip"><span>Skipped</span><b id="sumSkipped">0</b></div>
                    <div class="import-summary-chip"><span>Failed</span><b id="sumFailed">0</b></div>
                </div>
                <div class="import-summary-lines" id="sumSkippedLines"></div>
                <div class="import-summary-lines" id="sumFailedLines"></div>
                <div class="import-summary-issues" id="sumRowIssuesWrap" style="display:none;">
                    <div class="import-summary-issues-title">Row Issues</div>
                    <ul class="import-summary-issues-list" id="sumRowIssuesList"></ul>
                    <div class="import-summary-issues-more" id="sumRowIssuesMore"></div>
                </div>
            </div>

            <div class="customer-page-actions">
                <button type="button" class="action-btn secondary" onclick="window.location.href='@Url.Action("Index", "Dashboard")'"><i class="fa fa-arrow-left" aria-hidden="true"></i> Back to Dashboard</button>
            </div>
        </div>
    </div>
</section>

<div id="csvRulesBackdrop" class="csv-rules-modal-backdrop" aria-hidden="true"></div>
<div id="csvRulesModal" class="csv-rules-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="csvRulesTitle">
    <div class="csv-rules-modal-header">
        <div id="csvRulesTitle" class="csv-rules-modal-title">CSV Format Rules</div>
        <button type="button" id="closeCsvRulesBtn" class="csv-rules-close-btn" aria-label="Close">&times;</button>
    </div>
    <div class="csv-rules-modal-body">
        <ul>
            <li>Header row is mandatory: <span class="csv-rules-code">ServiceType,Category,ItemName,UnitPrice</span></li>
            <li>ServiceType, Category and ItemName are required text values.</li>
            <li>UnitPrice must be a valid number (0 or higher).</li>
            <li>Use UTF-8 CSV file format and keep file size under 2 MB.</li>
        </ul>
    </div>
    <div class="csv-rules-modal-footer">
        <button type="button" class="action-btn secondary" id="closeCsvRulesFooterBtn">Close</button>
    </div>
</div>

<div id="csvToast" class="toast-message"></div>

<style>
:root {
    --els-primary: #173B70;
    --els-primary-dark: #173B70;
    --els-primary-light: #2878C8;
    --els-accent: #EAF2FC;
    --els-background: #F5F7FA;
    --els-surface: #FFFFFF;
    --els-text: #1E293B;
    --els-text-muted: #64748B;
    --els-border: #E2E8F0;
    --els-success: #16A36A;
    --els-warning: #D99520;
    --els-danger: #D94848;
}

.customer-page,
.customer-page input,
.customer-page button,
.customer-page div,
.customer-page span {
    font-family: Arial, Helvetica, sans-serif;
}

.customer-page {
    padding: 24px;
    background: var(--els-background);
}

.customer-box {
    max-width: 1100px;
    margin: 0 auto;
}

.customer-header {
    border: 1px solid var(--els-border);
    border-radius: 14px;
    background: linear-gradient(120deg, #f8fbff 0%, #edf4fd 100%);
    box-shadow: 0 8px 22px rgba(23, 59, 112, 0.08);
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.customer-header-copy {
    display: flex;
    flex-direction: column;
    min-width: 280px;
    flex: 1 1 420px;
}

.customer-header .customer-title {
    margin: 0;
    color: var(--els-primary);
    font-size: 24px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: transparent !important;
    line-height: 1.25;
    position: relative;
    z-index: 1;
}

.customer-subtitle {
    margin: 6px 0 0;
    color: var(--els-text-muted);
    font-size: 13px;
    line-height: 1.4;
    white-space: normal;
}

.customer-context-wrap {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.customer-context-chip {
    border: 1px solid var(--els-border);
    border-radius: 999px;
    background: #fff;
    color: var(--els-primary);
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
}

.customer-body {
    display: grid;
    gap: 14px;
}

.customer-card {
    border: 1px solid var(--els-border);
    border-radius: 12px;
    background: var(--els-surface);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    padding: 16px;
}

.customer-card-title {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 700;
    color: var(--els-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.customer-card-title i {
    color: var(--els-primary);
}

.info-card {
    background: var(--els-accent);
}

.bulk-import-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
}

.bulk-import-grid {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, auto);
    gap: 12px;
    align-items: end;
}

.bulk-import-file-wrap {
    display: grid;
    gap: 6px;
}

.bulk-import-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--els-text);
}

.bulk-import-row input[type="file"] {
    width: 100%;
    max-width: 420px;
    font-size: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: #fff;
    padding: 8px;
}

.bulk-file-label {
    font-size: 12px;
    color: var(--els-text-muted);
}

.bulk-import-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.action-btn {
    min-width: 180px;
    min-height: 40px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: var(--els-primary-light);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    padding: 8px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
}

.action-btn.secondary {
    background: #fff;
    border-color: var(--els-border);
    color: var(--els-primary-dark);
}

.action-btn.tertiary {
    background: #fff;
    border-color: var(--els-primary-light);
    color: var(--els-primary-light);
}

.action-btn:hover:not(:disabled) {
    filter: brightness(0.96);
}

.action-btn:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(40, 120, 200, 0.18);
}

.action-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.field-hint {
    margin-top: 10px;
    font-size: 12px;
    color: #475467;
}

.import-summary-box {
    margin-top: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: #f8fafc;
    padding: 10px;
    display: none;
}

.import-summary-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--els-text);
    margin-bottom: 6px;
}

.import-summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(100px, 1fr));
    gap: 8px;
}

.import-summary-chip {
    border: 1px solid var(--els-border);
    border-radius: 6px;
    background: #fff;
    padding: 6px 8px;
    font-size: 12px;
    display: flex;
    justify-content: space-between;
}

.import-summary-lines {
    margin-top: 8px;
    font-size: 12px;
    color: #475467;
}

.import-summary-overall {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--els-text);
}

.import-summary-issues {
    margin-top: 10px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: #fff;
    padding: 8px;
}

.import-summary-issues-title {
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--els-text);
}

.import-summary-issues-list {
    list-style: disc;
    margin: 0;
    padding-left: 18px;
    max-height: 220px;
    overflow-y: auto;
}

.import-summary-issues-list li {
    font-size: 12px;
    color: #475467;
    margin-bottom: 4px;
}

.import-summary-issues-more {
    margin-top: 6px;
    font-size: 11px;
    color: #6b7280;
}

.csv-rules-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 9998;
    display: none;
}

.csv-rules-modal {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(760px, 92vw);
    background: var(--els-surface);
    border: 1px solid var(--els-border);
    border-radius: 10px;
    box-shadow: 0 14px 36px rgba(0,0,0,0.25);
    z-index: 9999;
    display: none;
}

.csv-rules-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    border-bottom: 1px solid var(--els-border);
    background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
    color: #fff;
}

.csv-rules-modal-title {
    font-size: 14px;
    font-weight: 700;
}

.csv-rules-close-btn {
    border: none;
    background: transparent;
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
}

.csv-rules-modal-body {
    padding: 14px;
    font-size: 12px;
    color: var(--els-text);
}

.csv-rules-code {
    font-family: Consolas, 'Courier New', monospace;
    background: #f6f8fa;
    border: 1px solid var(--els-border);
    border-radius: 6px;
    padding: 2px 6px;
}

.csv-rules-modal-footer {
    padding: 0 14px 14px;
    display: flex;
    justify-content: flex-end;
}

.toast-message {
    position: fixed;
    right: 24px;
    top: 80px;
    z-index: 10000;
    min-width: 260px;
    max-width: 380px;
    padding: 12px 16px;
    border-radius: 8px;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    font-weight: 600;
    display: none;
}

.toast-message.success { background: #2f8f46; }
.toast-message.error { background: #b63838; }
.toast-message.info { background: #2563eb; }

.catalog-status-box {
    border: 1px solid var(--els-border);
    border-left-width: 4px;
    border-radius: 10px;
    padding: 12px 14px;
    background: #fff;
    color: var(--els-text);
}

.catalog-status-box.loading { border-left-color: var(--els-border); }
.catalog-status-box.has-data { border-left-color: #2f8f46; }
.catalog-status-box.empty { border-left-color: #c58638; }
.catalog-status-box.error { border-left-color: #b63838; }

.catalog-status-title {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 6px;
}

.catalog-status-text {
    font-size: 12px;
    margin-bottom: 8px;
}

.catalog-status-breakdown {
    font-size: 12px;
    color: var(--els-text-muted);
    margin-top: 8px;
}

.catalog-image-diagnostics {
    font-size: 11px;
    color: #8a5b00;
    margin-bottom: 8px;
}

.visual-catalog-wrap {
    display: grid;
    gap: 12px;
}

.catalog-loading,
.visual-catalog-empty {
    border: 1px dashed var(--els-border);
    border-radius: 8px;
    background: #f8fafc;
    color: var(--els-text-muted);
    font-size: 12px;
    padding: 12px;
}

.visual-service-group {
    border: 1px solid var(--els-border);
    border-radius: 10px;
    background: #fff;
    padding: 10px;
}

.visual-service-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--els-primary);
}

.visual-category-title {
    margin: 8px 0 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--els-text);
}

.visual-item-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
}

.visual-item-card {
    border: 1px solid var(--els-border);
    border-radius: 10px;
    background: #fff;
    padding: 8px;
    display: grid;
    gap: 6px;
}

.visual-item-image {
    width: 100%;
    height: 88px;
    object-fit: contain;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: var(--els-accent);
}

.visual-item-name {
    font-size: 12px;
    font-weight: 700;
    color: var(--els-text);
    line-height: 1.25;
}

.visual-item-price {
    font-size: 11px;
    color: var(--els-text-muted);
}

.import-preview-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 8px;
    margin-bottom: 8px;
}

.import-preview-table-wrap {
    border: 1px solid var(--els-border);
    border-radius: 8px;
    overflow: auto;
    max-height: 460px;
}

.import-preview-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 820px;
}

.import-preview-table th,
.import-preview-table td {
    border-bottom: 1px solid var(--els-border);
    padding: 8px;
    font-size: 12px;
    text-align: left;
    vertical-align: middle;
}

.import-preview-table th {
    position: sticky;
    top: 0;
    background: #f8fafc;
    z-index: 1;
    font-weight: 700;
}

.preview-item-image {
    width: 54px;
    height: 54px;
    object-fit: contain;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: var(--els-accent);
}

.preview-row.valid-update { background: #edf9f1; }
.preview-row.unchanged { background: #f8fafc; }
.preview-row.invalid-item,
.preview-row.invalid-price,
.preview-row.invalid-duplicate { background: #fff1f1; }

.preview-status {
    display: inline-block;
    padding: 4px 8px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 11px;
}

.preview-status.valid-update { background: #d8f3e2; color: #166534; }
.preview-status.unchanged { background: #e2e8f0; color: #334155; }
.preview-status.invalid-item,
.preview-status.invalid-price,
.preview-status.invalid-duplicate { background: #fee2e2; color: #991b1b; }

.overwrite-check-label {
    font-size: 12px;
    color: var(--els-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.csv-rules-list {
    margin: 0;
    padding-left: 18px;
    color: var(--els-text);
    font-size: 12px;
}

.csv-rules-list li {
    margin-bottom: 6px;
}

.customer-page-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
}

@@media (max-width: 900px) {
    .customer-page {
        padding: 16px;
    }

    .bulk-import-grid {
        grid-template-columns: 1fr;
    }

    .import-preview-summary {
        grid-template-columns: repeat(2, minmax(120px, 1fr));
    }

    .action-btn {
        width: 100%;
    }

    .customer-page-actions {
        margin-top: 0;
    }
}
</style>

<script>
(function () {
    var importInProgress = false;
    var pendingImportPreviewRows = [];
    var catalogueManifest = null;
    var catalogueManifestFailed = false;
    var catalogueImageDiagnostics = { missing: [], unapproved: [] };
    var currentPricedItems = [];
    var placeholderImage = '@Url.Content("~/dist/img/noimage.png")';

    if (!window.location.search) {
        var customItemsCsvFileInput = document.getElementById("customItemsCsvFile");
        if (customItemsCsvFileInput) {
            customItemsCsvFileInput.value = "";
        }
    }

    function showToast(message, isSuccess, tone) {
        var toast = document.getElementById("csvToast");
        if (!toast) {
            window.alert(message || "Operation completed.");
            return;
        }

        var resolvedTone = tone === "info"
            ? "info"
            : (isSuccess ? "success" : "error");

        toast.classList.remove("success", "error", "info");
        toast.classList.add(resolvedTone);
        toast.textContent = message || "Operation completed.";
        toast.style.display = "block";

        if (window.__csvToastTimer) {
            clearTimeout(window.__csvToastTimer);
        }

        window.__csvToastTimer = setTimeout(function () {
            toast.style.display = "none";
        }, 3200);
    }

    function parseAmount(value) {
        var number = Number(value);
        return Number.isFinite(number) ? number : 0;
    }

    function normalizeText(value) {
        return (value == null ? "" : String(value)).trim();
    }

    function catalogueKey(serviceType, category, itemName) {
        return [serviceType, category, itemName].map(function (value) {
            return normalizeText(value).toLowerCase();
        }).join("|");
    }

    function resolveCatalogImagePath(value) {
        var path = (value || "").toString().trim();
        if (!path || path.indexOf("://") >= 0 || path.indexOf("//") === 0) {
            return placeholderImage;
        }

        return path.charAt(0) === "/" ? path : "/" + path;
    }

    function findCatalogueManifestEntry(serviceType, category, itemName) {
        var manifestItems = catalogueManifest && Array.isArray(catalogueManifest.items) ? catalogueManifest.items : [];
        if (!manifestItems.length) {
            return null;
        }

        var key = catalogueKey(serviceType, category, itemName);
        for (var i = 0; i < manifestItems.length; i++) {
            var entry = manifestItems[i];
            if (!entry) {
                continue;
            }

            if (catalogueKey(entry.serviceType, entry.category, entry.itemName) === key) {
                return entry;
            }
        }

        return null;
    }

    function resolveItemImageForPreview(serviceType, category, itemName) {
        var entry = findCatalogueManifestEntry(serviceType, category, itemName);
        if (!entry) {
            return "";
        }

        if (String(entry.assetStatus || "").toLowerCase() !== "approved") {
            return "";
        }

        return entry.imagePath || "";
    }

    function findExistingPriceForKey(items, serviceType, category, itemName) {
        var targetKey = catalogueKey(serviceType, category, itemName);
        var matches = (items || []).filter(function (item) {
            var key = catalogueKey(item.ServiceType || item.serviceType, item.Category || item.category, item.ItemName || item.itemName);
            return key === targetKey;
        });

        if (!matches.length) {
            return null;
        }

        var activeMatch = matches.find(function (item) {
            return !!(item.IsActive ?? item.isActive ?? true);
        });

        var match = activeMatch || matches[0];
        return {
            unitPrice: parseAmount(match.UnitPrice || match.unitPrice || 0),
            isActive: !!(match.IsActive ?? match.isActive ?? true)
        };
    }

    function parseCsvHeaderAndRows(csvContent) {
        var lines = (csvContent || "").split(/\r?\n/);
        if (!lines.length) {
            return { header: "", rows: [] };
        }

        var header = (lines[0] || "").replace(/^\uFEFF/, "").trim();
        var rows = [];

        for (var i = 1; i < lines.length; i++) {
            var lineText = lines[i] || "";
            if (!lineText.trim()) {
                continue;
            }

            var columns = [];
            var cursor = 0;
            var current = "";
            var inQuotes = false;

            while (cursor < lineText.length) {
                var ch = lineText[cursor];
                if (ch === '"') {
                    if (inQuotes && lineText[cursor + 1] === '"') {
                        current += '"';
                        cursor += 2;
                        continue;
                    }

                    inQuotes = !inQuotes;
                    cursor++;
                    continue;
                }

                if (ch === ',' && !inQuotes) {
                    columns.push(current.trim());
                    current = "";
                    cursor++;
                    continue;
                }

                current += ch;
                cursor++;
            }

            columns.push(current.trim());
            rows.push({ lineNumber: i + 1, columns: columns });
        }

        return { header: header, rows: rows };
    }

    function buildImportPreview(rows) {
        var dedupe = {};
        var result = [];

        (rows || []).forEach(function (row) {
            var cols = row.columns || [];
            var serviceType = normalizeText(cols[0] || "");
            var category = normalizeText(cols[1] || "");
            var itemName = normalizeText(cols[2] || "");
            var importedPriceRaw = normalizeText(cols[3] || "");
            var importedPrice = Number(importedPriceRaw);
            var key = catalogueKey(serviceType, category, itemName);

            var previewRow = {
                lineNumber: row.lineNumber,
                serviceType: serviceType,
                category: category,
                itemName: itemName,
                importedPriceRaw: importedPriceRaw,
                importedPrice: importedPrice,
                currentPrice: null,
                status: "",
                statusText: "",
                reason: "",
                key: key,
                imagePath: resolveItemImageForPreview(serviceType, category, itemName)
            };

            if (!serviceType || !category || !itemName) {
                previewRow.status = "invalid-item";
                previewRow.statusText = "Invalid item";
                previewRow.reason = "Missing ServiceType, Category or ItemName.";
                result.push(previewRow);
                return;
            }

            if (!Number.isFinite(importedPrice) || importedPrice < 0) {
                previewRow.status = "invalid-price";
                previewRow.statusText = "Invalid price";
                previewRow.reason = "UnitPrice must be a valid number (0 or higher).";
                result.push(previewRow);
                return;
            }

            if (dedupe[key]) {
                previewRow.status = "invalid-duplicate";
                previewRow.statusText = "Duplicate row";
                previewRow.reason = "Duplicate ServiceType + Category + ItemName in uploaded CSV.";
                result.push(previewRow);
                return;
            }
            dedupe[key] = true;

            var existing = findExistingPriceForKey(currentPricedItems, serviceType, category, itemName);
            if (!existing) {
                previewRow.status = "invalid-item";
                previewRow.statusText = "Item not found";
                previewRow.reason = "Item is not available in this store catalog.";
                result.push(previewRow);
                return;
            }

            previewRow.currentPrice = existing.unitPrice;

            if (Math.abs(existing.unitPrice - importedPrice) < 0.0001) {
                previewRow.status = "unchanged";
                previewRow.statusText = "Unchanged";
                previewRow.reason = "Imported price matches current store price.";
            } else {
                previewRow.status = "valid-update";
                previewRow.statusText = "Valid update";
                previewRow.reason = "Price will be updated.";
            }

            result.push(previewRow);
        });

        return result;
    }

    function renderImportPreview(previewRows) {
        var card = document.getElementById("csvImportPreviewCard");
        var body = document.getElementById("importPreviewBody");
        var hint = document.getElementById("importPreviewHint");
        var totalEl = document.getElementById("previewTotalRows");
        var validEl = document.getElementById("previewValidRows");
        var invalidEl = document.getElementById("previewInvalidRows");
        var changedEl = document.getElementById("previewChangedRows");
        var applyBtn = document.getElementById("applyPreviewImportBtn");

        if (!card || !body || !hint || !totalEl || !validEl || !invalidEl || !changedEl || !applyBtn) {
            return;
        }

        var rows = Array.isArray(previewRows) ? previewRows : [];
        var validRows = rows.filter(function (row) { return row.status === "valid-update"; });
        var invalidRows = rows.filter(function (row) { return row.status.indexOf("invalid") === 0; });
        var changedRows = validRows.length;

        totalEl.textContent = String(rows.length);
        validEl.textContent = String(validRows.length);
        invalidEl.textContent = String(invalidRows.length);
        changedEl.textContent = String(changedRows);

        body.innerHTML = "";

        rows.forEach(function (row) {
            var tr = document.createElement("tr");
            tr.className = "preview-row " + row.status;

            var imageTd = document.createElement("td");
            var img = document.createElement("img");
            img.className = "preview-item-image";
            img.loading = "lazy";
            img.alt = row.itemName || "Laundry item";
            img.src = resolveCatalogImagePath(row.imagePath);
            img.onerror = function () {
                if (img.src.indexOf(placeholderImage) < 0) {
                    img.src = placeholderImage;
                }
            };
            imageTd.appendChild(img);

            var serviceTd = document.createElement("td");
            serviceTd.textContent = row.serviceType || "-";
            var categoryTd = document.createElement("td");
            categoryTd.textContent = row.category || "-";
            var itemTd = document.createElement("td");
            itemTd.textContent = row.itemName || "-";
            var currentTd = document.createElement("td");
            currentTd.textContent = Number.isFinite(row.currentPrice) ? row.currentPrice.toFixed(2) : "-";
            var importedTd = document.createElement("td");
            importedTd.textContent = Number.isFinite(row.importedPrice) ? row.importedPrice.toFixed(2) : (row.importedPriceRaw || "-");

            var statusTd = document.createElement("td");
            var status = document.createElement("span");
            status.className = "preview-status " + row.status;
            status.textContent = row.statusText;
            statusTd.appendChild(status);
            if (row.reason) {
                var reason = document.createElement("div");
                reason.style.fontSize = "11px";
                reason.style.marginTop = "4px";
                reason.style.color = "#64748B";
                reason.textContent = row.reason;
                statusTd.appendChild(reason);
            }

            tr.appendChild(imageTd);
            tr.appendChild(serviceTd);
            tr.appendChild(categoryTd);
            tr.appendChild(itemTd);
            tr.appendChild(currentTd);
            tr.appendChild(importedTd);
            tr.appendChild(statusTd);
            body.appendChild(tr);
        });

        hint.textContent = validRows.length > 0
            ? ("Ready to apply " + validRows.length + " valid price update(s). Invalid rows will be ignored.")
            : "No valid price updates found in the uploaded CSV.";

        applyBtn.disabled = importInProgress || validRows.length === 0;
        card.style.display = rows.length ? "block" : "none";
    }

    function clearImportPreview() {
        pendingImportPreviewRows = [];
        renderImportPreview([]);
    }

    function executeCsvImportFromPreview() {
        var validRows = pendingImportPreviewRows.filter(function (row) { return row.status === "valid-update"; });
        if (!validRows.length) {
            showToast("No valid rows to import.", false);
            return;
        }

        if (!window.confirm("Apply " + validRows.length + " valid price update(s)? Invalid rows will not be applied.")) {
            return;
        }

        var fileInput = document.getElementById("customItemsCsvFile");
        var uploadBtn = document.getElementById("importUploadedItemsBtn");
        var exportBtn = document.getElementById("downloadItemsTemplateBtn");
        var applyBtn = document.getElementById("applyPreviewImportBtn");
        var overwriteChk = document.getElementById("overwriteExistingPricesChk");
        var selectedFile = fileInput && fileInput.files && fileInput.files.length ? fileInput.files[0] : null;

        if (!selectedFile) {
            showToast("Please choose a CSV file again before applying import.", false);
            return;
        }

        importInProgress = true;
        if (uploadBtn) {
            uploadBtn.disabled = true;
            uploadBtn.innerHTML = "<i class='fa fa-spinner fa-spin' aria-hidden='true'></i> Importing CSV...";
        }
        if (applyBtn) {
            applyBtn.disabled = true;
            applyBtn.innerHTML = "<i class='fa fa-spinner fa-spin' aria-hidden='true'></i> Applying...";
        }
        if (exportBtn) {
            exportBtn.disabled = true;
        }
        if (fileInput) {
            fileInput.disabled = true;
        }

        var filteredCsvRows = ["ServiceType,Category,ItemName,UnitPrice"];
        validRows.forEach(function (row) {
            filteredCsvRows.push([
                csvEscape(row.serviceType || ""),
                csvEscape(row.category || ""),
                csvEscape(row.itemName || ""),
                csvEscape(parseAmount(row.importedPrice).toFixed(2))
            ].join(","));
        });

        var filteredCsvBlob = new Blob([filteredCsvRows.join("\r\n")], { type: "text/csv;charset=utf-8;" });
        var formData = new FormData();
        formData.append("csvFile", filteredCsvBlob, "LaundryItemPrices.valid-updates.csv");
        formData.append("overwriteExisting", overwriteChk && overwriteChk.checked ? "true" : "false");

        fetch('@Url.Action("ImportLaundryItemPricesCsv", "Customer")', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    renderImportSummary(data || null);
                    showToast((data && data.message) || "Unable to import uploaded CSV items.", false);
                    return;
                }

                renderImportSummary(data);
                showToast(data.message || "Uploaded CSV items imported successfully.", true);
                clearImportPreview();
                if (fileInput) {
                    fileInput.value = "";
                }
                updateImportActionState();
                loadCatalogStatus();
            })
            .catch(function () {
                showToast("Unable to import uploaded CSV items.", false);
            })
            .finally(function () {
                importInProgress = false;
                if (uploadBtn) {
                    uploadBtn.innerHTML = "<i class='fa fa-upload' aria-hidden='true'></i> Import CSV File";
                }
                if (applyBtn) {
                    applyBtn.innerHTML = "<i class='fa fa-check' aria-hidden='true'></i> Apply Valid Price Updates";
                }
                if (exportBtn) {
                    exportBtn.disabled = false;
                }
                if (fileInput) {
                    fileInput.disabled = false;
                }
                updateImportActionState();
                renderImportPreview(pendingImportPreviewRows);
            });
    }

    function resetCatalogueImageDiagnostics() {
        catalogueImageDiagnostics = { missing: [], unapproved: [] };
    }

    function updateCatalogueImageDiagnostics() {
        var diagnosticsEl = document.getElementById("catalogImageDiagnostics");
        if (!diagnosticsEl) {
            return;
        }

        var missing = Array.from(new Set(catalogueImageDiagnostics.missing || []));
        var unapproved = Array.from(new Set(catalogueImageDiagnostics.unapproved || []));

        if (catalogueManifestFailed) {
            diagnosticsEl.textContent = "Catalogue manifest unavailable; using placeholder images.";
            return;
        }

        if (missing.length || unapproved.length) {
            var parts = [];
            if (missing.length) parts.push("Missing mappings: " + missing.length);
            if (unapproved.length) parts.push("Unapproved images: " + unapproved.length);
            diagnosticsEl.textContent = "Image diagnostics — " + parts.join("; ") + ". Placeholder images are in use.";
            return;
        }

        diagnosticsEl.textContent = "All displayed default items have approved catalogue images.";
    }

    function loadCatalogueManifest() {
        catalogueManifestFailed = false;
        resetCatalogueImageDiagnostics();

        return fetch('@Url.Content("~/catalog/laundry-item-catalogue.json")?_ts=' + Date.now(), {
            method: 'GET',
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Unable to load laundry catalogue manifest.");
                }
                return response.json();
            })
            .then(function (data) {
                catalogueManifest = data && Array.isArray(data.items) ? data : { items: [] };
            })
            .catch(function () {
                catalogueManifestFailed = true;
                catalogueManifest = { items: [] };
            });
    }

    function buildPriceLookup(items) {
        var lookup = {};
        (items || []).forEach(function (item) {
            var key = catalogueKey(item.ServiceType || item.serviceType, item.Category || item.category, item.ItemName || item.itemName);
            if (!key) {
                return;
            }

            lookup[key] = parseAmount(item.UnitPrice || item.unitPrice || 0);
        });

        return lookup;
    }

    function resolveCatalogueImageFromEntry(entry) {
        var key = catalogueKey(entry.serviceType, entry.category, entry.itemName);
        var status = String(entry.assetStatus || "").toLowerCase();

        if (!entry.imagePath) {
            catalogueImageDiagnostics.missing.push(key);
            return "";
        }

        if (status && status !== "approved") {
            catalogueImageDiagnostics.unapproved.push(key);
            return "";
        }

        return entry.imagePath;
    }

    function renderVisualCatalog() {
        var wrap = document.getElementById("visualCatalogWrap");
        if (!wrap) {
            return;
        }

        wrap.innerHTML = "";
        resetCatalogueImageDiagnostics();

        var manifestItems = catalogueManifest && Array.isArray(catalogueManifest.items) ? catalogueManifest.items : [];
        var priceLookup = buildPriceLookup(currentPricedItems);
        if (!manifestItems.length) {
            wrap.innerHTML = "<div class='visual-catalog-empty'>No default catalogue items were found.</div>";
            updateCatalogueImageDiagnostics();
            return;
        }

        var grouped = {};
        manifestItems.forEach(function (entry) {
            if (!entry) {
                return;
            }

            var service = normalizeText(entry.serviceType || "Others") || "Others";
            var category = normalizeText(entry.category || "Others") || "Others";
            var itemName = normalizeText(entry.itemName || "Item") || "Item";
            var key = catalogueKey(service, category, itemName);

            if (!grouped[service]) {
                grouped[service] = {};
            }
            if (!grouped[service][category]) {
                grouped[service][category] = [];
            }

            grouped[service][category].push({
                name: itemName,
                imagePath: resolveCatalogueImageFromEntry(entry),
                price: priceLookup[key],
                key: key
            });
        });

        var serviceNames = Object.keys(grouped).sort();
        serviceNames.forEach(function (serviceName) {
            var serviceSection = document.createElement("section");
            serviceSection.className = "visual-service-group";

            var serviceTitle = document.createElement("h3");
            serviceTitle.className = "visual-service-title";
            serviceTitle.textContent = serviceName;
            serviceSection.appendChild(serviceTitle);

            Object.keys(grouped[serviceName]).sort().forEach(function (categoryName) {
                var categoryTitle = document.createElement("div");
                categoryTitle.className = "visual-category-title";
                categoryTitle.textContent = categoryName;
                serviceSection.appendChild(categoryTitle);

                var grid = document.createElement("div");
                grid.className = "visual-item-grid";

                grouped[serviceName][categoryName].sort(function (a, b) {
                    return a.name.localeCompare(b.name);
                }).forEach(function (item) {
                    var card = document.createElement("div");
                    card.className = "visual-item-card";

                    var image = document.createElement("img");
                    image.className = "visual-item-image";
                    image.loading = "lazy";
                    image.alt = item.name;
                    image.src = resolveCatalogImagePath(item.imagePath);
                    image.onerror = function () {
                        if (image.src.indexOf(placeholderImage) < 0) {
                            catalogueImageDiagnostics.missing.push(item.key);
                            updateCatalogueImageDiagnostics();
                            image.src = placeholderImage;
                        }
                    };

                    var name = document.createElement("div");
                    name.className = "visual-item-name";
                    name.textContent = item.name;

                    var price = document.createElement("div");
                    price.className = "visual-item-price";
                    price.textContent = Number.isFinite(item.price)
                        ? ("Current price: " + item.price.toFixed(2))
                        : "Current price: not set";

                    card.appendChild(image);
                    card.appendChild(name);
                    card.appendChild(price);
                    grid.appendChild(card);
                });

                serviceSection.appendChild(grid);
            });

            wrap.appendChild(serviceSection);
        });

        updateCatalogueImageDiagnostics();
    }

    function csvEscape(value) {
        var text = (value === null || value === undefined) ? "" : String(value);
        if (text.indexOf('"') >= 0) {
            text = text.replace(/"/g, '""');
        }
        if (/[",\n\r]/.test(text)) {
            return '"' + text + '"';
        }
        return text;
    }

    // Tracks what the store already has so the user is told up front, before
    // they export a template or import a file that would overwrite existing prices.
    var existingCatalog = { loaded: false, activeCount: 0, inactiveCount: 0 };

    function setCatalogStatus(state, text, breakdown, counts) {
        var box = document.getElementById("catalogStatusBox");
        var textEl = document.getElementById("catalogStatusText");
        var countsEl = document.getElementById("catalogStatusCounts");
        var breakdownEl = document.getElementById("catalogStatusBreakdown");

        if (box) {
            box.classList.remove("loading", "has-data", "empty", "error");
            box.classList.add(state);
        }

        if (textEl) {
            textEl.textContent = text;
        }

        if (breakdownEl) {
            breakdownEl.textContent = breakdown || "";
        }

        if (countsEl) {
            if (counts) {
                document.getElementById("statActive").textContent = counts.active;
                document.getElementById("statInactive").textContent = counts.inactive;
                document.getElementById("statServices").textContent = counts.services;
                countsEl.style.display = "grid";
            } else {
                countsEl.style.display = "none";
            }
        }
    }

    function loadCatalogStatus() {
        return fetch('@Url.Action("GetLaundryItemPrices", "Customer")?includeInactive=true&_ts=' + Date.now(), {
            method: 'GET',
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Unable to read the current price catalog.");
                }
                return response.json();
            })
            .then(function (data) {
                if (!data || !data.success) {
                    existingCatalog = { loaded: false, activeCount: 0, inactiveCount: 0 };
                    setCatalogStatus("error", (data && data.message) || "Unable to read the current price catalog.", "", null);
                    return;
                }

                var items = Array.isArray(data.items) ? data.items : [];
                currentPricedItems = items;
                var activeItems = items.filter(function (item) {
                    return !!(item.IsActive ?? item.isActive ?? true);
                });
                var inactiveCount = items.length - activeItems.length;

                var countByService = {};
                activeItems.forEach(function (item) {
                    var service = (item.ServiceType || item.serviceType || "").trim() || "(no service type)";
                    countByService[service] = (countByService[service] || 0) + 1;
                });
                var serviceNames = Object.keys(countByService).sort();

                existingCatalog = {
                    loaded: true,
                    activeCount: activeItems.length,
                    inactiveCount: inactiveCount
                };

                if (!items.length) {
                    renderVisualCatalog();
                    setCatalogStatus(
                        "empty",
                        "This store has no prices yet. Exporting now gives you a sample template to fill in, and importing will create the catalog from scratch.",
                        "",
                        null);
                    return;
                }

                setCatalogStatus(
                    "has-data",
                    "This store already has prices configured. Exporting downloads these existing rows, and importing will overwrite the price of any item that matches ServiceType + Category + ItemName.",
                    serviceNames.length
                        ? ("By service type: " + serviceNames.map(function (name) {
                            return name + " (" + countByService[name] + ")";
                        }).join(", "))
                        : "",
                    {
                        active: activeItems.length,
                        inactive: inactiveCount,
                        services: serviceNames.length
                    });

                renderVisualCatalog();
            })
            .catch(function (error) {
                existingCatalog = { loaded: false, activeCount: 0, inactiveCount: 0 };
                currentPricedItems = [];
                setCatalogStatus("error", error.message || "Unable to read the current price catalog.", "", null);
                renderVisualCatalog();
            });
    }

    function confirmOverwriteIfNeeded() {
        if (!existingCatalog.loaded || existingCatalog.activeCount <= 0) {
            return true;
        }

        return window.confirm(
            "This store already has " + existingCatalog.activeCount + " priced item(s).\n\n"
            + "Importing will overwrite the price of every matching item and add any new ones.\n\n"
            + "Tip: use Export CSV File first to keep a backup of the current prices.\n\n"
            + "Do you want to continue?");
    }

    function updateImportActionState() {
        var fileInput = document.getElementById("customItemsCsvFile");
        var uploadBtn = document.getElementById("importUploadedItemsBtn");
        var fileLabel = document.getElementById("selectedCsvFileLabel");
        var hasFile = !!(fileInput && fileInput.files && fileInput.files.length);

        if (fileLabel) {
            fileLabel.textContent = hasFile
                ? ("Selected file: " + (fileInput.files[0].name || "CSV file"))
                : "No file selected.";
        }

        if (uploadBtn) {
            uploadBtn.disabled = importInProgress || !hasFile;
        }
    }

    function renderImportSummary(data) {
        var wrap = document.getElementById("csvImportSummary");
        var importedEl = document.getElementById("sumImported");
        var skippedEl = document.getElementById("sumSkipped");
        var failedEl = document.getElementById("sumFailed");
        var overallEl = document.getElementById("sumOverallResult");
        var skippedLinesEl = document.getElementById("sumSkippedLines");
        var failedLinesEl = document.getElementById("sumFailedLines");
        var issuesWrap = document.getElementById("sumRowIssuesWrap");
        var issuesList = document.getElementById("sumRowIssuesList");
        var issuesMore = document.getElementById("sumRowIssuesMore");

        if (!wrap || !importedEl || !skippedEl || !failedEl || !overallEl || !skippedLinesEl || !failedLinesEl || !issuesWrap || !issuesList || !issuesMore) {
            return;
        }

        if (!data) {
            wrap.style.display = "none";
            overallEl.textContent = "";
            skippedLinesEl.textContent = "";
            failedLinesEl.textContent = "";
            issuesWrap.style.display = "none";
            issuesList.textContent = "";
            issuesMore.textContent = "";
            return;
        }

        var importedCount = parseAmount(data.importedCount || 0);
        var skippedCount = parseAmount(data.skippedCount || 0);
        var failedCount = parseAmount(data.failedCount || 0);

        importedEl.textContent = importedCount.toString();
        skippedEl.textContent = skippedCount.toString();
        failedEl.textContent = failedCount.toString();

        var skippedLines = Array.isArray(data.skippedLineNumbers) ? data.skippedLineNumbers : [];
        var failedLines = Array.isArray(data.failedLineNumbers) ? data.failedLineNumbers : [];
        var rawIssues = Array.isArray(data.rowIssues) ? data.rowIssues : [];

        function getIssueLineNumber(issue) {
            if (!issue) {
                return "?";
            }

            var value = issue.lineNumber;
            if (value === undefined || value === null || value === "") {
                value = issue.LineNumber;
            }
            if (value === undefined || value === null || value === "") {
                value = issue.rowNumber;
            }

            return value === undefined || value === null || value === "" ? "?" : String(value);
        }

        function getIssueStatus(issue) {
            var status = issue && (issue.status || issue.Status || "");
            var normalized = String(status || "").trim().toLowerCase();
            if (normalized === "skipped") {
                return "Skipped";
            }
            return "Failed";
        }

        function getIssueReason(issue) {
            var reason = issue && (issue.reason || issue.Reason || issue.message || issue.Message || issue.error || issue.Error);
            return String(reason || "No reason provided.");
        }

        skippedLinesEl.textContent = skippedLines.length
            ? ("Skipped line numbers: " + skippedLines.join(", "))
            : "Skipped line numbers: none";

        failedLinesEl.textContent = failedLines.length
            ? ("Failed line numbers: " + failedLines.join(", "))
            : "Failed line numbers: none";

        var validationRejectedBeforeRowProcessing = !data.success
            && importedCount === 0
            && skippedCount === 0
            && failedCount === 0;

        if (validationRejectedBeforeRowProcessing) {
            overallEl.textContent = "Import rejected before processing because of file validation.";
        } else if (failedCount > 0) {
            overallEl.textContent = "Import completed with some failures; some rows may already have been saved.";
        } else if (skippedCount > 0) {
            overallEl.textContent = "Import completed with skipped rows.";
        } else {
            overallEl.textContent = "All rows imported successfully.";
        }

        issuesList.textContent = "";
        issuesMore.textContent = "";
        issuesWrap.style.display = "none";

        if (rawIssues.length) {
            var maxIssuesToRender = 100;
            var visibleIssues = rawIssues.slice(0, maxIssuesToRender);

            visibleIssues.forEach(function (issue) {
                var lineNumber = getIssueLineNumber(issue);
                var statusText = getIssueStatus(issue);
                var reasonText = getIssueReason(issue);

                var listItem = document.createElement("li");
                listItem.textContent = "Line " + lineNumber + " - " + statusText + ": " + reasonText;
                issuesList.appendChild(listItem);
            });

            if (rawIssues.length > maxIssuesToRender) {
                issuesMore.textContent = "Showing first " + maxIssuesToRender + " of " + rawIssues.length + " issues.";
            }

            issuesWrap.style.display = "block";
        } else if ((failedCount > 0 || skippedCount > 0) && !validationRejectedBeforeRowProcessing) {
            issuesMore.textContent = "Detailed row issues were not returned by the server for this response.";
            issuesWrap.style.display = "block";
        }

        wrap.style.display = "block";
    }

    function downloadItemsTemplateCsv() {
        fetch('@Url.Action("GetLaundryItemPrices", "Customer")?includeInactive=false&forImportExport=true', {
            method: 'GET',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
            .then(function (response) { return response.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    showToast((data && data.message) || "Unable to export CSV file.", false);
                    return;
                }

                var items = Array.isArray(data.items) ? data.items : [];
                var rows = ["ServiceType,Category,ItemName,UnitPrice"];
                var isSampleTemplate = !items.length;

                if (isSampleTemplate) {
                    rows.push("Dry Clean,Men,Shirt,25");
                    rows.push("Steam Iron,Women,Top,20");
                    rows.push("Wash & Fold,Household,Bedsheet,30");
                } else {
                    items.forEach(function (item) {
                        rows.push([
                            csvEscape(item.ServiceType || item.serviceType || ""),
                            csvEscape(item.Category || item.category || ""),
                            csvEscape(item.ItemName || item.itemName || ""),
                            csvEscape(parseAmount(item.UnitPrice || item.unitPrice || 0).toFixed(2))
                        ].join(","));
                    });
                }

                var blob = new Blob([rows.join("\r\n")], { type: "text/csv;charset=utf-8;" });
                var link = document.createElement("a");
                link.href = URL.createObjectURL(blob);
                link.download = isSampleTemplate ? "LaundryItemTemplate.csv" : "LaundryItemPrices.csv";
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(link.href);

                showToast(isSampleTemplate
                    ? "No prices exist yet. A sample template was downloaded for you to fill in."
                    : ("Exported " + items.length + " existing priced item(s)."), true);
            })
            .catch(function () {
                showToast("Unable to export CSV file.", false);
            });
    }

    function importUploadedItemsCsv() {
        if (importInProgress) {
            return;
        }

        var fileInput = document.getElementById("customItemsCsvFile");
        var uploadBtn = document.getElementById("importUploadedItemsBtn");
        var exportBtn = document.getElementById("downloadItemsTemplateBtn");
        var overwriteChk = document.getElementById("overwriteExistingPricesChk");
        var selectedFile = fileInput && fileInput.files && fileInput.files.length ? fileInput.files[0] : null;
        if (!selectedFile) {
            showToast("Please choose a CSV file to import.", false);
            return;
        }

        var fileName = (selectedFile.name || "").trim();
        var maxSizeBytes = 2 * 1024 * 1024;
        if (!/\.csv$/i.test(fileName)) {
            showToast("Invalid file type. Please upload a .csv file.", false);
            return;
        }

        if (!selectedFile.size || selectedFile.size <= 0) {
            showToast("Selected CSV file is empty.", false);
            return;
        }

        if (selectedFile.size > maxSizeBytes) {
            showToast("CSV file is too large. Max allowed size is 2 MB.", false);
            return;
        }

        selectedFile.text()
            .then(function (content) {
                var firstLine = ((content || "").split(/\r?\n/)[0] || "").replace(/^\uFEFF/, "").trim();
                var normalizedHeader = firstLine.toLowerCase().replace(/\s+/g, "");
                var requiredHeader = "servicetype,category,itemname,unitprice";
                if (normalizedHeader !== requiredHeader) {
                    showToast("Invalid CSV header. Required: ServiceType,Category,ItemName,UnitPrice", false);
                    return;
                }

                if (!confirmOverwriteIfNeeded()) {
                    return;
                }

                var parsed = parseCsvHeaderAndRows(content);
                pendingImportPreviewRows = buildImportPreview(parsed.rows || []);
                renderImportPreview(pendingImportPreviewRows);

                if (!pendingImportPreviewRows.length) {
                    showToast("No data rows found in the uploaded CSV.", false);
                    return;
                }

                var validUpdates = pendingImportPreviewRows.filter(function (row) { return row.status === "valid-update"; }).length;
                var invalidRows = pendingImportPreviewRows.filter(function (row) { return row.status.indexOf("invalid") === 0; }).length;
                var unchangedRows = pendingImportPreviewRows.filter(function (row) { return row.status === "unchanged"; }).length;

                if (validUpdates <= 0) {
                    if (unchangedRows > 0 && invalidRows > 0) {
                        showToast("No price changes found. Some rows are unchanged and others contain validation errors. Review the preview details.", false);
                    } else if (unchangedRows > 0) {
                        showToast("No price changes found. All valid imported prices already match the current prices.", false, "info");
                    } else {
                        showToast("No valid price updates found. Please review the invalid rows and their validation reasons.", false);
                    }
                    return;
                }

                showToast(
                    "Preview ready: " + validUpdates + " valid update(s), " + invalidRows + " invalid row(s). Confirm to apply valid updates.",
                    true);
            })
            .catch(function () {
                renderImportSummary(null);
                showToast("Unable to read CSV file. Please choose a valid UTF-8 CSV.", false);
            });
    }

    function setCsvRulesModalVisibility(isVisible) {
        var backdrop = document.getElementById("csvRulesBackdrop");
        var modal = document.getElementById("csvRulesModal");
        if (!backdrop || !modal) {
            return;
        }

        backdrop.style.display = isVisible ? "block" : "none";
        modal.style.display = isVisible ? "block" : "none";
    }

    document.getElementById("customItemsCsvFile")?.addEventListener("change", updateImportActionState);
    document.getElementById("openCsvRulesBtn")?.addEventListener("click", function (e) { e.preventDefault(); setCsvRulesModalVisibility(true); });
    document.getElementById("closeCsvRulesBtn")?.addEventListener("click", function (e) { e.preventDefault(); setCsvRulesModalVisibility(false); });
    document.getElementById("closeCsvRulesFooterBtn")?.addEventListener("click", function (e) { e.preventDefault(); setCsvRulesModalVisibility(false); });
    document.getElementById("csvRulesBackdrop")?.addEventListener("click", function () { setCsvRulesModalVisibility(false); });
    document.getElementById("importUploadedItemsBtn")?.addEventListener("click", function (e) { e.preventDefault(); importUploadedItemsCsv(); });
    document.getElementById("downloadItemsTemplateBtn")?.addEventListener("click", function (e) { e.preventDefault(); downloadItemsTemplateCsv(); });
    document.getElementById("applyPreviewImportBtn")?.addEventListener("click", function (e) { e.preventDefault(); executeCsvImportFromPreview(); });
    document.getElementById("clearPreviewBtn")?.addEventListener("click", function (e) { e.preventDefault(); clearImportPreview(); });

    updateImportActionState();
    loadCatalogueManifest().then(loadCatalogStatus);
})();
</script>
