@model LMSWebUI.Models.Customer.CustomerInfoDto 
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using LMSWebUI.Services
@using System.Collections.Generic
@{
   Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
   var hideButton = false;
   bool.TryParse(Convert.ToString(TempData.Peek("isHideButton")), out hideButton);
   var updateSearchTerm = Convert.ToString(ViewData["UpdateSearchTerm"]);
   var updateSearchNotFound = Convert.ToBoolean(ViewData["UpdateSearchNotFound"] ?? false);
   var actionMode = Convert.ToString(ViewData["CustomerActionMode"] ?? "create").Trim().ToLowerInvariant();
   var pageTitle = actionMode == "update"
       ? "Customer Update"
       : actionMode == "delete"
           ? "Customer Delete"
           : "Customer Create";
   ViewData["Title"] = pageTitle;
    var phoneCountries = JsonConvert.DeserializeObject<List<CustomerPhoneCountry>>(Convert.ToString(ViewData["CustomerPhoneCountries"]) ?? "[]") ?? new List<CustomerPhoneCountry>();
    var defaultPhoneCountry = Convert.ToString(Model?.PhoneCountryCode ?? ViewData["CustomerDefaultPhoneCountry"] ?? string.Empty);
    var phoneConfigMessage = Convert.ToString(ViewData["CustomerPhoneConfigMessage"] ?? string.Empty);
}

<style>
.customer-page,
.customer-page input,
.customer-page textarea,
.customer-page select,
.customer-page button {
    font-family: Arial, Helvetica, sans-serif;
}

.customer-page * { box-sizing: border-box; }

.customer-page {
    padding: 20px;
}

.customer-box {
    max-width: 1400px;
    margin: 0 auto;
    background: var(--els-surface);
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    overflow: hidden;
}

.customer-title {
    background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
    color: #fff;
    padding: 14px 20px;
    font-size: 20px;
    font-weight: 600;
}

.customer-body {
    padding: 20px;
}

.autocomplete {
  position: relative;
  display: inline-block;
}

.customer-search {
    width: 100% !important;
    border: 1px solid var(--els-border);
    border-radius: 6px;
}

.customer-code {
    margin: 15px 0;
    font-size: 15px;
}

.input-container {
    display: flex;
    width: 100%;
    gap: 10px;
    margin-bottom: 12px;
    align-items: stretch;
}

.icon {
    padding: 10px;
    background: var(--els-primary);
    color: #fff;
    min-width: 42px;
    text-align: center;
    border-radius: 4px;
}

.input-field,
.input1-field,
.input2-field {
    padding: 10px;
    outline: none;
    border: 1px solid var(--els-border);
    border-radius: 4px;
}

.input1-field { width: 50%; }
.input2-field { width: 25%; }

.customer-page input {
  border: 1px solid var(--els-border);
  background-color: var(--els-surface);
  padding: 10px;
  font-size: 16px;
  color: var(--els-text);
}
.customer-page input[type=text] {
  background-color: var(--els-surface);
  width: 100%;
}
.customer-page input:focus,
.customer-page textarea:focus,
.customer-page select:focus {
  border-color: #7eaed6;
  box-shadow: 0 0 0 0.2rem rgba(31, 95, 143, 0.15);
  outline: none;
}
.customer-page input[type=submit] {
  background-color: var(--els-primary);
  color: #fff;
}
.customer-page .autocomplete-items {
  position: absolute;
  border: 1px solid var(--els-border);
  border-bottom: none;
  border-top: none;
  z-index: 99;
  /*position the autocomplete items to be the same width as the container:*/
  top: 100%;
  left: 0;
  right: 0;
}
.customer-page .autocomplete-items div {
  padding: 10px;
  cursor: pointer;
  background-color: var(--els-surface);
  border-bottom: 1px solid var(--els-border);
}
.customer-page .autocomplete-items div:hover {
  /*when hovering an item:*/
  background-color: var(--els-accent);
}
.customer-page .autocomplete-active {
  /*when navigating through the items using the arrow keys:*/
  background-color: var(--els-primary) !important;
  color: #ffffff;
}

.maintain-text,
textarea.maintain-text {
    border-radius: 4px;
    border: 1px solid var(--els-border);
}

.nav-actions {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--els-border);
}

#customerActions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.navitem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    min-height: 46px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
    color: #fff;
    padding: 10px 16px;
    text-align: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.2px;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 2px 6px rgba(31, 95, 143, 0.25);
}

.navitem:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(31, 95, 143, 0.3);
    background: linear-gradient(180deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
}

.navitem:active {
    transform: translateY(0);
    box-shadow: 0 1px 4px rgba(31, 95, 143, 0.25);
}

.navitem:focus-visible {
    outline: 3px solid rgba(31, 95, 143, 0.35);
    outline-offset: 1px;
}

/* Button spinner */
.btn-spinner {
    display: inline-block;
    vertical-align: middle;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: customer-btn-spin 0.8s linear infinite;
    margin-right: 8px;
}

@@keyframes customer-btn-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

#custdelete {
    background: linear-gradient(180deg, #dc6f6b 0%, var(--els-danger) 100%);
    box-shadow: 0 2px 6px rgba(201, 48, 44, 0.25);
}

#custdelete:hover {
    background: linear-gradient(180deg, #e28582 0%, var(--els-danger) 100%);
    box-shadow: 0 4px 12px rgba(201, 48, 44, 0.3);
}

#custnew {
    background: linear-gradient(180deg, #66c066 0%, var(--els-success) 100%);
    box-shadow: 0 2px 6px rgba(68, 157, 68, 0.25);
}

#custnew:hover {
    background: linear-gradient(180deg, #7ccc7c 0%, var(--els-success) 100%);
    box-shadow: 0 4px 12px rgba(68, 157, 68, 0.3);
}

@@media (max-width: 768px) {
    .nav-actions {
        gap: 10px;
    }

    .navitem {
        flex: 1 1 calc(50% - 10px);
        min-width: 0;
    }
}

@@media (max-width: 520px) {
    .navitem {
        flex: 1 1 100%;
    }
}

.toast-message {
    position: fixed;
    right: 24px;
    top: 80px;
    z-index: 9999;
    min-width: 260px;
    max-width: 380px;
    padding: 12px 16px;
    border-radius: 8px;
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    font-weight: 600;
    display: none;
}

.toast-message.success {
    background: #2f8f46;
}

.toast-message.error {
    background: #b63838;
}

.field-error {
    color: #b63838;
    font-size: 12px;
    margin-top: 4px;
    display: none;
}

.field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(220px, 1fr));
    gap: 12px;
    margin-bottom: 12px;
}

.field-grid .field-item {
    display: flex;
    flex-direction: column;
}

.field-grid label {
    font-size: 13px;
    margin-bottom: 5px;
    color: var(--els-text);
}

.input-validation-error {
    border: 1px solid #b63838 !important;
    background-color: #fff5f5 !important;
}

.update-search-panel {
    margin-bottom: 14px;
    padding: 12px;
    border: 1px solid var(--els-border);
    border-radius: 8px;
    background: var(--els-accent);
}

.update-search-form {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
}

.update-search-form label {
    font-size: 13px;
    font-weight: 600;
    color: var(--els-text);
    margin: 0;
}

.update-search-form input[type=text] {
    flex: 1 1 280px;
    min-width: 220px;
}

.search-customer-btn {
    min-width: 130px;
}

.customer-page { background: #f5f8fc; min-height: calc(100vh - 80px); padding: 32px 20px; }
.customer-box { border: 1px solid #e6edf5; border-radius: 18px; box-shadow: 0 16px 45px rgba(22, 42, 70, .10); }
.customer-title { padding: 24px 30px; font-size: 24px; letter-spacing: -.3px; }
.customer-body { padding: 26px 30px 30px; }
.customer-code { display: grid; grid-template-columns: minmax(130px, auto) minmax(220px, 360px); align-items: center; gap: 10px 14px; margin: 0 0 22px; padding: 14px 16px; border: 1px solid #dfe9f4; border-radius: 12px; background: #f8fbff; color: #52657b; }
.customer-code label { margin: 0; color: #334b66; font-size: 13px; font-weight: 700; }
.customer-code input { width: 100%; min-height: 42px; margin: 0; border: 1px solid #d7e2ee; border-radius: 10px; background: #eef4fa; color: #52657b; font-size: 14px; font-weight: 600; }
.profile-layout { display: block; }
.profile-card { border: 1px solid #e5ecf4; border-radius: 16px; padding: 22px; background: #fff; box-shadow: 0 7px 22px rgba(30, 55, 85, .06); }
.profile-card h2 { margin: 0 0 4px; color: #19324f; font-size: 17px; font-weight: 700; }
.profile-card .card-subtitle { margin: 0 0 20px; color: #74869a; font-size: 13px; }
.profile-card .input-container { margin: 0; gap: 12px; }
.profile-card .icon { width: 40px; min-width: 40px; padding: 11px 8px; border-radius: 10px; background: #edf5ff; color: var(--els-primary); }
.profile-card .input-container input, .profile-card .input-container textarea { border-radius: 10px; border-color: #d7e2ee; }
.profile-card .profile-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; margin: 0; }
.profile-card .field-item { display: flex; flex-direction: column; min-width: 0; gap: 7px; }
.profile-card .field-item--wide { grid-column: 1 / -1; }
.field-grid label, .profile-card label { font-weight: 700; color: #334b66; }
.required-mark { color: #c33b4a; }
.phone-input-group { display: grid; grid-template-columns: minmax(126px, 145px) minmax(0, 1fr); gap: 8px; align-items: start; }
.phone-country { width: 100%; min-width: 0; min-height: 42px; border: 1px solid #d7e2ee; border-radius: 10px; padding: 10px 8px; color: #203b58; background: #fbfdff; }
.phone-input-group input { min-width: 0; }
.barcode-input { display: flex; gap: 8px; }
.barcode-input input { min-width: 0; }
.barcode-scan { flex: 0 0 44px; border: 1px solid #c9dced; border-radius: 10px; background: #eff7ff; color: var(--els-primary); }
.barcode-scan:hover, .barcode-scan:focus-visible { background: #dceeff; }
.helper-text { color: #77899d; font-size: 12px; margin-top: 2px; }
.phone-input-guidance { display: flex; align-items: flex-start; gap: 8px; width: 100%; margin-top: 7px; padding: 9px 11px; border: 1px solid #dce8f4; border-radius: 9px; background: #f5f9fe; color: #526b84; font-size: 12px; line-height: 1.5; }
.phone-input-guidance i { flex: 0 0 auto; margin-top: 2px; color: var(--els-primary); }
.phone-guidance-content { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.phone-guidance-summary { color: #294662; font-weight: 700; }
.phone-guidance-country { color: #526b84; }
.phone-guidance-detail { color: #71859a; }
.phone-config-note { color: #936b19; background: #fff8e6; border: 1px solid #f3dfaa; border-radius: 9px; padding: 9px 11px; font-size: 12px; margin-top: 9px; }
.profile-card .field-error { margin: 0; min-height: 0; }
.nav-actions { grid-column: 1 / -1; margin-top: 2px; padding: 20px 0 0; }
.nav-actions #custsave { min-width: 190px; }
@@media (max-width: 700px) { .profile-card .profile-fields { grid-template-columns: 1fr; } .profile-card .field-item--wide { grid-column: auto; } }
@@media (max-width: 560px) { .customer-page { padding: 16px 10px; } .customer-body { padding: 18px 14px 22px; } .customer-title { padding: 20px; } .profile-card { padding: 17px; } .customer-code { grid-template-columns: 1fr; gap: 7px; } .phone-input-group { grid-template-columns: minmax(112px, 128px) minmax(0, 1fr); } }
</style>

</style>

     @{
         var customerUserMessageJson = Convert.ToString(TempData.Peek("UserMessage"));
         LMSWebUI.Models.MessageDto customerUserMessage = null;

         if (!string.IsNullOrWhiteSpace(customerUserMessageJson))
         {
             try
             {
                 customerUserMessage = JsonConvert.DeserializeObject<LMSWebUI.Models.MessageDto>(customerUserMessageJson);
             }
             catch
             {
                 customerUserMessage = null;
             }
         }

         var suppressLayoutStatusMessage = customerUserMessage != null
             && !string.IsNullOrWhiteSpace(customerUserMessage.CssClassName)
             && customerUserMessage.CssClassName.IndexOf("alert-success", StringComparison.OrdinalIgnoreCase) >= 0;

         if (suppressLayoutStatusMessage)
         {
             if (TempData["CustomerSaveToast"] == null && !string.IsNullOrWhiteSpace(customerUserMessage.DisplayMessage))
             {
                 TempData["CustomerSaveToast"] = customerUserMessage.DisplayMessage;
             }

             TempData.Remove("UserMessage");
         }
     }
     <div id="customerToast" class="toast-message"></div>
     @if (TempData["UpdateModeToast"] != null)
     {
         <script type="text/javascript">
             window.updateModeToastMessage = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(TempData["UpdateModeToast"])))';
         </script>
     }
     @if (TempData["CustomerSaveToast"] != null)
     {
         <script type="text/javascript">
             window.customerSaveToastMessage = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(TempData["CustomerSaveToast"])))';
         </script>
     }
     @if (TempData["UpdateSearchToast"] != null)
     {
         <script type="text/javascript">
             window.updateSearchToastMessage = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(TempData["UpdateSearchToast"])))';
         </script>
     }
     <script type="text/javascript">
         document.addEventListener("DOMContentLoaded", function () {
             if (!window.customerSaveToastMessage || window.__initialSaveToastShown) {
                 return;
             }

             var toast = document.getElementById("customerToast");
             if (!toast) {
                 return;
             }

             toast.classList.remove("error");
             toast.classList.add("success");
             toast.textContent = "Success! " + window.customerSaveToastMessage;
             toast.style.display = "block";
             window.__initialSaveToastShown = true;

             setTimeout(function () {
                 toast.style.display = "none";
             }, 3200);
         });
     </script>
     <section class="customer-page">
     <div class="customer-box">
     <div class="customer-title">@pageTitle</div>
     <div class="customer-body">
         
<!-- NEW: Existing Orders section -->
<section id="existingCustomerOrders"
         style="display:none; margin:20px 0;">

    <h3>Existing Orders</h3>

    <div id="customerOrdersMessage"
         role="status"
         style="margin-bottom:10px;">
    </div>

    <div style="overflow-x:auto;">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Order No.</th>
                    <th>Invoice No.</th>
                    <th>Created Date</th>
                    <th>Service</th>
                    <th>Pieces</th>
                    <th>Total Amount</th>
                    <th>Paid Amount</th>
                    <th>Pending Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="customerOrdersBody"></tbody>
        </table>
    </div>

</section>
  
     @if (hideButton)
     {
         <div class="update-search-panel">
             <form method="get" action="@Url.Action("Index", "Customer")" class="update-search-form">
                 <label for="updateCustomerSearch">@(actionMode == "delete" ? "Search Customer for Delete" : "Search Customer for Update")</label>
                 <input type="text" id="updateCustomerSearch" name="customerName" class="form-control maintain-text" placeholder="Enter customer name" value="@(string.IsNullOrWhiteSpace(updateSearchTerm) ? Model?.CustomerName : updateSearchTerm)" />
                 <input type="hidden" name="mode" value="@actionMode" />
                 <button type="submit" class="navitem search-customer-btn">Search</button>
             </form>
         </div>
     }
     @using (Html.BeginForm("Index","Customer", FormMethod.Post, new { @class = "form" }))
   {
       <div class="customer-code" aria-label="Customer code status">
     <label for="customerCodeValue">Customer Code</label>
     <input type="text" id="customerCodeValue" value="@(string.IsNullOrWhiteSpace(Convert.ToString(TempData["customerCode"])) ? "Auto-generated on Save" : Convert.ToString(TempData["customerCode"]))" readonly aria-readonly="true" />
    <input type="hidden" id="customerCodeHidden" name="customerCode" value="@(TempData["customerCode"] ?? string.Empty)" />
    @* Ensure the logged-in store/tenant are posted so server binding works even if session is missing *@
    @{
        var storeVal = Context?.Session?.GetString("TenantStore") ?? string.Empty;
        var tenantVal = Context?.Session?.GetString("TenantName") ?? string.Empty;
    }
    <input type="hidden" id="StoreCode" name="StoreCode" value="@storeVal" />
    <input type="hidden" id="TenantName" name="TenantName" value="@tenantVal" />
         </div>
        <div class="profile-layout">
       <section class="profile-card" aria-labelledby="profile-details-heading">
           <h2 id="profile-details-heading"><i class="fa fa-user-circle-o" aria-hidden="true"></i> Profile details</h2>
           <p class="card-subtitle">Add the customer details used across orders and history.</p>
        <div class="profile-fields">
           <div class="field-item">
                <label for="name">Customer name <span class="required-mark">*</span></label>
                <div class="input-container">
                    <i class="fa fa-user icon" aria-hidden="true"></i>
                    @Html.TextBoxFor(m => m.CustomerName, new { @placeholder = "Customer name", @class = "form-control maintain-text", id = "name", aria_required = "true", autocomplete = "name" })
                </div>
                <div id="nameError" class="field-error" role="alert">Customer name is required.</div>
           </div>
           <div class="field-item">
                <label for="email">Email <span class="helper-text">Optional</span></label>
                @Html.TextBoxFor(m => m.Email, new { @placeholder = "name@example.com", @class = "form-control maintain-text", id = "email", type = "email", autocomplete = "email" })
                <div id="emailError" class="field-error">Please enter a valid email address.</div>
           </div>
           <div class="field-item field-item--wide">
                <label for="address">Address <span class="required-mark">*</span></label>
                <div class="input-container">
                    <i class="fa fa-map-marker icon" aria-hidden="true"></i>
                    @Html.TextAreaFor(m => m.Address, new { @placeholder = "Address", @class = "form-control maintain-text", id = "address", rows = "3", aria_required = "true", autocomplete = "street-address" })
                </div>
                <div id="addressError" class="field-error" role="alert">Customer address is required.</div>
           </div>
           <div class="field-item">
                <label for="phoneNumber">Phone number</label>
               <div class="phone-input-group">
                   <select id="phoneCountryCode" name="PhoneCountryCode" class="phone-country" aria-label="Phone country" autocomplete="tel-country-code">
                       @foreach (var country in phoneCountries)
                       {
                           <option value="@country.Iso2" data-calling-code="@country.CallingCode" selected="@(string.Equals(defaultPhoneCountry, country.Iso2, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@country.Flag @country.Name (@country.CallingCode)</option>
                       }
                   </select>
                   @Html.TextBoxFor(m => m.PhoneNumber, new { @placeholder = "Local phone number", @class = "form-control maintain-text", id = "phoneNumber", type = "tel", inputmode = "tel", autocomplete = "tel" })
               </div>
               <div id="phoneError" class="field-error" role="alert">Enter a valid phone number for the selected country.</div>
                 <div id="phoneGuidance" class="phone-input-guidance" role="note" aria-live="polite">
                     <i class="fa fa-info-circle" aria-hidden="true"></i>
                     <div class="phone-guidance-content">
                         <span class="phone-guidance-summary">Phone number Optional; exactly 10 digits when provided.</span>
                         <span id="phoneGuidanceCountry" class="phone-guidance-country"></span>
                         <span id="phoneGuidanceText" class="phone-guidance-detail"></span>
                     </div>
                </div>
               @if (!string.IsNullOrWhiteSpace(phoneConfigMessage)) { <div class="phone-config-note" role="status"><i class="fa fa-info-circle" aria-hidden="true"></i> @phoneConfigMessage</div> }
          </div>
      </div>
       </section>

      <div class="nav-actions">
        @{
            var tempCustomerCode = Convert.ToString(TempData["customerCode"] ?? string.Empty);
            var isLoadedCustomer = !string.IsNullOrWhiteSpace(Model?.customerCode) || !string.IsNullOrWhiteSpace(tempCustomerCode);
        }

        @* If we're in create mode but a customer is already loaded, expose actions (Update/Delete/Add New).
           This preserves the previous UX where loading an existing customer showed edit/delete/add options. *@
        @if (actionMode == "create")
        {
            if (isLoadedCustomer)
            {
                @* Always render a hidden Save button so client-side Add New can reveal it without a full page reload *@
                <input class="navitem" type="submit" id="custsave" value="Save" style="display:none;" />
                <div id="customerActions" style="display:flex; flex-wrap:wrap; gap:12px;">
                    <button class="navitem" type="button" id="custedit" onclick="return window.triggerCustomerUpdateFromButton ? window.triggerCustomerUpdateFromButton() : false;">Update</button>
                    <button class="navitem" type="button" id="custdelete" onclick="return window.triggerCustomerDeleteFromButton ? window.triggerCustomerDeleteFromButton() : false;">Delete</button>
                    <button class="navitem" type="button" id="custnew" onclick="return window.triggerAddNewCustomerFromButton ? window.triggerAddNewCustomerFromButton() : false;">Add New</button>
                </div>
            }
            else
            {
                <input class="navitem" type="submit" id="custsave" value="Save" />
                <div id="customerActions" style="display:none;"></div>
            }
        }
        else if (actionMode == "update")
        {
            @* Keep a hidden Save button available so client-side Add New can reveal it without navigation *@
            <input class="navitem" type="submit" id="custsave" value="Save" style="display:none;" />
            <div id="customerActions" style="display:flex; flex-wrap:wrap; gap:12px;">
                <button class="navitem" type="button" id="custedit" onclick="return window.triggerCustomerUpdateFromButton ? window.triggerCustomerUpdateFromButton() : false;">Update</button>
                <button class="navitem" type="button" id="custnew" onclick="return window.triggerAddNewCustomerFromButton ? window.triggerAddNewCustomerFromButton() : false;">Add New</button>
            </div>
        }
        else if (actionMode == "delete")
        {
            @* Keep a hidden Save button available so client-side Add New can reveal it without navigation *@
            <input class="navitem" type="submit" id="custsave" value="Save" style="display:none;" />
            <div id="customerActions" style="display:flex; flex-wrap:wrap; gap:12px;">
                <button class="navitem" type="button" id="custdelete" onclick="return window.triggerCustomerDeleteFromButton ? window.triggerCustomerDeleteFromButton() : false;">Delete</button>
                <button class="navitem" type="button" id="custnew" onclick="return window.triggerAddNewCustomerFromButton ? window.triggerAddNewCustomerFromButton() : false;">Add New</button>
            </div>
        }
        else
        {
            <input class="navitem" type="submit" id="custsave" value="Save" />
            <div id="customerActions" style="display:none;"></div>
        }
    </div>
     </div>
     <script type='text/javascript'>
         (function () {
             function getValue(id) {
                 var element = document.getElementById(id);
                 return element && element.value ? element.value : "";
             }

              function clearPhoneValidationState() {
                  var phone = document.getElementById("phoneNumber");
                  var error = document.getElementById("phoneError");
                  if (phone) {
                      phone.dataset.phoneValidated = "";
                      phone.classList.remove("input-validation-error");
                  }
                  if (error) error.style.display = "none";
              }

              function setPhoneValidationError(message) {
                  var phone = document.getElementById("phoneNumber");
                  var error = document.getElementById("phoneError");
                  if (error) {
                      error.textContent = message || "Unable to validate the phone number. Please try again.";
                      error.style.display = "block";
                  }
                  if (phone) phone.classList.add("input-validation-error");
              }

               function isIndiaPhoneCountry() {
                   var country = document.getElementById("phoneCountryCode");
                   return country && (country.value || "").toUpperCase() === "IN";
               }

               function updatePhoneGuidance() {
                   var country = document.getElementById("phoneCountryCode");
                   var guidance = document.getElementById("phoneGuidanceText");
                   var guidanceCountry = document.getElementById("phoneGuidanceCountry");
                   var phone = document.getElementById("phoneNumber");
                   if (!country || !guidance || !guidanceCountry) return;

                   var selected = country.options[country.selectedIndex];
                   var countryName = selected ? (selected.textContent || "").replace(/^\S+\s+/, "").replace(/\s*\([^)]*\)\s*$/, "").trim() : "selected country";
                   var flag = selected ? (selected.textContent || "").split(/\s+/)[0] : "";
                   var callingCode = selected ? (selected.getAttribute("data-calling-code") || "") : "";
                   var countryValue = (country.value || "").toUpperCase();
                   var examples = {
                       US: "202 555 0125",
                       GB: "020 7946 0018",
                       CA: "416 555 0123",
                       AU: "02 9374 4000",
                       AE: "04 123 4567"
                   };
                   var example = examples[countryValue] || "local number";
                   var placeholder = countryValue === "IN" ? "10-digit mobile number" : "Local number, e.g. " + example;
                   if (phone) phone.placeholder = placeholder;
                   guidanceCountry.textContent = flag + " " + countryName + (callingCode ? " (" + callingCode + ")" : "");

                   if (countryValue === "IN") {
                       guidance.textContent = "Enter 10 digits starting with 6, 7, 8, or 9. You may also enter a number with +91.";
                       return;
                   }

                   guidance.textContent = callingCode
                       ? "Enter the local number for " + countryName + " without " + callingCode + ". Example: " + example + "."
                       : "Enter the local phone number for " + countryName + ". Include the country code only in the selector.";
               }

               function validatePhoneInput() {
                   var phone = document.getElementById("phoneNumber");
                   if (!phone) return false;

                   var phoneValue = phone.value.trim();
                   if (!phoneValue) {
                       clearPhoneValidationState();
                       return true;
                   }

                    var indiaPhoneValue = phoneValue.indexOf("+91") === 0 ? phoneValue.substring(3) : phoneValue;
                    if (isIndiaPhoneCountry() && !/^[6-9][0-9]{9}$/.test(indiaPhoneValue)) {
                       setPhoneValidationError("Enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.");
                       return false;
                   }

                   clearPhoneValidationState();
                   return true;
               }

              function validatePhoneOnSave() {
                  var phone = document.getElementById("phoneNumber");
                  var country = document.getElementById("phoneCountryCode");
                  if (!phone || !country) {
                      return Promise.reject(new Error("Phone validation controls are unavailable."));
                  }

                  var phoneValue = phone.value.trim();
                  if (!phoneValue) {
                      clearPhoneValidationState();
                      return Promise.resolve(true);
                  }
                    var indiaPhoneValue = phoneValue.indexOf("+91") === 0 ? phoneValue.substring(3) : phoneValue;
                    if (isIndiaPhoneCountry() && !/^[6-9][0-9]{9}$/.test(indiaPhoneValue)) {
                       setPhoneValidationError("Enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.");
                      return Promise.resolve(false);
                  }
                  var countryValue = country.value;
                  var controller = typeof AbortController === "function" ? new AbortController() : null;
                  var timeout = controller ? setTimeout(function () { controller.abort(); }, 10000) : null;
                  var url = '@Url.Action("ValidatePhone", "Customer")'
                      + '?phone=' + encodeURIComponent(phoneValue)
                      + '&countryIso2=' + encodeURIComponent(countryValue);

                  return fetch(url, {
                      headers: { "X-Requested-With": "XMLHttpRequest" },
                      signal: controller ? controller.signal : undefined
                  })
                      .then(function (response) {
                          if (!response.ok) throw new Error("Phone validation service unavailable.");
                          return response.json();
                      })
                      .then(function (result) {
                          if (!result || result.isValid !== true || !result.normalizedNumber) {
                              setPhoneValidationError(result && result.message);
                              return false;
                          }

                          phone.value = result.localNumber || phoneValue;
                          phone.dataset.phoneValidated = phone.value + "|" + countryValue;
                          var error = document.getElementById("phoneError");
                          if (error) error.style.display = "none";
                          phone.classList.remove("input-validation-error");
                          return true;
                      })
                      .catch(function (error) {
                          setPhoneValidationError(error && error.name === "AbortError"
                              ? "Phone validation timed out. Please try again."
                              : "Unable to validate the phone number. Please try again.");
                          return false;
                      })
                      .then(function (result) {
                          if (timeout) clearTimeout(timeout);
                          return result;
                      });
              }

             function setValue(id, value) {
                 var element = document.getElementById(id);
                 if (element) {
                     element.value = value || "";
                 }
             }

             function setText(id, value) {
                 var element = document.getElementById(id);
                 if (element) {
                      if ("value" in element) {
                          element.value = value || "";
                      } else {
                          element.textContent = value || "";
                      }
                 }
             }

             function setDisabled(id, disabled) {
                 var element = document.getElementById(id);
                 if (element) {
                     element.disabled = !!disabled;
                 }
             }

             function navigateToDashboard() {
                 window.location.href = '@Url.Action("Index", "Dashboard")';
             }

             function showToast(message, isSuccess) {
                 var toast = document.getElementById("customerToast");
                 if (!toast) {
                     window.alert(message || "Operation completed.");
                     return;
                 }

                 toast.classList.remove("success", "error");
                 toast.classList.add(isSuccess ? "success" : "error");
                 toast.textContent = message || "Operation completed.";
                 toast.style.display = "block";

                 if (window.__customerToastTimer) {
                     clearTimeout(window.__customerToastTimer);
                 }

                 window.__customerToastTimer = setTimeout(function () {
                     toast.style.display = "none";
                 }, 3200);
             }

             function resetCustomerFormToCreateMode() {
                ["name", "address", "barCode", "phoneNumber", "email"].forEach(function (id) {
                     setValue(id, "");
                 });

                 setValue("customerCodeHidden", "");
                 setText("customerCodeValue", "Auto-generated on Save");
                 var country = document.getElementById("phoneCountryCode");
                 if (country && '@defaultPhoneCountry') country.value = '@defaultPhoneCountry';

                 var saveButton = document.getElementById("custsave");
                 if (saveButton) {
                     saveButton.style.display = "inline-flex";
                     saveButton.disabled = false;
                 }

                 var actionContainer = document.getElementById("customerActions");
                 if (actionContainer) {
                     actionContainer.style.display = "none";
                 }

                 ["nameError", "addressError", "phoneError", "emailError"].forEach(function (id) {
                     var errorElement = document.getElementById(id);
                     if (errorElement) {
                         errorElement.style.display = "none";
                     }
                 });

                 ["name", "address", "phoneNumber", "email"].forEach(function (id) {
                     var input = document.getElementById(id);
                     if (input) {
                         input.classList.remove("input-validation-error");
                     }
                 });
             }

             function validateCustomerFields() {
                 var isValid = true;
                 var customerName = (getValue("name") || "").trim();
                 var address = (getValue("address") || "").trim();
                  var phoneNumber = getValue("phoneNumber") || "";
                 var email = getValue("email") || "";
                 var emailPattern = /^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/;
                // Read preferences cached on DOM load (if available)
                var prefs = window.__customerPreferences || null;

                 ["nameError", "addressError", "phoneError", "emailError"].forEach(function (id) {
                     var errorElement = document.getElementById(id);
                     if (errorElement) {
                         errorElement.style.display = "none";
                     }
                 });

                 ["name", "address", "phoneNumber", "email"].forEach(function (id) {
                     var input = document.getElementById(id);
                     if (input) {
                         input.classList.remove("input-validation-error");
                     }
                 });

                 if (!customerName) {
                     var nameError = document.getElementById("nameError");
                     var name = document.getElementById("name");
                     if (nameError) {
                         nameError.style.display = "block";
                     }
                     if (name) {
                         name.classList.add("input-validation-error");
                     }
                     isValid = false;
                 } else {
                     setValue("name", customerName);
                 }

                 if (!address) {
                     var addressError = document.getElementById("addressError");
                     var addressInput = document.getElementById("address");
                     if (addressError) {
                         addressError.style.display = "block";
                     }
                     if (addressInput) {
                         addressInput.classList.add("input-validation-error");
                     }
                     isValid = false;
                 } else {
                     setValue("address", address);
                 }

                  if (!validatePhoneInput()) {
                      isValid = false;
                  }
                var emailRequired = prefs && prefs.RequireEmail;
                if (emailRequired && email.trim().length === 0) {
                    var emailError = document.getElementById("emailError");
                    var emailInput = document.getElementById("email");
                    if (emailError) {
                        emailError.textContent = 'Email is required.';
                        emailError.style.display = "block";
                    }
                    if (emailInput) {
                        emailInput.classList.add("input-validation-error");
                    }
                    isValid = false;
                } else if (email.trim().length > 0) {
                     var normalizedEmail = email.trim();
                     if (!emailPattern.test(normalizedEmail)) {
                         var emailError = document.getElementById("emailError");
                         var emailInput = document.getElementById("email");
                         if (emailError) {
                             emailError.style.display = "block";
                         }
                         if (emailInput) {
                             emailInput.classList.add("input-validation-error");
                         }
                         isValid = false;
                     } else {
                         setValue("email", normalizedEmail);
                     }
                 }

                 return isValid;
             }

             function resolveCustomerCode(done, fail) {
                 var customerCode = (getValue("customerCodeHidden") || "").trim();
                 if (customerCode) {
                     done(customerCode);
                     return;
                 }

                 var customerName = (getValue("name") || "").trim();
                 if (!customerName) {
                     fail("Please enter customer name.");
                     return;
                 }

                 fetch('@Url.Action("GetCustomerByName", "Customer")' + '?customerName=' + encodeURIComponent(customerName), {
                     method: 'GET',
                     headers: {
                         'X-Requested-With': 'XMLHttpRequest'
                     }
                 })
                     .then(function (response) { return response.json(); })
                     .then(function (data) {
                         var resolvedCode = data && data.StatusCode === "200" ? ((data.CustCode || "").trim()) : "";
                         if (!resolvedCode) {
                             fail((data && data.Message) ? data.Message : "Customer not found.");
                             return;
                         }

                         setValue("customerCodeHidden", resolvedCode);
                         setText("customerCodeValue", resolvedCode);
                         done(resolvedCode);
                     })
                     .catch(function () {
                         fail("Unable to identify customer.");
                     });
             }

             function performCustomerDelete() {
                 if (!confirm("Are you sure you want to delete this customer?")) {
                     return false;
                 }

                 setDisabled("custdelete", true);

                 resolveCustomerCode(function (resolvedCode) {
                     var customerName = (getValue("name") || "").trim();
                     var body = new URLSearchParams();
                     body.append("customerCode", resolvedCode);
                     body.append("customerName", customerName);

                     fetch('@Url.Action("DeleteCustomer", "Customer")', {
                         method: 'POST',
                         headers: {
                             'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                             'X-Requested-With': 'XMLHttpRequest'
                         },
                         body: body.toString()
                     })
                         .then(function (response) { return response.json(); })
                         .then(function (response) {
                             if (response && response.success) {
                                 showToast(response.message || "Customer deleted successfully.", true);
                                 resetCustomerFormToCreateMode();
                                 navigateToDashboard();
                                 return;
                             }

                             showToast((response && response.message) || "Failed to delete customer.", false);
                             setDisabled("custdelete", false);
                         })
                         .catch(function (error) {
                             var apiError = (error && error.message) ? ("Failed to delete customer. " + error.message) : "Failed to delete customer.";
                             showToast(apiError, false);
                             setDisabled("custdelete", false);
                         });
                 }, function (message) {
                     showToast(message, false);
                     setDisabled("custdelete", false);
                 });
                    
                 return false;
             }

             function loadExistingCustomerOrders() {
    var panel = document.getElementById("existingCustomerOrders");
    var message = document.getElementById("customerOrdersMessage");
    var tbody = document.getElementById("customerOrdersBody");

    if (!panel || !message || !tbody) return;

    var customerName = (getValue("name") || "").trim();
    var customerCode = (getValue("customerCodeHidden") || "").trim();

    if (!customerName && !customerCode) return;

    panel.style.display = "block";
    message.textContent = "Loading orders...";
    tbody.replaceChildren();

    resolveCustomerCode(function (resolvedCode) {
        fetch('@Url.Action("GetSelectedCustomerOrders", "Customer")', {
            method: "GET",
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error("Unable to load orders");
            }
            return response.json();
        })
        .then(function (data) {
            tbody.replaceChildren();

            if (!data || data.success !== true) {
                message.textContent =
                    (data && data.message) || "Unable to load orders.";
                return;
            }

            var orders = Array.isArray(data.orders)
                ? data.orders : [];

            if (orders.length === 0) {
                message.textContent =
                    "No existing orders found for this customer.";
                return;
            }

            message.textContent = "Orders found: " + orders.length;

            orders.forEach(function (order) {
                var row = document.createElement("tr");

                [
                    order.OrderNo || order.OrderNumber || order.OrderCode,
                    order.InvoiceNo || order.InvoiceNumber,
                    order.CreatedDate || order.OrderDate,
                    order.ServiceName || order.Service,
                    order.Pieces || order.PieceCount,
                    order.NetPayable || order.TotalAmount,
                    order.PaidAmount || order.AdvanceUsed,
                    order.PendingAmount || order.BalanceAmount,
                    order.Status || order.OrderStatus
                ].forEach(function (value) {
                    var cell = document.createElement("td");
                    cell.textContent =
                        value === undefined || value === null || value === ""
                            ? "—"
                            : String(value);
                    row.appendChild(cell);
                });

                tbody.appendChild(row);
            });
        })
        .catch(function () {
            message.textContent =
                "Unable to load customer orders. Please try again.";
        });
    }, function (errorMessage) {
        message.textContent =
            errorMessage || "Please select a customer first.";
    });
}
             function handleCustomerUpdateClick(e) {
                 if (e) {
                     e.preventDefault();
                     e.stopPropagation();
                 }

                 var editButton = document.getElementById("custedit");
                 if (editButton) {
                     editButton.disabled = true;
                 }

                 validatePhoneOnSave().then(function (phoneValid) {
                     if (!phoneValid || !validateCustomerFields()) {
                         showToast("Please correct validation errors before update.", false);
                         if (editButton) editButton.disabled = false;
                         return;
                     }

                     resolveCustomerCode(function (resolvedCode) {
                     var updatePayload = new URLSearchParams();
                     updatePayload.append("CustomerName", getValue("name") || "");
                     updatePayload.append("Address", getValue("address") || "");
                     // MembershipId removed from UI
                     updatePayload.append("BarCode", getValue("barCode") || "");
                     updatePayload.append("PhoneNumber", getValue("phoneNumber") || "");
                      updatePayload.append("PhoneCountryCode", getValue("phoneCountryCode") || "");
                     updatePayload.append("Email", getValue("email") || "");
                     updatePayload.append("customerCode", resolvedCode || "");

                     fetch('@Url.Action("UpdateCustomer", "Customer")', {
                         method: "POST",
                         headers: {
                             "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
                             "X-Requested-With": "XMLHttpRequest"
                         },
                         body: updatePayload.toString()
                     })
                         .then(function (response) { return response.json(); })
                         .then(function (response) {
                             if (response && response.success) {
                                 if (response.customerCode) {
                                     setValue("customerCodeHidden", response.customerCode);
                                     setText("customerCodeValue", response.customerCode);
                                 }
                                 showToast(response.message || "Customer updated successfully.", true);
                                 navigateToDashboard();
                                 return;
                             }

                             showToast((response && response.message) || "Failed to update customer.", false);
                             if (editButton) {
                                 editButton.disabled = false;
                             }
                         })
                         .catch(function (error) {
                             var apiError = (error && error.message)
                                 ? ("Failed to update customer. " + error.message)
                                 : "Failed to update customer.";
                             showToast(apiError, false);
                             if (editButton) {
                                 editButton.disabled = false;
                             }
                         });
                 }, function (message) {
                     showToast(message, false);
                     if (editButton) {
                         editButton.disabled = false;
                     }
                 });

                 return false;
             }

             window.triggerAddNewCustomerFromButton = function () {
                 // If we're already on the Customer Index page, perform a client-side reset to the Create UI
                 // so the user sees the same blank Create screen immediately. Otherwise navigate to the
                 // server AddNewCustomer endpoint which will render a fresh Create view.
                 try {
                     var path = window.location.pathname || "";
                     if (path.indexOf('/Customer/Index') !== -1 || path.match(/\/Customer(\/?$)/i)) {
                         resetCustomerFormToCreateMode();
                         return false;
                     }
                 } catch (e) {
                     // ignore and fallback to server navigation
                 }

                 window.location.href = '@Url.Action("AddNewCustomer", "Customer")';
                 return false;
             };

             window.triggerCustomerUpdateFromButton = function () {
                 return handleCustomerUpdateClick();
             };

             window.triggerCustomerDeleteFromButton = function () {
                 return performCustomerDelete();
             };

            function redirectToSetupCreateOrder(orderMode) {
                if (window.__createOrderRedirectInProgress) {
                    return false;
                }

                var customerName = (getValue("name") || "").trim();
                var customerCode = (getValue("customerCodeHidden") || "").trim();

                if (!customerName) {
                    showToast("Please search/select a customer first.", false);
                    return false;
                }

                window.__createOrderRedirectInProgress = true;

                var navigate = function (resolvedCustomerCode) {
                    var url = '@Url.Action("SetupCreateOrder", "Customer")';
                    var query = [];

                    query.push("customerName=" + encodeURIComponent(customerName));

                    if (resolvedCustomerCode) {
                        query.push("customerCode=" + encodeURIComponent(resolvedCustomerCode));
                    }

                    if (orderMode) {
                        query.push("orderMode=" + encodeURIComponent(orderMode));
                    }

                    if (query.length > 0) {
                        url += "?" + query.join("&");
                    }

                    window.location.href = url;
                };

                var onFailure = function (message) {
                    window.__createOrderRedirectInProgress = false;
                    showToast(message || "Unable to load customer. Please try again.", false);
                };

                if (customerCode) {
                    navigate(customerCode);
                    return false;
                }

                fetch('@Url.Action("GetCustomerByName", "Customer")' + '?customerName=' + encodeURIComponent(customerName), {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data && data.StatusCode === "403") {
                            onFailure(data.Message || "Customer belongs to another store and cannot be accessed.");
                            return;
                        }

                        var resolvedCode = data && data.StatusCode === "200" ? ((data.CustCode || "").trim()) : "";
                        if (!resolvedCode) {
                            var notFoundMessage = (data && data.Message) ? data.Message : "Customer not found. Please select a valid customer first.";
                            onFailure(notFoundMessage);
                            return;
                        }

                        setValue("customerCodeHidden", resolvedCode);
                        setText("customerCodeValue", resolvedCode);
                        navigate(resolvedCode);
                    })
                    .catch(function () {
                        onFailure("Unable to resolve customer code. Please try again.");
                    });

                return false;
            }

            window.triggerCreateOrderPerPiecesFromButton = function () {
                return redirectToSetupCreateOrder("pieces");
            };

            window.triggerCreateOrderPerWeightFromButton = function () {
                return redirectToSetupCreateOrder("weight");
            };

             window.__custEditClick = handleCustomerUpdateClick;
             window.__custDeleteClick = function (e) {
                 if (e) {
                     e.preventDefault();
                     e.stopPropagation();
                 }
                 return performCustomerDelete();
             };

             window.showCustomerToast = showToast;
             window.resetCustomerFormToCreateMode = resetCustomerFormToCreateMode;

             document.addEventListener("DOMContentLoaded", function () {
                var shouldClearCreateFieldsOnFreshLoad = !window.location.search
                    && !window.location.hash
                    && '@(actionMode == "create" ? "true" : "false")' === "true"
                    && !window.customerSaveToastMessage
                    && !window.updateModeToastMessage
                    && !window.updateSearchToastMessage;

                if (shouldClearCreateFieldsOnFreshLoad) {
                    resetCustomerFormToCreateMode();
                }

                // Apply customer preferences driven UI adjustments
                try {
                    var prefsJson = @Html.Raw(ViewData["CustomerPreferences"] ?? "null");
                    if (prefsJson) {
                        var prefs = (typeof prefsJson === 'string') ? JSON.parse(prefsJson) : prefsJson;
                        // cache for validators
                        window.__customerPreferences = prefs || null;
                        var emailLabel = document.querySelector('label[for="email"]');
                        if (emailLabel) emailLabel.textContent = 'Email *';
                        if (prefs && prefs.AutoGenerateCustomerCode) {
                            // hide manual barcode field when auto-generate is enabled
                            var barcodeField = document.getElementById('barCode');
                            if (barcodeField) barcodeField.parentElement.style.display = 'none';
                        }
                    } else {
                        window.__customerPreferences = null;
                    }
                } catch (e) {
                    window.__customerPreferences = null;
                }
                 if (window.updateModeToastMessage) {
                     showToast(window.updateModeToastMessage, true);
                 }

                 if (window.customerSaveToastMessage && !window.__initialSaveToastShown) {
                     showToast("Success! " + window.customerSaveToastMessage, true);
                     window.__initialSaveToastShown = true;
                 }

                 if (window.updateSearchToastMessage) {
                     showToast(window.updateSearchToastMessage, false);
                 }

                 ["name", "address", "phoneNumber", "email"].forEach(function (id) {
                     var element = document.getElementById(id);
                     if (element) {
                         element.addEventListener("input", validateCustomerFields);
                         element.addEventListener("blur", validateCustomerFields);
                     }
                 });
                  var phoneInput = document.getElementById("phoneNumber");
                   if (phoneInput) phoneInput.addEventListener("input", validatePhoneInput);
                  var countrySelect = document.getElementById("phoneCountryCode");
                   if (countrySelect) countrySelect.addEventListener("change", function () {
                       var phone = document.getElementById("phoneNumber");
                       if (phone) clearPhoneValidationState();
                       updatePhoneGuidance();
                       validateCustomerFields();
                   });
                   updatePhoneGuidance();
                  var barcodeScan = document.getElementById("barcodeScan");
                  if (barcodeScan) barcodeScan.addEventListener("click", function () { document.getElementById("barCode").focus(); });

                 var form = document.querySelector(".form");
                 if (form) {
                     form.addEventListener("submit", function (e) {
                          var isCreateMode = '@(actionMode == "create" ? "true" : "false")' === "true";
                          var saveButton = document.getElementById("custsave");

                          if (isCreateMode && !form.dataset.phoneSaveValidationApproved) {
                              e.preventDefault();
                              if (form.dataset.phoneSaveValidationInFlight === "true") return false;

                              form.dataset.phoneSaveValidationInFlight = "true";
                              if (saveButton) {
                                  saveButton.disabled = true;
                                  saveButton.dataset.origValue = saveButton.value || "Save";
                                  saveButton.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>Validating...';
                              }

                              validatePhoneOnSave().then(function (valid) {
                                  if (!valid || !validateCustomerFields()) {
                                      form.dataset.phoneSaveValidationInFlight = "false";
                                      if (saveButton) {
                                          saveButton.disabled = false;
                                          saveButton.innerHTML = saveButton.dataset.origValue || "Save";
                                      }
                                      return;
                                  }

                                  form.dataset.phoneSaveValidationApproved = "true";
                                  form.dataset.phoneSaveValidationInFlight = "false";
                                  form.requestSubmit();
                              });
                              return false;
                          }

                          form.dataset.phoneSaveValidationApproved = "";
                         if (!validateCustomerFields()) {
                             e.preventDefault();
                             return false;
                         }

                         // Only perform AJAX submit for create mode; preserve normal POST for update/delete
                         if (!isCreateMode) {
                             if (saveButton) saveButton.disabled = true;
                             return; // allow normal form submit
                         }

                         // AJAX submit for create
                         e.preventDefault();
                         if (saveButton) {
                            saveButton.disabled = true;
                            try {
                                // show spinner inside the button using CSS class (styles moved to CSS)
                                saveButton.dataset.origValue = saveButton.value || '';
                                saveButton.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span>Processing...';
                            } catch (err) { }
                         }

                         // Collect form values (prefer name attributes generated by Html helpers)
                         var toCollect = [
                              'CustomerName', 'Address', 'BarCode', 'PhoneNumber', 'PhoneCountryCode', 'Email',
                             'customerCode', 'StoreCode', 'TenantName'
                         ];

                         var collectFields = function () {
                             var payload = new URLSearchParams();
                             toCollect.forEach(function (n) {
                                 var el = document.querySelector('[name="' + n + '"]') || document.getElementById(n) || document.getElementById(n.toLowerCase());
                                 var v = el ? (el.value || '') : '';
                                 payload.append(n, v);
                             });
                             return payload;
                         };

                         var payload = collectFields();

                         fetch('@Url.Action("Index", "Customer")', {
                             method: 'POST',
                             headers: {
                                 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                 'X-Requested-With': 'XMLHttpRequest'
                             },
                             body: payload.toString()
                         })
                             .then(function (resp) { return resp.json(); })
                            .then(function (data) {
                                if (data && data.success) {
                                    // display returned customer code if provided
                                    if (data.customerCode) {
                                        setText('customerCodeValue', data.customerCode);
                                        setValue('customerCodeHidden', data.customerCode);
                                    }

                                    // reset other form fields to create state (keep displayed code)
                                    ['name','address','barCode','phoneNumber','email'].forEach(function(id){ setValue(id, ''); });

                                    // If server requested a redirect, navigate immediately (do not show success toast)
                                    if (data.redirect) {
                                        setTimeout(function() {
                                            window.location.href = data.redirect;
                                        }, 800);
                                        return;
                                    }

                                    if (saveButton) saveButton.innerHTML = '<i class="fa fa-check" aria-hidden="true"></i> Saved';
                                    // Show success toast only when not redirecting
                                    if (data.message && data.message.length > 0) {
                                        showToast(data.message, true);
                                    }
                                } else {
                                    showToast((data && data.message) || 'Unable to save customer.', false);
                                }

                                if (saveButton) {
                                    saveButton.disabled = false;
                                    try {
                                        var orig = saveButton.dataset.origValue || 'Save';
                                        saveButton.innerHTML = orig;
                                    } catch (err) { }
                                }
                            })
                             .catch(function () {
                                 showToast('Unable to save customer. Please try again.', false);
                                 if (saveButton) {
                                     saveButton.disabled = false;
                                     try { saveButton.value = 'Save'; } catch (err) { }
                                 }
                             });
                         return false;
                     });
                 }).catch(function () {
                     showToast("Unable to validate the phone number. Please try again.", false);
                     if (editButton) editButton.disabled = false;
                 });
                 return false;
                 }

                 var customerActions = document.getElementById("customerActions");
                 if (customerActions) {
                     customerActions.addEventListener("click", function (e) {
                         if (!e || !e.target) {
                             return;
                         }

                         if (e.target.id === "custedit") {
                             handleCustomerUpdateClick(e);
                         }

                         if (e.target.id === "custdelete") {
                             window.__custDeleteClick(e);
                         }
                     });
                 }

                 var alertStatus = document.getElementById("alertstatus");
                 if (alertStatus) {
                     setTimeout(function () {
                         alertStatus.style.display = "none";
                     }, 2400);
                 }

                 var custEditBtn = document.getElementById("custedit");
                 if (custEditBtn) {
                     custEditBtn.onclick = handleCustomerUpdateClick;
                 }

                 var custDeleteBtn = document.getElementById("custdelete");
                 if (custDeleteBtn) {
                     custDeleteBtn.onclick = window.__custDeleteClick;
                 }

                 var custNewBtn = document.getElementById("custnew");
                 if (custNewBtn) {
                     custNewBtn.addEventListener("click", function (e) {
                         e.preventDefault();
                         window.triggerAddNewCustomerFromButton();
                     });
                 }


                 // NEW: Load existing orders for the selected customer
                  //  loadExistingCustomerOrders();

             });
         })();
    </script>
     }
     </div>
     </div>
     </section>


