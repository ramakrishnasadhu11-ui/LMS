@model LMSWebUI.Models.Customer.CustomerInfoDto 
@{
    ViewData["Title"] = "Customer";
   Layout = "~/Views/Shared/_HeaderMenuItemsLayout.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Add icon library -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<style>
body {font-family: Arial, Helvetica, sans-serif;}
* {box-sizing: border-box;}

.input-container {
  display: -ms-flexbox; /* IE10 */
  display: flex;
  width: 100%;
  margin-bottom: 15px;
}

.icon {
  padding: 10px;
  background: dodgerblue;
  color: white;
  min-width: 50px;
  text-align: center;
}

.input-field {
  width: 100%;
  padding: 10px;
  outline: none;
}
.input1-field {
  width: 50%;
  padding: 10px;
  outline: none;
}
.input2-field {
  width: 25%;
  padding: 10px;
  outline: none;
}
.input-field:focus {
  border: 2px solid dodgerblue;
}
.relative {
            padding: 10px;
            position:fixed;
            margin: 10px;
        }
        
        .navitem {
            display: inline-block;
            width: 100px;
            height: 100px;
            text-align: center;
            border: gray;
            background-color:gainsboro;
            color:black;
            cursor: pointer;
            font-weight: bold;
        }
/* Set a style for the submit button */
.btn {
  background-color: dodgerblue;
  color: white;
  padding: 15px 20px;
  border: none;
  cursor: pointer;
  width: 100%;
  opacity: 0.9;
}

.btn:hover {
  opacity: 1;
}
</style>
</head>
<body>
      @if (TempData["UserMessage"] !=null)
      {
        @using Newtonsoft.Json;
        @if (TempData["UserMessage"] != null)
        {
            var returnmessage =TempData["UserMessage"];
            var message=JsonConvert.DeserializeObject<LMSWebUI.Models.MessageDto>(returnmessage.ToString());
            <div class="input-field">
            <div class="alert @message.CssClassName alert-dismissible fade show" id="alertstatus">
              <button type="button" class="close" data-dismiss="alert">&times;</button>
              <strong style="align-content:center">@message.Title</strong> @message.DisplayMessage.
              </div>
            </div>
            <script type="text/javascript">
                document.getElementById("custsave").hidden = true;
            </script>
        }
      }
     <div class="btn"><b>Customer Create/Update/Delete</b></div>
     @using (Html.BeginForm("AddCustomer","Customer", FormMethod.Post, new { @class = "form" }))
   {
    <form>
  <div class="input-container">
    <i class="fa fa-search icon"></i>
    <input class="input-field" type="text" placeholder="Search Customer here to Edit/Delete a Customer" name="usrnm">
  </div>
  <div class="input-container">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;
    <label class="input1-field"><b>Customer Code</b></label>
    <i class="fa fa-users icon"></i>
    <input class="input2-field" type="text" placeholder="Membership ID" name="membershipid">
    <i class="fa fa-barcode icon"></i>
    <input class="input2-field" type="text" placeholder="Barcode" name="barcode">
  </div>
  <div class="input-container">
   <i class="fa fa-user icon"></i>
   <select class="input2-field" name = "dropdown">
            <option value = "Mr">Mr</option>
            <option value = "Mrs">Mrs</option>
            <option value = "Ms">Ms</option>
            <option value = "Dr">Dr</option>
   </select>
      @Html.TextBoxFor(m => m.CustomerName, new { @placeholder = "Name", @class = "form-control, input2-field", id = "name"})
      <i class="fa fa-birthday-cake icon"></i>
      <input class="input2-field" type="text" placeholder="Birthday" name="birthday">
      <i class="fa fa-birthday-cake icon"></i>
      <input class="input2-field" type="text" placeholder="Anniversary" name="anniversary">
  </div>
  <div class="input-container">
    @*<textarea class="input2-field" placeholder="Address here..."></textarea>*@
      @Html.TextAreaFor(m=> m.Address, new { @placeholder = "Address here...", @class = "form-control, input2-field", id = "address"})
    <textarea class="input2-field" placeholder="Area Location here..."></textarea>
      <i class="fa fa-birthday-cake icon"></i>
      <input class="input2-field" type="text" placeholder="Birthday" name="birthday">
      <i class="fa fa-birthday-cake icon"></i>
      <input class="input2-field" type="text" placeholder="Anniversary" name="anniversary">
  </div>
  <div class="input-container">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input1-field" type="text" placeholder="Pin Code" name="pincode">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Remarks" name="remarks">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Home Delivery" name="homedelivery">
  </div>
  <div class="input-container">
    <i class="fa fa-phone-alt"></i>
    <input class="input2-field" type="text" placeholder="Phone Number" name="pincode">
    <i class="fa fa-envelope icon"></i>
    <input class="input2-field" type="text" placeholder="Email ID" name="emailid">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Marketing Source" name="source">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Phone" name="phone">
  </div>
  <div class="input-container">
    <i class="fa fa-phone-alt"></i>
    <input class="input2-field" type="text" placeholder="Preference" name="preference">
    <i class="fa fa-envelope icon"></i>
    <input class="input2-field" type="text" placeholder="Select Communication Preference" name="communication">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Customer Advance" name="advance">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="OTP" name="otp">
  </div>
  <div class="input-container">
    <i class="fa fa-phone-alt"></i>
    <input class="input1-field" type="text" placeholder="Rate List" name="ratelist">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Facebook Id" name="facebookid">
    <i class="fa fa-birthday-cake icon"></i>
    <input class="input2-field" type="text" placeholder="Registration Source" name="registrationspurce">
  </div>
      <div class="relative">
         <input class="navitem" type="submit"  id="custsave" value="Save" >
         <button class="navitem" type="button" id="custnew">Add New Customer</button>
         <button class="navitem" type="button" id="custedit">Edit</button>
         <button class="navitem" type="button" id="custdelete">Delete</button>
         <button class="navitem" type="button" id="custadvance">Advance Balance Adjustments</button>
         <button class="navitem" type="button" id="custdetails">Customer Details</button>
         <button class="navitem" type="button" id="custpickup">Schedule Pick Up</button>
         <button class="navitem" type="button" id="custdrop">Schedule Drop</button>
         <button class="navitem" type="button" id="custperpiece">Create Order Per Pieces</button>
         <button class="navitem" type="button" id="custperweight">Create Order Per Weight</button>
   </div>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <script type='text/javascript'>
         $("#alertstatus").fadeTo(2000, 500).slideUp(500, function ()
        {
            $("#success-alert").slideUp(500);
         });
        $(document).ready(function () {
            $('#custsave').show();
            $('#custnew').hide();
            $('#custedit').hide();
            $('#custdelete').hide();
            $('#custadvance').hide();
            $('#custdetails').hide();
            $('#custpickup').hide();
            $('#custdrop').hide();
            $('#custperpiece').hide();
            $('#custperweight').hide();
        });
   </script>
    </form>
     }
</body>
</html>


