    function loadCustomerData() {
        if (setupOnly) {
            return;
        }

        var requestId = ++loadCustomerRequestId;

        function parseJsonOrHandleRedirect(response, fallbackMessage) {
            if (!response) {
                throw new Error(fallbackMessage);
            }

            var responseUrl = (response.url || "").toLowerCase();
            var redirectedToLogin = responseUrl.indexOf("/login") >= 0 || responseUrl.indexOf("/account/login") >= 0;

            if (response.status === 302 || (response.redirected && redirectedToLogin)) {
                showToast("Session expired. Redirecting to login...", false);
                if (response.url) {
                    setTimeout(function () {
                        window.location.href = response.url;
                    }, 300);
                }
                throw new Error("Session expired. Please login again.");
            }

            if (!response.ok) {
                throw new Error(fallbackMessage);
            }

            var contentType = (response.headers && response.headers.get("content-type")) || "";
            if (contentType.toLowerCase().indexOf("application/json") === -1) {
                if (redirectedToLogin) {
                    showToast("Session expired. Redirecting to login...", false);
                    if (response.url) {
                        setTimeout(function () {
                            window.location.href = response.url;
                        }, 300);
                    }
                    throw new Error("Session expired. Please login again.");
                }

                throw new Error((fallbackMessage || "Request failed.") + " (Invalid response format)");
            }

            return response.json();
        }

        var customerName = (document.getElementById("customerName").value || "").trim();
        var customerCode = (document.getElementById("custCode").value || "").trim();
        var requestedCustomerName = customerName;
        var requestedCustomerCode = customerCode;
        if (!customerName && !customerCode) {
            updateAvailableAdvanceDisplay(0, "Select a customer to view available advance.");
            showToast("Please enter customer name.", false);
            return;
        }

        updateAvailableAdvanceDisplay(0, "Loading latest advance balance...");

        function loadOrdersForCustomer(nameValue, codeValue) {
            var orderQuery = [];
            if (nameValue) {
                orderQuery.push('customerName=' + encodeURIComponent(nameValue));
            }
            if (codeValue) {
                orderQuery.push('customerCode=' + encodeURIComponent(codeValue));
            }

            if (!orderQuery.length) {
                renderOrdersHistory([]);
                return;
            }

            fetch('@Url.Action("GetCustomerOrders", "Customer")' + '?' + orderQuery.join('&'), {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            })
            .then(function (response) { return parseJsonOrHandleRedirect(response, 'Unable to fetch orders.'); })
            .then(function (orderData) {
                if (!orderData || !orderData.success) {
                    showToast((orderData && orderData.message) || "Unable to fetch orders.", false);
                    renderOrdersHistory([]);
                    return;
                }
                renderOrdersHistory(orderData.orders || []);
            })
            .catch(function (error) {
                showToast((error && error.message) || "Unable to fetch orders.", false);
                renderOrdersHistory([]);
            });
        }

        var advanceQuery = [];
        if (customerName) {
            advanceQuery.push('customerName=' + encodeURIComponent(customerName));
        }
        if (customerCode) {
            advanceQuery.push('customerCode=' + encodeURIComponent(customerCode));
        }

        fetch('@Url.Action("GetCustomerAdvances", "Customer")' + '?' + advanceQuery.join('&'), {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(function (response) { return parseJsonOrHandleRedirect(response, 'Unable to fetch customer advances.'); })
        .then(function (advanceData) {
            if (requestId !== loadCustomerRequestId) {
                return;
            }

            var currentName = (document.getElementById("customerName").value || "").trim();
            var currentCode = (document.getElementById("custCode").value || "").trim();
            if (currentName !== requestedCustomerName || currentCode !== requestedCustomerCode) {
                return;
            }

            if (!advanceData || !advanceData.success) {
                showToast((advanceData && advanceData.message) || "Unable to fetch customer advances. Continuing with 0 advance balance.", false);
                currentAdvanceBalance = 0;
                updateAvailableAdvanceDisplay(0, (advanceData && advanceData.message) || "Unable to retrieve latest advance balance.");
                if (customerCode) {
                    document.getElementById("custCode").value = customerCode;
                    document.getElementById("customerCodeDisplay").value = customerCode;
                }
                loadOrdersForCustomer(customerName, customerCode);
                syncTotals();
                return;
            }

            currentAdvanceBalance = Number(advanceData.balance || 0);
            updateAvailableAdvanceDisplay(currentAdvanceBalance, "");
            document.getElementById("custCode").value = advanceData.customerCode || "";
            document.getElementById("customerCodeDisplay").value = advanceData.customerCode || "";

            var resolvedCustomerCode = (advanceData.customerCode || "").trim();
            loadOrdersForCustomer(customerName, resolvedCustomerCode);

            syncTotals();
        })
        .catch(function (error) {
            if (requestId !== loadCustomerRequestId) {
                return;
            }

            var currentName = (document.getElementById("customerName").value || "").trim();
            var currentCode = (document.getElementById("custCode").value || "").trim();
            if (currentName !== requestedCustomerName || currentCode !== requestedCustomerCode) {
                return;
            }

            showToast((error && error.message) || "Unable to fetch customer advances. Continuing with 0 advance balance.", false);
            currentAdvanceBalance = 0;
            updateAvailableAdvanceDisplay(0, "Unable to retrieve latest advance balance.");
            loadOrdersForCustomer(customerName, customerCode);
            syncTotals();
        });
    }

    function loadOrderReferenceSuggestions() {
        var lookupEl = document.getElementById("orderLookupText");
        var listEl = document.getElementById("orderLookupSuggestions");
        if (!lookupEl || !listEl) {
            return;
        }

        var term = (lookupEl.value || "").trim();
        if (!term || term.length < 2) {
            listEl.innerHTML = "";
            return;
        }

        fetch('@Url.Action("SearchOrderReferences", "Customer")?searchText=' + encodeURIComponent(term) + '&top=20', {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error("Unable to load order suggestions.");
            }
            return response.json();
        })
        .then(function (items) {
            listEl.innerHTML = "";
            if (items && typeof items === 'object' && !Array.isArray(items) && items.success === false) {
                showToast(items.message || "Unable to load order suggestions.", false);
                return;
            }

            (Array.isArray(items) ? items : []).forEach(function (value) {
                if (!value) {
                    return;
                }

                var option = document.createElement("option");
                option.value = value;
                listEl.appendChild(option);
            });
        })
        .catch(function () {
            listEl.innerHTML = "";
        });
    }

    function findOrderReferenceAndLoadCustomer() {
        var lookupEl = document.getElementById("orderLookupText");
        if (!lookupEl) {
            return;
        }

        var term = (lookupEl.value || "").trim();
        if (!term) {
            showToast("Please enter Order No or Invoice No.", false);
            return;
        }

        fetch('@Url.Action("SearchOrderReference", "Customer")?searchText=' + encodeURIComponent(term), {
            method: 'GET',
            credentials: 'same-origin',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error("Unable to find order reference.");
            }
            return response.json();
        })
        .then(function (data) {
            if (!data || !data.success) {
                showToast((data && data.message) || "No order found for given reference.", false);
                return;
            }

            var customerName = (data.customerName || "").trim();
            var customerCode = (data.customerCode || "").trim();

            if (!customerName) {
                showToast("Order found but customer details are missing.", false);
                return;
            }

            document.getElementById("customerName").value = customerName;
            document.getElementById("custCode").value = customerCode;
            document.getElementById("customerCodeDisplay").value = customerCode;

            loadCustomerData();
            showToast("Customer loaded from order reference.", true);
        })
        .catch(function (error) {
            showToast((error && error.message) || "Unable to find order reference.", false);
        });
    }

    function renderAllTabsAndCatalog() {
        if (setupOnly) {
            return;
        }

        if (currentOrderMode === "weight") {
            selectedService = "Wash & Fold";
            selectedCategory = "Household";
            document.getElementById("weightServiceType").value = "Wash & Fold";
            if (!document.getElementById("ratePerKg").value || parseAmount(document.getElementById("ratePerKg").value) <= 0) {
                document.getElementById("ratePerKg").value = "50";
            }
        }

        renderServiceTabs();
        renderCategoryTabs();
        renderCatalogGrid();
        renderSelectedItemPane();
        updateCatalogStats();
        setOrderMode(currentOrderMode);
    }

    function initializeSetupOrderPage() {
        var formEl = document.getElementById("setupOrderForm");
        if (!formEl) {
            return;
        }
        if (formEl.dataset.setupOrderInitialized === "true") {
            return;
        }
        formEl.dataset.setupOrderInitialized = "true";

        // If current user is not an admin, hide or disable price configuration controls
        try {
            if (typeof isAdminUser !== 'undefined' && !isAdminUser) {
                // hide admin buttons
                var hideBtn = function (id) { var el = document.getElementById(id); if (el) el.style.display = 'none'; };
                hideBtn('savePriceConfigBtn');
                hideBtn('removePriceConfigBtn');
                hideBtn('restorePriceConfigBtn');

                // disable inputs that allow editing configuration
                var disableEl = function (id) { var e = document.getElementById(id); if (e) e.disabled = true; };
                disableEl('cfgServiceType');
                disableEl('cfgCategory');
                disableEl('cfgItemName');
                disableEl('cfgItemPicker');
                disableEl('showInactiveItemsChk');
            }
        } catch (ex) {
            // ignore
        }

        if (window.setupOrderToastMessage) {
            showToast(window.setupOrderToastMessage, true);
        }

        var hasValidationErrors = document.querySelector(".validation-summary-errors li, .field-validation-error:not(:empty)") !== null;
        var shouldClearFreshEntryFields = !setupOnly
            && !window.location.search
            && !window.location.hash
            && !window.setupOrderToastMessage
            && !hasValidationErrors;

        if (shouldClearFreshEntryFields) {
            ["customerName", "orderLookupText", "customerCodeDisplay", "custCode", "advanceUsed", "paidNow", "orderHistorySearch"].forEach(function (id) {
                var element = document.getElementById(id);
                if (element) {
                    element.value = "";
                }
            });
        }

        setupPostOrderActions();

        renderSelectedItemPane();
        loadStoreMasters();
        loadConfiguredItems();
        renderOrderLines();

        if (!setupOnly) {
            document.getElementById("modePiecesBtn").onclick = function (e) { e.preventDefault(); setOrderMode("pieces"); };
            document.getElementById("modeWeightBtn").onclick = function (e) { e.preventDefault(); setOrderMode("weight"); };
            document.getElementById("loadOrderDataBtn").onclick = function (e) {
                e.preventDefault();
                var customerName = (document.getElementById("customerName").value || "").trim();
                if (!customerName) {
                    updateAvailableAdvanceDisplay(0, "Select a customer to view available advance.");
                }
                loadCustomerData();
            };
            document.getElementById("findOrderRefBtn").onclick = function (e) { e.preventDefault(); findOrderReferenceAndLoadCustomer(); };
            document.getElementById("orderLookupText")?.addEventListener("input", loadOrderReferenceSuggestions);
            document.getElementById("orderLookupText")?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    findOrderReferenceAndLoadCustomer();
                }
            });

            document.getElementById("qtyPlus").onclick = function (e) {
                e.preventDefault();
                e.stopPropagation();
                var qtyInput = document.getElementById("selectedQty");
                if (!qtyInput) {
                    return;
                }

                var qty = getNormalizedSelectedQty();
                qtyInput.value = qty + 1;
            };

            document.getElementById("qtyMinus").onclick = function (e) {
                e.preventDefault();
                e.stopPropagation();
                var qtyInput = document.getElementById("selectedQty");
                if (!qtyInput) {
                    return;
                }

                var qty = getNormalizedSelectedQty() - 1;
                if (qty < 1) {
                    qty = 1;
                }

                qtyInput.value = qty;
            };

            document.getElementById("addItemBtn").onclick = function (e) {
                e.preventDefault();
                e.stopPropagation();
                addSelectedItemToOrder();
            };
            document.getElementById("orderHistorySearch")?.addEventListener("input", applyOrderHistorySearch);
            document.getElementById("advanceUsed").addEventListener("input", syncTotals);
            document.getElementById("paidNow").addEventListener("input", syncTotals);
            document.getElementById("weightInKg").addEventListener("input", syncTotals);
            document.getElementById("ratePerKg").addEventListener("input", syncTotals);
            document.getElementById("weightServiceType").addEventListener("change", syncTotals);

            var customerNameInput = document.getElementById("customerName");
            if (customerNameInput) {
                customerNameInput.addEventListener("input", function () {
                    var selectedName = (customerNameInput.value || "").trim();
                    var custCodeEl = document.getElementById("custCode");
                    var custCodeDisplayEl = document.getElementById("customerCodeDisplay");

                    loadCustomerRequestId++;

                    if (custCodeEl) {
                        custCodeEl.value = "";
                    }

                    if (custCodeDisplayEl) {
                        custCodeDisplayEl.value = "";
                    }

                    currentAdvanceBalance = 0;
                    if (selectedName) {
                        updateAvailableAdvanceDisplay(0, "Select a valid customer and click Load Customer Details.");
                        loadOrdersForCustomer(selectedName, "");
                        syncTotals();
                    } else {
                        updateAvailableAdvanceDisplay(0, "Select a customer to view available advance.");
                        renderOrdersHistory([]);
                        syncTotals();
                    }
                });
            }

            var form = document.getElementById("setupOrderForm");
            form.addEventListener("submit", function (e) {
                var itemsPayloadInput = document.getElementById("orderItemsJson");
                if (itemsPayloadInput) {
                    var payloadItems = orderLines.map(function (line) {
                        return {
                            serviceType: line.service || selectedService,
                            category: line.category || selectedCategory,
                            itemName: line.name,
                            unitPrice: Number(line.price || 0),
                            quantity: Number(line.qty || 0)
                        };
                    });
                    itemsPayloadInput.value = JSON.stringify(payloadItems);
                }

                var createOrderBtn = document.getElementById("createOrderBtn");
                var customerName = (document.getElementById("customerName").value || "").trim();
                if (!customerName) {
                    e.preventDefault();
                    showToast("Please enter customer name and click Load Customer.", false);
                    return;
                }

                // Allow submit even if customer code is not preloaded.
                // Server-side action already resolves CustCode from customer name when possible.

                if (currentOrderMode === "pieces" && !orderLines.length) {
                    e.preventDefault();
                    showToast("Please add at least one garment item to Order Lines before submitting.", false);
                    return;
                }

                if (currentOrderMode === "weight") {
                    var weight = parseAmount(document.getElementById("weightInKg").value);
                    var rate = parseAmount(document.getElementById("ratePerKg").value);

                    if (weight <= 0) { e.preventDefault(); showToast("Weight should be greater than zero.", false); return; }
                    if (rate <= 0) { e.preventDefault(); showToast("Rate per kg should be greater than zero.", false); return; }

                    document.getElementById("serviceType").value = document.getElementById("weightServiceType").value;
                }

                // Always refresh totals right before validation to avoid stale hidden-field values.
                syncTotals();

                var orderAmountValue = computeOrderAmount();
                if (orderAmountValue <= 0) {
                    e.preventDefault();
                    showToast("Order amount is zero. Please add items or valid weight/rate before submit.", false);
                    return;
                }

                // Enforce store payment policy: if partial payments are not allowed then Net Payable must be zero
                // i.e., the customer's advance must cover the total before creating the order.
                var net = parseAmount(document.getElementById("netPayableInput").value || 0);
                if (!allowPartialPayment && net > 0) {
                    e.preventDefault();
                    showToast("Partial payments are disabled for this store. Please use customer's advance or collect full payment before creating the order.", false);
                    if (createOrderBtn) {
                        createOrderBtn.disabled = false;
                        createOrderBtn.textContent = "Create Order";
                    }
                    return;
                }

                var notesBox = document.getElementById("notes");
                var autoSummary = buildItemSummaryText();
                if (autoSummary) {
                    var existing = (notesBox.value || "").trim();
                    notesBox.value = existing ? (existing + " | Items: " + autoSummary) : ("Items: " + autoSummary);
                }

                if (createOrderBtn) {
                    createOrderBtn.disabled = true;
                    createOrderBtn.textContent = "Submitting...";
                }

                showToast("Submitting order. Please wait...", true);
            });

            var hasCustomer = document.getElementById("customerName") && document.getElementById("customerName").value;
            if (hasCustomer) {
                updateAvailableAdvanceDisplay(0, "Loading latest advance balance...");
                loadCustomerData();
            } else {
                updateAvailableAdvanceDisplay(0, "Select a customer to view available advance.");
            }
        }

        document.getElementById("savePriceConfigBtn")?.addEventListener("click", function (e) { e.preventDefault(); saveConfiguredItemPrice(); });
        document.getElementById("removePriceConfigBtn")?.addEventListener("click", function (e) { e.preventDefault(); removeConfiguredItemPrice(); });
        document.getElementById("restorePriceConfigBtn")?.addEventListener("click", function (e) { e.preventDefault(); restoreConfiguredItemPrice(); });
        document.getElementById("cfgServiceType")?.addEventListener("change", function () {
            refreshCategoryOptionsForSelectedService();
            resetConfigItemSelection();
            updateConfigItemSuggestions();
            applySuggestedPrice();
        });
        document.getElementById("cfgCategory")?.addEventListener("change", function () {
            resetConfigItemSelection();
            updateConfigItemSuggestions();
            applySuggestedPrice();
        });
        var inactiveChk = document.getElementById("showInactiveItemsChk");
        if (inactiveChk) {
            inactiveChk.addEventListener("change", onInactiveToggleChanged);
        }
        document.getElementById("cfgItemName")?.addEventListener("input", applySuggestedPrice);
        document.getElementById("cfgItemName")?.addEventListener("change", applySuggestedPrice);
        document.getElementById("cfgItemPicker")?.addEventListener("change", function () {
            var selectedKey = (this.value || "").trim();
            if (!selectedKey || !cfgPickerEntriesByKey[selectedKey]) {
                return;
            }

            var selected = cfgPickerEntriesByKey[selectedKey];
            var serviceEl = document.getElementById("cfgServiceType");
            var categoryEl = document.getElementById("cfgCategory");

            if (serviceEl && selected.service) {
                serviceEl.value = selected.service;
            }
            if (categoryEl && selected.category) {
                categoryEl.value = selected.category;
            }

            document.getElementById("cfgItemName").value = selected.name || "";
            applySuggestedPrice();
        });

        window.addEventListener("hashchange", function () {
            setTimeout(focusAnchorTargetFromHash, 40);
        });
        setTimeout(focusAnchorTargetFromHash, 120);

    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initializeSetupOrderPage);
    } else {
        initializeSetupOrderPage();
    }
})();
</script>
