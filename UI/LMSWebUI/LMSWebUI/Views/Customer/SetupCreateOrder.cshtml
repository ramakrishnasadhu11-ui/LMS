    function loadStoreMasters() {
        var url = '@Url.Action("GetStoreMasters", "Customer")?includeInactive=false&_ts=' + Date.now();

        return fetch(url, {
            method: 'GET',
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error("Unable to load store master data.");
            }
            return response.json();
        })
        .then(function (data) {
            var serviceTypes = (data && data.success) ? (data.serviceTypes || data.ServiceTypes || []) : [];
            masterItems = (data && data.success) ? (data.items || data.Items || []) : [];

            fillMasterSelect("cfgServiceType", serviceTypes, "Select service type", "No service types configured");
            refreshCategoryOptionsForSelectedService();
            updateConfigItemSuggestions();
        })
        .catch(function () {
            masterItems = [];
            fillMasterSelect("cfgServiceType", [], "Select service type", "No service types configured");
            refreshCategoryOptionsForSelectedService();
        });
    }

    function updateConfigItemSuggestions() {
        var serviceTypeEl = document.getElementById("cfgServiceType");
        var categoryEl = document.getElementById("cfgCategory");
        var datalist = document.getElementById("cfgItemNameSuggestions");
        var picker = document.getElementById("cfgItemPicker");

        // Non-admin users do not render the price-config block, so these controls can be absent.
        // In that case just skip config suggestion logic.
        if (!serviceTypeEl || !categoryEl || !datalist) {
            cfgPickerEntriesByKey = {};
            return;
        }

        var serviceType = (serviceTypeEl.value || "").trim();
        var category = (categoryEl.value || "").trim();
        var serviceTypeLower = serviceType.toLowerCase();
        var categoryLower = category.toLowerCase();
        var includeInactive = !!(document.getElementById("showInactiveItemsChk") && document.getElementById("showInactiveItemsChk").checked);

        var scopeSelected = !!serviceType && !!category;
        var entriesByName = {};
        cfgPickerEntriesByKey = {};

        // Build suggestions strictly from configured price rows in this scope.
        // Skipped entirely until a scope is chosen, otherwise rows from different
        // service/category combinations would collapse onto the same item name.
        if (scopeSelected) {
            configuredItems.forEach(function (item) {
                var itemService = (item.ServiceType || item.serviceType || "").trim();
                var itemCategory = (item.Category || item.category || "").trim();
                var itemName = (item.ItemName || item.itemName || "").trim();
                if (!itemName) {
                    return;
                }

                if (itemService.toLowerCase() !== serviceTypeLower || itemCategory.toLowerCase() !== categoryLower) {
                    return;
                }

                var isActive = !!(item.IsActive ?? item.isActive ?? true);
                if (includeInactive !== !isActive) {
                    return;
                }

                entriesByName[itemName.toLowerCase()] = {
                    service: itemService,
                    category: itemCategory,
                    name: itemName,
                    price: parseAmount(item.UnitPrice || item.unitPrice || 0),
                    isActive: isActive,
                    hasPrice: true
                };
            });
        }

        datalist.innerHTML = "";
        if (picker) {
            picker.innerHTML = scopeSelected
                ? "<option value=''>Select item from list</option>"
                : "<option value=''>Select service type and category first</option>";
        }

        Object.keys(entriesByName).sort().forEach(function (key) {
            var entry = entriesByName[key];
            entry.pickerKey = [entry.service, entry.category, entry.name, entry.isActive ? "1" : "0"].join("|");

            var statusLabel = entry.hasPrice
                ? (entry.isActive ? "Priced" : "Inactive")
                : "No price set";

            var opt = document.createElement("option");
            opt.value = entry.name;
            opt.label = entry.price > 0
                ? (entry.name + " (" + entry.price.toFixed(2) + ", " + statusLabel + ")")
                : (entry.name + " (" + statusLabel + ")");
            datalist.appendChild(opt);

            if (picker) {
                var selectOpt = document.createElement("option");
                selectOpt.value = entry.pickerKey;
                selectOpt.textContent = entry.name
                    + " - " + statusLabel
                    + (entry.price > 0 ? (", " + entry.price.toFixed(2)) : "");
                picker.appendChild(selectOpt);
                cfgPickerEntriesByKey[entry.pickerKey] = entry;
            }
        });

        var hintText;
        if (!scopeSelected) {
            hintText = "Select a service type and category to see its items.";
        } else if (!Object.keys(entriesByName).length) {
            hintText = includeInactive
                ? ("No inactive items for " + serviceType + " / " + category + ".")
                : ("No active priced items found for " + serviceType + " / " + category + ".");
        } else {
            hintText = includeInactive
                ? ("Showing inactive items for " + serviceType + " / " + category + ".")
                : ("Showing active priced items for " + serviceType + " / " + category + ".");
        }

        var hintEl = document.getElementById("cfgItemNameHint");
        if (hintEl) {
            hintEl.textContent = hintText;
        }
    }

    function applySuggestedPrice() {
        var serviceTypeEl = document.getElementById("cfgServiceType");
        var categoryEl = document.getElementById("cfgCategory");
        var itemNameEl = document.getElementById("cfgItemName");
        if (!serviceTypeEl || !categoryEl || !itemNameEl) {
            return;
        }

        var serviceType = (serviceTypeEl.value || "").trim();
        var category = (categoryEl.value || "").trim();
        var serviceTypeLower = serviceType.toLowerCase();
        var categoryLower = category.toLowerCase();
        var itemName = (itemNameEl.value || "").trim();
        var priceInput = document.getElementById("cfgUnitPrice");
        if (!itemName) {
            return;
        }

        var searchName = itemName.toLowerCase();

        // Only ever match within the selected service type + category so the same item name
        // under a different scope can never pull in the wrong price.
        var matched = configuredItems.find(function (item) {
            return (item.ServiceType || item.serviceType || "").trim().toLowerCase() === serviceTypeLower
                && (item.Category || item.category || "").trim().toLowerCase() === categoryLower
                && (item.ItemName || item.itemName || "").trim().toLowerCase() === searchName;
        });

        if (matched) {
            var price = parseAmount(matched.UnitPrice || matched.unitPrice || 0);
            if (priceInput) {
                priceInput.value = price > 0 ? price.toFixed(2) : "";
            }
        } else if (priceInput) {
            // Item has no price yet for this scope; clear any leftover value from a previous item.
            priceInput.value = "";
        }
    }

    function saveConfiguredItemPrice() {
        var serviceType = (document.getElementById("cfgServiceType").value || "").trim();
