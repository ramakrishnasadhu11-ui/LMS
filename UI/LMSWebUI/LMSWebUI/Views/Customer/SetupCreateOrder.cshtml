        tbody.querySelectorAll('.settle-row-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetOrderNo = (btn.getAttribute('data-order-no') || '').trim();
                var pendingValue = parseAmount(btn.getAttribute('data-pending') || 0);
                var paymentModeValue = (btn.getAttribute('data-mode') || 'Cash').trim() || 'Cash';

                if (!targetOrderNo || pendingValue <= 0) {
                    showToast('No pending amount available for this order.', false);
                    return;
                }

                var amountText = window.prompt('Enter settle amount for order ' + targetOrderNo + ' (max ' + pendingValue.toFixed(2) + '):', pendingValue.toFixed(2));
                if (amountText === null) {
                    return;
                }

                var paidAmount = parseAmount(amountText);
                if (paidAmount <= 0 || paidAmount > pendingValue) {
                    showToast('Settle amount must be greater than zero and not more than pending amount.', false);
                    return;
                }

                var body = new URLSearchParams();
                body.append('orderNo', targetOrderNo);
                body.append('paidAmount', paidAmount.toFixed(2));
                body.append('paymentMode', paymentModeValue);
                body.append('notes', 'Settled from order history row');

                btn.disabled = true;
                btn.textContent = 'Settling...';

                fetch('@Url.Action("SettleOrderPendingPayment", "Customer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: body.toString()
                })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data || !data.success || !data.order) {
                        showToast((data && data.message) || 'Unable to settle pending payment.', false);
                        return;
                    }

                    var updatedOrder = data.order;
                    orderHistoryCache = (orderHistoryCache || []).map(function (item) {
                        var itemOrderNo = (item.OrderNo || item.orderNo || '').toString();
                        if (itemOrderNo.toLowerCase() !== targetOrderNo.toLowerCase()) {
                            return item;
                        }

                        item.PendingAmount = Number(updatedOrder.PendingAmount || updatedOrder.pendingAmount || updatedOrder.NetPayable || updatedOrder.netPayable || 0);
                        item.pendingAmount = item.PendingAmount;
                        item.NetPayable = Number(updatedOrder.NetPayable || updatedOrder.netPayable || 0);
                        item.netPayable = item.NetPayable;
                        item.PaidNow = Number(updatedOrder.PaidNow || updatedOrder.paidNow || 0);
                        item.paidNow = item.PaidNow;
                        item.PaymentMode = updatedOrder.PaymentMode || updatedOrder.paymentMode || paymentModeValue;
                        item.paymentMode = item.PaymentMode;
                        return item;
                    });

                    applyOrderHistorySearch();
                    showToast(data.message || 'Payment updated.', true);
                })
                .catch(function () {
                    showToast('Unable to settle pending payment.', false);
