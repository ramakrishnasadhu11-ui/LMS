    function applyOrderHistorySearch() {
        if (setupOnly) {
            return;
        }

        var searchEl = document.getElementById("orderHistorySearch");
        var term = (searchEl && searchEl.value ? searchEl.value : "").trim().toLowerCase();
        if (!term) {
            renderOrdersHistoryRows(orderHistoryCache);
            return;
        }

        var filtered = (orderHistoryCache || []).filter(function (order) {
            var orderNo = (order.OrderNo || order.orderNo || "").toString().toLowerCase();
            var invoiceNo = (order.InvoiceNo || order.invoiceNo || "").toString().toLowerCase();
            return orderNo.indexOf(term) >= 0 || invoiceNo.indexOf(term) >= 0;
        });

        renderOrdersHistoryRows(filtered);
    }

    function renderOrdersHistory(orders) {
        orderHistoryCache = Array.isArray(orders) ? orders : [];
        applyOrderHistorySearch();
    }

    function setupPostOrderActions() {
        if (setupOnly || !window.orderCompletionContext) {
            return;
        }

        var ctx = window.orderCompletionContext;
        var orderNo = (ctx.orderNo || ctx.OrderNo || "").toString();
        var invoiceNo = (ctx.invoiceNo || ctx.InvoiceNo || orderNo || "").toString();
        var customerEmail = (ctx.customerEmail || ctx.CustomerEmail || "").toString();
        if (!orderNo) {
            return;
        }

        ctx.orderNo = orderNo;
        ctx.invoiceNo = invoiceNo;
        ctx.customerEmail = customerEmail;

        var actionBox = document.getElementById("postOrderActions");
        var info = document.getElementById("postOrderInfo");
        var emailStatus = document.getElementById("billEmailStatus");
        var settleBlock = document.getElementById("paymentSettlementBlock");
        var settleStatus = document.getElementById("settlePaymentStatus");
        var settleAmountInput = document.getElementById("settlePaidAmount");
        var settleModeInput = document.getElementById("settlePaymentMode");
        var settleBtn = document.getElementById("settlePaymentBtn");
        if (!actionBox) {
            return;
        }

        var pendingAmount = Number(ctx.pendingAmount ?? ctx.PendingAmount ?? ctx.netPayable ?? ctx.NetPayable ?? 0);

        actionBox.style.display = "block";
        if (info) {
            var infoText = "Order " + orderNo + " created. Invoice " + invoiceNo + ".";
            if (pendingAmount > 0) {
                infoText += " Pending: " + pendingAmount.toFixed(2);
            }
            info.textContent = infoText;
        }

        if (settleModeInput) {
            settleModeInput.value = (ctx.paymentMode || ctx.PaymentMode || "Cash");
        }

        if (settleBlock && settleAmountInput && settleBtn) {
            if (pendingAmount > 0) {
                settleBlock.style.display = "block";
                settleAmountInput.value = pendingAmount.toFixed(2);
                settleAmountInput.max = pendingAmount.toFixed(2);
            } else {
                settleBlock.style.display = "none";
            }

            settleBtn.onclick = function () {
                var defaultAmount = parseAmount(settleAmountInput.value || pendingAmount || 0);
                if (defaultAmount <= 0) {
                    defaultAmount = pendingAmount;
                }

                var amountText = window.prompt(
                    "Enter settle amount for order " + (ctx.orderNo || "") + " (max " + pendingAmount.toFixed(2) + "): ",
                    defaultAmount.toFixed(2)
                );

                if (amountText === null) {
                    return;
                }

                var amount = parseAmount(amountText);
                if (amount <= 0) {
                    showToast("Enter a valid settle amount.", false);
                    return;
                }

                if (amount > pendingAmount) {
                    showToast("Settle amount cannot exceed pending amount.", false);
                    return;
                }

                settleAmountInput.value = amount.toFixed(2);

                var body = new URLSearchParams();
                body.append('orderNo', ctx.orderNo || '');
                body.append('paidAmount', amount.toFixed(2));
                body.append('paymentMode', settleModeInput ? (settleModeInput.value || 'Cash') : 'Cash');
                body.append('notes', 'Settled from setup order screen');

                settleBtn.disabled = true;
                settleBtn.textContent = 'Settling...';

                fetch('@Url.Action("SettleOrderPendingPayment", "Customer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: body.toString()
                })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data || !data.success || !data.order) {
                        var msg = (data && data.message) || 'Unable to settle pending payment.';
                        if (settleStatus) {
                            settleStatus.textContent = msg;
                        }
                        showToast(msg, false);
                        return;
                    }

                    var order = data.order;
                    ctx.pendingAmount = Number(order.PendingAmount || order.pendingAmount || order.NetPayable || order.netPayable || 0);
                    ctx.PendingAmount = ctx.pendingAmount;
                    ctx.netPayable = Number(order.NetPayable || order.netPayable || 0);
                    ctx.NetPayable = ctx.netPayable;
                    ctx.paidNow = Number(order.PaidNow || order.paidNow || 0);
                    ctx.PaidNow = ctx.paidNow;
                    ctx.paymentMode = order.PaymentMode || order.paymentMode || (settleModeInput ? settleModeInput.value : 'Cash');
                    ctx.PaymentMode = ctx.paymentMode;

                    pendingAmount = ctx.pendingAmount;

                    orderHistoryCache = (orderHistoryCache || []).map(function (item) {
                        var itemOrderNo = (item.OrderNo || item.orderNo || '').toString();
                        if (itemOrderNo.toLowerCase() !== orderNo.toLowerCase()) {
                            return item;
                        }

                        item.PendingAmount = pendingAmount;
                        item.pendingAmount = pendingAmount;
                        item.NetPayable = ctx.netPayable;
                        item.netPayable = ctx.netPayable;
                        item.PaidNow = ctx.paidNow;
                        item.paidNow = ctx.paidNow;
                        item.PaymentMode = ctx.paymentMode;
                        item.paymentMode = ctx.paymentMode;
                        return item;
                    });
                    applyOrderHistorySearch();

                    if (settleStatus) {
                        settleStatus.textContent = data.message || 'Payment settled successfully.';
                    }
                    showToast(data.message || 'Payment settled successfully.', true);

                    if (pendingAmount > 0) {
                        settleAmountInput.value = pendingAmount.toFixed(2);
                        settleAmountInput.max = pendingAmount.toFixed(2);
                    } else {
                        settleBlock.style.display = 'none';
                    }

                    if (info) {
                        info.textContent = "Order " + orderNo + " created. Invoice " + invoiceNo + "."
                            + (pendingAmount > 0 ? (" Pending: " + pendingAmount.toFixed(2)) : " Payment settled.");
                    }
                })
                .catch(function () {
                    var msg = 'Unable to settle pending payment.';
                    if (settleStatus) {
                        settleStatus.textContent = msg;
                    }
                    showToast(msg, false);
                })
                .finally(function () {
                    settleBtn.disabled = false;
                    settleBtn.textContent = 'Settle';
                });
            };
        }

        var printTagsBtn = document.getElementById("printTagsBtn");
        var printBillBtn = document.getElementById("printBillBtn");
        var downloadPdfBtn = document.getElementById("downloadBillPdfBtn");
        var sendEmailBtn = document.getElementById("sendBillEmailBtn");

        if (printTagsBtn) {
            printTagsBtn.onclick = function () {
                window.open('@Url.Action("PrintOrderTags", "Customer")?orderNo=' + encodeURIComponent(ctx.orderNo), '_blank');
            };
        }

        if (printBillBtn) {
            printBillBtn.onclick = function () {
                window.open('@Url.Action("PrintOrderBill", "Customer")?orderNo=' + encodeURIComponent(ctx.orderNo) + '&autoPrint=true', '_blank');
            };
        }

        if (downloadPdfBtn) {
            downloadPdfBtn.onclick = function () {
                window.open('@Url.Action("DownloadOrderBillPdf", "Customer")?orderNo=' + encodeURIComponent(ctx.orderNo), '_blank');
            };
        }

        if (sendEmailBtn) {
            sendEmailBtn.onclick = function () {
                if (!window.confirm('Send bill to customer email now?')) {
                    return;
                }

                var email = (ctx.customerEmail || "").trim();
                if (!email) {
                    email = (window.prompt('Customer email is missing. Please enter email to continue:', '') || '').trim();
                    if (!email) {
                        if (emailStatus) {
                            emailStatus.textContent = 'Email sending skipped. Customer email not provided.';
                        }
                        return;
                    }
                }

                var body = new URLSearchParams();
                body.append('orderNo', ctx.orderNo || '');
                body.append('email', email);

                sendEmailBtn.disabled = true;
                sendEmailBtn.textContent = 'Sending...';

                fetch('@Url.Action("SendOrderBillEmail", "Customer")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: body.toString()
                })
                .then(function (response) { return response.json(); })
                .then(function (data) {
                    if (!data || !data.success) {
                        if (emailStatus) {
                            emailStatus.textContent = (data && data.message) || 'Unable to send bill email.';
                        }
                        return;
                    }

                    ctx.customerEmail = email;
                    if (emailStatus) {
                        emailStatus.textContent = data.message || 'Bill emailed successfully.';
                    }
                })
                .catch(function () {
                    if (emailStatus) {
                        emailStatus.textContent = 'Unable to send bill email.';
                    }
                })
                .finally(function () {
                    sendEmailBtn.disabled = false;
                    sendEmailBtn.textContent = 'Send Bill Email';
                });
            };
        }
    }

    function loadConfiguredItems(showModeToast, includeInactiveOverride) {
        var requestId = ++loadItemsRequestId;
        var includeInactive = !!(document.getElementById("showInactiveItemsChk") && document.getElementById("showInactiveItemsChk").checked);
        if (typeof includeInactiveOverride === "boolean") {
            includeInactive = includeInactiveOverride;
            var inactiveToggleEl = document.getElementById("showInactiveItemsChk");
            if (inactiveToggleEl) {
                inactiveToggleEl.checked = includeInactive;
            }
        }

        var itemsUrl = '@Url.Action("GetLaundryItemPrices", "Customer")'
            + '?includeInactive=' + (includeInactive ? 'true' : 'false')
            + '&_ts=' + Date.now();

        return fetch(itemsUrl, {
            method: 'GET',
            cache: 'no-store',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error("Unable to load laundry item prices.");
            }
            return response.json();
        })
        .then(function (data) {
            if (requestId !== loadItemsRequestId) {
                return;
            }

            if (!data || !data.success) {
                configuredItems = [];
                refreshCategoryOptionsForSelectedService();
                updateConfigItemSuggestions();
                renderAllTabsAndCatalog();
                var message = (data && data.message) || "Unable to load laundry item prices.";
                showToast(message, false);
                return;
            }

            configuredItems = data.items || [];

            refreshCategoryOptionsForSelectedService();
            updateConfigItemSuggestions();
            renderAllTabsAndCatalog();
        })
        .catch(function (error) {
            if (requestId !== loadItemsRequestId) {
                return;
            }

            configuredItems = [];
            refreshCategoryOptionsForSelectedService();
            updateConfigItemSuggestions();
            renderAllTabsAndCatalog();
            showToast((error && error.message) || "Unable to load items for selected filter.", false);
        });
    }

    function fillMasterSelect(selectId, rows, placeholder, emptyText) {
        var select = document.getElementById(selectId);
        if (!select) {
            return;
        }

        var previous = select.value;
        var activeRows = (rows || []).filter(function (row) {
            return !!(row.IsActive ?? row.isActive ?? true);
        });

        select.innerHTML = "";

        var firstOption = document.createElement("option");
        firstOption.value = "";
        firstOption.textContent = activeRows.length ? placeholder : emptyText;
        select.appendChild(firstOption);

        activeRows.forEach(function (row) {
            var name = (row.Name || row.name || "").trim();
            if (!name) {
                return;
            }

            var option = document.createElement("option");
            option.value = name;
            option.textContent = name;
            select.appendChild(option);
        });

        if (previous) {
            select.value = previous;
        }
    }

    function refreshCategoryOptionsForSelectedService() {
        var serviceTypeEl = document.getElementById("cfgServiceType");
        var categoryEl = document.getElementById("cfgCategory");

        if (!serviceTypeEl || !categoryEl) {
            return;
        }

        var selectedService = (serviceTypeEl.value || "").trim().toLowerCase();
        var previousCategory = (categoryEl.value || "").trim();
        var includeInactive = !!(document.getElementById("showInactiveItemsChk") && document.getElementById("showInactiveItemsChk").checked);
        var categories = [];
        var seen = {};

        if (!includeInactive) {
            (masterItems || []).forEach(function (item) {
                if (!(item.IsActive ?? item.isActive ?? true)) {
                    return;
                }

                var itemService = (item.ServiceType || item.serviceType || "").trim().toLowerCase();
                var itemCategory = (item.Category || item.category || "").trim();
                if (!itemCategory) {
                    return;
                }

                if (selectedService && itemService !== selectedService) {
                    return;
                }

                var key = itemCategory.toLowerCase();
                if (seen[key]) {
                    return;
                }

                seen[key] = true;
                categories.push(itemCategory);
            });
        }

        (configuredItems || []).forEach(function (item) {
            var itemService = (item.ServiceType || item.serviceType || "").trim().toLowerCase();
            var itemCategory = (item.Category || item.category || "").trim();
            if (!itemCategory) {
                return;
            }

            if (selectedService && itemService !== selectedService) {
                return;
            }

            var isActive = !!(item.IsActive ?? item.isActive ?? true);
            if (includeInactive !== !isActive) {
                return;
            }

            var key = itemCategory.toLowerCase();
            if (seen[key]) {
                return;
            }

            seen[key] = true;
            categories.push(itemCategory);
        });

        categories.sort(function (a, b) { return a.localeCompare(b); });

        categoryEl.innerHTML = "";

        var firstOption = document.createElement("option");
        firstOption.value = "";
        firstOption.textContent = categories.length ? "Select category" : "No categories configured";
        categoryEl.appendChild(firstOption);

        categories.forEach(function (category) {
            var option = document.createElement("option");
            option.value = category;
            option.textContent = category;
            categoryEl.appendChild(option);
        });

        if (previousCategory && categories.some(function (x) { return x.toLowerCase() === previousCategory.toLowerCase(); })) {
            categoryEl.value = categories.find(function (x) { return x.toLowerCase() === previousCategory.toLowerCase(); }) || "";
        } else {
            categoryEl.value = "";
        }
    }

