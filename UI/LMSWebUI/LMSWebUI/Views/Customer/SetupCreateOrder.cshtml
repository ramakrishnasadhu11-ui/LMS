                : "<span class='order-history-settled'>Settled</span>";
            var actionHtml = "<div class='order-history-actions'>"
                + settleActionHtml
                + "<button type='button' class='order-history-action-btn history-print-bill-btn' data-order-no='" + orderNo + "'>Print Bill</button>"
                + "<button type='button' class='order-history-action-btn history-pdf-btn' data-order-no='" + orderNo + "'>PDF</button>"
                + "<button type='button' class='order-history-action-btn history-email-btn' data-order-no='" + orderNo + "' data-email='" + customerEmail + "'>Email</button>"
                + "<button type='button' class='order-history-action-btn history-tags-btn' data-order-no='" + orderNo + "'>Tags</button>"
                + "</div>";
            var tr = document.createElement("tr");
            tr.innerHTML = "<td>" + orderNo + "</td>"
                + "<td>" + invoiceNo + "</td>"
                + "<td>" + createdDate.toString().replace("T", " ").substring(0, 16) + "</td>"
