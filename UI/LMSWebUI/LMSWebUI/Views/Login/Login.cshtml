@model LMSWebUI.Models.Login.ClientLoginDto
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELS Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/custom.css">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,300,400,500,600,700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="form-body">
        <div class="website-logo">
            <a href="index.html">
                <div class="logo">
                    <img class="logo-size" src="~/Images/els-white.png" alt="">
                </div>
            </a>
        </div>
        <div class="row">
            <div class="img-holder">
                <div class="bg"></div>
                <div class="info-holder">
                    <img src="~/Images/loginimage.png" alt="">
                </div>
            </div>
            <div class="form-holder">
                <div class="form-content">
                    <div class="form-items" style="width: 340px;">
                        <img class="logo-size" src="~/Images/els-blue-web.png" alt="" style="
    width: 180px;margin-bottom: 20px;">
                        <div class="page-links">
                            <a href="@Url.Action("Login", "Login")">Login</a> <a href="@Url.Action("Register", "Login")">Register</a>
                        </div>
                        <form>

                            @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-Mail", @class = "form-control", required = "required", id = "userEmail", @onblur = "return BindClientStores()" })
                            @Html.TextBoxFor(m => m.Password, new { @placeholder = "password", @class = "form-control", required = "required", id="userPassword", @type = "password" })
                            @Html.DropDownList("Store", new  List <SelectListItem>
                            {

                            }, "Select Store")
                            @*<select class="form-control" id="sel1" required="">
            <option>Store Name</option>
            <option>Store Name</option>
            <option>Store Name</option>
            <option>Store Name</option>
        </select>*@
                            <div class="form-button">
                                <button id="submit" type="submit" class="ibtn">Login</button> <a href="#" data-toggle="modal" data-target="#myModal">Forget password?</a>
                            </div>
                        </form>
                        <div class="other-links">
                            <span><i>The best way to manage your Dry cleaning and Laundry business</span></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- popup html -->
    <!-- The Modal -->
    <div class="modal" id="myModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Forgot Your Password?</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    <div class="form-group">
                        <input class="form-control input-lg" placeholder="E-mail Address" name="email" type="email" required> <br>
                        <input class="form-control input-lg" placeholder="New Password" name="email" type="password" required><br>
                        <input class="form-control input-lg" placeholder="Confirm Password" name="email" type="password" required>
                    </div>
                </div>

                <!-- Modal footer -->

                <div class="modal-footer">
                    <button id="submit" type="submit" class="ibtn">Reset my Password</button>

                </div>

            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
        <script type='text/javascript'>
            function BindClientStores() {
                var userEmail = $("#userEmail").get(0).value;
                var url = "/Login/GetAllStoresByClient?clientUrl" + userEmail;
                var model = {
                    'clientUrl': $("#userEmail").get(0).value,
                }

                
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("CheckClientEmail", "Login")',
                    data: model,
                    success: function (data) {
                        alert(data);
                        if (data != null || data > 0 )
                        {
                            $("#userPassword").focus();
                        }
                        else
                        {
                            BootstrapDialog.show({
                                title: 'Warning Alert',
                                message: 'The Email supplied was not found with us, Please Register with us.',
                                buttons: [{
                                    label: 'OK',
                                    cssClass: 'btn btn-success btn-middle',
                                    action: function (dialog) {
                                        dialog.close();
                                    }
                                }]
                            });

                        }
                    },
                    error: function () {
                        BootstrapDialog.show({
                            title: 'Warning Alert',
                            message: 'Error occurred while processing your request.',
                            buttons: [{
                                label: 'OK',
                                cssClass: 'btn btn-success btn-middle',
                                action: function (dialog) {
                                    dialog.close();
                                }
                            }]
                        });
                    }
                });

                @*$.ajax({
                    type: "GET",
                    url: '@Url.Action("GetAllStoresByClient", "Login")',
                    data: model,
                    success: function (data) {
                        if (data != null)
                        {
                            var stores = data.split(',');
                            var mySelect = $('#Store');
                            $.each(stores, function (val, text) {
                                mySelect.append(
                                    $('<option></option>').val(val).html(text)
                                );
                            });
                        }
                    },
                    error: function () {
                        BootstrapDialog.show({
                            title: 'Warning Alert',
                            message: 'Error occurred while processing your request.',
                            buttons: [{
                                label: 'OK',
                                cssClass: 'btn btn-success btn-middle',
                                action: function (dialog) {
                                    dialog.close();
                                }
                            }]
                        });
                    }
                });*@
               }
        </script>
        
    </body>
</html >
