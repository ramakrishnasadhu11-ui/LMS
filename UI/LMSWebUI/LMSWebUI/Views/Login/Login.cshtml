@model LMSWebUI.Models.Login.ClientLoginDto
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELS Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/custom.css">
    <link rel="stylesheet" type="text/css" href="~/css/app-theme.css">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,300,400,500,600,700&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            overflow: hidden;
        }

        .form-body {
            height: 100vh;
            min-height: 0;
        }

        .form-body > .row {
            height: 100vh;
            min-height: 0;
        }

        .form-holder,
        .form-holder .form-content {
            height: 100vh;
            min-height: 0;
        }

        .form-content {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            overflow: auto;
        }

        .form-content .form-items {
            max-height: calc(100vh - 32px);
            overflow-y: auto;
        }

        .login-card {
            width: 380px;
            max-width: 100%;
            padding: 24px 26px;
            border-radius: 14px;
            background: var(--els-surface);
            border: 1px solid var(--els-border);
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
        }

        .login-card-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
        }

        .login-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--els-text);
            margin: 0;
        }

        .login-subtitle {
            font-size: 13px;
            color: var(--els-text-muted, #64748b);
            margin: 4px 0 0;
        }

        .login-card .page-links {
            display: flex;
            gap: 20px;
            border-bottom: 1px solid var(--els-border);
            margin-bottom: 16px;
        }

        .login-card .page-links a {
            position: relative;
            padding-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--els-text-muted, #64748b);
            text-decoration: none;
        }

        .login-card .page-links a.active {
            color: var(--els-primary-dark);
        }

        .login-card .page-links a.active::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 2px;
            background: var(--els-primary);
            border-radius: 2px;
        }
        /* Plain, no-color active tab: keep it simple (no background, no shadow) */
        .login-card .page-links a.professional-active {
            color: inherit !important;
            background: transparent !important;
            /* add a small top border as a subtle, neutral indicator */
            padding: 6px 0 0 !important;
            border-top: 3px solid #9CA3AF; /* neutral gray, avoid green/blue */
            border-radius: 0 !important;
            display: inline-block;
            box-shadow: none !important;
            transform: none !important;
            font-weight: 700;
            box-sizing: border-box;
        }
        .login-card .page-links a.professional-active::after {
            display: none;
        }

        .login-field {
            margin-bottom: 12px;
        }

        .login-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.2px;
            text-transform: uppercase;
            color: var(--els-text-muted, #64748b);
            margin-bottom: 5px;
        }

        .login-card .form-control,
        .login-card select {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            border: 1px solid var(--els-border);
            border-radius: 8px;
            background: var(--els-background);
            color: var(--els-text);
            font-size: 14px;
            box-shadow: none;
        }

        .login-card .form-control:focus,
        .login-card select:focus {
            outline: none;
            border-color: var(--els-primary);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--els-primary) 20%, transparent);
        }

        .login-password-wrap {
            position: relative;
        }

        .login-password-wrap .form-control {
            padding-right: 60px;
        }

        .login-password-toggle {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: var(--els-primary-dark);
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            padding: 4px 6px;
        }

        .login-hint {
            font-size: 12px;
            color: var(--els-text-muted, #64748b);
            margin-top: 6px;
        }

        .login-card .form-button {
            display: flex;
            flex-direction: column;
            gap: 10px;
            align-items: stretch;
            margin-top: 16px;
        }

        .login-card .form-button .ibtn {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .login-card .form-button .ibtn:hover {
            filter: brightness(0.96);
        }

        .login-card .form-button a {
            text-align: center;
            font-size: 13px;
            font-weight: 600;
            color: var(--els-primary-dark);
            text-decoration: none;
        }

        .modal-validation-message {
            display: block;
            margin-top: 6px;
            color: #dc3545;
            font-size: 12px;
            font-weight: 600;
        }

        .login-card .form-button a:hover {
            text-decoration: underline;
        }

        .login-card .other-links {
            margin-top: 16px;
            padding-top: 12px;
            border-top: 1px solid var(--els-border);
            text-align: center;
            font-size: 12px;
            color: var(--els-text-muted, #64748b);
        }

        .login-card button:focus-visible,
        .login-card a:focus-visible,
        .login-card .form-control:focus-visible,
        .login-card select:focus-visible {
            outline: 2px solid var(--els-primary);
            outline-offset: 2px;
        }

        @@media (max-height: 760px) {
            .login-card {
                padding: 18px 22px;
            }

            .login-card-head {
                margin-bottom: 10px;
            }

            .login-subtitle {
                display: none;
            }

            .login-card .other-links {
                display: none;
            }

            .login-field {
                margin-bottom: 10px;
            }
        }
    </style>
</head>
<body>
    <script>
        (function () {
            try {
                var selectedTheme = localStorage.getItem('els-theme');
                if (selectedTheme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            } catch (e) {
                document.documentElement.removeAttribute('data-theme');
            }
        })();
    </script>
