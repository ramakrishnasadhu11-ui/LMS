    </div>
    <!-- popup Forgot Your Password html -->
    <!-- The Modal -->
    <div class="modal" id="ForgotPassword">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Forgot Your Password?</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div class="form-group">
                        @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-Mail", @class = "form-control", required = "required", id = "tenantforgotpasswordEmail", autocomplete = "email", autocapitalize = "none", spellcheck = "false" })
                        <span id="forgotPasswordEmailValidation" class="modal-validation-message" style="display:none;"></span>
                    </div>
                </div>
                <!-- Modal footer -->
                <div class="modal-footer">
                    <button id="forgotpassword" type="submit" class="ibtn">Reset my Password</button>
                    <span id="forgotPasswordProgress" style="display:none; margin-left:10px; font-size:12px; color:var(--els-text-muted, #64748b);">
                        Processing your request...
                    </span>
                </div>
            </div>
        </div>
    </div>


    <!-- popup Change Your Password html -->
    <!-- The Modal -->
    <div class="modal fade" id="ChangePassword">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Change Password</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <lable id="lblOTPInformation"></lable>
                    <div class="form-group">
                        @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-Mail", @class = "form-control", required = "required", id = "changePasswordEmail", autocomplete = "email", autocapitalize = "none", spellcheck = "false" })
                        <span id="changePasswordEmailValidation" class="modal-validation-message" style="display:none;"></span>
                        <div class="login-password-wrap">
                            @Html.TextBoxFor(m => m.OldPassword, new { @placeholder = "Current password", @class = "form-control", required = "required", id = "oldPassword", @type = "password", autocomplete = "current-password" })
                            <button type="button" class="login-password-toggle" data-password-target="oldPassword" aria-controls="oldPassword" aria-label="Show current password">SHOW</button>
                        </div>
                        <span id="oldPasswordValidation" class="modal-validation-message" style="display:none;"></span>
                        <div class="login-password-wrap">
                            @Html.TextBoxFor(m => m.NewPassword, new { @placeholder = "New password", @class = "form-control", required = "required", id = "newPassword", @type = "password", autocomplete = "new-password" })
                            <button type="button" class="login-password-toggle" data-password-target="newPassword" aria-controls="newPassword" aria-label="Show new password">SHOW</button>
                        </div>
                        <span id="newPasswordValidation" class="modal-validation-message" style="display:none;"></span>
                        <div class="login-password-wrap">
                            <input id="confirmNewPassword" type="password" class="form-control" placeholder="Confirm new password" autocomplete="new-password" />
                            <button type="button" class="login-password-toggle" data-password-target="confirmNewPassword" aria-controls="confirmNewPassword" aria-label="Show confirm new password">SHOW</button>
                        </div>
                        <span id="confirmNewPasswordValidation" class="modal-validation-message" style="display:none;"></span>
                    </div>
                </div>
                <!-- Modal footer -->
                    <div class="modal-footer">
                        <button id="changepassword" class="ibtn">Change Password</button>
                    </div>
                </div>
            </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <script type='text/javascript'>
        function toggleTheme() {
            var current = document.documentElement.getAttribute('data-theme');
            var next = current === 'dark' ? 'light' : 'dark';

            if (next === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }

            localStorage.setItem('els-theme', next);
            syncThemeButtonText();
        }

        function syncThemeButtonText() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            var toggle = document.getElementById('themeToggleLogin');
            if (toggle) {
                toggle.textContent = isDark ? 'Light Theme' : 'Dark Theme';
            }
        }

        function setLoginModeHint(isStoreUser, autoStore, isSuperAdmin) {
            var hint = $('#storeUserHint');
            var modeBadge = $('#storeUserModeBadge');
            var modeBadgeText = $('#storeUserModeBadgeText');
            var storeDropdownContainer = $('#storeDropdownContainer');
            if (!hint.length) return;

            if (isSuperAdmin) {
                hint.css('color', '#7c4dff');
                hint.text('Super Admin login detected. No store selection is required.');
                if (storeDropdownContainer.length) {
                    storeDropdownContainer.hide();
                }
                if (modeBadgeText.length) {
                    modeBadgeText.text('Super Admin Mode');
                }
                if (modeBadge.length) {
                    modeBadge.show();
                }
                return;
            }

            if (isStoreUser) {
                hint.css('color', '#0b7285');
                hint.html('Store-user login detected. Store is auto-selected' + (autoStore ? (': <b>' + autoStore + '</b>') : '.') );
                if (storeDropdownContainer.length) {
                    storeDropdownContainer.hide();
                }
                if (modeBadgeText.length) {
                    modeBadgeText.text('Store User Mode');
                }
                if (modeBadge.length) {
                    modeBadge.show();
                }
                return;
            }

            hint.css('color', '#64748b');
            hint.text('Tenant/Admin login: select a store. Store-user login: store is auto-detected.');
            if (storeDropdownContainer.length) {
                storeDropdownContainer.show();
            }
            if (modeBadge.length) {
                modeBadge.hide();
            }
        }

        function setForgotPasswordProcessing(isProcessing) {
            var button = $('#forgotpassword');
            var progress = $('#forgotPasswordProgress');

            if (isProcessing) {
                button.prop('disabled', true).text('Processing...');
                progress.show();
                return;
            }

            button.prop('disabled', false).text('Reset my Password');
            progress.hide();
        }

        function isValidEmailAddress(email) {
            var emailPattern = /^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/;
            return emailPattern.test(email);
        }

        function clearValidationMessage(selector) {
            $(selector).text('').hide();
        }

        function setValidationMessage(selector, message) {
            $(selector).text(message).show();
        }

        function resetForgotPasswordModalState() {
            $('#tenantforgotpasswordEmail').val('');
            clearValidationMessage('#forgotPasswordEmailValidation');
            setForgotPasswordProcessing(false);
            $('#forgotpassword').show();
        }

        function resetChangePasswordModalState(clearEmail) {
            if (clearEmail) {
                $('#changePasswordEmail').val('');
            }
            $('#oldPassword').val('');
            $('#newPassword').val('');
            $('#confirmNewPassword').val('');
            clearValidationMessage('#changePasswordEmailValidation');
            clearValidationMessage('#oldPasswordValidation');
            clearValidationMessage('#newPasswordValidation');
            clearValidationMessage('#confirmNewPasswordValidation');
        }

        $(document).ready(function ()
        {
            $('#information').hide();

            if (!window.location.search) {
                var loginPageInputs = $('input').not(':button, :submit, :reset, [type=hidden], [type=checkbox], [type=radio]');
                loginPageInputs.val('');
                $('input[type=checkbox], input[type=radio]').prop('checked', false);
            }

            let storeLookupTimer;
            $('#tenantEmail').on('input', function () {
                clearTimeout(storeLookupTimer);
                storeLookupTimer = setTimeout(function () {
                    BindTenantStores();
                }, 120);
            });

            $('#tenantEmail').on('change blur', function () {
                clearTimeout(storeLookupTimer);
                BindTenantStores();
            });

            $('.login-password-toggle').click(function () {
                var field = $('#' + $(this).attr('data-password-target'));
                var isPassword = field.attr('type') === 'password';
                field.attr('type', isPassword ? 'text' : 'password');
                $(this).text(isPassword ? 'HIDE' : 'SHOW');
                var fieldName = field.attr('id') === 'newPassword' ? 'new password'
                    : field.attr('id') === 'oldPassword' ? 'current password'
                    : field.attr('id') === 'confirmNewPassword' ? 'confirm new password' : 'password';
                $(this).attr('aria-label', (isPassword ? 'Hide ' : 'Show ') + fieldName);
            });

            $('#tenantEmail, #tenantPassword, #Store').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $('#LoginCheck').click();
                }
            });

            $('#tenantforgotpasswordEmail').on('input', function () {
                clearValidationMessage('#forgotPasswordEmailValidation');
            });

            $('#changePasswordEmail, #oldPassword, #newPassword, #confirmNewPassword').on('input', function () {
                clearValidationMessage('#changePasswordEmailValidation');
                clearValidationMessage('#oldPasswordValidation');
                clearValidationMessage('#newPasswordValidation');
                clearValidationMessage('#confirmNewPasswordValidation');
            });

            $('#tenantforgotpasswordEmail').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $('#forgotpassword').click();
                }
            });

            $('#changePasswordEmail, #oldPassword, #newPassword, #confirmNewPassword').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $('#changepassword').click();
                }
            });

            $('#ForgotPassword').on('shown.bs.modal', function () {
                resetForgotPasswordModalState();
            });

            $('#ForgotPassword').on('hidden.bs.modal', function () {
                resetForgotPasswordModalState();
            });

            $('#ChangePassword').on('shown.bs.modal', function () {
                resetChangePasswordModalState(false);
            });

            $('#ChangePassword').on('hidden.bs.modal', function () {
                resetChangePasswordModalState(false);
                $('#lblOTPInformation').empty();
            });

            $('a[data-target="#ForgotPassword"]').on('click', function () {
                resetForgotPasswordModalState();
            });

            $('a[data-target="#ChangePassword"]').on('click', function () {
                $('#lblOTPInformation').empty();
                $('#changePasswordEmail').val(($('#tenantEmail').val() || '').trim());
                resetChangePasswordModalState(false);
            });

            syncThemeButtonText();

        });

        var tenantStoresRequest = null;
        var loginStoresRequest = null;
        $("#forgotpassword").click(function (e) {
            e.preventDefault();
            clearValidationMessage('#forgotPasswordEmailValidation');

            var forgotPasswordEmailInput = $("#tenantforgotpasswordEmail").get(0);
            var forgotPasswordEmail = forgotPasswordEmailInput ? forgotPasswordEmailInput.value.trim() : '';
            if (!forgotPasswordEmail) {
                setValidationMessage('#forgotPasswordEmailValidation', 'Email address is required.');
                return;
            }

            if (!isValidEmailAddress(forgotPasswordEmail)) {
                setValidationMessage('#forgotPasswordEmailValidation', 'Please enter a valid email address.');
                return;
            }

            var model =
            {
                'Email': forgotPasswordEmail,
            }
            setForgotPasswordProcessing(true);
                                 $.ajax
                                ({
                                    type: "GET",
                                    url: '@Url.Action("forgotpassword", "Login")',
                                    data: model,
                                         success: function (data) {
                                        setForgotPasswordProcessing(false);
                                        $("#forgotpassword").hide();
                                             $('#information').show();
                                             $('#ForgotPassword').hide();
                                             $('#information').html("<p>" + data + "</p>");
                                             $('body').removeClass('modal-open');
                                             $('.modal-backdrop').remove();
                                    },
                                    error: function () {
                                        setForgotPasswordProcessing(false);
                                        $('#information').show();
                                        $('#information').html("<p>Unable to process reset password request. Please try again.</p>");
                                    }
                                })

        });
      

        $("#changepassword").click(function (e) {
            e.preventDefault();
            clearValidationMessage('#changePasswordEmailValidation');
            clearValidationMessage('#oldPasswordValidation');
            clearValidationMessage('#newPasswordValidation');
            clearValidationMessage('#confirmNewPasswordValidation');

            var changePasswordEmailInput = $("#changePasswordEmail").get(0);
            var oldPasswordInput = $("#oldPassword").get(0);
            var newPasswordInput = $("#newPassword").get(0);
            var confirmNewPasswordInput = $("#confirmNewPassword").get(0);

            var changePasswordEmail = changePasswordEmailInput ? changePasswordEmailInput.value.trim() : '';
            var oldPassword = oldPasswordInput ? oldPasswordInput.value : '';
            var newPassword = newPasswordInput ? newPasswordInput.value : '';
            var confirmNewPassword = confirmNewPasswordInput ? confirmNewPasswordInput.value : '';

            var hasValidationErrors = false;
            if (!changePasswordEmail) {
                setValidationMessage('#changePasswordEmailValidation', 'Email address is required.');
                hasValidationErrors = true;
            } else if (!isValidEmailAddress(changePasswordEmail)) {
                setValidationMessage('#changePasswordEmailValidation', 'Please enter a valid email address.');
                hasValidationErrors = true;
            }

            if (!oldPassword) {
                setValidationMessage('#oldPasswordValidation', 'Current password is required.');
                hasValidationErrors = true;
            }

            if (!newPassword) {
                setValidationMessage('#newPasswordValidation', 'New password is required.');
                hasValidationErrors = true;
            }

            if (!confirmNewPassword) {
                setValidationMessage('#confirmNewPasswordValidation', 'Confirm new password is required.');
                hasValidationErrors = true;
            } else if (newPassword && confirmNewPassword !== newPassword) {
                setValidationMessage('#confirmNewPasswordValidation', 'Confirm new password must match new password.');
                hasValidationErrors = true;
            }

            if (oldPassword && newPassword && oldPassword === newPassword) {
                setValidationMessage('#newPasswordValidation', 'New password must be different from current password.');
                hasValidationErrors = true;
            }

            if (hasValidationErrors) {
                return;
            }

            var model =
            {
                'Email': changePasswordEmail,
                'NewPassword': newPassword,
                'OldPassword': oldPassword,
                'ConfirmNewPassword': confirmNewPassword,
            }
                                 $.ajax
                                ({
                                    type: "POST",
                                    url: '@Url.Action("ChangePassword", "Login")',
                                    data: model,
                                         success: function (data) {
                                        $("#ChangePassword").hide();
                                        $('#information').show();
                                             $('#information').html("<p>" + data + "</p>");
                                             $('body').removeClass('modal-open');
                                             $('.modal-backdrop').remove();

                                            // After successful password change, redirect to login page and refresh controls
                                            // Clear password fields and show professional login tab highlight
                                            $('#tenantPassword').val('');
                                            $('#newPassword').val('');
                                            $('#oldPassword').val('');
                                            // Close modal already done; now visually highlight Login tab
                                            $('#loginTab').addClass('professional-active');
                                            $('#registerTab').removeClass('professional-active');
                                            // Optionally focus the password field for new login
                                            setTimeout(function () { $('#tenantPassword').focus(); }, 200);
                                    }
                                })

        });
        $('#LoginCheck').click(function ()
        {
            var emailElement = $("#tenantEmail").get(0);
            var passwordElement = $("#tenantPassword").get(0);
            var email = emailElement ? emailElement.value : "";
            var password = passwordElement ? passwordElement.value : "";
            var selectedStore = $("#Store option:selected").val();

            if (!email || email.trim().length === 0 || !password || password.trim().length === 0)
            {
                $('#information').show();
                $('#information').html("<p>Please enter email and password.</p>");
                return;
            }

            if (loginStoresRequest && loginStoresRequest.readyState !== 4) {
                loginStoresRequest.abort();
            }

            loginStoresRequest = $.ajax({
                type: "GET",
                url: '@Url.Action("ResolveLoginStores", "Login")',
                data: { email: email, password: password },
                success: function (resolveData) {
                    if (!resolveData || !resolveData.success) {
                        $('#information').show();
                        $('#information').html("<p>" + ((resolveData && resolveData.message) || "Login failed. Please check your email/password.") + "</p>");
                        return;
                    }

                    var stores = resolveData.stores || [];
                    var role = (resolveData.role || "").toLowerCase();
                    var isSuperAdmin = role === "superadmin";
                    var isStoreUser = !!resolveData.isStoreUser || (role && role !== "admin" && !isSuperAdmin);
                    var storeForLogin = selectedStore;

                    if (isStoreUser) {
                        if (stores.length > 0) {
                            storeForLogin = stores[0];
                            var storeDropDown = $('#Store');
                            storeDropDown.empty();
                            storeDropDown.append($('<option></option>').val(storeForLogin).html(storeForLogin));
                            storeDropDown.val(storeForLogin);
                            setLoginModeHint(true, storeForLogin, false);
                        }
                    } else if (isSuperAdmin) {
                        // Super admins are global accounts with no store of their own.
                        setLoginModeHint(false, "", true);
                        storeForLogin = "";
                    } else {
                        setLoginModeHint(false, "", false);
                        if (!storeForLogin || storeForLogin.trim().length === 0) {
                            $('#information').show();
                            $('#information').html("<p>Please select a store before login.</p>");
                            return;
                        }
                    }

                    var model = {
                        'Email': email,
                        'Password': password,
                        'Store': storeForLogin
                    };

                    var newUrl = '@Url.Action("Index","Dashboard")';
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("Login", "Login")',
                        data: model,
                        success: function (data) {
                            if (data === "success")
                            {
                                window.location.href = newUrl;
                            }
                            else if (data === "requirePasswordChange")
                            {
                                $('#lblOTPInformation').html("<p>An One Time Password(OTP) has been sent to: <br>" + email + "</p>");
                                $('#changePasswordEmail').val(email);
                                $("#ChangePassword").modal("show");
                            }
                            else if (data === "storeRequired")
                            {
                                $('#information').show();
                                $('#information').html("<p>Store mapping not found for this user.</p>");
                            }
                            else if (data === "serviceUnavailable")
                            {
                                $('#information').show();
                                $('#information').html("<p>The login service is unavailable. Please try again shortly.</p>");
                            }
                            else if (typeof data === "string" && data.indexOf("notApproved|") === 0)
                            {
                                var blockedMessage = data.substring("notApproved|".length);
                                $('#information').show();
                                $('#information').text(blockedMessage);
                            }
                            else
                            {
                                $('#information').show();
                                $('#information').html("<p>Login failed. Please check your email/password.</p>");
                            }
                        },
                        error: function () {
                            $('#information').show();
                            $('#information').html("<p>Login failed. Please check your email/password.</p>");
                        }
                    });
                },
                error: function () {
                    $('#information').show();
                    $('#information').html("<p>Login failed. Please check your email/password.</p>");
                }
            });
        });
         function BindTenantStores()
         {
                var tenantEmail = $("#tenantEmail").get(0).value;
                var emailPattern = /^[^\s\x40]+\x40[^\s\x40]+\.[^\s\x40]+$/;
                if (!tenantEmail || tenantEmail.trim().length === 0)
                {
                    $('#Store').empty();
                    $('#Store').append($('<option></option>').val('').html('Select a Store...'));
                    $('#LoginCheck').prop('disabled', true);
                    return;
                }

                if (!emailPattern.test(tenantEmail.trim()))
                {
                    $('#Store').empty();
                    $('#Store').append($('<option></option>').val('').html('Select a Store...'));
                    $('#LoginCheck').prop('disabled', true);
                    return;
                }

                var model = {
                    'tenantEmail': $("#tenantEmail").get(0).value,
             }
                if (tenantStoresRequest && tenantStoresRequest.readyState !== 4) {
                    tenantStoresRequest.abort();
                }

                $('#Store').empty();
                $('#Store').append($('<option></option>').val('').html('Loading stores...'));

                tenantStoresRequest = $.ajax({
                    type: "GET",
                    url: '@Url.Action("GetAllStoresByTenant", "Login")',
                    data: model,
                    success: function (data) {
                        var mySelect = $('#Store');
                        mySelect.empty();
                        mySelect.append($('<option></option>').val('').html('Select a Store...'));

                        if (data === 'superadmin')
                        {
                            $('#tenantPassword').focus();
                            $('#information').empty();
                            $('#information').hide();
                            setLoginModeHint(false, "", true);
                            $('#LoginCheck').prop('disabled', false);
                            return;
                        }

                        if (data && data.length > 0)
                        {
                            $('#tenantPassword').focus();
                            $('#information').empty();
                            $('#information').hide();
                            setLoginModeHint(false, "", false);
                            $('#LoginCheck').prop('disabled', false);

                            var stores = data.split(',');
                            var uniqueStores = [];

                            $.each(stores, function (_, text) {
                                var store = text ? text.trim() : '';
                                if (store.length > 0 && $.inArray(store, uniqueStores) === -1) {
                                    uniqueStores.push(store);
                                    mySelect.append($('<option></option>').val(store).html(store));
                                }
                            });
                        }
                        else
                        {
                            $('#information').hide();
                            $('#information').empty();
                            setLoginModeHint(true, "", false);
                            $('#LoginCheck').prop('disabled', false);
                        }
                    },
                    error: function (xhr) {
                        var mySelect = $('#Store');
                        mySelect.empty();
                        mySelect.append($('<option></option>').val('').html('Select a Store...'));
                        $('#LoginCheck').prop('disabled', true);
                        setLoginModeHint(false, "", false);

                        var message = (xhr && xhr.responseText) ? xhr.responseText : 'Error occurred while processing your request.';

                        BootstrapDialog.show({
                            title: 'Warning Alert',
                            message: message,
                            buttons: [{
                                label: 'OK',
                                cssClass: 'btn btn-success btn-middle',
                                action: function (dialog) {
                                    dialog.close();
                                }
                            }]
                        });
                    }
                });
        }
    </script>
