@model LMSWebUI.Models.Login.ClientLoginDto
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELS Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.1.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/custom.css">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,300,400,500,600,700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="form-body">
        <div class="website-logo">
            <a href="index.html">
                <div class="logo">
                    <img class="logo-size" src="~/Images/els-white.png" alt="">
                </div>
            </a>
        </div>
        <div class="row">
            <div class="img-holder">
                <div class="bg"></div>
                <div class="info-holder">
                    <img src="~/Images/loginimage.png" alt="">
                </div>
            </div>
            <div class="form-holder">
                <div class="form-content">
                    <div class="form-items" style="width: 340px;">
                        <img class="logo-size" src="~/Images/els-blue-web.png" alt="" style="
    width: 180px;margin-bottom: 20px;">
                        <div id="information" class="alert alert-success" role="alert"><strong>Well done!</strong><span class="glyphi glyphicon glyphicon-exclamation-sign"></span>@Model.Message</div>
                        <div class="page-links">
                            <a class="active" href="@Url.Action("Login", "Login")">Login</a> <a href="@Url.Action("Register", "Login")">Register</a>
                        </div>
                        @*@using (Html.BeginForm("CheckIsPasswordChangedByclient", "Login", FormMethod.Post, new { @class = "form" }))
                        {*@
                            <form>
                                @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-Mail", @class = "form-control", required = "required", id = "tenantEmail", @onblur = "return BindTenantStores()" })
                                @Html.TextBoxFor(m => m.Password, new { @placeholder = "password", @class = "form-control", required = "required", id = "tenantPassword", @type = "password" })
                                @Html.DropDownListFor(x => x.StoreCode, new List<SelectListItem> { }, "Select a Store...", new { id = "Store", @style = "width:135px" })
                                <div class="form-button">
                                    <button id="LoginCheck" onclick="LoginValidate();" type="button" class="ibtn">Login</button> <a href="#" data-toggle="modal" data-target="#ForgotPassword">Change password?</a>
                                </div>
                            </form>
                        @*}*@
                        <div class="other-links">
                            <span><i>The best way to manage your Dry cleaning and Laundry business</i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- popup Forgot Your Password html -->
    <!-- The Modal -->
    <div class="modal" id="ForgotPassword">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Forgot Your Password?</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div class="form-group">
                        <input class="form-control input-lg" placeholder="E-mail Address" name="email" type="email" required> <br>
                        <input class="form-control input-lg" placeholder="New Password" name="email" type="password" required><br>
                        <input class="form-control input-lg" placeholder="Confirm Password" name="email" type="password" required>
                    </div>
                </div>
                <!-- Modal footer -->
                <div class="modal-footer">
                    <button id="submit" type="submit" class="ibtn">Reset my Password</button>
                </div>
            </div>
        </div>
    </div>


    <!-- popup Change Your Password html -->
    <!-- The Modal -->
    <div class="modal fade" id="ChangePassword">
        <div class="modal-dialog">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h4 class="modal-title">Change Password</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <lable id="lblOTPInformation"></lable>
                    <div class="form-group">
                        @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-Mail", @class = "form-control", required = "required", id = "userEmail" })
                        @Html.TextBoxFor(m => m.NewPassword, new { @placeholder = "New password", @class = "form-control", required = "required", id = "newPassword", @type = "password" })
                        @Html.TextBoxFor(m => m.OldPassword, new { @placeholder = "Old password", @class = "form-control", required = "required", id = "oldPassword", @type = "password" })
                    </div>
                </div>
                <!-- Modal footer -->
                    <div class="modal-footer">
                        <button id="changepassword" class="ibtn">Change Password</button>
                    </div>
                </div>
            </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    <script type='text/javascript'>
        $(document).ready(function ()
        {
            $('#information').hide();
        });

        $("#changepassword").click(function () {
            var model =
            {
                'Email': $("#userEmail").get(0).value,
                'NewPassword': $("#newPassword").get(0).value,
                'OldPassword': $("#oldPassword").get(0).value,
            }
                                 $.ajax
                                ({
                                    type: "POST",
                                    url: '@Url.Action("ChangePassword", "Login")',
                                    data: model,
                                         success: function (data) {
                                        $("#ChangePassword").hide();
                                        $('#information').show();
                                             $('#information').html("<p>" + data + "</p>");
                                             $('body').removeClass('modal-open');
                                             $('.modal-backdrop').remove();
                                    }
                                })

        });
        $('#LoginCheck').click(function ()
        {
            var model = {
                    'Email': $("#tenantEmail").get(0).value,
             }
            //alert($("#tenantEmail").val());
            //alert($("#tenantPassword").val());
            //alert($("#Store option:selected").text());
            $.ajax
                ({
                type: "GET",
                url: '@Url.Action("CheckIsPasswordChangedByTenant", "Login")',
                data: model,
                success: function (data)
                {
                    if (data != null)
                    {
                        if (data == true)
                        {
                            var model = {
                                'Email': $("#tenantEmail").get(0).value,
                                'Password': $("#tenantPassword").get(0).value,
                                'StoreCode': $("#Store option:selected").text(),
                            }
                            $.ajax
                                ({
                                    type: "POST",
                                    url: '@Url.Action("Login", "Login")',
                                    data: model,
                                    success: function (data) {
                                        $('#information').show();
                                        $('#information').html("<p>" + data + "</p>");
                                    }
                                })

                        }
                        else
                        {
                            $('#lblOTPInformation').html("<p>An One Time Password(OTP) has been sent to: <br>" + $("#tenantEmail").get(0).value + "</p>");
                            $("#ChangePassword").modal("show");
                        }
                        
                    }
                }
            })
        });
         function BindTenantStores()
         {
                var tenantEmail = $("#tenantEmail").get(0).value;
                var url = "/Login/GetAllStoresByTenant?tenantUrl" + tenantEmail;
                var model = {
                    'tenantEmail': $("#tenantEmail").get(0).value,
             }
                $.ajax({
                    type: "GET",
                    url: '@Url.Action("CheckTenantEmail", "Login")',
                    data: model,
                    success: function (data) {
                        if (data > 0)
                        {
                            $('#tenantPassword').focus();
                            $('#Store').empty();
                            $('#information').empty();
                            $('#information').hide();
                            $('#login').prop('disabled', false);
                            $.ajax({
                                type: "GET",
                                url: '@Url.Action("GetAllStoresByTenant", "Login")',
                                data: model,
                                success: function (data)
                                {
                                    if (data.length > 0)
                                    {
                                    var stores = data.split(',');
                                    var mySelect = $('#Store');
                                    $.each(stores, function (val,text) {
                                    mySelect.append(
                                    $('<option></option>').val(text).html(text)
                                 );
                             });
                         }
                     },
                     error: function () {
                         BootstrapDialog.show({
                             title: 'Warning Alert',
                             message: 'Error occurred while processing your request.',
                             buttons: [{
                                 label: 'OK',
                                 cssClass: 'btn btn-success btn-middle',
                                 action: function (dialog) {
                                     dialog.close();
                                 }
                             }]
                         });
                     }
                 });
                        }
                        else if (data == 0)
                        {
                            $('#information').show();
                            $('#information').html("<p>The Email supplied was not found.Please Register with us.</p>");
                            $('#login').prop('disabled', true);
                        }
                    },
                    error: function () {
                        BootstrapDialog.show({
                            title: 'Warning Alert',
                            message: 'Error occurred while processing your request.',
                            buttons: [{
                                label: 'OK',
                                cssClass: 'btn btn-success btn-middle',
                                action: function (dialog) {
                                    dialog.close();
                                }
                            }]
                        });
                    }
                });
        }
    </script>
</body>
</html >
