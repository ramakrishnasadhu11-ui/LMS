     <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script type='text/javascript'>
        syncThemeButtonText();
        var shouldClearRegisterInputs = @((ViewData.ModelState.IsValid && string.IsNullOrWhiteSpace(Model?.Message)) ? "true" : "false");

        // Embed country->currency mappings for the registration page. This is a suggestion only;
        // administrators may override the suggested currency before submitting.
        var countryCurrencyMap = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(LMSWebUI.Services.CountryCurrencyMapping.GetMappings()));

        $(function ()
        {
            // Suggest currency when country selection changes. Do not infer country automatically.
            $('#countrySelect').on('change', function () {
                try {
                    var selected = $(this).val();
                    if (selected && countryCurrencyMap && countryCurrencyMap[selected]) {
                        var cfg = countryCurrencyMap[selected];
                        $('#currencyCode').val(cfg.CurrencyCode || '');
                        $('#currencySymbol').val(cfg.CurrencySymbol || '');
                        $('#currencyLocale').val(cfg.CurrencyLocale || '');
                        $('#currencyDigits').val(cfg.DecimalDigits != null ? cfg.DecimalDigits : '');
                    }
                    else {
                        // no suggestion available - clear fields to allow manual input
                        $('#currencyCode').val('');
                        $('#currencySymbol').val('');
                        $('#currencyLocale').val('');
                        $('#currencyDigits').val('');
                    }
                } catch (e) {
                    // no-op
                }
            });

            if (shouldClearRegisterInputs) {
                var registerPageInputs = $('input').not(':button, :submit, :reset, [type=hidden], [type=checkbox], [type=radio]');
                registerPageInputs.val('');
                $('input[type=checkbox], input[type=radio]').prop('checked', false);
            }

            $("input[type=submit]").on('click', function () {
                $(this).attr('disabled', 'disabled');
            });
        });
    </script>
</body>
</html>
