                            </div>
                        </div>

                        <div class="register-benefits-section" aria-label="Trial benefits">
                            <div class="register-benefit-item">
                                <span class="register-benefit-icon" aria-hidden="true">45</span>
                                <div class="register-benefit-content">
                                    <strong>45 Days to Explore</strong>
                                    <p>Experience the software using the existing trial.</p>
                                </div>
                            </div>
                            <div class="register-benefit-item">
                                <span class="register-benefit-icon" aria-hidden="true">✓</span>
                                <div class="register-benefit-content">
                                    <strong>Simple Setup</strong>
                                    <p>Get started after account approval.</p>
                                </div>
                            </div>
                            <div class="register-benefit-item">
                                <span class="register-benefit-icon" aria-hidden="true">★</span>
                                <div class="register-benefit-content">
                                    <strong>Business-Focused Features</strong>
                                    <p>Manage customers, orders, billing, garment tags, and store workflows.</p>
                                </div>
                            </div>
                            <div class="register-benefit-item">
                                <span class="register-benefit-icon" aria-hidden="true">ℹ</span>
                                <div class="register-benefit-content">
                                    <strong>Personalized Demo</strong>
                                    <p>Contact us to see how the software fits your laundry business.</p>
                                </div>
                            </div>
                        </div>

                        <div class="register-contact-demo">
                            <p class="demo-title">Contact Us for a Personalized Demo</p>
                            <div class="demo-links">
                                <a href="mailto:techforgeacademydev@gmail.com">techforgeacademydev@gmail.com</a>
                                <a href="https://wa.me/919059261259" target="_blank" rel="noopener noreferrer">WhatsApp: +91 90592 61259</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="register-brand-image">
                    <img src="~/Images/loginimage.png" alt="Excel Laundry Services registration">
                </div>
            </div>
            <div class="register-form-panel">
                <div class="form-content register">
                    <div class="register-header">
                        <img src="~/Images/els-blue-web.png" alt="Excel Laundry Services">
                        <button id="themeToggleRegister" type="button" class="theme-toggle-btn" onclick="toggleTheme()">Dark Theme</button>
                    </div>
                    <h2 class="register-title">Create your account</h2>
                    <p class="register-subtitle">Use your business details to request access. A super admin will review and approve your registration.</p>
                        @{
                             bool disablebtn = false;
                        }
                        @if (Model.Message != null)
                        {
                            <div class="alert alert-success register-success-alert" role="alert">
                                <strong>Registration request received successfully.</strong>
                                <div class="mt-1">@Model.Message</div>
                                <p class="register-approval-note">Your account remains pending until super admin approval. You can sign in after approval.</p>
                                <p class="mb-0 mt-2"><a href="@Url.Action("Login", "Login")">Go to Login</a></p>
                            </div>
                            disablebtn=true; 
                        }
                        @using (Html.BeginForm("Register", "Login", FormMethod.Post, new { @class = "form register-form" }))
                        {
                                <div class="register-field">
                                    <label for="FamilyName">First Name</label>
                                    @Html.TextBoxFor(m => m.FamilyName, new { @placeholder = "First Name", @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.FamilyName, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field">
                                    <label for="MiddleName">Last Name</label>
                                    @Html.TextBoxFor(m => m.MiddleName, new { @placeholder = "Last Name", @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.MiddleName, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field register-full">
                                    <label for="TenantName">Company Name</label>
                                    @Html.TextBoxFor(m => m.TenantName, new { @placeholder = "Company Name", @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.TenantName, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field register-full">
                                    <label for="Email">Email Address</label>
                                    @Html.TextBoxFor(m => m.Email, new { @placeholder = "E-mail Address", @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Email, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field">
                                    <label for="PhoneNumber">Phone Number</label>
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @placeholder = "Phone Number", @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field">
                                    <label for="NoOfStores">Number of Stores</label>
                                    @Html.TextBoxFor(m => m.NoOfStores, new { @placeholder = "Number of Stores", @class = "form-control" })
                                    <small class="register-helper-text">How many laundry outlets do you currently operate?</small>
                                    @Html.ValidationMessageFor(m => m.NoOfStores, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field register-full">
                                    <label for="countrySelect">Country</label>
                                    @Html.DropDownListFor(m => m.Country, new Microsoft.AspNetCore.Mvc.Rendering.SelectList(LMSWebUI.Services.CountryCurrencyMapping.GetMappings().Keys), "Select Country", new { @class = "form-control", id = "countrySelect" })
                                    @Html.ValidationMessageFor(m => m.Country, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field currency-technical-field">
                                    <label for="currencyCode">Currency Code</label>
                                    @Html.TextBoxFor(m => m.CurrencyCode, new { @placeholder = "Currency Code (e.g. INR)", @class = "form-control", id = "currencyCode" })
                                    @Html.ValidationMessageFor(m => m.CurrencyCode, null, new { @class = "text-danger" })
                                </div>
                                <div class="register-field currency-technical-field">
                                    <label for="currencySymbol">Currency Symbol</label>
                                    @Html.TextBoxFor(m => m.CurrencySymbol, new { @placeholder = "Currency Symbol", @class = "form-control", id = "currencySymbol" })
                                </div>
                                <div class="register-field currency-technical-field">
                                    <label for="currencyLocale">Currency Locale</label>
                                    @Html.TextBoxFor(m => m.CurrencyLocale, new { @placeholder = "Currency Locale (e.g. en-IN)", @class = "form-control", id = "currencyLocale" })
                                </div>
                                <div class="register-field currency-technical-field">
                                    <label for="currencyDigits">Decimal Digits</label>
                                    @Html.TextBoxFor(m => m.CurrencyDecimalDigits, new { @placeholder = "Decimal Digits (e.g. 2)", @class = "form-control", id = "currencyDigits", type = "number", min = "0", max = "6" })
                                </div>
                                <div class="register-actions">
                                    <button id="registerBtn" type="submit" class="ibtn register-submit-btn" disabled="@(disablebtn ? "disabled" : null)">Register</button>
                                    <p class="register-login-link">Already have an account? <a href="@Url.Action("Login", "Login")">Login</a></p>
                                </div>
                        }
                        @Html.ValidationSummary(excludePropertyErrors: true, message: "", htmlAttributes: new { @class = "text-danger" })

                    </div>
                </div>
            </div>
        </div>
