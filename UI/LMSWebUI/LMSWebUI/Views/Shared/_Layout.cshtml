    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';

      if (next === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      localStorage.setItem('els-theme', next);
      syncThemeButtonText();
    }

    function syncThemeButtonText() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      var toggle = document.getElementById('themeToggleMain');
      if (toggle) {
        toggle.textContent = isDark ? 'Light Theme' : 'Dark Theme';
      }
    }

    syncThemeButtonText();

    function handleProfileImageFallback(img) {
      if (!img) {
        return;
      }

      var defaultAvatar = img.getAttribute('data-default-avatar');
      if (!defaultAvatar) {
        return;
      }

      var currentSrc = (img.getAttribute('src') || '').trim();
      var normalizedCurrentSrc = currentSrc.replace(/\/$/, '');
      var normalizedDefaultSrc = defaultAvatar.replace(/\/$/, '');
      if (normalizedCurrentSrc === normalizedDefaultSrc) {
        return;
      }

      img.onerror = null;
      img.setAttribute('src', defaultAvatar);
    }
    </script>
