              <img src="@resolvedProfileImageUrl" class="user-image" alt="@profileImageAlt" data-default-avatar="@defaultProfileImageUrl" loading="lazy" onerror="window.handleProfileImageFallback ? window.handleProfileImageFallback(this) : (this.onerror=null,this.src=this.getAttribute('data-default-avatar'))">
