@using Microsoft.AspNetCore.Http
@using System.Globalization
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isDashboardIndexPage = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isMyProfilePage = string.Equals(currentController, "Login", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "TenantProfileDetails", StringComparison.OrdinalIgnoreCase);
    var currentUserRole = Context?.Session?.GetString("UserRole") ?? string.Empty;
    var isSuperAdminUser = string.Equals(currentUserRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
    var isAdminUser = string.Equals(currentUserRole, "Admin", StringComparison.OrdinalIgnoreCase);
    var isAdminCompanyHeaderOnly = Convert.ToBoolean(ViewData["AdminCompanyHeaderOnly"] ?? false);
    var showHeaderNavigation = Convert.ToBoolean(ViewData["ShowHeaderNavigation"] ?? false);
    var hideSidebar = Convert.ToBoolean(ViewData["HideSidebar"] ?? false) || isMyProfilePage;
    var bodyCss = hideSidebar
        ? "hold-transition skin-blue sidebar-mini sidebar-collapse no-sidebar-page"
        : "hold-transition skin-blue sidebar-mini";
    if (isDashboardIndexPage)
    {
        bodyCss += " fixed dashboard-fixed-header";
    }
    if (isAdminCompanyHeaderOnly)
    {
        bodyCss += " admin-company-header-only";
    }
    var memberSinceRaw = Context?.Session?.GetString("TenantMemberSince");
    var memberSinceText = "Member since -";
    var businessNameRaw = Context?.Session?.GetString("TenantBusinessName");
    var fallbackBusinessName = "LMS";
    var resolvedBusinessName = string.IsNullOrWhiteSpace(businessNameRaw)
        ? fallbackBusinessName
        : businessNameRaw.Trim();
    var profileImageUrl = Context?.Session?.GetString("TenantProfileImageUrl");
    var tenantStoreRaw = Context?.Session?.GetString("TenantStore");
    var defaultProfileImageUrl = Url.Content("~/dist/img/noimage.png");
    var resolvedProfileImageUrl = string.IsNullOrWhiteSpace(profileImageUrl)
        ? defaultProfileImageUrl
        : (profileImageUrl.Trim().StartsWith("~/", StringComparison.Ordinal)
            ? Url.Content(profileImageUrl.Trim())
            : profileImageUrl.Trim());
    var profileImageAlt = string.IsNullOrWhiteSpace(resolvedBusinessName)
        ? "Profile avatar"
        : $"{resolvedBusinessName} profile avatar";
    var currentPathAndQuery = $"{Context?.Request?.Path}{Context?.Request?.QueryString}";
    var myProfileUrl = Url.Action("TenantProfileDetails", "Login", new { returnUrl = currentPathAndQuery });
    var appDocumentTitle = "Excel Laundry Services | Laundry Management";
    var pageTitle = Convert.ToString(ViewData["Title"] ?? string.Empty)?.Trim();
    var fullDocumentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? appDocumentTitle
        : $"{pageTitle} | {appDocumentTitle}";

    if (!string.IsNullOrWhiteSpace(memberSinceRaw))
    {
        if (DateTimeOffset.TryParse(memberSinceRaw, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsedMemberSinceOffset))
        {
            memberSinceText = $"Member since {parsedMemberSinceOffset.Year}";
        }
        else if (DateTime.TryParse(memberSinceRaw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedMemberSince))
        {
            memberSinceText = $"Member since {parsedMemberSince.Year}";
        }
    }
}
