      overflow: hidden;
    }

    .user-menu .user-header .profile-avatar-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
      display: block;
    }

    .user-menu .user-header p {
      margin-top: 10px;
      line-height: 1.4;
      font-weight: 600;
      color: #fff;
    }

    .user-menu .user-header .profile-name {
      display: block;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .user-menu .user-header .profile-meta {
      display: block;
      font-size: 12px;
      font-weight: 600;
      opacity: 0.95;
    }

    .user-menu .user-header p small {
      color: rgba(255, 255, 255, 0.88);
      display: block;
      margin-top: 2px;
    }

    .user-menu .dropdown-menu .user-footer {
