      padding: 12px;
      background: color-mix(in srgb, var(--els-accent) 32%, var(--els-surface));
      border-top: 1px solid var(--els-border);
    }

    .user-menu .user-body {
      display: block !important;
      padding: 10px 12px;
      background: var(--els-surface);
    }

    .tenant-menu-action {
      display: block;
      width: 100%;
      text-align: center;
      border: 1px solid var(--els-border);
      border-radius: 8px;
      min-height: 36px;
      line-height: 34px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      background: #ffffff;
      color: var(--els-text);
    }

    .tenant-menu-action:hover {
      text-decoration: none;
      background: var(--els-accent);
    }

    .tenant-menu-action.profile {
      margin-bottom: 8px;
      border-color: var(--els-primary-light);
      background: color-mix(in srgb, var(--els-accent) 24%, #ffffff);
      color: var(--els-primary-dark);
    }

    .tenant-menu-action.profile:hover {
      color: var(--els-primary-dark);
      background: color-mix(in srgb, var(--els-accent) 40%, #ffffff);
    }

    .tenant-menu-action.signout {
      border-color: #c9302c;
      background: linear-gradient(180deg, #e35d5b 0%, #c9302c 100%);
      color: #fff;
    }

    .tenant-menu-action.signout:hover {
      color: #fff;
      filter: brightness(0.96);
    }

    @@media (max-width: 768px) {
      .user-menu .dropdown-menu {
        width: 92vw;
        min-width: 260px;
        right: 4px;
      }
    }

  </style>
  <script>
      (function () {
          try {
              var selectedTheme = localStorage.getItem('els-theme');
              if (selectedTheme === 'dark') {
                  document.documentElement.setAttribute('data-theme', 'dark');
              } else {
                  document.documentElement.removeAttribute('data-theme');
              }
          } catch (e) {
              document.documentElement.removeAttribute('data-theme');
          }
      })();
  </script>
