    @{
        // Currency metadata is rendered asynchronously via a ViewComponent to avoid blocking
        // the layout with synchronous service calls. Default client-side fallbacks are used
        // inside the script below so Razor does not attempt to evaluate server variables.
    }

    <script type="text/javascript">
        // window.__currency: authoritative client-side metadata for formatting monetary values
        // Start with safe client-side defaults (no server-side interpolation here) so
        // Razor does not attempt to evaluate server variables in the script body.
        window.__currency = {
            code: 'INR',
            symbol: '₹',
            locale: 'en-IN',
            decimalDigits: 2
        };

        // Shared client-side currency formatter used across pages. Uses Intl.NumberFormat when possible
        // and falls back to symbol + fixed decimal formatting. Does not infer currency from client locale.
        function formatCurrency(value) {
            try {
                var meta = window.__currency || { code: 'INR', symbol: '₹', locale: 'en-IN', decimalDigits: 2 };
                var digits = Number.isFinite(Number(meta.decimalDigits)) ? Number(meta.decimalDigits) : 2;
                var num = Number(value);
                if (!isFinite(num)) return '';

                // Prefer Intl.NumberFormat when currency code and locale are available
                try {
                    var nf = new Intl.NumberFormat(meta.locale || undefined, { style: 'currency', currency: meta.code || undefined, minimumFractionDigits: digits, maximumFractionDigits: digits });
                    var formatted = nf.format(num);

                    // If the resolved symbol differs and Intl did not include it (rare), prefix with configured symbol
                    if (meta.symbol && formatted.indexOf(meta.symbol) === -1) {
                        return meta.symbol + ' ' + num.toFixed(digits);
                    }

                    return formatted;
                } catch (e) {
                    return (meta.symbol || '') + ' ' + num.toFixed(digits);
                }
            } catch (e) {
                return '';
            }
        }
    </script>
