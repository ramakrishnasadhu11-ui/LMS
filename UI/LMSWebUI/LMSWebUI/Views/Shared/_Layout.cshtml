    function toggleTheme() {
      var current = document.documentElement.getAttribute('data-theme');
      var next = current === 'dark' ? 'light' : 'dark';

      if (next === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }

      localStorage.setItem('els-theme', next);
      syncThemeButtonText();
    }

    function syncThemeButtonText() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      var toggle = document.getElementById('themeToggleMain');
      if (toggle) {
        toggle.textContent = isDark ? 'Light Theme' : 'Dark Theme';
      }
    }

    syncThemeButtonText();

    function handleProfileImageFallback(img) {
      if (!img) {
        return;
      }

      var defaultAvatar = img.getAttribute('data-default-avatar');
      if (!defaultAvatar) {
        return;
      }

      var currentSrc = (img.getAttribute('src') || '').trim();
      var normalizedCurrentSrc = currentSrc.replace(/\/$/, '');
      var normalizedDefaultSrc = defaultAvatar.replace(/\/$/, '');
      if (normalizedCurrentSrc === normalizedDefaultSrc) {
        return;
      }

      img.onerror = null;
      img.setAttribute('src', defaultAvatar);
    }

    (function setupDashboardProfileDropdownAnchor() {
      var body = document.body;
      if (!body || !body.classList.contains('dashboard-fixed-header') || typeof window.jQuery === 'undefined') {
        return;
      }

      var userMenu = document.querySelector('.navbar-nav > .user-menu');
      if (!userMenu) {
        return;
      }

      var toggle = userMenu.querySelector('.dropdown-toggle');
      var dropdownMenu = userMenu.querySelector('.dropdown-menu');
      if (!toggle || !dropdownMenu) {
        return;
      }

      var isTracking = false;

      function alignProfileDropdown() {
        if (!userMenu.classList.contains('open')) {
          return;
        }

        var triggerRect = toggle.getBoundingClientRect();
        var menuWidth = dropdownMenu.offsetWidth || 280;
        var top = Math.round(triggerRect.bottom + 8);
        var left = Math.round(triggerRect.right - menuWidth);

        dropdownMenu.style.position = 'fixed';
        dropdownMenu.style.top = top + 'px';
        dropdownMenu.style.left = left + 'px';
        dropdownMenu.style.right = 'auto';
      }

      function resetProfileDropdown() {
        dropdownMenu.style.position = '';
        dropdownMenu.style.top = '';
        dropdownMenu.style.left = '';
        dropdownMenu.style.right = '';
      }

      function startTracking() {
        if (isTracking) {
          return;
        }

        isTracking = true;
        window.addEventListener('scroll', alignProfileDropdown, { passive: true });
        window.addEventListener('resize', alignProfileDropdown);
        document.addEventListener('scroll', alignProfileDropdown, true);
      }

      function stopTracking() {
        if (!isTracking) {
          return;
        }

        isTracking = false;
        window.removeEventListener('scroll', alignProfileDropdown);
        window.removeEventListener('resize', alignProfileDropdown);
        document.removeEventListener('scroll', alignProfileDropdown, true);
      }

      jQuery(userMenu).on('shown.bs.dropdown', function () {
        alignProfileDropdown();
        startTracking();
      });

      jQuery(userMenu).on('hidden.bs.dropdown', function () {
        stopTracking();
        resetProfileDropdown();
      });
    })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>