<!DOCTYPE html>
<html>
    <head>

    </head>
    <body>
        @using Newtonsoft.Json;
        @if (TempData["UserMessage"] != null)
        {
            var returnmessage =TempData["UserMessage"];
            var message=JsonConvert.DeserializeObject<LMSWebUI.Models.MessageDto>(returnmessage.ToString());
            <div class="container">
            <div class="alert @message.CssClassName alert-dismissible fade show" id="alertstatus">
              <button type="button" class="close" data-dismiss="alert">&times;</button>
              <strong>@message.Title</strong> @message.DisplayMessage.
              </div>
            </div>
        }
    </body>
</html>