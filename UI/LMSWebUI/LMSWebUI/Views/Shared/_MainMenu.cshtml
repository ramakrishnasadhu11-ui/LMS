<script>
    $(function() {
        $.ajax(
        {
            type: "POST",
            url: '@Url.Action("GetDashboardsList", "Dashboard")',
            error: function (result) {
                alert(result);
            },
            success: function (result) {
                var menu = null;
                $.each( result, function( key, value ) {
                    menu += '<li><a href="/Dashboard/Dashboard/'+value.id+'">'+value.name+'</a></li>';
                });
                $("#menu").html(menu);
            }
        });
});
</script>