@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["HideSidebar"] = true;
    ViewData["ShowHeaderNavigation"] = true;
}

<style>
    .admin-company-header-only .content-wrapper {
        background: var(--els-page-bg, #f4f6f9) !important;
        min-height: calc(100vh - 58px);
    }

    .admin-company-header-only .admin-content-shell {
        padding-bottom: 18px;
    }

    .admin-company-header-only .admin-setup-page,
    .admin-company-header-only .tax-settings-page,
    .admin-company-header-only .store-config-page,
    .admin-company-header-only .pricing-rules-page,
    .admin-company-header-only .wf-settings-page,
    .admin-company-header-only .admin-feature-page,
    .admin-company-header-only .tag-settings-page,
    .admin-company-header-only .adv-page,
    .admin-company-header-only .preferences-page,
    .admin-company-header-only .payment-settings-page,
    .admin-company-header-only .wf-page,
    .admin-company-header-only .master-page,
    .admin-company-header-only .setup-page,
    .admin-company-header-only .customer-page {
        padding: clamp(14px, 2.3vw, 24px) !important;
    }

    .admin-company-header-only .admin-setup-box,
    .admin-company-header-only .tax-settings-box,
    .admin-company-header-only .store-config-box,
    .admin-company-header-only .pricing-rules-box,
    .admin-company-header-only .wf-settings-box,
    .admin-company-header-only .admin-feature-box,
    .admin-company-header-only .tag-settings-box,
    .admin-company-header-only .adv-box,
    .admin-company-header-only .preferences-box,
    .admin-company-header-only .payment-settings-box,
    .admin-company-header-only .wf-box,
    .admin-company-header-only .master-box,
    .admin-company-header-only .setup-box,
    .admin-company-header-only .customer-box {
        border: 1px solid #dbe6f6 !important;
        border-radius: 12px !important;
        box-shadow: 0 3px 14px rgba(15, 23, 42, 0.08) !important;
        background: var(--els-surface) !important;
        overflow: hidden;
    }

    .admin-company-header-only .admin-setup-title,
    .admin-company-header-only .tax-settings-title,
    .admin-company-header-only .store-config-title,
    .admin-company-header-only .pricing-rules-title,
    .admin-company-header-only .wf-settings-title,
    .admin-company-header-only .admin-feature-title,
    .admin-company-header-only .tag-settings-title,
    .admin-company-header-only .adv-title,
    .admin-company-header-only .preferences-title,
    .admin-company-header-only .payment-settings-title,
    .admin-company-header-only .wf-title,
    .admin-company-header-only .master-title,
    .admin-company-header-only .setup-title,
    .admin-company-header-only .customer-title {
        background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%) !important;
        color: #ffffff !important;
        padding: 14px 20px !important;
        font-size: 20px !important;
        font-weight: 600 !important;
        border-bottom: 1px solid color-mix(in srgb, var(--els-primary-dark) 56%, #0f172a);
    }

    .admin-company-header-only .admin-setup-body,
    .admin-company-header-only .tax-settings-body,
    .admin-company-header-only .store-config-body,
    .admin-company-header-only .pricing-rules-body,
    .admin-company-header-only .wf-settings-body,
    .admin-company-header-only .admin-feature-body,
    .admin-company-header-only .tag-settings-body,
    .admin-company-header-only .adv-body,
    .admin-company-header-only .preferences-body,
    .admin-company-header-only .payment-settings-body,
    .admin-company-header-only .wf-body,
    .admin-company-header-only .master-body,
    .admin-company-header-only .setup-body,
    .admin-company-header-only .customer-body {
        padding: clamp(16px, 2.4vw, 24px) !important;
        background: var(--els-surface);
    }

    .admin-company-header-only .admin-setup-note,
    .admin-company-header-only .tax-settings-note,
    .admin-company-header-only .store-config-note,
    .admin-company-header-only .pricing-rules-note,
    .admin-company-header-only .wf-settings-note,
    .admin-company-header-only .admin-feature-note,
    .admin-company-header-only .tag-settings-note,
    .admin-company-header-only .adv-note,
    .admin-company-header-only .preferences-note,
    .admin-company-header-only .payment-settings-note,
    .admin-company-header-only .wf-note,
    .admin-company-header-only .master-note,
    .admin-company-header-only .setup-note,
    .admin-company-header-only .customer-note {
        border: 1px solid #dbe6f6 !important;
        border-radius: 10px !important;
        background: #f4f8ff !important;
        color: var(--els-text) !important;
    }

    .admin-company-header-only .admin-btn,
    .admin-company-header-only .tax-btn,
    .admin-company-header-only .store-btn,
    .admin-company-header-only .pricing-btn,
    .admin-company-header-only .wf-btn,
    .admin-company-header-only .admin-feature-btn,
    .admin-company-header-only .tag-btn,
    .admin-company-header-only .adv-btn,
    .admin-company-header-only .pref-btn,
    .admin-company-header-only .payment-btn,
    .admin-company-header-only .action-btn,
    .admin-company-header-only .master-btn,
    .admin-company-header-only .setup-btn,
    .admin-company-header-only .customer-btn {
        min-height: 42px;
        border-radius: 8px !important;
        border: 1px solid transparent !important;
        background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%) !important;
        color: #fff !important;
        font-weight: 600 !important;
    }

    .admin-company-header-only .tax-input,
    .admin-company-header-only .store-input,
    .admin-company-header-only .store-select,
    .admin-company-header-only .pricing-input,
    .admin-company-header-only .wf-input,
    .admin-company-header-only .tag-input,
    .admin-company-header-only .payment-input,
    .admin-company-header-only .payment-select,
    .admin-company-header-only .master-input,
    .admin-company-header-only .setup-input,
    .admin-company-header-only .customer-input,
    .admin-company-header-only .tax-textarea,
    .admin-company-header-only .store-textarea,
    .admin-company-header-only .pricing-textarea,
    .admin-company-header-only .tag-textarea,
    .admin-company-header-only .payment-textarea {
        border-color: #cfdcf0 !important;
        border-radius: 8px !important;
        background: #ffffff !important;
    }

    @@media (max-width: 768px) {
        .admin-company-header-only .admin-setup-page,
        .admin-company-header-only .tax-settings-page,
        .admin-company-header-only .store-config-page,
        .admin-company-header-only .pricing-rules-page,
        .admin-company-header-only .wf-settings-page,
        .admin-company-header-only .admin-feature-page,
        .admin-company-header-only .tag-settings-page,
        .admin-company-header-only .adv-page,
        .admin-company-header-only .preferences-page,
        .admin-company-header-only .payment-settings-page,
        .admin-company-header-only .wf-page,
        .admin-company-header-only .master-page,
        .admin-company-header-only .setup-page,
        .admin-company-header-only .customer-page {
            padding: 10px !important;
        }
    }
</style>

@await Html.PartialAsync("_LayoutStatus")
<main class="admin-content-shell">
    @RenderBody()
</main>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
