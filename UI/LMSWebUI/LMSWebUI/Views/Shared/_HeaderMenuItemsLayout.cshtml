			}

			ul#cnet h1, ul#cnet h2 {
				margin: 0;
				font-size: 0;
				position: absolute;
				width: 10px;
				height: 10px;
				background-image: url(sub.gif);
			}

			ul#cnet h1 {
				left: 100%;
				top: 0;
				background-position: 100% 0;
			}

			ul#cnet h2 {
				left: 0;
				top: 100%;
				background-position: 0 100%;
			}

		ul#cnet {
			display: block;
			font-size: 0;
			zoom: 1;
			height: 30px;
			float: left;
		}

			ul#cnet ul {
