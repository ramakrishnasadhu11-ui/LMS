				margin-right: 12px;
				width: 24px;
				height: 24px;
			}

			ul#cnet ul img {
				width: 16px;
				height: 16px;
			}

			ul#cnet img.over {
				display: none
			}

			ul#cnet li.dis a:hover img.over {
				display: none !important
			}

			ul#cnet li.dis a:hover img.def {
				display: inline !important
			}

			ul#cnet li:hover > a img.def {
				display: none
			}

			ul#cnet li:hover > a img.over {
				display: inline
			}

			ul#cnet span {
