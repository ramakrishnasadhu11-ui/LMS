            var rangeKeyLabel = getAdminSelectedRangeKey();
            adminLastComputedMetrics = {
                rangeLabel: rangeKeyLabel === "today" ? "Today" : (rangeKeyLabel === "7d" ? "Last 7 Days" : "Month to Date"),
