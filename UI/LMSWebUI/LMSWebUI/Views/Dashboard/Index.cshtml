                var option = document.createElement("option");
                option.value = country.Iso2 || "";
                option.textContent = (country.Flag || "") + " " + (country.Name || "") + " (" + (country.CallingCode || "") + ")";
                option.setAttribute("data-calling-code", country.CallingCode || "");
