    .dashboard-header-subtitle {
        margin: 6px 0 0;
        opacity: 0.92;
        font-size: 14px;
        font-weight: 500;
    }

    .subscription-billing-card {
        margin: 16px 0 18px;
        border-radius: 12px;
        border: 1px solid var(--els-border);
        background: #f8fbff;
        padding: 16px;
    }

    .subscription-billing-card.state-trial-active {
        border-color: rgba(22, 163, 106, 0.35);
        background: linear-gradient(120deg, #edf9f2 0%, #e4f6ec 100%);
    }

    .subscription-billing-card.state-trial-warning {
        border-color: rgba(217, 149, 32, 0.45);
        background: linear-gradient(120deg, #fff9eb 0%, #fff5dd 100%);
    }

    .subscription-billing-card.state-trial-expired {
        border-color: rgba(217, 72, 72, 0.45);
        background: linear-gradient(120deg, #fff4f4 0%, #ffebeb 100%);
    }

    .subscription-billing-card.state-paid-active {
        border-color: rgba(23, 59, 112, 0.3);
        background: linear-gradient(120deg, #eef4ff 0%, #e8f0ff 100%);
    }

    .subscription-billing-card.state-missing {
        border-color: rgba(100, 116, 139, 0.3);
        background: #f8fafc;
    }

    .subscription-billing-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        flex-wrap: wrap;
    }

    .subscription-billing-title {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: var(--els-text);
    }

    .subscription-billing-subtitle {
        margin: 5px 0 0;
        font-size: 13px;
        color: var(--els-text-muted);
        line-height: 1.5;
    }

    .subscription-billing-grid {
        margin-top: 14px;
        display: grid;
        grid-template-columns: repeat(4, minmax(150px, 1fr));
        gap: 10px;
    }

    .subscription-billing-metric {
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: rgba(255,255,255,0.86);
        padding: 10px 11px;
    }

    .subscription-billing-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: var(--els-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }

    .subscription-billing-value {
        display: block;
        margin-top: 4px;
        font-size: 15px;
