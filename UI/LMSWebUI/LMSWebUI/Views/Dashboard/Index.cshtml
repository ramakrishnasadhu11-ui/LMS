<script type='text/javascript'>
    var customerSearchRequest = null;
    var orderReferenceSearchRequest = null;
    var serverCustomers = [];
    var serverOrderReferences = [];
    var isAutocompleteRefresh = false;
    var isInvoiceAutocompleteRefresh = false;
    var isAdminDashboardUser = @Html.Raw(isAdminUser.ToString().ToLowerInvariant());
    var isSuperAdminDashboardUser = @Html.Raw(isSuperAdminUser.ToString().ToLowerInvariant());
    var adminInsightsIntervalHandle = null;
    var adminInsightsCountdownHandle = null;
    var adminInsightsNextRefreshAt = null;
    var adminInsightsIntervalMs = 60000;

    function asNumber(value) {
        var parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : 0;
    }

    function formatAmount(value) {
        return asNumber(value).toFixed(2);
    }

    function formatCurrency(value) {
        return "₹ " + formatAmount(value);
    }

    function formatDateTime(value) {
        var date = value instanceof Date ? value : new Date(value);
        if (isNaN(date.getTime())) {
            return "--";
        }

        return date.toLocaleDateString() + " " + date.toLocaleTimeString();
    }

    function updateAdminRefreshModeLabel(enabled) {
        var modeEl = document.getElementById("adminInsightsRefreshMode");
        if (!modeEl) {
            return;
        }

        modeEl.textContent = enabled ? "Auto (every 60s)" : "Manual";
    }

    function updateAdminNextRefreshLabel() {
        var nextEl = document.getElementById("adminInsightsNextRefresh");
        var inlineEl = document.getElementById("adminToolbarRefreshInfo");
        if (!nextEl) {
            return;
        }

        var autoRefreshCheckbox = document.getElementById("adminAutoRefreshChk");
        var autoEnabled = !!(autoRefreshCheckbox && autoRefreshCheckbox.checked);
        if (!autoEnabled) {
            nextEl.textContent = "Auto refresh off";
            if (inlineEl) {
                inlineEl.textContent = "Auto refresh off";
            }
            return;
        }

        if (!(adminInsightsNextRefreshAt instanceof Date) || isNaN(adminInsightsNextRefreshAt.getTime())) {
            nextEl.textContent = "--";
            if (inlineEl) {
                inlineEl.textContent = "Next refresh: --";
            }
            return;
        }

        var remainingMs = adminInsightsNextRefreshAt.getTime() - Date.now();
        if (remainingMs < 0) {
            remainingMs = 0;
        }

        var secondsText = Math.ceil(remainingMs / 1000) + "s";
        nextEl.textContent = secondsText;
        if (inlineEl) {
            inlineEl.textContent = "Next refresh: " + secondsText;
        }
    }

    function scheduleAdminNextRefreshCountdown() {
        if (adminInsightsCountdownHandle) {
            clearInterval(adminInsightsCountdownHandle);
            adminInsightsCountdownHandle = null;
        }

        updateAdminNextRefreshLabel();
        adminInsightsCountdownHandle = setInterval(updateAdminNextRefreshLabel, 1000);
    }

    function toDateOnlyKey(dateValue) {
        var dt = new Date(dateValue);
        if (isNaN(dt.getTime())) {
            return "";
        }

        var month = String(dt.getMonth() + 1).padStart(2, '0');
        var day = String(dt.getDate()).padStart(2, '0');
        return dt.getFullYear() + '-' + month + '-' + day;
    }

    function renderAdminBarRows(containerId, rows, valueFormatter) {
        var container = document.getElementById(containerId);
        if (!container) {
            return;
        }

        if (!rows || rows.length === 0) {
            container.innerHTML = "<div class='admin-insights-empty'>No data available.</div>";
            return;
        }

        var maxValue = rows.reduce(function (acc, row) {
            return Math.max(acc, asNumber(row.value));
        }, 0);
        if (maxValue <= 0) {
            maxValue = 1;
        }

        container.innerHTML = rows.map(function (row) {
            var width = Math.max(4, Math.round((asNumber(row.value) / maxValue) * 100));
            return "<div class='admin-chart-row'>"
                + "<span class='admin-chart-label'>" + row.label + "</span>"
                + "<div class='admin-chart-track'><div class='admin-chart-fill' style='width:" + width + "%;'></div></div>"
                + "<span class='admin-chart-value'>" + valueFormatter(asNumber(row.value)) + "</span>"
                + "</div>";
        }).join("");
    }

    function renderAdminListRows(containerId, rows) {
        var container = document.getElementById(containerId);
        if (!container) {
            return;
        }

        if (!rows || rows.length === 0) {
            container.innerHTML = "<div class='admin-insights-empty'>No data available.</div>";
            return;
        }

        container.innerHTML = rows.map(function (row) {
            var valueClass = row.valueClass ? ("admin-list-value " + row.valueClass) : "admin-list-value";
            return "<div class='admin-list-row'>"
                + "<span class='admin-list-label'>" + row.label + "</span>"
                + "<span class='" + valueClass + "'>" + row.value + "</span>"
                + "</div>";
        }).join("");
    }

    function getAdminSelectedRangeKey() {
        var rangeEl = document.getElementById("adminRangeFilter");
        return rangeEl ? (rangeEl.value || "mtd") : "mtd";
    }

    function getDateRangeByKey(rangeKey) {
        var now = new Date();
        var end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
        var start;

        if (rangeKey === "today") {
            start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
        } else if (rangeKey === "7d") {
            start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 6, 0, 0, 0, 0);
        } else {
            start = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
        }

        return { start: start, end: end };
    }

    function isWithinRange(dateValue, range) {
        var dt = new Date(dateValue);
        if (isNaN(dt.getTime())) {
            return false;
        }

        return dt >= range.start && dt <= range.end;
    }

    function topEntriesFromMap(mapObj, topCount) {
        return Object.keys(mapObj || {})
            .map(function (key) {
                return { key: key, value: asNumber(mapObj[key]) };
            })
            .sort(function (a, b) {
                return b.value - a.value;
            })
            .slice(0, topCount);
    }

    function buildTrendMap(rangeKey, range) {
        var trendMap = {};
        var now = new Date();

        if (rangeKey === "today") {
            var todayKey = toDateOnlyKey(now);
            trendMap[todayKey] = 0;
            return trendMap;
        }

        if (rangeKey === "7d") {
            for (var i = 6; i >= 0; i--) {
                var dt7 = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
                trendMap[toDateOnlyKey(dt7)] = 0;
            }

            return trendMap;
        }

        var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
        for (var d = 1; d <= daysInMonth; d++) {
            var dt = new Date(now.getFullYear(), now.getMonth(), d);
            var key = toDateOnlyKey(dt);
            if (dt >= range.start && dt <= range.end) {
                trendMap[key] = 0;
            }
        }

        return trendMap;
    }

    function exportAdminInsightsSnapshot(rows) {
        if (!rows || rows.length === 0) {
            return;
        }

        var csvHeader = "Metric,Value\n";
        var csvBody = rows.map(function (row) {
            var metric = (row.label || "").replace(/,/g, " ");
            var value = (row.value || "").toString().replace(/,/g, " ");
            return metric + "," + value;
        }).join("\n");

        var blob = new Blob([csvHeader + csvBody], { type: "text/csv;charset=utf-8;" });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = "admin-dashboard-snapshot.csv";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }

    function loadAdminInsightsDashboard(refreshSource) {
        var messageBox = document.getElementById("adminInsightsMessage");
        if (messageBox) {
            messageBox.style.display = "none";
            messageBox.textContent = "";
        }

        var rangeKey = getAdminSelectedRangeKey();
        var selectedRange = getDateRangeByKey(rangeKey);

        fetch('@Url.Action("GetStoreWorkflowOrders", "Customer")?status=&searchText=&_ts=' + Date.now(), {
            method: 'GET',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (response) { return response.json(); })
        .then(function (payload) {
            if (!payload || payload.success !== true) {
                throw new Error((payload && payload.message) || "Unable to load store dashboard insights.");
            }

            var orders = Array.isArray(payload.orders) ? payload.orders : [];
            var now = new Date();
            var todayKey = toDateOnlyKey(now);
            var mtdRange = getDateRangeByKey("mtd");
            var trendMap = buildTrendMap(rangeKey, selectedRange);

            var todayOrders = 0;
            var todaySales = 0;
            var monthOrders = 0;
            var monthSales = 0;
            var selectedOrders = 0;
            var selectedSales = 0;
            var selectedPaid = 0;
            var pendingPayments = 0;
            var pendingAmount = 0;
            var statusMap = { Received: 0, Processing: 0, Ready: 0, Delivered: 0 };
            var paymentModeCounts = { Cash: 0, UPI: 0, Card: 0, Wallet: 0, Other: 0 };
            var customerCountsInRange = {};
            var serviceSales = {};
            var customerLastOrderDate = {};
            var cancelCount = 0;
            var openAgeHoursTotal = 0;
            var openAgeOrders = 0;
            var stuckOrders = 0;
            var highUnpaidOrders = 0;

            orders.forEach(function (order) {
                var created = new Date(order.CreatedDate || order.createdDate || "");
                var amount = asNumber(order.OrderAmount || order.orderAmount || 0);
                var pending = asNumber(order.PendingAmount ?? order.pendingAmount ?? order.NetPayable ?? order.netPayable ?? 0);
                var status = (order.Status || order.status || "Received").toString();
                var normalizedStatus = status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
                var dateKey = toDateOnlyKey(created);
                var paidNow = asNumber(order.PaidNow || order.paidNow || 0);
                var customerName = (order.CustomerName || order.customerName || "Unknown").toString().trim() || "Unknown";
                var serviceName = (order.ServiceType || order.serviceType || "General").toString().trim() || "General";
                var paymentMode = (order.PaymentMode || order.paymentMode || "Other").toString().trim();
                var ageHours = isNaN(created.getTime()) ? 0 : ((now.getTime() - created.getTime()) / 3600000);

                if (statusMap.hasOwnProperty(normalizedStatus)) {
                    statusMap[normalizedStatus] += 1;
                }

                if (dateKey === todayKey) {
                    todayOrders += 1;
                    todaySales += amount;
                }

                if (isWithinRange(created, mtdRange)) {
                    monthOrders += 1;
                    monthSales += amount;
                }

                if (isWithinRange(created, selectedRange)) {
                    selectedOrders += 1;
                    selectedSales += amount;
                    selectedPaid += paidNow;
                    customerCountsInRange[customerName] = (customerCountsInRange[customerName] || 0) + 1;
                    serviceSales[serviceName] = (serviceSales[serviceName] || 0) + amount;

                    if (paymentModeCounts.hasOwnProperty(paymentMode)) {
                        paymentModeCounts[paymentMode] += 1;
                    } else {
                        paymentModeCounts.Other += 1;
                    }

                    if (trendMap.hasOwnProperty(dateKey)) {
                        trendMap[dateKey] += 1;
                    }
                }

                if (pending > 0) {
                    pendingPayments += 1;
                    pendingAmount += pending;

                    if (pending >= 500) {
                        highUnpaidOrders += 1;
                    }
                }

                if (normalizedStatus === "Cancelled") {
                    cancelCount += 1;
                }

                if (normalizedStatus !== "Delivered") {
                    openAgeHoursTotal += ageHours;
                    openAgeOrders += 1;
                    if (ageHours >= 24) {
                        stuckOrders += 1;
                    }
                }

                var lastOrderDate = customerLastOrderDate[customerName];
                if (!lastOrderDate || (!isNaN(created.getTime()) && created > lastOrderDate)) {
                    customerLastOrderDate[customerName] = created;
                }
            });

            var avgOrderValue = selectedOrders > 0 ? (selectedSales / selectedOrders) : 0;
            var topCustomers = topEntriesFromMap(customerCountsInRange, 3);
            var repeatCustomers = topCustomers.filter(function (x) { return x.value > 1; }).length;
            var repeatPercent = topCustomers.length > 0 ? ((repeatCustomers / topCustomers.length) * 100) : 0;
            var topServices = topEntriesFromMap(serviceSales, 3);
            var lowEngagementCount = Object.keys(customerLastOrderDate).filter(function (name) {
                var dt = customerLastOrderDate[name];
                if (!dt || isNaN(dt.getTime())) {
                    return false;
                }
                var days = (now.getTime() - dt.getTime()) / (24 * 3600000);
                return days > 30;
            }).length;
            var openAvgHours = openAgeOrders > 0 ? (openAgeHoursTotal / openAgeOrders) : 0;
            var pendingDeliveryCount = statusMap.Ready;
            var readyForDeliveryCount = statusMap.Ready;

            var todayOrdersEl = document.getElementById("adminKpiTodayOrders");
            var todaySalesEl = document.getElementById("adminKpiTodaySales");
            var monthOrdersEl = document.getElementById("adminKpiMonthOrders");
            var monthSalesEl = document.getElementById("adminKpiMonthSales");
            var pendingPaymentsEl = document.getElementById("adminKpiPendingPayments");
            var pendingAmountEl = document.getElementById("adminKpiPendingAmount");
            var collectedEl = document.getElementById("adminKpiCollectedAmount");
            var avgOrderValueEl = document.getElementById("adminKpiAvgOrderValue");
            var refreshedEl = document.getElementById("adminInsightsLastRefreshed");

            if (todayOrdersEl) todayOrdersEl.textContent = String(todayOrders);
            if (todaySalesEl) todaySalesEl.textContent = formatCurrency(todaySales);
            if (monthOrdersEl) monthOrdersEl.textContent = String(monthOrders);
            if (monthSalesEl) monthSalesEl.textContent = formatCurrency(monthSales);
            if (pendingPaymentsEl) pendingPaymentsEl.textContent = String(pendingPayments);
            if (pendingAmountEl) pendingAmountEl.textContent = formatCurrency(pendingAmount);
            if (collectedEl) collectedEl.textContent = formatCurrency(selectedPaid);
            if (avgOrderValueEl) avgOrderValueEl.textContent = formatCurrency(avgOrderValue);
            if (refreshedEl) {
                var nowRefreshed = new Date();
                var source = (refreshSource || "auto").toString();
                var sourceLabel = source === "manual" ? "Manual" : (source === "filter" ? "Filter" : "Auto");
                refreshedEl.textContent = formatDateTime(nowRefreshed) + " (" + sourceLabel + ")";
            }

            var inlineEl = document.getElementById("adminToolbarRefreshInfo");
            if (inlineEl) {
                var sourceText = (refreshSource || "auto").toString();
                var sourceLabelText = sourceText === "manual" ? "Manual refresh done" : (sourceText === "filter" ? "Filter refresh done" : "Auto refresh done");
                inlineEl.textContent = sourceLabelText;
            }

            var autoRefreshCheckbox = document.getElementById("adminAutoRefreshChk");
            if (autoRefreshCheckbox && autoRefreshCheckbox.checked) {
                adminInsightsNextRefreshAt = new Date(Date.now() + adminInsightsIntervalMs);
                updateAdminNextRefreshLabel();
            }

            renderAdminListRows("adminActionQueueRows", [
                { label: "Ready for Delivery", value: String(readyForDeliveryCount) },
                { label: "Pending Delivery", value: String(pendingDeliveryCount) },
                { label: "High Pending Payments", value: String(highUnpaidOrders), valueClass: highUnpaidOrders > 0 ? "alert" : "success" },
                { label: "Processing Backlog", value: String(statusMap.Processing) }
            ]);

            renderAdminListRows("adminRevenueRows", [
                { label: "Sales (Selected Range)", value: formatCurrency(selectedSales) },
                { label: "Collected (Selected Range)", value: formatCurrency(selectedPaid) },
                { label: "Pending Amount", value: formatCurrency(pendingAmount), valueClass: pendingAmount > 0 ? "alert" : "success" },
                { label: "Payment Split", value: "Cash " + paymentModeCounts.Cash + " | UPI " + paymentModeCounts.UPI + " | Card " + paymentModeCounts.Card + " | Wallet " + paymentModeCounts.Wallet }
            ]);

            renderAdminListRows("adminOperationsRows", [
                { label: "Open Orders", value: String(openAgeOrders) },
                { label: "Avg Open Order Age", value: openAvgHours.toFixed(1) + " hrs" },
                { label: "Stuck Orders (>24h)", value: String(stuckOrders), valueClass: stuckOrders > 0 ? "alert" : "success" },
                { label: "Cancellations", value: String(cancelCount) }
            ]);

            var topCustomerText = topCustomers.length
                ? topCustomers.map(function (x) { return x.key + " (" + x.value + ")"; }).join(", ")
                : "N/A";

            renderAdminListRows("adminCustomerRows", [
                { label: "Active Customers (Range)", value: String(Object.keys(customerCountsInRange).length) },
                { label: "Repeat Customer %", value: repeatPercent.toFixed(0) + "%" },
                { label: "Top Customers", value: topCustomerText },
                { label: "Low Engagement (>30d)", value: String(lowEngagementCount), valueClass: lowEngagementCount > 0 ? "alert" : "success" }
            ]);

            var topServiceText = topServices.length
                ? topServices.map(function (x) { return x.key + " (₹" + x.value.toFixed(0) + ")"; }).join(", ")
                : "N/A";

            renderAdminListRows("adminServiceRows", [
                { label: "Top Service Mix", value: topServiceText },
                { label: "Unique Services", value: String(Object.keys(serviceSales).length) },
                { label: "Top Service Revenue", value: topServices.length ? formatCurrency(topServices[0].value) : "₹ 0.00" },
                { label: "Service Coverage", value: selectedOrders > 0 ? (Object.keys(serviceSales).length + " types") : "N/A" }
            ]);

            renderAdminListRows("adminAlertRows", [
                { label: "Stuck Orders", value: String(stuckOrders), valueClass: stuckOrders > 0 ? "alert" : "success" },
                { label: "Large Unpaid Orders", value: String(highUnpaidOrders), valueClass: highUnpaidOrders > 0 ? "alert" : "success" },
                { label: "Pending Payments", value: String(pendingPayments), valueClass: pendingPayments > 0 ? "alert" : "success" },
                { label: "Email/Notification Failures", value: "N/A" }
            ]);

            renderAdminBarRows("adminStatusChartRows", [
                { label: "Received", value: statusMap.Received },
                { label: "Processing", value: statusMap.Processing },
                { label: "Ready", value: statusMap.Ready },
                { label: "Delivered", value: statusMap.Delivered }
            ], function (value) { return String(Math.round(value)); });

            var trendRows = Object.keys(trendMap).map(function (key) {
                var parts = key.split('-');
                var shortLabel = parts.length === 3 ? (parts[2] + '/' + parts[1]) : key;
                return { label: shortLabel, value: trendMap[key] };
            });

            renderAdminBarRows("adminTrendChartRows", trendRows, function (value) { return String(Math.round(value)); });

            var exportButton = document.getElementById("adminExportSnapshotBtn");
            if (exportButton) {
                exportButton.onclick = function () {
                    exportAdminInsightsSnapshot([
                        { label: "Today Orders", value: String(todayOrders) },
                        { label: "Today Sales", value: formatCurrency(todaySales) },
                        { label: "Month Orders", value: String(monthOrders) },
                        { label: "Month Sales", value: formatCurrency(monthSales) },
                        { label: "Pending Payments", value: String(pendingPayments) },
                        { label: "Pending Amount", value: formatCurrency(pendingAmount) },
                        { label: "Collected (Selected Range)", value: formatCurrency(selectedPaid) },
                        { label: "Avg Order Value", value: formatCurrency(avgOrderValue) },
                        { label: "Stuck Orders", value: String(stuckOrders) }
                    ]);
                };
            }
        })
        .catch(function (error) {
            if (messageBox) {
                messageBox.style.display = "block";
                messageBox.textContent = (error && error.message) || "Unable to load store dashboard insights.";
            }
        });
    }

    function setAdminInsightsAutoRefresh(enabled) {
        if (adminInsightsIntervalHandle) {
            clearInterval(adminInsightsIntervalHandle);
            adminInsightsIntervalHandle = null;
        }

        if (adminInsightsCountdownHandle) {
            clearInterval(adminInsightsCountdownHandle);
            adminInsightsCountdownHandle = null;
        }

        updateAdminRefreshModeLabel(enabled);

        if (enabled) {
            adminInsightsNextRefreshAt = new Date(Date.now() + adminInsightsIntervalMs);
            updateAdminNextRefreshLabel();
            scheduleAdminNextRefreshCountdown();
            adminInsightsIntervalHandle = setInterval(function () {
                loadAdminInsightsDashboard("auto");
            }, adminInsightsIntervalMs);
        } else {
            adminInsightsNextRefreshAt = null;
            updateAdminNextRefreshLabel();
        }
    }

    function autocomplete(inp, arr, onItemSelected)
         {
            var currentFocus;
            inp.addEventListener("input", function(e) {
            var a, b, i, val = this.value;
            closeAllLists();
            if (!val) { return false;}
            currentFocus = -1;
      a = document.createElement("DIV");
      a.setAttribute("id", this.id + "autocomplete-list");
      a.setAttribute("class", "autocomplete-items");
      this.parentNode.appendChild(a);
      for (i = 0; i < arr.length; i++) {
        var customerText = (arr[i] || "").toString().trim();
        if (!customerText) {
            continue;
        }

        b = document.createElement("DIV");
        b.innerHTML = customerText;
        b.innerHTML += "<input type='hidden' value='" + customerText + "'>";
            b.addEventListener("click", function(e) {
            var selectedItem = this.getElementsByTagName("input")[0].value;
            inp.value = selectedItem;
            closeAllLists();
            if (typeof onItemSelected === "function") {
                onItemSelected(selectedItem);
            }
        });
        a.appendChild(b);
      }
  });
  inp.addEventListener("keydown", function(e) {
      var x = document.getElementById(this.id + "autocomplete-list");
      if (x) x = x.getElementsByTagName("div");
      if (e.keyCode == 40) {
         currentFocus++;
        addActive(x);
      } else if (e.keyCode == 38) { //up
        currentFocus--;
        addActive(x);
      } else if (e.keyCode == 13) {
        e.preventDefault();
        if (currentFocus > -1) {
          if (x) x[currentFocus].click();
        }
      }
  });
  function addActive(x) {
    if (!x) return false;
    removeActive(x);
    if (currentFocus >= x.length) currentFocus = 0;
    if (currentFocus < 0) currentFocus = (x.length - 1);
    x[currentFocus].classList.add("autocomplete-active");
  }
  function removeActive(x) {
    for (var i = 0; i < x.length; i++) {
      x[i].classList.remove("autocomplete-active");
    }
  }
  function closeAllLists(elmnt) 
  {
    var x = document.getElementsByClassName("autocomplete-items");
    for (var i = 0; i < x.length; i++) {
      if (elmnt != x[i] && elmnt != inp) {
      x[i].parentNode.removeChild(x[i]);
    }
  }
}
document.addEventListener("click", function (e) 
{
    closeAllLists(e.target);
});
}

    $(function () {
        var initialSearchMode = '@searchMode'.toLowerCase();
        if (isAdminDashboardUser) {
            if (!isSuperAdminDashboardUser) {
                var adminRangeFilter = document.getElementById("adminRangeFilter");
                if (adminRangeFilter) {
                    adminRangeFilter.addEventListener("change", function () {
                        loadAdminInsightsDashboard("filter");
                    });
                }

                var adminRefreshInsightsBtn = document.getElementById("adminRefreshInsightsBtn");
                if (adminRefreshInsightsBtn) {
                    adminRefreshInsightsBtn.addEventListener("click", function () {
                        loadAdminInsightsDashboard("manual");
                    });
                }

                var adminAutoRefreshChk = document.getElementById("adminAutoRefreshChk");
                if (adminAutoRefreshChk) {
                    adminAutoRefreshChk.addEventListener("change", function (e) {
                        var checked = !!(e && e.target && e.target.checked);
                        setAdminInsightsAutoRefresh(checked);
                    });
                }

                loadAdminInsightsDashboard("initial");
                setAdminInsightsAutoRefresh(true);
            }
            return;
        }

        if (initialSearchMode === "invoice") {
            $("#searchInvoiceradio").show();
            $("#searchradio").hide();
            $("#invoice").prop("checked", true);
            $("#search").prop("checked", false);
        } else {
            $("#searchradio").show();
            $("#searchInvoiceradio").hide();
            $("#search").prop("checked", true);
            $("#invoice").prop("checked", false);
        }

        var searchInput = document.getElementById("searchCustomers");
        var invoiceInput = document.getElementById("searchInvoiceText");

        function triggerInvoiceReferenceLookup(referenceText) {
            var value = (referenceText || "").trim();
            if (!value) {
                setInvoiceSearchMessage("Please enter Order No or Invoice No.");
                return;
            }

            setInvoiceSearchMessage("");

            $.ajax({
                type: "GET",
                url: '@Url.Action("SearchOrderReference", "Customer")',
                data: { searchText: value },
                success: function (data) {
                    if (!data || data.success !== true) {
                        setInvoiceSearchMessage((data && data.message) ? data.message : "No order found.");
                        return;
                    }

                    var workflowSearchValue = (data.orderNo || data.invoiceNo || value || "");
                    var url = '@Url.Action("OrderWorkflow", "Customer")'
                        + '?searchText=' + encodeURIComponent(workflowSearchValue);

                    window.location.href = url;
                },
                error: function () {
                    setInvoiceSearchMessage("Unable to search order reference. Please try again.");
                }
            });
        }

        autocomplete(searchInput, serverCustomers, function (selectedCustomer) {
            setCustomerSearchMessage("");
            window.location.href = '@Url.Action("Index", "Customer")' + '?customerName=' + encodeURIComponent(selectedCustomer);
        });

        autocomplete(invoiceInput, serverOrderReferences, function (selectedReference) {
            triggerInvoiceReferenceLookup(selectedReference);
        });

        function setCustomerSearchMessage(message) {
            var messageBox = document.getElementById("customerSearchMessage");
            if (!messageBox) {
                return;
            }

            if (!message) {
                messageBox.textContent = "";
                messageBox.style.display = "none";
                return;
            }

            messageBox.textContent = message;
            messageBox.style.display = "block";
        }

        function setInvoiceSearchMessage(message) {
            var messageBox = document.getElementById("invoiceSearchMessage");
            if (!messageBox) {
                return;
            }

            if (!message) {
                messageBox.textContent = "";
                messageBox.style.display = "none";
                return;
            }

            messageBox.textContent = message;
            messageBox.style.display = "block";
        }

        searchInput.addEventListener("input", function () {
            if (isAutocompleteRefresh) {
                return;
            }

            var searchText = (this.value || "").trim();

            if (!searchText) {
                setCustomerSearchMessage("");
                return;
            }

            if (customerSearchRequest && customerSearchRequest.readyState !== 4) {
                customerSearchRequest.abort();
            }

            customerSearchRequest = $.ajax({
                type: "GET",
                url: '@Url.Action("SearchCustomers", "Customer")',
                data: { searchText: searchText },
                success: function (data) {
                    serverCustomers.length = 0;
                    $.each(data || [], function (_, item) {
                        serverCustomers.push(item);
                    });

                    setCustomerSearchMessage(serverCustomers.length === 0
                        ? 'No customer found for "' + searchText + '" in this store.'
                        : "");

                    isAutocompleteRefresh = true;
                    searchInput.dispatchEvent(new Event("input"));
                    isAutocompleteRefresh = false;
                },
                error: function (xhr, status) {
                    if (status === "abort") {
                        return;
                    }

                    serverCustomers.length = 0;
                    setCustomerSearchMessage("Unable to search customers. Please try again.");
                    isAutocompleteRefresh = true;
                    searchInput.dispatchEvent(new Event("input"));
                    isAutocompleteRefresh = false;
                }
            });
        });

        $("#searchCustomers").on("keydown", function (e) {
            if (e.keyCode !== 13) {
                return;
            }

            e.preventDefault();

            var customerSearchText = ($(this).val() || "").trim();
            if (!customerSearchText) {
                return;
            }

            var hasMatch = serverCustomers.some(function (item) {
                return (item || "").trim().toLowerCase() === customerSearchText.toLowerCase();
            });

            if (!hasMatch) {
                setCustomerSearchMessage('Customer "' + customerSearchText + '" does not exist in this store.');
                return;
            }

            setCustomerSearchMessage("");
            window.location.href = '@Url.Action("Index", "Customer")' + '?customerName=' + encodeURIComponent(customerSearchText);
        });

        $("#search").on("click", function () {
            $("#searchradio").show();
            $("#searchInvoiceradio").hide();
        });

        $("#invoice").on("click", function () {
            $("#searchInvoiceradio").show();
            $("#searchradio").hide();
        });

        $("#searchInvoiceText").on("keydown", function (e) {
            if (e.keyCode !== 13) {
                return;
            }

            e.preventDefault();

            var invoiceSearchText = ($(this).val() || "").trim();
            if (!invoiceSearchText) {
                setInvoiceSearchMessage("Please enter Order No or Invoice No.");
                return;
            }

            var hasMatch = serverOrderReferences.some(function (item) {
                return (item || "").trim().toLowerCase() === invoiceSearchText.toLowerCase();
            });

            if (!hasMatch && serverOrderReferences.length > 0) {
                setInvoiceSearchMessage('Order/Invoice "' + invoiceSearchText + '" does not exist in this store.');
                return;
            }

            triggerInvoiceReferenceLookup(invoiceSearchText);
        });

        if (invoiceInput) {
            invoiceInput.addEventListener("input", function () {
                if (isInvoiceAutocompleteRefresh) {
                    return;
                }

                var searchText = (this.value || "").trim();
                if (!searchText) {
                    serverOrderReferences.length = 0;
                    setInvoiceSearchMessage("");
                    return;
                }

                if (searchText.length < 3) {
                    setInvoiceSearchMessage("Type at least 3 characters to search Order/Invoice.");
                    return;
                }

                if (orderReferenceSearchRequest && orderReferenceSearchRequest.readyState !== 4) {
                    orderReferenceSearchRequest.abort();
                }

                orderReferenceSearchRequest = $.ajax({
                    type: "GET",
                    url: '@Url.Action("SearchOrderReferences", "Customer")',
                    data: { searchText: searchText, top: 20 },
                    success: function (data) {
                        serverOrderReferences.length = 0;
                        $.each(data || [], function (_, item) {
                            serverOrderReferences.push(item);
                        });

                        setInvoiceSearchMessage(serverOrderReferences.length === 0
                            ? 'No order/invoice found for "' + searchText + '" in this store.'
                            : "");

                        isInvoiceAutocompleteRefresh = true;
                        invoiceInput.dispatchEvent(new Event("input"));
                        isInvoiceAutocompleteRefresh = false;
                    },
                    error: function (xhr, status) {
                        if (status === "abort") {
                            return;
                        }

                        serverOrderReferences.length = 0;
                        setInvoiceSearchMessage("Unable to search order/invoice. Please try again.");
                        isInvoiceAutocompleteRefresh = true;
                        invoiceInput.dispatchEvent(new Event("input"));
                        isInvoiceAutocompleteRefresh = false;
                    }
                });
            });
        }
    });

    function DashboardTemplates()
    {
        localStorage.setItem("dashboard_name", $("#dashboard-name").val());
        window.location = "/Dashboard/TemplateList/";
    }

    function refreshLiveCounterDetails() {
        var now = new Date();
        var lastRefreshed = document.getElementById('lcLastRefreshed');
        if (lastRefreshed) {
            lastRefreshed.textContent = now.toLocaleTimeString();
        }
    }

    function setLiveCounterValue(elementId, value, fallbackValue) {
        var element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        if (value === null || value === undefined || value === "") {
            element.textContent = fallbackValue || "--";
            return;
        }

        element.textContent = value;
    }

    function setLiveCounterStatus(statusText) {
        var statusElement = document.getElementById("lcLiveStatus");
        if (!statusElement) {
            return;
        }

        statusElement.textContent = statusText;
    }

    function loadLiveCounterDashboardStats() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetLiveCounterDashboardStats", "Customer")',
            success: function (response) {
                if (!response || response.success !== true) {
                    setLiveCounterStatus((response && response.message) ? response.message : "Unable to load counters");
                    return;
                }

                setLiveCounterValue("lcTodayOrders", response.todayOrders, "0");
                setLiveCounterValue("lcWalkins", response.walkinsToday, "0");
                setLiveCounterValue("lcAdvanceUsed", response.advanceUsedToday, "0");
                setLiveCounterValue("lcPendingPayment", response.pendingPaymentCount, "0");

                var readyForDeliveryValue = response.readyForDeliveryCount;
                var pendingDeliveryValue = response.pendingDeliveryCount;

                setLiveCounterValue("lcReadyDelivery", readyForDeliveryValue, "N/A");
                setLiveCounterValue("lcPendingDelivery", pendingDeliveryValue, "N/A");

                var pendingAmount = response.pendingPaymentAmount || 0;
                var statusText = "Live";
                if (response.readyPendingReason) {
                    statusText += " (Delivery status pending API)";
                }
                statusText += " | Pending ₹" + pendingAmount;

                setLiveCounterStatus(statusText);
                refreshLiveCounterDetails();
            },
            error: function () {
                setLiveCounterStatus("Live counter API unavailable");
            }
        });
    }

    if (!isAdminDashboardUser) {
        loadLiveCounterDashboardStats();
        setInterval(loadLiveCounterDashboardStats, 30000);
    }
</script>
