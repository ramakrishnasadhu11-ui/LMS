                readyForDeliverySupportEl.textContent = readyForDeliveryCount > 0
                    ? "Orders are ready for customer handover."
                    : "No orders are waiting for delivery right now.";
            }

            setAdminSlaText("adminSla0to4", sla0to4);
            setAdminSlaText("adminSla4to12", sla4to12);
            setAdminSlaText("adminSla12to24", sla12to24);
            setAdminSlaText("adminSla24Plus", sla24Plus);

            var totalSlaCount = sla0to4 + sla4to12 + sla12to24 + sla24Plus;
            var slaDivisor = totalSlaCount > 0 ? totalSlaCount : 1;
            var seg0to4 = document.getElementById("adminSlaSeg0to4");
            var seg4to12 = document.getElementById("adminSlaSeg4to12");
            var seg12to24 = document.getElementById("adminSlaSeg12to24");
            var seg24Plus = document.getElementById("adminSlaSeg24Plus");
            var slaGridEl = document.getElementById("adminSlaGrid");
            var slaWrapEl = document.getElementById("adminSlaHealthWrap");
            var slaEmptyEl = document.getElementById("adminSlaEmptyState");
            if (seg0to4) seg0to4.style.width = ((sla0to4 / slaDivisor) * 100).toFixed(2) + "%";
            if (seg4to12) seg4to12.style.width = ((sla4to12 / slaDivisor) * 100).toFixed(2) + "%";
            if (seg12to24) seg12to24.style.width = ((sla12to24 / slaDivisor) * 100).toFixed(2) + "%";
            if (seg24Plus) seg24Plus.style.width = ((sla24Plus / slaDivisor) * 100).toFixed(2) + "%";

            if (slaGridEl) {
                slaGridEl.style.display = totalSlaCount === 0 ? "none" : "grid";
            }

            if (slaWrapEl) {
                slaWrapEl.style.display = totalSlaCount === 0 ? "none" : "block";
