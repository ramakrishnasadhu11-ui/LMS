        #dashboardEditCustomerModal .modal-dialog {
            width: calc(100% - 20px);
            margin: 18px auto;
        }

        #dashboardEditCustomerModal .edit-customer-modal-header,
        #dashboardEditCustomerModal .edit-customer-modal-body {
            padding: 20px;
        }

        #dashboardEditCustomerModal .edit-customer-fields {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        #dashboardEditCustomerModal .edit-customer-phone-group {
            grid-template-columns: minmax(118px, .85fr) minmax(0, 1.5fr);
        }

        #dashboardEditCustomerModal .edit-customer-field--wide,
        #dashboardEditCustomerModal .edit-customer-message {
            grid-column: auto;
        }

        #dashboardEditCustomerModal .edit-customer-modal-footer {
            flex-direction: column-reverse;
            padding: 16px 20px 20px;
        }

        #dashboardEditCustomerModal .edit-customer-action {
