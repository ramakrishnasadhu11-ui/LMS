@model LMSWebUI.Models.DashBoard.TenantInfoDto
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdminUser = Convert.ToBoolean(ViewData["IsAdminUser"] ?? false);
    var searchMode = Convert.ToString(ViewData["SearchMode"] ?? "customer");
    var currentUserRole = Convert.ToString(ViewData["UserRole"] ?? "StoreUser");
    var isSuperAdminUser = string.Equals(currentUserRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
    var tenantName = Model?.TenantName ?? "-";
    var tenantStore = Model?.TenantStore ?? "-";
    var dashboardTitle = Convert.ToString(ViewData["DashboardTitle"] ?? $"Welcome to {Model?.TenantStore} Store");
    var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);

    bool IsActiveAdminMenu(string actionName, string controllerName = "Customer")
    {
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
               && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);
    }
}
<style>
    .dashboard-page {
        padding: 24px;
    }

    .dashboard-box {
        max-width: 1200px;
        margin: 0 auto;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: visible;
    }

    .dashboard-header {
        background: linear-gradient(90deg, var(--els-primary) 0%, var(--els-primary-dark) 100%);
        color: #fff;
        padding: 20px;
    }

    .dashboard-header h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
    }

    .dashboard-body {
        padding: 24px;
        background: var(--els-surface);
    }

    .dashboard-header-subtitle {
        margin: 6px 0 0;
        opacity: 0.92;
        font-size: 14px;
        font-weight: 500;
    }

    .search-mode {
        margin-bottom: 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .search-mode label {
        margin: 0 0 0 6px;
        font-weight: 500;
    }

    .search-input-wrap {
        margin-bottom: 20px;
    }

    .autocomplete {
        position: relative;
    }

    #searchCustomers,
    #searchInvoiceText {
        height: 42px;
    }

    .search-no-result {
        display: none;
        margin-top: 6px;
        padding: 8px 12px;
        border: 1px solid var(--els-danger);
        border-radius: 6px;
        background: rgba(201, 48, 44, 0.08);
        color: var(--els-danger);
        font-size: 13px;
        font-weight: 600;
    }

    .autocomplete-items {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 999;
        border: 1px solid var(--els-border);
        border-top: none;
        background: var(--els-surface);
        max-height: 220px;
        overflow-y: auto;
    }

    .autocomplete-items div {
        padding: 10px 12px;
        cursor: pointer;
        border-bottom: 1px solid var(--els-border);
    }

    .autocomplete-items div:hover,
    .autocomplete-active {
        background-color: var(--els-accent);
    }

    .dashboard-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .admin-menu-wrap {
        margin-top: 20px;
    }

    .admin-menu-section + .admin-menu-section {
        margin-top: 24px;
    }

    .admin-menu-section-title {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        color: var(--els-primary-dark);
        margin: 0;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--els-border);
    }

    .admin-menu-section-desc {
        font-size: 13px;
        color: var(--els-text-muted, #6b7280);
        margin: 8px 0 14px;
    }

    .admin-menu-btn:focus-visible,
    .reports-link:focus-visible {
        outline: 2px solid var(--els-primary);
        outline-offset: 2px;
    }

    .admin-menu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 14px;
    }

    .admin-menu-card {
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-background);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 170px;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .admin-menu-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }

    .admin-menu-card-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--els-text);
        margin: 0;
    }

    .admin-menu-card-desc {
        font-size: 13px;
        color: var(--els-text-muted, #6b7280);
        min-height: 38px;
        margin: 0;
    }

    .admin-menu-btn {
        border: 1px solid transparent;
        border-radius: 8px;
        min-height: 40px;
        background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        padding: 0 12px;
        text-align: center;
        margin-top: auto;
    }

    .admin-menu-btn:hover {
        filter: brightness(0.97);
    }

    .admin-menu-card.active {
        border-color: var(--els-primary);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--els-primary) 40%, transparent);
    }

    .reports-panel {
        margin-top: 20px;
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-background);
        padding: 16px;
    }

    .reports-panel-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--els-text);
        margin: 0;
    }

    .reports-panel-desc {
        font-size: 13px;
        color: var(--els-text-muted, #6b7280);
        margin: 4px 0 14px;
    }

    .reports-link-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px;
    }

    .reports-group {
        border-top: 1px dashed var(--els-border);
        padding-top: 12px;
        margin-top: 12px;
    }

    .reports-group:first-of-type {
        border-top: none;
        padding-top: 0;
        margin-top: 0;
    }

    .reports-group-title {
        margin: 0 0 4px;
        font-size: 13px;
        font-weight: 700;
        color: var(--els-primary-dark);
    }

    .reports-group-desc {
        margin: 0 0 10px;
        font-size: 12px;
        color: #64748b;
    }

    .reports-link {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 12px;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        color: var(--els-text);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    }

    .reports-link:hover {
        background: var(--els-accent);
        border-color: var(--els-primary-light);
        color: var(--els-primary-dark);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .reports-link-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }

    .reports-link-name {
        font-size: 13px;
        font-weight: 700;
        color: inherit;
    }

    .reports-link-note {
        font-size: 11px;
        color: #64748b;
        font-weight: 500;
    }

    .reports-badge {
        border: 1px solid var(--els-border);
        border-radius: 999px;
        padding: 2px 7px;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

    .reports-badge.live { background: #e8f4ff; color: #1f4e79; }
    .reports-badge.daily { background: #eefbf3; color: #1b6e45; }
    .reports-badge.monthly { background: #fff7e8; color: #925f00; }
    .reports-badge.exception { background: #fdecec; color: #ab2f2f; }

    .live-counter-panel {
        margin-bottom: 18px;
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-background);
        padding: 14px;
    }

    .live-counter-title {
        margin: 0 0 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--els-primary-dark);
    }

    .live-counter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
    }

    .live-counter-item {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 10px;
    }

    .live-counter-label {
        display: block;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .live-counter-value {
        display: block;
        font-size: 18px;
        font-weight: 700;
        color: var(--els-text);
    }

    .live-counter-meta {
        margin-top: 10px;
        font-size: 12px;
        color: #64748b;
    }

    .admin-insights-panel {
        margin-bottom: 18px;
        border: 1px solid var(--els-border);
        border-radius: 10px;
        background: var(--els-background);
        padding: 14px;
    }

    .admin-insights-title {
        margin: 0 0 10px;
        font-size: 16px;
        font-weight: 700;
        color: var(--els-primary-dark);
    }

    .admin-insights-subtitle {
        margin: 0 0 12px;
        font-size: 12px;
        color: #64748b;
    }

    .admin-insights-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 8px 10px;
        margin-bottom: 12px;
    }

    .admin-insights-toolbar-left,
    .admin-insights-toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .admin-toolbar-label {
        margin: 0;
        font-size: 12px;
        font-weight: 600;
        color: #475467;
    }

    .admin-range-select {
        min-width: 140px;
        height: 34px;
        font-size: 12px;
    }

    .admin-scope-badge {
        border: 1px solid var(--els-border);
        background: var(--els-accent);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        color: var(--els-primary-dark);
        padding: 5px 10px;
    }

    .admin-auto-refresh-wrap {
        margin: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #475467;
        font-weight: 600;
    }

    .admin-refresh-inline-info {
        font-size: 11px;
        color: #64748b;
        font-weight: 600;
        padding: 4px 8px;
        border: 1px solid var(--els-border);
        border-radius: 999px;
        background: var(--els-background);
    }

    .admin-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .admin-kpi-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 10px;
    }

    .admin-kpi-label {
        display: block;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .admin-kpi-value {
        display: block;
        font-size: 20px;
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-chart-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .admin-chart-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 10px;
    }

    .admin-chart-title {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-chart-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .admin-chart-row {
        display: grid;
        grid-template-columns: 92px 1fr auto;
        gap: 8px;
        align-items: center;
        font-size: 12px;
    }

    .admin-chart-label {
        color: #475467;
        white-space: nowrap;
    }

    .admin-chart-track {
        position: relative;
        height: 8px;
        border-radius: 999px;
        background: var(--els-accent);
        overflow: hidden;
    }

    .admin-chart-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(180deg, var(--els-primary-light) 0%, var(--els-primary) 100%);
    }

    .admin-chart-value {
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-insights-meta {
        margin-top: 10px;
        font-size: 12px;
        color: #64748b;
    }

    .admin-insights-sections-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 12px;
    }

    .admin-insight-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 10px;
        min-height: 170px;
    }

    .admin-insight-card-title {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-insight-card-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .admin-list-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 7px 8px;
        border: 1px solid var(--els-border);
        border-radius: 6px;
        background: var(--els-background);
        font-size: 12px;
        color: var(--els-text);
    }

    .admin-list-label {
        color: #475467;
    }

    .admin-list-value {
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-list-value.alert {
        color: #b63838;
    }

    .admin-list-value.success {
        color: #2f8f46;
    }

    .admin-insights-empty {
        font-size: 12px;
        color: #64748b;
        border: 1px dashed var(--els-border);
        border-radius: 6px;
        padding: 10px;
        background: var(--els-surface);
    }

    @@media (max-width: 900px) {
        .admin-insights-sections-grid,
        .admin-chart-grid {
            grid-template-columns: 1fr;
        }

    }

</style>

<section class="content dashboard-page">
    <div class="box dashboard-box">
        <div class="dashboard-header">
            <h2>@dashboardTitle</h2>
            @if (isAdminUser)
            {
                @if (isSuperAdminUser)
                {
                    <p class="dashboard-header-subtitle">Review and approve tenant stores awaiting activation.</p>
                }
                else
                {
                    <p class="dashboard-header-subtitle">Manage store configuration, pricing policies, operations, and users from one place.</p>
                }
            }
        </div>
        <div class="dashboard-body">
            @if (!isAdminUser)
            {
                <div class="live-counter-panel" id="liveCounterPanel">
                    <h3 class="live-counter-title">Live Counter Dashboard</h3>
                    <div class="live-counter-grid">
                        <div class="live-counter-item">
                            <span class="live-counter-label">Today Orders</span>
                            <span class="live-counter-value" id="lcTodayOrders">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Ready for Delivery</span>
                            <span class="live-counter-value" id="lcReadyDelivery">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Pending Delivery</span>
                            <span class="live-counter-value" id="lcPendingDelivery">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Pending Payment</span>
                            <span class="live-counter-value" id="lcPendingPayment">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Walk-ins Today</span>
                            <span class="live-counter-value" id="lcWalkins">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Advance Used Today</span>
                            <span class="live-counter-value" id="lcAdvanceUsed">--</span>
                        </div>
                    </div>
                    <div class="live-counter-meta">
                        User Role: <b>@currentUserRole</b> | Tenant: <b>@tenantName</b> | Store: <b>@tenantStore</b> |
                        Last refreshed: <span id="lcLastRefreshed">--</span> | Status: <b id="lcLiveStatus">Initializing...</b>
                    </div>
                </div>

                <div class="search-mode">
                    <div>
                        <input type="radio" id="search" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? null : "checked")" />
                        <label for="search">Search Customer (Name, Address, Mobile Number, Membership Id or Customer Code)</label>
                    </div>
                    <div>
                        <input type="radio" id="invoice" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? "checked" : null)" />
                        <label for="invoice">Search Invoice</label>
                    </div>
                </div>

                <div id="searchradio" class="search-input-wrap autocomplete">
                    <div class="input-group">
                        <div class="input-group-btn">
                            <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Search All <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a href="#">Name</a></li>
                                <li><a href="#">Address</a></li>
                                <li><a href="#">Mobile</a></li>
                                <li><a href="#">Membership Id</a></li>
                                <li><a href="#">Customer Code</a></li>
                            </ul>
                        </div>
                        <input type="text" id="searchCustomers" class="form-control" placeholder="Search customer..." />
                    </div>
                    <div id="customerSearchMessage" class="search-no-result"></div>
                </div>

                <div class="form-group search-input-wrap" id="searchInvoiceradio">
                    <input type="text" id="searchInvoiceText" class="form-control" placeholder="Search Order No / Invoice No..." />
                    <div id="invoiceSearchMessage" class="search-no-result"></div>
                </div>
            }

            @if (!isAdminUser)
            {
                <div class="dashboard-actions">
                    <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Customer")'">
                        Add New Customer
                    </button>
                </div>
            }
            else if (isSuperAdminUser)
            {
                <div class="admin-menu-wrap">
                    <section class="admin-menu-section" aria-labelledby="superAdminGroupApprovals">
                        <h3 class="admin-menu-section-title" id="superAdminGroupApprovals">Tenant &amp; Store Approvals</h3>
                        <p class="admin-menu-section-desc">Approve tenant stores before they can be used. Store configuration and day-to-day operations are handled by each store's own admin.</p>
                        <div class="admin-menu-grid">
                            <div class="admin-menu-card @(IsActiveAdminMenu("TenantApproval") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Tenant Approval</p>
                                <p class="admin-menu-card-desc">Approve or reject newly registered tenants. Pending and rejected tenants cannot log in.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("TenantApproval", "Customer")'">Open</button>
                            </div>

                            <div class="admin-menu-card @(IsActiveAdminMenu("StoreActivation") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Store Activation</p>
                                <p class="admin-menu-card-desc">Review stores across all tenants and activate or deactivate them. Newly created stores stay inactive until approved here.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("StoreActivation", "Customer")'">Open</button>
                            </div>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="admin-insights-panel" id="adminInsightsPanel">
                    <h3 class="admin-insights-title">Store Business Snapshot</h3>
                    <p class="admin-insights-subtitle">Current store analytics: action queue, revenue, operations, customer trends, alerts and productivity.</p>
                    <div class="admin-insights-toolbar">
                        <div class="admin-insights-toolbar-left">
                            <label for="adminRangeFilter" class="admin-toolbar-label">Range</label>
                            <select id="adminRangeFilter" class="form-control admin-range-select">
                                <option value="today">Today</option>
                                <option value="7d">Last 7 Days</option>
                                <option value="mtd" selected>Month to Date</option>
                            </select>
                            <span class="admin-scope-badge" id="adminScopeBadge">Scope: Current Store</span>
                        </div>
                        <div class="admin-insights-toolbar-right">
                            <button type="button" class="btn btn-default" id="adminRefreshInsightsBtn">Refresh</button>
                            <button type="button" class="btn btn-default" id="adminExportSnapshotBtn">Export Snapshot</button>
                            <label class="admin-auto-refresh-wrap" for="adminAutoRefreshChk">
                                <input type="checkbox" id="adminAutoRefreshChk" checked /> Auto refresh
                            </label>
                            <span id="adminToolbarRefreshInfo" class="admin-refresh-inline-info">Next refresh: --</span>
                        </div>
                    </div>
                    <div class="admin-kpi-grid">
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Today Orders</span><span class="admin-kpi-value" id="adminKpiTodayOrders">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Today Sales</span><span class="admin-kpi-value" id="adminKpiTodaySales">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Month Orders</span><span class="admin-kpi-value" id="adminKpiMonthOrders">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Month Sales</span><span class="admin-kpi-value" id="adminKpiMonthSales">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Pending Payments</span><span class="admin-kpi-value" id="adminKpiPendingPayments">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Pending Amount</span><span class="admin-kpi-value" id="adminKpiPendingAmount">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Collected (Range)</span><span class="admin-kpi-value" id="adminKpiCollectedAmount">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Avg Order Value</span><span class="admin-kpi-value" id="adminKpiAvgOrderValue">--</span></div>
                    </div>

                    <div class="admin-insights-sections-grid">
                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Today Action Queue</h4>
                            <div class="admin-insight-card-body" id="adminActionQueueRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Revenue &amp; Payment Split</h4>
                            <div class="admin-insight-card-body" id="adminRevenueRows"></div>
                        </div>

