            }

            var inlineEl = document.getElementById("adminToolbarRefreshInfo");
            if (inlineEl) {
                var sourceText = (refreshSource || "auto").toString();
                var sourceLabelText = sourceText === "manual" ? "Manual refresh done" : (sourceText === "filter" ? "Filter refresh done" : "Auto refresh done");
                inlineEl.textContent = sourceLabelText;
