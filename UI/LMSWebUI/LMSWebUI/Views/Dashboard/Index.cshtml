        }).join("");
    }

    function getAdminSelectedRangeKey() {
        var rangeEl = document.getElementById("adminRangeFilter");
        return rangeEl ? (rangeEl.value || "mtd") : "mtd";
    }

    function getDateRangeByKey(rangeKey) {
        var now = new Date();
        var end = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59, 999);
        var start;

        if (rangeKey === "today") {
            start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
        } else if (rangeKey === "7d") {
            start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 6, 0, 0, 0, 0);
        } else {
            start = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
        }

        return { start: start, end: end };
    }

    function isWithinRange(dateValue, range) {
        var dt = new Date(dateValue);
        if (isNaN(dt.getTime())) {
            return false;
        }

        return dt >= range.start && dt <= range.end;
    }

    function topEntriesFromMap(mapObj, topCount) {
        return Object.keys(mapObj || {})
            .map(function (key) {
                return { key: key, value: asNumber(mapObj[key]) };
            })
            .sort(function (a, b) {
                return b.value - a.value;
            })
            .slice(0, topCount);
    }

    function buildTrendMap(rangeKey, range) {
        var trendMap = {};
        var now = new Date();

        if (rangeKey === "today") {
            var todayKey = toDateOnlyKey(now);
            trendMap[todayKey] = 0;
            return trendMap;
        }

        if (rangeKey === "7d") {
            for (var i = 6; i >= 0; i--) {
                var dt7 = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
                trendMap[toDateOnlyKey(dt7)] = 0;
            }

            return trendMap;
        }

        var daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
        for (var d = 1; d <= daysInMonth; d++) {
            var dt = new Date(now.getFullYear(), now.getMonth(), d);
            var key = toDateOnlyKey(dt);
            if (dt >= range.start && dt <= range.end) {
                trendMap[key] = 0;
            }
        }

        return trendMap;
    }

    function exportAdminInsightsSnapshot(rows) {
        if (!rows || rows.length === 0) {
            return;
        }

        var csvHeader = "Metric,Value\n";
        var csvBody = rows.map(function (row) {
            var metric = (row.label || "").replace(/,/g, " ");
            var value = (row.value || "").toString().replace(/,/g, " ");
            return metric + "," + value;
        }).join("\n");

        var blob = new Blob([csvHeader + csvBody], { type: "text/csv;charset=utf-8;" });
        var url = URL.createObjectURL(blob);
        var link = document.createElement("a");
        link.href = url;
        link.download = "admin-dashboard-snapshot.csv";
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }

