    function loadAdminInsightsDashboard(refreshSource) {
        var messageBox = document.getElementById("adminInsightsMessage");
        if (messageBox) {
            messageBox.style.display = "none";
            messageBox.textContent = "";
        }

        var rangeKey = getAdminSelectedRangeKey();
        var selectedRange = getDateRangeByKey(rangeKey);
        var requestUrl = '@Url.Action("GetStoreWorkflowOrders", "Customer")?status=&searchText=&_ts=' + Date.now();

        function onLoadError(httpStatus, message) {
            if (messageBox) {
                messageBox.style.display = "block";
                var statusSuffix = httpStatus ? (" (HTTP " + httpStatus + ")") : "";
                messageBox.textContent = (message || "Unable to load store dashboard insights.") + statusSuffix;
            }
            setAdminSlaText("adminSla0to4", 0);
            setAdminSlaText("adminSla4to12", 0);
            setAdminSlaText("adminSla12to24", 0);
            setAdminSlaText("adminSla24Plus", 0);

            var summaryEl = document.getElementById("adminEbjSummaryText");
            if (summaryEl) {
                summaryEl.textContent = "Unable to load admin summary. Please refresh or re-login if session expired.";
            }
        }

        function onLoadSuccess(payload) {
                if (!payload || payload.success !== true) {
                    onLoadError(0, (payload && payload.message) || "Unable to load store dashboard insights.");
                    return;
                }

            var orders = Array.isArray(payload.orders) ? payload.orders : [];
            var now = new Date();
            var todayKey = toDateOnlyKey(now);
            var mtdRange = getDateRangeByKey("mtd");
            var trendMap = buildTrendMap(rangeKey, selectedRange);

            var todayOrders = 0;
            var todaySales = 0;
            var monthOrders = 0;
            var monthSales = 0;
            var selectedOrders = 0;
            var selectedSales = 0;
            var selectedPaid = 0;
            var pendingPayments = 0;
            var pendingAmount = 0;
            var statusMap = { Received: 0, Processing: 0, Ready: 0, Delivered: 0 };
            var paymentModeCounts = { Cash: 0, UPI: 0, Card: 0, Wallet: 0, Other: 0 };
            var customerCountsInRange = {};
            var serviceSales = {};
            var customerLastOrderDate = {};
            var cancelCount = 0;
            var openAgeHoursTotal = 0;
            var openAgeOrders = 0;
            var stuckOrders = 0;
            var highUnpaidOrders = 0;
            var sla0to4 = 0;
            var sla4to12 = 0;
            var sla12to24 = 0;
            var sla24Plus = 0;

            orders.forEach(function (order) {
                order = order || {};
                var created = new Date(order.CreatedDate || order.createdDate || "");
                var amount = asNumber(order.OrderAmount || order.orderAmount || 0);
                var pendingRaw = (order.PendingAmount != null ? order.PendingAmount : (order.pendingAmount != null ? order.pendingAmount : (order.NetPayable != null ? order.NetPayable : (order.netPayable != null ? order.netPayable : 0))));
                var pending = asNumber(pendingRaw);
                var status = (order.Status || order.status || "Received").toString();
                var normalizedStatus = status.charAt(0).toUpperCase() + status.slice(1).toLowerCase();
                var dateKey = toDateOnlyKey(created);
                var paidNow = asNumber(order.PaidNow || order.paidNow || 0);
                var customerName = (order.CustomerName || order.customerName || "Unknown").toString().trim() || "Unknown";
                var serviceName = (order.ServiceType || order.serviceType || "General").toString().trim() || "General";
                var paymentMode = (order.PaymentMode || order.paymentMode || "Other").toString().trim();
                var ageHours = isNaN(created.getTime()) ? 0 : ((now.getTime() - created.getTime()) / 3600000);

                if (statusMap.hasOwnProperty(normalizedStatus)) {
                    statusMap[normalizedStatus] += 1;
                }

                if (dateKey === todayKey) {
                    todayOrders += 1;
                    todaySales += amount;
                }

                if (isWithinRange(created, mtdRange)) {
                    monthOrders += 1;
                    monthSales += amount;
                }

                if (isWithinRange(created, selectedRange)) {
                    selectedOrders += 1;
                    selectedSales += amount;
                    selectedPaid += paidNow;
                    customerCountsInRange[customerName] = (customerCountsInRange[customerName] || 0) + 1;
                    serviceSales[serviceName] = (serviceSales[serviceName] || 0) + amount;

                    if (paymentModeCounts.hasOwnProperty(paymentMode)) {
                        paymentModeCounts[paymentMode] += 1;
                    } else {
                        paymentModeCounts.Other += 1;
                    }

                    if (trendMap.hasOwnProperty(dateKey)) {
                        trendMap[dateKey] += 1;
                    }
                }

                if (pending > 0) {
                    pendingPayments += 1;
                    pendingAmount += pending;

                    if (pending >= 500) {
                        highUnpaidOrders += 1;
                    }
                }

                if (normalizedStatus === "Cancelled") {
                    cancelCount += 1;
                }

                if (normalizedStatus !== "Delivered") {
                    openAgeHoursTotal += ageHours;
                    openAgeOrders += 1;
                    if (ageHours >= 24) {
                        stuckOrders += 1;
                    }

                    if (ageHours < 4) {
                        sla0to4 += 1;
                    } else if (ageHours < 12) {
                        sla4to12 += 1;
                    } else if (ageHours < 24) {
                        sla12to24 += 1;
                    } else {
                        sla24Plus += 1;
                    }
                }

                var lastOrderDate = customerLastOrderDate[customerName];
                if (!lastOrderDate || (!isNaN(created.getTime()) && created > lastOrderDate)) {
                    customerLastOrderDate[customerName] = created;
                }
            });

            var avgOrderValue = selectedOrders > 0 ? (selectedSales / selectedOrders) : 0;
            var topCustomers = topEntriesFromMap(customerCountsInRange, 3);
            var repeatCustomers = topCustomers.filter(function (x) { return x.value > 1; }).length;
            var repeatPercent = topCustomers.length > 0 ? ((repeatCustomers / topCustomers.length) * 100) : 0;
            var topServices = topEntriesFromMap(serviceSales, 3);
            var lowEngagementCount = Object.keys(customerLastOrderDate).filter(function (name) {
                var dt = customerLastOrderDate[name];
                if (!dt || isNaN(dt.getTime())) {
                    return false;
                }
                var days = (now.getTime() - dt.getTime()) / (24 * 3600000);
                return days > 30;
            }).length;
            var openAvgHours = openAgeOrders > 0 ? (openAgeHoursTotal / openAgeOrders) : 0;
            var pendingDeliveryCount = statusMap.Ready;
            var readyForDeliveryCount = statusMap.Ready;

            var todayOrdersEl = document.getElementById("adminKpiTodayOrders");
            var todaySalesEl = document.getElementById("adminKpiTodaySales");
            var monthOrdersEl = document.getElementById("adminKpiMonthOrders");
            var monthSalesEl = document.getElementById("adminKpiMonthSales");
            var pendingPaymentsEl = document.getElementById("adminKpiPendingPayments");
            var pendingAmountEl = document.getElementById("adminKpiPendingAmount");
            var collectedEl = document.getElementById("adminKpiCollectedAmount");
            var avgOrderValueEl = document.getElementById("adminKpiAvgOrderValue");
            var refreshedEl = document.getElementById("adminInsightsLastRefreshed");

            if (todayOrdersEl) todayOrdersEl.textContent = String(todayOrders);
            if (todaySalesEl) todaySalesEl.textContent = formatCurrency(todaySales);
            if (monthOrdersEl) monthOrdersEl.textContent = String(monthOrders);
            if (monthSalesEl) monthSalesEl.textContent = formatCurrency(monthSales);
            if (pendingPaymentsEl) pendingPaymentsEl.textContent = String(pendingPayments);
            if (pendingAmountEl) pendingAmountEl.textContent = formatCurrency(pendingAmount);
            if (collectedEl) collectedEl.textContent = formatCurrency(selectedPaid);
