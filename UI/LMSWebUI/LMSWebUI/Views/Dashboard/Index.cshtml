    }

    .subscription-spotlight-cta:hover,
    .subscription-spotlight-cta:focus {
        text-decoration: none;
        color: #111827;
        box-shadow: 0 8px 18px rgba(227, 188, 92, 0.32);
    }

    .subscription-spotlight-dismiss {
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        padding: 9px 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .subscription-entry-point {
        margin-bottom: 16px;
        border-radius: 10px;
        border: 1px solid #d7e3ff;
        background: #f8fbff;
        color: #123b91;
