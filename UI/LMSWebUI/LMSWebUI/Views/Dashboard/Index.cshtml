        margin-top: 8px;
        font-size: 12px;
        color: #475467;
    }

    .admin-insights-sections-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 12px;
    }

    .admin-insight-card {
        border: 1px solid var(--els-border);
        border-radius: 8px;
        background: var(--els-surface);
        padding: 10px;
        min-height: 170px;
    }

    .admin-insight-card-title {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-insight-card-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .admin-list-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        padding: 7px 8px;
        border: 1px solid var(--els-border);
        border-radius: 6px;
        background: var(--els-background);
        font-size: 12px;
        color: var(--els-text);
    }

    .admin-list-label {
        color: #475467;
    }

    .admin-list-value {
        font-weight: 700;
        color: var(--els-text);
    }

    .admin-list-value.alert {
        color: #b63838;
    }

    .admin-list-value.success {
        color: #2f8f46;
    }

    .admin-insights-empty {
        font-size: 12px;
        color: #64748b;
        border: 1px dashed var(--els-border);
        border-radius: 6px;
        padding: 10px;
        background: var(--els-surface);
    }

    @@media (max-width: 900px) {
        .admin-insights-sections-grid,
        .admin-chart-grid {
            grid-template-columns: 1fr;
        }

        .admin-sla-grid {
            grid-template-columns: repeat(2, minmax(120px, 1fr));
        }

    }

</style>

<section class="content dashboard-page">
    <div class="box dashboard-box">
        <div class="dashboard-header">
            <h2>@dashboardTitle</h2>
            @if (isAdminUser)
            {
                @if (isSuperAdminUser)
                {
                    <p class="dashboard-header-subtitle">Review and approve tenant stores awaiting activation.</p>
                }
                else
                {
                    <p class="dashboard-header-subtitle">Manage store configuration, pricing policies, operations, and users from one place.</p>
                }
            }
        </div>
        <div class="dashboard-body">
            @if (!isAdminUser)
            {
                <div class="live-counter-panel" id="liveCounterPanel">
                    <h3 class="live-counter-title">Live Counter Dashboard</h3>
                    <div class="live-counter-grid">
                        <div class="live-counter-item">
                            <span class="live-counter-label">Today Orders</span>
                            <span class="live-counter-value" id="lcTodayOrders">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Ready for Delivery</span>
                            <span class="live-counter-value" id="lcReadyDelivery">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Pending Delivery</span>
                            <span class="live-counter-value" id="lcPendingDelivery">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Pending Payment</span>
                            <span class="live-counter-value" id="lcPendingPayment">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Walk-ins Today</span>
                            <span class="live-counter-value" id="lcWalkins">--</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Advance Used Today</span>
                            <span class="live-counter-value" id="lcAdvanceUsed">--</span>
                        </div>
                    </div>
                    <div class="live-counter-meta">
                        User Role: <b>@currentUserRole</b> | Tenant: <b>@tenantName</b> | Store: <b>@tenantStore</b> |
                        Last refreshed: <span id="lcLastRefreshed">--</span> | Status: <b id="lcLiveStatus">Initializing...</b>
                    </div>
                </div>

                <div class="store-action-board" id="storeImmediateActions">
                    <div class="store-board-header">Immediate Actions for Store User</div>
                    <div class="store-action-grid">
                        <a class="store-action-card alert" href="@Url.Action("OrderWorkflow", "Customer")?status=Ready">
                            <div class="store-action-title">Ready for delivery</div>
                            <div class="store-action-value" id="actReadyCount">--</div>
                            <div class="store-action-note">Deliver now and close open pickups</div>
                        </a>
                        <a class="store-action-card alert" href="@Url.Action("OrderWorkflow", "Customer")?status=Received">
                            <div class="store-action-title">Pending processing</div>
                            <div class="store-action-value" id="actPendingCount">--</div>
                            <div class="store-action-note">Move quickly to avoid delays</div>
                        </a>
                        <a class="store-action-card" href="@Url.Action("OrderWorkflow", "Customer")?status=&searchText=" id="actUnpaidLink">
                            <div class="store-action-title">Pending payment cases</div>
                            <div class="store-action-value" id="actPendingPaymentCount">--</div>
                            <div class="store-action-note">Collect dues and settle orders</div>
                        </a>
                        <a class="store-action-card success" href="@Url.Action("SetupCreateOrder", "Customer")">
                            <div class="store-action-title">Create new order</div>
                            <div class="store-action-value">+</div>
                            <div class="store-action-note">Fast billing for walk-in customers</div>
                        </a>
                    </div>
                </div>

                <div class="owner-summary-board" id="storeOwnerSummary">
                    <div class="store-board-header">Owner Summary Snapshot</div>
                    <div class="owner-summary-grid">
                        <div class="owner-summary-item">
                            <span class="owner-summary-label">Today Orders</span>
                            <span class="owner-summary-value" id="ownerTodayOrders">--</span>
                        </div>
                        <div class="owner-summary-item">
                            <span class="owner-summary-label">Ready for Delivery</span>
                            <span class="owner-summary-value" id="ownerReadyOrders">--</span>
                        </div>
                        <div class="owner-summary-item">
                            <span class="owner-summary-label">Pending Payment Amount</span>
                            <span class="owner-summary-value" id="ownerPendingAmount">--</span>
                        </div>
                        <div class="owner-summary-item">
                            <span class="owner-summary-label">Average Ticket (Today)</span>
                            <span class="owner-summary-value" id="ownerAvgTicket">--</span>
                        </div>
                    </div>
                </div>

                <div class="search-mode">
                    <div class="search-option" id="searchOptionCustomer">
                        <input type="radio" id="search" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? null : "checked")" />
                        <label for="search">Search Customer (Name, Address, Mobile Number, Membership Id or Customer Code)</label>
                    </div>
                    <div class="search-option" id="searchOptionInvoice">
                        <input type="radio" id="invoice" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? "checked" : null)" />
                        <label for="invoice">Search Invoice</label>
                    </div>
                </div>

                <div id="searchradio" class="search-input-wrap autocomplete">
                    <div class="input-group">
                        <div class="input-group-btn">
                            <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Search All <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a href="#">Name</a></li>
                                <li><a href="#">Address</a></li>
                                <li><a href="#">Mobile</a></li>
                                <li><a href="#">Membership Id</a></li>
                                <li><a href="#">Customer Code</a></li>
                            </ul>
                        </div>
                        <input type="text" id="searchCustomers" class="form-control" placeholder="Search customer..." autocomplete="off" />
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-primary" id="customerSearchGoBtn">Go</button>
                        </span>
                    </div>
                    <div class="search-hint">Type to search. Use ↑/↓ to navigate suggestions and Enter to load customer history.</div>
                    <div id="customerSearchMessage" class="search-no-result"></div>
                </div>

                <div class="form-group search-input-wrap" id="searchInvoiceradio">
                    <div class="input-group">
                        <input type="text" id="searchInvoiceText" class="form-control" placeholder="Search Order No / Invoice No..." autocomplete="off" />
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-primary" id="invoiceSearchGoBtn">Go</button>
                        </span>
                    </div>
                    <div class="search-hint">Partial match supported. Press Enter to preview invoice details and then open workflow.</div>
                    <div id="invoiceSearchMessage" class="search-no-result"></div>
                </div>

                <div id="invoicePreviewPanel" class="invoice-preview-panel" style="display:none;">
                    <div class="invoice-preview-header" id="invoicePreviewHeader">Invoice details</div>
                    <div class="invoice-preview-body" id="invoicePreviewBody"></div>
                    <div class="invoice-preview-actions">
                        <button type="button" class="btn btn-primary" id="invoiceOpenWorkflowBtn">Open in Workflow</button>
                        <button type="button" class="btn btn-default" id="invoicePreviewClearBtn">Clear</button>
                    </div>
                </div>

                <div id="customerOrdersPanel" class="customer-orders-panel" style="display:none;">
                    <div id="customerOrdersHeader" class="customer-orders-header">Customer order history</div>
                    <div class="customer-history-filters" id="customerHistoryFilters" style="display:none;">
                        <div class="customer-history-quick-filters">
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="today">Today</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="last7">Last 7 days</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="thisMonth">This Month</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="clear">Clear Range</button>
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryStatus">Status</label>
                            <select id="customerHistoryStatus" class="form-control">
                                <option value="">All Status</option>
                                <option value="received">Received</option>
                                <option value="processing">Processing</option>
                                <option value="ready">Ready</option>
                                <option value="delivered">Delivered</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryFromDate">From Date</label>
                            <input type="date" id="customerHistoryFromDate" class="form-control" />
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryToDate">To Date</label>
                            <input type="date" id="customerHistoryToDate" class="form-control" />
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistorySearchText">Search Order / Invoice</label>
                            <input type="text" id="customerHistorySearchText" class="form-control" placeholder="Order / Invoice" />
                        </div>
                        <div class="filter-actions">
                            <button type="button" id="customerHistoryApplyBtn" class="btn btn-default">Apply</button>
                            <button type="button" id="customerHistoryResetBtn" class="btn btn-link">Reset</button>
                        </div>
                    </div>
                    <div class="customer-orders-wrap">
                        <table class="customer-orders-table">
                            <thead>
                                <tr>
                                    <th>Order No</th>
                                    <th>Invoice No</th>
                                    <th>Date (UTC)</th>
                                    <th>Status</th>
                                    <th>Items</th>
                                    <th class="num">Pieces</th>
                                    <th class="num">Total Amount</th>
                                    <th class="num">Paid Amount</th>
                                    <th class="num">Pending Balance</th>
                                </tr>
                            </thead>
                            <tbody id="customerOrdersBody">
                                <tr><td colspan="9" class="customer-orders-state">Search and select a customer to view all orders.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (!isAdminUser)
            {
                <div class="customer-workbench">
                    <div class="customer-workbench-meta" id="selectedCustomerMeta">Selected customer: None</div>
                    <div class="dashboard-actions">
                        <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Customer")'">
                            Add New Customer
                        </button>
                        <button type="button" class="btn btn-primary" id="dashboardCreateOrderBtn" disabled>
                            Create New Order
                        </button>
                        <button type="button" class="btn btn-default" id="dashboardEditCustomerBtn" disabled>
                            Edit Customer
                        </button>
                        <button type="button" class="btn btn-danger" id="dashboardDeleteCustomerBtn" disabled>
                            Delete Customer
                        </button>
                    </div>
                    <div id="customerActionMessage" class="search-no-result" style="display:none;"></div>
                </div>
                <div class="dashboard-actions" style="margin-top:10px;">
                    <button type="button" class="btn btn-default" id="dashboardClearCustomerBtn">
                        Clear Selected Customer
                    </button>
                    <button type="button" class="btn btn-default" id="dashboardRefreshCustomerOrdersBtn" disabled>
                        Refresh Customer Orders
                    </button>
                </div>
            }

            @if (!isAdminUser)
            {
                <div id="dashboardEditCustomerModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="dashboardEditCustomerModalLabel">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="dashboardEditCustomerModalLabel">Edit Customer</h4>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label for="editCustomerName">Customer Name</label>
                                    <input type="text" id="editCustomerName" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="editCustomerAddress">Address</label>
                                    <input type="text" id="editCustomerAddress" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="editCustomerPhone">Phone Number</label>
                                    <input type="text" id="editCustomerPhone" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="editCustomerEmail">Email</label>
                                    <input type="email" id="editCustomerEmail" class="form-control" />
                                </div>
                                <div id="editCustomerMessage" class="search-no-result" style="display:none;"></div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="dashboardSaveCustomerBtn">Save Changes</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (isSuperAdminUser)
            {
                <div class="admin-menu-wrap">
                    <section class="admin-menu-section" aria-labelledby="superAdminGroupApprovals">
                        <h3 class="admin-menu-section-title" id="superAdminGroupApprovals">Tenant &amp; Store Approvals</h3>
                        <p class="admin-menu-section-desc">Approve tenant stores before they can be used. Store configuration and day-to-day operations are handled by each store's own admin.</p>
                        <div class="admin-menu-grid">
                            <div class="admin-menu-card @(IsActiveAdminMenu("TenantApproval") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Tenant Approval</p>
                                <p class="admin-menu-card-desc">Approve or reject newly registered tenants. Pending and rejected tenants cannot log in.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("TenantApproval", "Customer")'">Open</button>
                            </div>

                            <div class="admin-menu-card @(IsActiveAdminMenu("StoreActivation") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Store Activation</p>
                                <p class="admin-menu-card-desc">Review stores across all tenants and activate or deactivate them. Newly created stores stay inactive until approved here.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("StoreActivation", "Customer")'">Open</button>
                            </div>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="admin-insights-panel" id="adminInsightsPanel">
                    <h3 class="admin-insights-title">Store Business Snapshot</h3>
                    <p class="admin-insights-subtitle">Current store analytics: action queue, revenue, operations, customer trends, alerts and productivity.</p>
                    <div class="admin-insights-toolbar">
                        <div class="admin-insights-toolbar-left">
                            <label for="adminRangeFilter" class="admin-toolbar-label">Range</label>
                            <select id="adminRangeFilter" class="form-control admin-range-select">
                                <option value="today">Today</option>
                                <option value="7d">Last 7 Days</option>
                                <option value="mtd" selected>Month to Date</option>
                            </select>
                            <span class="admin-scope-badge" id="adminScopeBadge">Scope: Current Store</span>
                        </div>
                        <div class="admin-insights-toolbar-right">
                            <button type="button" class="btn btn-default" id="adminRefreshInsightsBtn">Refresh</button>
                            <button type="button" class="btn btn-default" id="adminExportSnapshotBtn">Export Snapshot</button>
                            <label class="admin-auto-refresh-wrap" for="adminAutoRefreshChk">
                                <input type="checkbox" id="adminAutoRefreshChk" checked /> Auto refresh
                            </label>
                            <span id="adminToolbarRefreshInfo" class="admin-refresh-inline-info">Next refresh: --</span>
                        </div>
                    </div>

                    <div class="admin-ebj-suite" id="adminEbjSuite">
                        <div class="admin-ebj-suite-header">
                            <div>
                                <h4 class="admin-ebj-suite-title">Admin Dashboard - EBJ Store</h4>
                                <p class="admin-ebj-suite-subtitle">Daily KPI focus, SLA monitor, and reporting actions for quick business decisions.</p>
                            </div>
                            <div class="admin-report-actions">
                                <button type="button" class="btn btn-default" id="adminPrintSummaryBtn">Print Summary</button>
                                <button type="button" class="btn btn-default" id="adminEmailSummaryBtn">Email Summary</button>
                            </div>
                        </div>
                        <div class="admin-sla-grid">
                            <div class="admin-sla-card">
                                <span class="admin-sla-label">SLA &lt; 4h</span>
                                <span class="admin-sla-value success" id="adminSla0to4">--</span>
                            </div>
                            <div class="admin-sla-card">
                                <span class="admin-sla-label">SLA 4-12h</span>
                                <span class="admin-sla-value" id="adminSla4to12">--</span>
                            </div>
                            <div class="admin-sla-card">
                                <span class="admin-sla-label">SLA 12-24h</span>
                                <span class="admin-sla-value warn" id="adminSla12to24">--</span>
                            </div>
                            <div class="admin-sla-card">
                                <span class="admin-sla-label">SLA &gt; 24h (At Risk)</span>
                                <span class="admin-sla-value alert" id="adminSla24Plus">--</span>
                            </div>
                        </div>
                        <div class="admin-ebj-summary" id="adminEbjSummaryText">Loading admin summary...</div>
                    </div>

                    <div class="admin-kpi-grid">
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Today Orders</span><span class="admin-kpi-value" id="adminKpiTodayOrders">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Today Sales</span><span class="admin-kpi-value" id="adminKpiTodaySales">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Month Orders</span><span class="admin-kpi-value" id="adminKpiMonthOrders">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Month Sales</span><span class="admin-kpi-value" id="adminKpiMonthSales">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Pending Payments</span><span class="admin-kpi-value" id="adminKpiPendingPayments">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Pending Amount</span><span class="admin-kpi-value" id="adminKpiPendingAmount">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Collected (Range)</span><span class="admin-kpi-value" id="adminKpiCollectedAmount">--</span></div>
                        <div class="admin-kpi-card"><span class="admin-kpi-label">Avg Order Value</span><span class="admin-kpi-value" id="adminKpiAvgOrderValue">--</span></div>
                    </div>

                    <div class="admin-insights-sections-grid">
                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Today Action Queue</h4>
                            <div class="admin-insight-card-body" id="adminActionQueueRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Revenue &amp; Payment Split</h4>
                            <div class="admin-insight-card-body" id="adminRevenueRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Operations Health</h4>
                            <div class="admin-insight-card-body" id="adminOperationsRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Customer Insights</h4>
                            <div class="admin-insight-card-body" id="adminCustomerRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Service Mix</h4>
                            <div class="admin-insight-card-body" id="adminServiceRows"></div>
                        </div>

                        <div class="admin-insight-card">
                            <h4 class="admin-insight-card-title">Alert Center</h4>
                            <div class="admin-insight-card-body" id="adminAlertRows"></div>
                        </div>

                    </div>

                    <div class="admin-chart-grid">
                        <div class="admin-chart-card">
                            <h4 class="admin-chart-title">Order Status Split</h4>
                            <div class="admin-chart-list" id="adminStatusChartRows"></div>
                        </div>
                        <div class="admin-chart-card">
                            <h4 class="admin-chart-title">Last 7 Days Orders</h4>
                            <div class="admin-chart-list" id="adminTrendChartRows"></div>
                        </div>
                    </div>
                    <div class="admin-insights-meta">
                        Tenant: <b>@tenantName</b> | Store: <b>@tenantStore</b>
                        | Refresh: <span id="adminInsightsRefreshMode">Auto (every 60s)</span>
                        | Last refreshed: <span id="adminInsightsLastRefreshed">--</span>
                        | Next refresh in: <span id="adminInsightsNextRefresh">--</span>
                    </div>
                    <div class="admin-insights-empty" id="adminInsightsMessage" style="display:none;"></div>
                </div>

                <div class="admin-menu-wrap">
                    <section class="admin-menu-section" aria-labelledby="adminGroupStoreSetup">
                        <h3 class="admin-menu-section-title" id="adminGroupStoreSetup">1. Store Setup &amp; Access</h3>
                        <p class="admin-menu-section-desc">Start here when onboarding a store or granting staff access.</p>
                        <div class="admin-menu-grid">
                            <div class="admin-menu-card @(IsActiveAdminMenu("NewStoreCreation") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">New Store Creation</p>
                                <p class="admin-menu-card-desc">Create a new store code for admin login. Configure remaining store details in Store Configuration.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("NewStoreCreation", "Customer")'">Open</button>
                            </div>

                            <div class="admin-menu-card @(IsActiveAdminMenu("StoreTimings") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Store Configuration</p>
                                <p class="admin-menu-card-desc">Configure store timings and remaining store details.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("StoreTimings", "Customer")'">Open</button>
                            </div>

                            <div class="admin-menu-card @(IsActiveAdminMenu("StoreUsersSetup") ? "active" : string.Empty)">
                                <p class="admin-menu-card-title">Store Users Setup</p>
                                <p class="admin-menu-card-desc">Create and manage store users with role-based access.</p>
                                <button type="button" class="admin-menu-btn" onclick="location.href='@Url.Action("StoreUsersSetup", "Customer")'">Open</button>
                            </div>
