                                    <span class="reports-link-note">Return patterns and quality follow-up cases.</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<script type='text/javascript'>
    // expose resolved currency metadata to client scripts
    window.__currency = @Html.Raw(_currencyJson ?? "{}");
    var customerSearchRequest = null;
    var customerLookupRequest = null;
    var customerOrdersRequest = null;
    var orderReferenceSearchRequest = null;
    var serverCustomers = [];
    var serverOrderReferences = [];
    var customerOrdersByCodeCache = {};
    var customerCodeByNameCache = {};
    var isAutocompleteRefresh = false;
    var isInvoiceAutocompleteRefresh = false;
    var customerSearchRequestSeq = 0;
    var customerSelectionRequestSeq = 0;
    var activeCustomerSelectionRequestSeq = 0;
    var isAdminDashboardUser = @Html.Raw(isAdminUser.ToString().ToLowerInvariant());
    var isSuperAdminDashboardUser = @Html.Raw(isSuperAdminUser.ToString().ToLowerInvariant());
    var subscriptionSpotlightStorageKey = "els:subscription-spotlight-dismissed:" + (("@tenantName" || "").toLowerCase());
    var adminInsightsIntervalHandle = null;
    var adminInsightsCountdownHandle = null;
    var adminInsightsNextRefreshAt = null;
    var adminInsightsIntervalMs = 60000;
    var adminLastComputedMetrics = null;
    var adminInsightsInitialized = false;
    var invoiceDetailsRequest = null;
    var selectedInvoiceReference = null;
    var selectedDashboardCustomer = {
        name: "",
        code: "",
        profile: null,
        orders: [],
        filteredOrders: []
    };

    (function initializeSubscriptionSpotlight() {
        var spotlight = document.getElementById("subscriptionSpotlight");
        var entryPoint = document.getElementById("subscriptionEntryPoint");
        var dismissBtn = document.getElementById("subscriptionSpotlightDismiss");
        if (!spotlight && !entryPoint) {
            return;
        }

        var dismissed = false;
        try {
            dismissed = window.localStorage && localStorage.getItem(subscriptionSpotlightStorageKey) === "1";
        } catch (_) {
            dismissed = false;
        }

        if (dismissed) {
            if (spotlight) {
                spotlight.style.display = "none";
            }
            if (entryPoint) {
                entryPoint.style.display = "flex";
            }
        }

        if (dismissBtn) {
            dismissBtn.addEventListener("click", function () {
                if (spotlight) {
                    spotlight.style.display = "none";
                }
                if (entryPoint) {
                    entryPoint.style.display = "flex";
                }

                try {
                    if (window.localStorage) {
                        localStorage.setItem(subscriptionSpotlightStorageKey, "1");
                    }
                } catch (_) { }
            });
        }
    })();

    function asNumber(value) {
        var parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : 0;
    }

    function formatAmount(value) {
        return asNumber(value).toFixed(2);
    }

    // Use shared formatCurrency from layout for client-side currency display.
    // This view exposes window.__currency above; call the global formatCurrency when needed.

    function formatDateTime(value) {
        var date = value instanceof Date ? value : new Date(value);
        if (isNaN(date.getTime())) {
            return "--";
        }

        return date.toLocaleDateString() + " " + date.toLocaleTimeString();
    }

    function escapeHtml(text) {
        return (text == null ? "" : String(text))
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function parseItemsForDashboard(order) {
        var items = order && (order.Items || order.items);
        if (Array.isArray(items) && items.length) {
            return items;
        }

        var json = (order && (order.OrderItemsJson || order.orderItemsJson)) || "";
        if (!json) {
            return [];
        }

        try {
            var parsed = JSON.parse(json);
            if (Array.isArray(parsed)) {
                return parsed;
            }
            if (parsed && Array.isArray(parsed.Items)) {
                return parsed.Items;
            }
        } catch (_) { }

        return [];
    }

    function summarizeItemsForDashboard(order) {
        var items = parseItemsForDashboard(order);
        if (!items.length) {
            return "-";
        }

        return items.slice(0, 3).map(function (item) {
            var name = (item && (item.ItemName || item.itemName)) || "Item";
            var qtyValue = item && (item.Quantity != null ? item.Quantity : (item.quantity != null ? item.quantity : 1));
            var qty = asNumber(qtyValue);
            return escapeHtml(name) + " x" + (qty > 0 ? qty : 1);
        }).join(", ") + (items.length > 3 ? " +" + (items.length - 3) + " more" : "");
    }

    function resolvePiecesForDashboard(order) {
        var explicitPieces = order && (order.TotalPieces != null ? order.TotalPieces : (order.totalPieces != null ? order.totalPieces : 0));
        var explicit = asNumber(explicitPieces);
        if (explicit > 0) {
            return Math.floor(explicit);
        }

        var items = parseItemsForDashboard(order);
        if (!items.length) {
            return 0;
        }

        return items.reduce(function (sum, item) {
            var qtyValue = item && (item.Quantity != null ? item.Quantity : (item.quantity != null ? item.quantity : 0));
            var qty = asNumber(qtyValue);
            return sum + (qty > 0 ? qty : 0);
        }, 0);
    }

    function resolveOrderAmounts(order) {
        order = order || {};
        var orderAmount = asNumber(order.OrderAmount != null ? order.OrderAmount : order.orderAmount);
        var subTotalRaw = (order.SubTotal != null ? order.SubTotal : order.subTotal);
        var subTotal = asNumber(subTotalRaw != null ? subTotalRaw : orderAmount);
        var taxAmount = asNumber(order.TaxAmount != null ? order.TaxAmount : order.taxAmount);
        var totalAmount = asNumber(order.TotalAmount != null ? order.TotalAmount : order.totalAmount);

        if (subTotal <= 0 && orderAmount > 0) {
            subTotal = orderAmount;
        }

        if (totalAmount <= 0) {
            totalAmount = asNumber(subTotal + taxAmount);
        }

        if (taxAmount <= 0 && totalAmount > subTotal) {
            taxAmount = asNumber(totalAmount - subTotal);
        }

        var advanceUsed = asNumber(order.AdvanceUsed != null ? order.AdvanceUsed : order.advanceUsed);
        if (advanceUsed > totalAmount) {
            advanceUsed = totalAmount;
        }

        var paidNow = asNumber(order.PaidNow != null ? order.PaidNow : order.paidNow);
        var payableAfterAdvance = asNumber(totalAmount - advanceUsed);
        if (payableAfterAdvance < 0) {
            payableAfterAdvance = 0;
        }
        if (paidNow > payableAfterAdvance) {
            paidNow = payableAfterAdvance;
        }

        var pendingStoredRaw = (order.PendingAmount != null ? order.PendingAmount : (order.pendingAmount != null ? order.pendingAmount : (order.NetPayable != null ? order.NetPayable : order.netPayable)));
        var pendingStored = asNumber(pendingStoredRaw);
        var pendingComputed = asNumber(payableAfterAdvance - paidNow);
        if (pendingComputed < 0) {
            pendingComputed = 0;
        }

        var pendingAmount = pendingComputed > 0 ? pendingComputed : pendingStored;
        if (pendingAmount < 0) {
            pendingAmount = 0;
        }

        return {
            subTotal: subTotal,
            taxAmount: taxAmount,
            totalAmount: totalAmount,
            advanceUsed: advanceUsed,
            paidNow: paidNow,
            pendingAmount: pendingAmount,
            netPayable: pendingAmount
        };
    }

    function setCustomerOrdersState(message) {
        var panel = document.getElementById("customerOrdersPanel");
        var body = document.getElementById("customerOrdersBody");
        if (!panel || !body) {
            return;
        }

        panel.style.display = "block";
        body.innerHTML = "<tr><td colspan='9' class='customer-orders-state'>" + escapeHtml(message || "No orders found.") + "</td></tr>";
    }

    function setCustomerSearchMessage(message) {
        var messageBox = document.getElementById("customerSearchMessage");
        if (!messageBox) {
            return;
        }

        if (!message) {
            messageBox.textContent = "";
            messageBox.style.display = "none";
            return;
        }

        messageBox.textContent = message;
        messageBox.style.display = "block";
    }

    function setSearchModeUi(mode) {
        var customerWrap = document.getElementById("searchradio");
        var invoiceWrap = document.getElementById("searchInvoiceradio");
        var customerOpt = document.getElementById("searchOptionCustomer");
        var invoiceOpt = document.getElementById("searchOptionInvoice");

        if (mode === "invoice") {
            if (customerWrap) customerWrap.style.display = "none";
            if (invoiceWrap) invoiceWrap.style.display = "block";
            if (customerOpt) customerOpt.classList.remove("active");
            if (invoiceOpt) invoiceOpt.classList.add("active");
            if (customerWrap) customerWrap.classList.remove("active");
            if (invoiceWrap) invoiceWrap.classList.add("active");
            return;
        }

        if (customerWrap) customerWrap.style.display = "block";
        if (invoiceWrap) invoiceWrap.style.display = "none";
        if (customerOpt) customerOpt.classList.add("active");
        if (invoiceOpt) invoiceOpt.classList.remove("active");
        if (customerWrap) customerWrap.classList.add("active");
        if (invoiceWrap) invoiceWrap.classList.remove("active");
    }

    function applyQuickDateRange(rangeKey) {
        var fromDateInput = document.getElementById("customerHistoryFromDate");
        var toDateInput = document.getElementById("customerHistoryToDate");
        if (!fromDateInput || !toDateInput) {
            return;
        }

        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var fromDate = "";
        var toDate = "";

        if (rangeKey === "today") {
            fromDate = toDate = today;
        } else if (rangeKey === "last7") {
            var last7 = new Date(today);
            last7.setDate(last7.getDate() - 6);
            fromDate = last7;
            toDate = today;
        } else if (rangeKey === "thisMonth") {
            fromDate = new Date(today.getFullYear(), today.getMonth(), 1);
            toDate = today;
        }

        if (fromDate instanceof Date) {
            fromDateInput.value = fromDate.toISOString().slice(0, 10);
        } else {
            fromDateInput.value = "";
        }

        if (toDate instanceof Date) {
            toDateInput.value = toDate.toISOString().slice(0, 10);
        } else {
            toDateInput.value = "";
        }

        setActiveQuickDateChip(rangeKey === "clear" ? "" : rangeKey);
        applyCustomerHistoryFilters();
    }

    function setActiveQuickDateChip(rangeKey) {
        var chips = document.querySelectorAll(".customer-history-chip");
        if (!chips || chips.length === 0) {
            return;
        }

        chips.forEach(function (chip) {
            var key = (chip.getAttribute("data-range") || "").trim();
            if (rangeKey && key === rangeKey) {
                chip.classList.add("active");
            } else {
                chip.classList.remove("active");
            }
        });
    }

    function hideInvoicePreview() {
        var panel = document.getElementById("invoicePreviewPanel");
        var body = document.getElementById("invoicePreviewBody");
        var header = document.getElementById("invoicePreviewHeader");
        if (panel) {
            panel.style.display = "none";
        }
        if (body) {
            body.innerHTML = "";
        }
        if (header) {
            header.textContent = "Invoice details";
        }
        selectedInvoiceReference = null;
    }

    function renderInvoicePreview(orderInfo) {
        var panel = document.getElementById("invoicePreviewPanel");
        var body = document.getElementById("invoicePreviewBody");
        var header = document.getElementById("invoicePreviewHeader");
        if (!panel || !body || !header) {
            return;
        }

        if (!orderInfo) {
            hideInvoicePreview();
            return;
        }

        selectedInvoiceReference = orderInfo;
        header.textContent = "Invoice details - " + (orderInfo.invoiceNo || orderInfo.orderNo || "-");
        body.innerHTML = ""
            + "<div class='invoice-preview-item'><b>Order No:</b> " + escapeHtml(orderInfo.orderNo || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Invoice No:</b> " + escapeHtml(orderInfo.invoiceNo || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Customer:</b> " + escapeHtml(orderInfo.customerName || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Customer Code:</b> " + escapeHtml(orderInfo.customerCode || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Status:</b> " + escapeHtml(orderInfo.status || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Date:</b> " + escapeHtml(orderInfo.createdDate || "-") + "</div>"
            + "<div class='invoice-preview-item'><b>Total:</b> " + formatCurrency(asNumber(orderInfo.totalAmount || 0)) + "</div>"
            + "<div class='invoice-preview-item'><b>Paid:</b> " + formatCurrency(asNumber(orderInfo.paidAmount || 0)) + "</div>"
            + "<div class='invoice-preview-item'><b>Pending:</b> " + formatCurrency(asNumber(orderInfo.pendingAmount || 0)) + "</div>";

        panel.style.display = "block";
        try {
            panel.scrollIntoView({ behavior: "smooth", block: "start" });
        } catch (_) { }
    }

    function setCustomerActionMessage(message, isSuccess) {
        var messageBox = document.getElementById("customerActionMessage");
        if (!messageBox) {
            return;
        }

        if (!message) {
            messageBox.textContent = "";
            messageBox.style.display = "none";
            messageBox.classList.remove("customer-action-message--success");
            return;
        }

        messageBox.textContent = "";
        messageBox.classList.toggle("customer-action-message--success", isSuccess === true);
        var icon = document.createElement("i");
        icon.className = "customer-action-message-icon fa " + (isSuccess === true ? "fa-check-circle" : "fa-exclamation-circle");
        icon.setAttribute("aria-hidden", "true");
        messageBox.appendChild(icon);
        messageBox.appendChild(document.createTextNode(message));
        messageBox.style.display = "flex";
    }

    function setEditCustomerMessage(message) {
        var messageBox = document.getElementById("editCustomerMessage");
        if (!messageBox) {
            return;
        }

        if (!message) {
            messageBox.textContent = "";
            messageBox.style.display = "none";
            return;
        }

        messageBox.textContent = message;
        messageBox.style.display = "block";
    }

    function updateSelectedCustomerMeta() {
        var meta = document.getElementById("selectedCustomerMeta");
        var emptyState = document.getElementById("selectedCustomerEmptyState");
        if (!meta) {
            return;
        }

        if (!selectedDashboardCustomer.code) {
            meta.textContent = "Selected customer: None";
            if (emptyState) {
                emptyState.style.display = "block";
            }
            return;
        }

        var total = Array.isArray(selectedDashboardCustomer.orders) ? selectedDashboardCustomer.orders.length : 0;
        meta.textContent = "Selected customer: " + (selectedDashboardCustomer.name || "-")
            + " (" + selectedDashboardCustomer.code + ")"
            + " | Orders: " + total;
        if (emptyState) {
            emptyState.style.display = "none";
        }
    }

    function updateDashboardCustomerActionButtons() {
        var hasCustomer = !!selectedDashboardCustomer.code;
        var hasOrders = Array.isArray(selectedDashboardCustomer.orders) && selectedDashboardCustomer.orders.length > 0;

        var editBtn = document.getElementById("dashboardEditCustomerBtn");
        var deleteBtn = document.getElementById("dashboardDeleteCustomerBtn");
        var refreshBtn = document.getElementById("dashboardRefreshCustomerOrdersBtn");
        var createOrderBtn = document.getElementById("dashboardCreateOrderBtn");

        if (editBtn) {
            editBtn.disabled = !hasCustomer;
        }
        if (deleteBtn) {
            deleteBtn.disabled = !hasCustomer || hasOrders;
        }
        if (refreshBtn) {
            refreshBtn.disabled = !hasCustomer;
        }
        if (createOrderBtn) {
            var createOrderEnabled = hasCustomer;
            createOrderBtn.classList.toggle("is-disabled", !createOrderEnabled);
            createOrderBtn.setAttribute("aria-disabled", createOrderEnabled ? "false" : "true");
            createOrderBtn.tabIndex = createOrderEnabled ? 0 : -1;
            createOrderBtn.href = createOrderEnabled
                ? '@Url.Action("SetupCreateOrder", "Customer")' + "?customerName=" + encodeURIComponent(selectedDashboardCustomer.name || "") + "&customerCode=" + encodeURIComponent(selectedDashboardCustomer.code || "")
                : "#";
        }
    }

    function normalizeStatusValue(value) {
        return ((value || "") + "").toLowerCase().trim();
    }

    function getOrderDateKey(order) {
        var raw = (order && (order.CreatedDate || order.createdDate)) || "";
        var dt = new Date(raw);
        if (isNaN(dt.getTime())) {
            return "";
        }

        var year = dt.getFullYear();
        var month = String(dt.getMonth() + 1).padStart(2, "0");
        var day = String(dt.getDate()).padStart(2, "0");
        return year + "-" + month + "-" + day;
    }

    function applyCustomerHistoryFilters() {
        var allOrders = Array.isArray(selectedDashboardCustomer.orders) ? selectedDashboardCustomer.orders : [];
        var statusFilter = normalizeStatusValue((document.getElementById("customerHistoryStatus") || {}).value || "");
        var fromDate = ((document.getElementById("customerHistoryFromDate") || {}).value || "").trim();
        var toDate = ((document.getElementById("customerHistoryToDate") || {}).value || "").trim();
        var textFilter = (((document.getElementById("customerHistorySearchText") || {}).value || "") + "").trim().toLowerCase();

        var filtered = allOrders.filter(function (order) {
            var status = normalizeStatusValue(order && (order.Status || order.status || "received"));
            var orderNo = ((order && (order.OrderNo || order.orderNo)) || "").toString().toLowerCase();
            var invoiceNo = ((order && (order.InvoiceNo || order.invoiceNo)) || "").toString().toLowerCase();
            var dateKey = getOrderDateKey(order);

            if (statusFilter && status.indexOf(statusFilter) === -1) {
                return false;
            }

            if (fromDate && dateKey && dateKey < fromDate) {
                return false;
            }

            if (toDate && dateKey && dateKey > toDate) {
                return false;
            }

            if (textFilter && orderNo.indexOf(textFilter) === -1 && invoiceNo.indexOf(textFilter) === -1) {
                return false;
            }

            return true;
        });

        selectedDashboardCustomer.filteredOrders = filtered;
        renderCustomerOrdersRows(selectedDashboardCustomer.name, selectedDashboardCustomer.code, filtered);
        updateDashboardCustomerActionButtons();
        updateSelectedCustomerMeta();
    }

    function setSelectedCustomerOrdersAndRender(customerName, customerCode, orders) {
        selectedDashboardCustomer.name = (customerName || "").trim();
        selectedDashboardCustomer.code = (customerCode || "").trim();
        selectedDashboardCustomer.orders = Array.isArray(orders) ? orders : [];

        var filtersPanel = document.getElementById("customerHistoryFilters");
        if (filtersPanel) {
            filtersPanel.style.display = selectedDashboardCustomer.code ? "grid" : "none";
        }

        applyCustomerHistoryFilters();
        var panel = document.getElementById("customerOrdersPanel");
        if (panel) {
            try {
                panel.scrollIntoView({ behavior: "smooth", block: "start" });
            } catch (_) { }
        }
    }

    function setInvoiceSearchMessage(message) {
        var messageBox = document.getElementById("invoiceSearchMessage");
        if (!messageBox) {
            return;
        }

        if (!message) {
            messageBox.textContent = "";
            messageBox.style.display = "none";
            return;
        }

        messageBox.textContent = message;
        messageBox.style.display = "block";
    }

    function renderCustomerOrdersRows(customerName, customerCode, orders) {
        var panel = document.getElementById("customerOrdersPanel");
        var header = document.getElementById("customerOrdersHeader");
        var body = document.getElementById("customerOrdersBody");
        if (!panel || !header || !body) {
            return;
        }

        panel.style.display = "block";
        header.textContent = "Customer order history - " + (customerName || "-") + (customerCode ? (" (" + customerCode + ")") : "");

        if (!orders || !orders.length) {
            body.innerHTML = "<tr><td colspan='9' class='customer-orders-state'>No orders found for this customer.</td></tr>";
            return;
        }

        body.innerHTML = (orders || []).map(function (order) {
            var orderNo = (order.OrderNo || order.orderNo || "").toString();
            var invoiceNo = (order.InvoiceNo || order.invoiceNo || orderNo || "").toString();
            var workflowSearchValue = (orderNo || invoiceNo || "").toString().trim();
            var createdDate = (order.CreatedDate || order.createdDate || "").toString().replace("T", " ").substring(0, 16);
            var status = (order.Status || order.status || "Received").toString();
            var itemsText = summarizeItemsForDashboard(order);
            var pieces = resolvePiecesForDashboard(order);
            var amounts = resolveOrderAmounts(order);
            var totalAmount = amounts.totalAmount;
            var paidAmount = amounts.paidNow;
            var pendingAmount = amounts.pendingAmount;

            var orderCellHtml = escapeHtml(orderNo || "-");
            if (workflowSearchValue) {
                orderCellHtml = "<a class='customer-order-link' href='@Url.Action("OrderWorkflow", "Customer")?searchText="
                    + encodeURIComponent(workflowSearchValue)
                    + "'>"
                    + escapeHtml(orderNo || workflowSearchValue)
                    + "</a>";
            }

            return "<tr>"
                + "<td>" + orderCellHtml + "</td>"
                + "<td>" + escapeHtml(invoiceNo) + "</td>"
                + "<td>" + escapeHtml(createdDate || "-") + "</td>"
                + "<td>" + escapeHtml(status) + "</td>"
                + "<td>" + itemsText + "</td>"
                + "<td class='num'>" + escapeHtml(String(pieces)) + "</td>"
                + "<td class='num'>" + formatCurrency(totalAmount) + "</td>"
                + "<td class='num'>" + formatCurrency(paidAmount) + "</td>"
                + "<td class='num'>" + formatCurrency(pendingAmount) + "</td>"
                + "</tr>";
        }).join("");
    }

    function loadDashboardCustomerOrders(selectedCustomer, options) {
        options = options || {};
        var forceReload = !!options.forceReload;
        var customerName = (selectedCustomer || "").trim();
        if (!customerName) {
            return;
        }

        var requestSeq = ++customerSelectionRequestSeq;
        activeCustomerSelectionRequestSeq = requestSeq;

        function isStaleSelectionRequest() {
            return requestSeq !== activeCustomerSelectionRequestSeq;
        }

        setCustomerSearchMessage("");
        setCustomerOrdersState("Loading customer orders...");

        var normalizedNameKey = customerName.toLowerCase();
        var cachedCustomerCode = customerCodeByNameCache[normalizedNameKey] || "";

        if (customerLookupRequest && customerLookupRequest.readyState !== 4) {
            customerLookupRequest.abort();
        }
        if (customerOrdersRequest && customerOrdersRequest.readyState !== 4) {
            customerOrdersRequest.abort();
        }

        function fetchOrdersByCode(customerCode) {
            var codeKey = (customerCode || "").trim().toLowerCase();
            if (!forceReload && codeKey && customerOrdersByCodeCache[codeKey]) {
                renderCustomerOrdersRows(customerName, customerCode, customerOrdersByCodeCache[codeKey]);
                return;
            }

            customerOrdersRequest = $.ajax({
                type: "GET",
                url: '@Url.Action("GetCustomerOrders", "Customer")',
                data: { customerName: customerName, customerCode: customerCode || "" },
                success: function (payload) {
                    if (isStaleSelectionRequest()) {
                        return;
                    }

                    if (!payload || payload.success !== true) {
                        setCustomerOrdersState((payload && payload.message) || "Unable to load customer orders.");
                        return;
                    }

                    var resolvedCode = ((payload.customerCode || payload.CustomerCode || customerCode || "") + "").trim();
                    var orders = Array.isArray(payload.orders)
                        ? payload.orders
                        : (Array.isArray(payload.Orders) ? payload.Orders : []);

                    // Fallback for stores where customer-orders API can return empty while
                    // workflow API still has full historical rows.
                    if (orders.length === 0) {
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("GetStoreWorkflowOrders", "Customer")',
                            data: { status: "", searchText: customerName },
                            success: function (wfPayload) {
                                if (isStaleSelectionRequest()) {
                                    return;
                                }

                                var wfOrders = (wfPayload && wfPayload.success === true && Array.isArray(wfPayload.orders))
                                    ? wfPayload.orders
                                    : [];

                                var filtered = wfOrders.filter(function (x) {
                                    var code = ((x && (x.CustCode || x.custCode)) || "").toString().trim();
                                    var name = ((x && (x.CustomerName || x.customerName)) || "").toString().trim();
                                    if (resolvedCode) {
                                        return code && code.toLowerCase() === resolvedCode.toLowerCase();
                                    }
                                    return name && name.toLowerCase() === customerName.toLowerCase();
                                });

                                if (resolvedCode) {
                                    customerOrdersByCodeCache[resolvedCode.toLowerCase()] = filtered;
                                    customerCodeByNameCache[normalizedNameKey] = resolvedCode;
                                }

                                setSelectedCustomerOrdersAndRender(customerName, resolvedCode, filtered);
                            },
                            error: function () {
                                if (isStaleSelectionRequest()) {
                                    return;
                                }

                                setSelectedCustomerOrdersAndRender(customerName, resolvedCode, orders);
                            }
                        });
                        return;
                    }

                    if (resolvedCode) {
                        customerOrdersByCodeCache[resolvedCode.toLowerCase()] = orders;
                        customerCodeByNameCache[normalizedNameKey] = resolvedCode;
                    }

                    setSelectedCustomerOrdersAndRender(customerName, resolvedCode, orders);
                },
                error: function () {
                    if (isStaleSelectionRequest()) {
                        return;
                    }

                    setCustomerOrdersState("Unable to load customer orders. Please try again.");
                }
            });
        }

        if (cachedCustomerCode) {
            fetchOrdersByCode(cachedCustomerCode);
            return;
        }

        customerLookupRequest = $.ajax({
            type: "GET",
            url: '@Url.Action("GetCustomerByName", "Customer")',
            data: { customerName: customerName },
            success: function (customerData) {
                if (isStaleSelectionRequest()) {
                    return;
                }

                var statusCode = ((customerData && (customerData.StatusCode || customerData.statusCode)) || "").toString();
                var custCode = ((customerData && (customerData.CustCode || customerData.custCode)) || "").toString().trim();
                if (!customerData || statusCode !== "200" || !custCode) {
                    setCustomerOrdersState((customerData && customerData.Message) || "Customer not found in this store.");
                    return;
                }

                var resolvedCode = custCode;
                selectedDashboardCustomer.profile = {
                    customerName: (customerData.CustomerName || customerData.customerName || customerName || "").toString().trim(),
                    address: (customerData.Address || customerData.address || "").toString(),
                    phoneNumber: (customerData.PhoneNumber || customerData.phoneNumber || "").toString(),
                    email: (customerData.Email || customerData.email || "").toString(),
                    customerCode: resolvedCode
                };
                customerCodeByNameCache[normalizedNameKey] = resolvedCode;
                fetchOrdersByCode(resolvedCode);
            },
            error: function () {
                if (isStaleSelectionRequest()) {
                    return;
                }

                setCustomerOrdersState("Unable to resolve customer details.");
            }
        });
    }

