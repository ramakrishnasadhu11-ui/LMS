@model LMSWebUI.Models.DashBoard.TenantInfoDto
@inject LMSWebUI.Services.ICurrencyService CurrencyService
@inject LMSWebUI.Services.ICustomerPhoneService CustomerPhoneService
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAdminUser = Convert.ToBoolean(ViewData["IsAdminUser"] ?? false);
    var searchMode = Convert.ToString(ViewData["SearchMode"] ?? "customer");
    var currentUserRole = Convert.ToString(ViewData["UserRole"] ?? "StoreUser");
    var isSuperAdminUser = string.Equals(currentUserRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase);
    var tenantName = Model?.TenantName ?? "-";
    var tenantStore = Model?.TenantStore ?? "-";
    var storeName = string.IsNullOrWhiteSpace(Model?.StoreName) ? tenantStore : Model.StoreName;
    var isStoreActive = Model?.IsStoreActive ?? false;
    var activeDashboardStores = Model?.ActiveStores ?? new List<LMSWebUI.Models.DashBoard.DashboardStoreOption>();
    var dashboardTitle = Convert.ToString(ViewData["DashboardTitle"] ?? $"Welcome to {Model?.TenantStore} Store");
    var canResumeOnboarding = Convert.ToBoolean(ViewData["CanResumeOnboarding"] ?? false);
    var showSubscriptionSpotlight = Convert.ToBoolean(ViewData["ShowSubscriptionSpotlight"] ?? false);
    var currentPlanCode = Convert.ToString(ViewData["CurrentPlanCode"] ?? string.Empty);
    var currentSubscriptionStatus = Convert.ToString(ViewData["CurrentSubscriptionStatus"] ?? string.Empty);
    var dashboardTrialEndUtc = Model?.TrialEndUtc;
    var dashboardTrialDaysRemaining = Model?.TrialDaysRemaining;
    var subscriptionSpotlightVisible = showSubscriptionSpotlight;
    var plansAndTariffUrl = Url.Action("TenantSubscriptionPlans", "Customer");
    var subscriptionCtaText = "Explore Subscription Plans";
    var isSubscriptionTrial = string.Equals(currentSubscriptionStatus, "Trial", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentSubscriptionStatus, "TrialActive", StringComparison.OrdinalIgnoreCase);
    var subscriptionStatusClass = string.Equals(currentSubscriptionStatus, "Active", StringComparison.OrdinalIgnoreCase)
        ? "active"
        : isSubscriptionTrial
            ? "trial"
            : string.Equals(currentSubscriptionStatus, "Suspended", StringComparison.OrdinalIgnoreCase)
                ? "suspended"
                : string.Equals(currentSubscriptionStatus, "Expired", StringComparison.OrdinalIgnoreCase)
                    ? "expired"
                    : "neutral";
    var dashboardPlanText = string.IsNullOrWhiteSpace(currentPlanCode) ? "Not configured" : currentPlanCode;
    var dashboardSubscriptionText = string.IsNullOrWhiteSpace(currentSubscriptionStatus) ? "Not configured" : currentSubscriptionStatus;
    var hasMultipleActiveStores = activeDashboardStores.Count > 1;
    var showSubscriptionBillingCard = Convert.ToBoolean(ViewData["ShowSubscriptionBillingCard"] ?? false);
    var subscriptionBillingState = Convert.ToString(ViewData["SubscriptionBillingState"] ?? "missing");
    var subscriptionBillingHeadline = Convert.ToString(ViewData["SubscriptionBillingHeadline"] ?? "Subscription details unavailable");
    var subscriptionBillingMessage = Convert.ToString(ViewData["SubscriptionBillingMessage"] ?? "We could not load subscription data right now.");
    var showSubscriptionTrialProgress = Convert.ToBoolean(ViewData["SubscriptionBillingShowTrialProgress"] ?? false);
    var subscriptionTrialProgressPercent = Convert.ToInt32(ViewData["SubscriptionBillingTrialProgressPercent"] ?? 0);
    var subscriptionExpiryUtc = ViewData["SubscriptionExpiryUtc"] as DateTime?;
    var canManageSubscriptionBillingActions = Convert.ToBoolean(ViewData["SubscriptionBillingCanManageActions"] ?? false);

    var trialDaysRemainingText = dashboardTrialDaysRemaining.HasValue
        ? Math.Max(dashboardTrialDaysRemaining.Value, 0).ToString()
        : "0";
    var subscriptionExpiryText = subscriptionExpiryUtc.HasValue
        ? subscriptionExpiryUtc.Value.ToUniversalTime().ToString("dd MMM yyyy")
        : "Not available";
    var subscriptionTrialProgressClamped = Math.Max(0, Math.Min(100, subscriptionTrialProgressPercent));
    var subscriptionBillingCardClass = $"subscription-billing-card state-{(string.IsNullOrWhiteSpace(subscriptionBillingState) ? "missing" : subscriptionBillingState.ToLowerInvariant())}";
    var isTrialEndingSoonState = string.Equals(subscriptionBillingState, "trial-warning", StringComparison.OrdinalIgnoreCase);
    var billingPrimaryCtaText = string.Equals(subscriptionBillingState, "trial-expired", StringComparison.OrdinalIgnoreCase)
        ? "Renew / Upgrade"
        : "View Plans & Upgrade";
    var billingPrimaryCtaUrl = plansAndTariffUrl;
    var billingHistoryUrl = plansAndTariffUrl + "#tenantPaymentHistoryHost";
    var billingRenewalUrl = plansAndTariffUrl + "#renewalAmountValue";
    var currentController = Convert.ToString(ViewContext.RouteData.Values["controller"]);
    var currentAction = Convert.ToString(ViewContext.RouteData.Values["action"]);
    var canViewOwnerSummary = string.Equals(currentUserRole, "Owner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentUserRole, "StoreOwner", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentUserRole, "TenantOwner", StringComparison.OrdinalIgnoreCase);

    bool IsActiveAdminMenu(string actionName, string controllerName = "Customer")
    {
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
               && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);
    }
    // Resolve effective currency for this tenant/store so client-side scripts can format consistently.
    var _currencyJson = "{}";
    var dashboardPhoneCountries = CustomerPhoneService.GetSupportedCountries();
    var dashboardPhoneCountriesJson = Newtonsoft.Json.JsonConvert.SerializeObject(dashboardPhoneCountries);
    try
    {
        var _currency = await CurrencyService.GetEffectiveCurrencyAsync(tenantName, tenantStore);
        _currencyJson = Newtonsoft.Json.JsonConvert.SerializeObject(new {
            resolved = _currency != null,
            symbol = _currency?.CurrencySymbol,
            locale = _currency?.CurrencyLocale,
            digits = _currency?.DecimalDigits,
            code = _currency?.CurrencyCode
        });
    }
    catch
    {
        _currencyJson = "{\"resolved\":false,\"warning\":\"Currency configuration could not be loaded.\"}";
    }
}
<style>
    :root {
        --els-primary: #173B70;
        --els-primary-dark: #173B70;
        --els-primary-light: #2878C8;
        --els-accent: #EAF2FC;
        --els-background: #F5F7FA;
        --els-surface: #FFFFFF;
        --els-text: #1E293B;
        --els-text-muted: #64748B;
        --els-border: #E2E8F0;
        --els-success: #16A36A;
        --els-warning: #D99520;
        --els-danger: #D94848;
        --els-info: #64748B;
    }

    .dashboard-page {
        padding: 24px;
        background: var(--els-background);
    }

    .dashboard-box {
        max-width: 1200px;
        margin: 0 auto;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: visible;
    }

    .dashboard-header {
        background: var(--els-primary);
        color: #fff;
        padding: 20px;
    }

    .dashboard-header h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
    }

    .dashboard-body {
        padding: 24px;
        background: var(--els-surface);
    }

    #customerActionMessage {
        display: none;
        align-items: center;
        gap: 9px;
        margin-top: 12px;
        padding: 11px 14px;
        border: 1px solid #f1c8cc;
        border-radius: 10px;
        background: #fff6f6;
        color: #a23843;
        font-size: 13px;
        line-height: 1.45;
    }

    #customerActionMessage.customer-action-message--success {
        border-color: #b7e3cf;
        background: #f0fbf5;
        color: #177245;
    }

    #customerActionMessage .customer-action-message-icon {
        flex: 0 0 auto;
        font-size: 15px;
    }

    #dashboardEditCustomerBtn {
        border: 1px solid var(--els-primary);
        background: linear-gradient(135deg, var(--els-primary) 0%, var(--els-primary-light) 100%);
        color: #fff;
        padding: 9px 16px;
        box-shadow: 0 3px 8px rgba(23, 59, 112, .2);
        transition: transform .15s ease, box-shadow .2s ease, background .2s ease;
    }

    #dashboardEditCustomerBtn:hover:not(:disabled),
    #dashboardEditCustomerBtn:focus-visible:not(:disabled) {
        background: linear-gradient(135deg, var(--els-primary-dark) 0%, #216aae 100%);
        box-shadow: 0 5px 12px rgba(23, 59, 112, .28);
        transform: translateY(-1px);
        color: #fff;
    }

    #dashboardEditCustomerBtn:focus-visible {
        outline: 3px solid rgba(40, 120, 200, .28);
        outline-offset: 2px;
    }

    #dashboardEditCustomerBtn i {
        margin-right: 7px;
    }

    #dashboardEditCustomerModal .modal-dialog {
        width: min(680px, calc(100% - 24px));
        margin: 30px auto;
    }

    #dashboardEditCustomerModal .modal-content {
        overflow: hidden;
        border: 1px solid #dce5f0;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 24px 70px rgba(15, 35, 65, .22);
    }

    #dashboardEditCustomerModal .edit-customer-modal-header {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 24px 28px;
        border: 0;
        background: linear-gradient(135deg, #102d5c 0%, #1d5e9d 100%);
        color: #fff;
    }

    #dashboardEditCustomerModal .edit-customer-modal-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        border: 1px solid rgba(255,255,255,.28);
        border-radius: 14px;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 20px;
    }

    #dashboardEditCustomerModal .edit-customer-modal-heading {
        min-width: 0;
    }

    #dashboardEditCustomerModal .edit-customer-modal-title {
        margin: 0;
        color: #fff;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    #dashboardEditCustomerModal .edit-customer-modal-subtitle {
        margin: 4px 0 0;
        color: rgba(255,255,255,.78);
        font-size: 13px;
        line-height: 1.45;
    }

    #dashboardEditCustomerModal .edit-customer-modal-close {
        position: absolute;
        top: 16px;
        right: 18px;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: rgba(255,255,255,.82);
        font-size: 25px;
        line-height: 28px;
        opacity: 1;
        transition: background .2s ease, color .2s ease;
    }

    #dashboardEditCustomerModal .edit-customer-modal-close:hover,
    #dashboardEditCustomerModal .edit-customer-modal-close:focus-visible {
        background: rgba(255,255,255,.14);
        color: #fff;
        outline: none;
    }

    #dashboardEditCustomerModal .edit-customer-modal-body {
        padding: 28px;
        background: #fbfdff;
    }

    #dashboardEditCustomerModal .edit-customer-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 18px;
    }

    #dashboardEditCustomerModal .edit-customer-field {
        min-width: 0;
    }

    #dashboardEditCustomerModal .edit-customer-field--wide {
        grid-column: 1 / -1;
    }

    #dashboardEditCustomerModal .edit-customer-label {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        margin: 0 0 8px;
        color: #213b5b;
        font-size: 13px;
        font-weight: 700;
    }

    #dashboardEditCustomerModal .edit-customer-required {
        color: #c43d4d;
    }

    #dashboardEditCustomerModal .edit-customer-optional {
        color: #7890a8;
        font-size: 11px;
        font-weight: 600;
    }

    #dashboardEditCustomerModal .edit-customer-control {
        width: 100%;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #d5e0ec;
        border-radius: 11px;
        background: #fff;
        color: #203b58;
        box-shadow: 0 2px 6px rgba(30, 55, 85, .04);
        font-size: 14px;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

    #dashboardEditCustomerModal .edit-customer-control:focus {
        border-color: #4285c5;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(66,133,197,.14), 0 3px 9px rgba(30,55,85,.07);
