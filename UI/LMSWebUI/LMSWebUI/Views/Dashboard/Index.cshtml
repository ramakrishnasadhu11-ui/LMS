                totalAmount: 0,
                paidAmount: 0,
                pendingAmount: 0
            });

            $.ajax({
                type: "GET",
                url: '@Url.Action("SearchOrderReference", "Customer")',
                data: { searchText: value },
                success: function (data) {
                    if (!data || data.success !== true) {
                        setInvoiceSearchMessage((data && data.message) ? data.message : "No order found.");
                        hideInvoicePreview();
                        return;
                    }

                    var workflowSearchValue = (data.orderNo || data.invoiceNo || value || "");

                    if (invoiceDetailsRequest && invoiceDetailsRequest.readyState !== 4) {
                        invoiceDetailsRequest.abort();
                    }

                    invoiceDetailsRequest = $.ajax({
                        type: "GET",
                        url: '@Url.Action("GetStoreWorkflowOrders", "Customer")',
                        data: { status: "", searchText: workflowSearchValue },
                        success: function (wf) {
                            var orders = (wf && wf.success === true && Array.isArray(wf.orders)) ? wf.orders : [];
                            var matched = orders.find(function (x) {
                                var o = ((x && (x.OrderNo || x.orderNo)) || "").toString().trim().toLowerCase();
                                var i = ((x && (x.InvoiceNo || x.invoiceNo)) || "").toString().trim().toLowerCase();
                                var input = workflowSearchValue.toLowerCase();
                                return o === input || i === input;
                            }) || orders[0] || null;

                            renderInvoicePreview({
                                orderNo: (data.orderNo || (matched && (matched.OrderNo || matched.orderNo)) || "").toString(),
                                invoiceNo: (data.invoiceNo || (matched && (matched.InvoiceNo || matched.invoiceNo)) || "").toString(),
                                customerName: (data.customerName || (matched && (matched.CustomerName || matched.customerName)) || "").toString(),
                                customerCode: (data.customerCode || (matched && (matched.CustCode || matched.custCode)) || "").toString(),
                                status: ((matched && (matched.Status || matched.status)) || "-").toString(),
                                createdDate: ((matched && (matched.CreatedDate || matched.createdDate)) || "").toString().replace("T", " ").substring(0, 16),
                                totalAmount: resolveOrderAmounts(matched).totalAmount,
                                paidAmount: resolveOrderAmounts(matched).paidNow,
                                pendingAmount: resolveOrderAmounts(matched).pendingAmount,
                                workflowSearchValue: workflowSearchValue
                            });
                        },
                        error: function () {
                            renderInvoicePreview({
                                orderNo: (data.orderNo || "").toString(),
                                invoiceNo: (data.invoiceNo || "").toString(),
                                customerName: (data.customerName || "").toString(),
                                customerCode: (data.customerCode || "").toString(),
                                status: "-",
                                createdDate: "-",
                                totalAmount: 0,
                                paidAmount: 0,
                                pendingAmount: 0,
                                workflowSearchValue: workflowSearchValue
