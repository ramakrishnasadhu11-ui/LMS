                var searchText = document.getElementById("customerHistorySearchText");
                if (statusFilter) statusFilter.value = "";
                if (fromDate) fromDate.value = "";
                if (toDate) toDate.value = "";
                if (searchText) searchText.value = "";
                setActiveQuickDateChip("");
                applyCustomerHistoryFilters();
            });
        }

        if (customerHistoryFromDate) {
            customerHistoryFromDate.addEventListener("change", function () {
                setActiveQuickDateChip("");
            });
        }

        if (customerHistoryToDate) {
            customerHistoryToDate.addEventListener("change", function () {
                setActiveQuickDateChip("");
            });
        }

        if (quickFilterChips && quickFilterChips.length) {
            quickFilterChips.forEach(function (chip) {
                chip.addEventListener("click", function () {
                    var key = (chip.getAttribute("data-range") || "").trim();
                    applyQuickDateRange(key);
                });
            });
        }

        if (dashboardEditCustomerBtn) {
            dashboardEditCustomerBtn.addEventListener("click", function () {
                if (!selectedDashboardCustomer.code) {
                    setCustomerActionMessage("Please select a customer first.");
                    return;
                }

                var profile = selectedDashboardCustomer.profile || {};
                var existingPhone = (profile.phoneNumber || "").toString().trim();
                var existingCountry = profile.phoneCountryCode || inferEditCustomerPhoneCountry(existingPhone);
                renderEditCustomerPhoneCountries(existingCountry);
                updateEditCustomerPhoneGuidance();
                document.getElementById("editCustomerName").value = profile.customerName || selectedDashboardCustomer.name || "";
                document.getElementById("editCustomerAddress").value = profile.address || "";
                document.getElementById("editCustomerPhone").value = getEditCustomerLocalPhone(existingPhone, existingCountry);
                document.getElementById("editCustomerEmail").value = profile.email || "";
                setEditCustomerMessage("");
                $("#dashboardEditCustomerModal").modal("show");
            });
        }

        if (editCustomerPhoneCountry) {
            editCustomerPhoneCountry.addEventListener("change", updateEditCustomerPhoneGuidance);
        }

        if (dashboardSaveCustomerBtn) {
            dashboardSaveCustomerBtn.addEventListener("click", function () {
                if (!selectedDashboardCustomer.code) {
                    setEditCustomerMessage("Please select a customer first.");
                    return;
                }

                var phoneValue = (document.getElementById("editCustomerPhone").value || "").trim();
                var phoneCountryCode = getEditCustomerPhoneCountry();
                var nameValue = (document.getElementById("editCustomerName").value || "").trim();
                var addressValue = (document.getElementById("editCustomerAddress").value || "").trim();
                var phoneValidation = validateEditCustomerPhone(phoneValue, phoneCountryCode);
                if (!nameValue) {
                    setEditCustomerValidationMessage("Please enter Customer Name");
                    return;
                }
                if (!addressValue) {
                    setEditCustomerValidationMessage("Please enter Customer Address");
                    return;
                }
                if (!phoneValidation.isValid) {
                    setEditCustomerValidationMessage(phoneValidation.message);
                    return;
                }

                var payload = {
                    customerCode: selectedDashboardCustomer.code,
                    CustomerName: nameValue,
                    Address: addressValue,
                    PhoneNumber: phoneValue,
                    PhoneCountryCode: phoneCountryCode,
                    Email: (document.getElementById("editCustomerEmail").value || "").trim()
                };

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("UpdateCustomer", "Customer")',
                    data: payload,
                    success: function (response) {
                        if (!response || response.success !== true) {
                            setEditCustomerMessage((response && response.message) || "Unable to update customer.");
                            return;
                        }

                        selectedDashboardCustomer.name = payload.CustomerName;
                        selectedDashboardCustomer.profile = {
                            customerName: payload.CustomerName,
                            address: payload.Address,
                            phoneNumber: payload.PhoneNumber,
                            phoneCountryCode: payload.PhoneCountryCode,
                            email: payload.Email,
                            customerCode: selectedDashboardCustomer.code
                        };

                        if (searchInput) {
                            searchInput.value = payload.CustomerName;
                        }

                        $("#dashboardEditCustomerModal").modal("hide");
                        setCustomerActionMessage("Customer updated successfully.", true);
                        updateSelectedCustomerMeta();
                    },
                    error: function () {
                        setEditCustomerMessage("Unable to update customer. Please try again.");
                    }
                });
            });
        }

        if (dashboardDeleteCustomerBtn) {
            dashboardDeleteCustomerBtn.addEventListener("click", function () {
                if (!selectedDashboardCustomer.code) {
                    setCustomerActionMessage("Please select a customer first.");
                    return;
                }

                if (Array.isArray(selectedDashboardCustomer.orders) && selectedDashboardCustomer.orders.length > 0) {
                    setCustomerActionMessage("Delete is disabled for customers who have orders.");
                    updateDashboardCustomerActionButtons();
                    return;
                }

                var confirmed = window.confirm("Delete customer '" + (selectedDashboardCustomer.name || "") + "'? This action cannot be undone.");
                if (!confirmed) {
                    return;
                }

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("DeleteCustomer", "Customer")',
                    data: { customerCode: selectedDashboardCustomer.code, customerName: selectedDashboardCustomer.name },
                    success: function (response) {
                        if (!response || response.success !== true) {
                            setCustomerActionMessage((response && response.message) || "Unable to delete customer.");
                            return;
                        }

                        if (searchInput) {
                            searchInput.value = "";
                        }

                        clearSelectedDashboardCustomer();
                        setCustomerActionMessage("Customer deleted successfully.", true);
                    },
                    error: function () {
                        setCustomerActionMessage("Unable to delete customer. Please try again.");
                    }
                });
            });
        }

        if (dashboardClearCustomerBtn) {
            dashboardClearCustomerBtn.addEventListener("click", function () {
                if (searchInput) {
                    searchInput.value = "";
                }
                clearSelectedDashboardCustomer();
            });
        }

        if (dashboardRefreshCustomerOrdersBtn) {
            dashboardRefreshCustomerOrdersBtn.addEventListener("click", function () {
                if (!selectedDashboardCustomer.name) {
                    setCustomerActionMessage("Please select a customer first.");
                    return;
                }

                loadDashboardCustomerOrders(selectedDashboardCustomer.name);
            });
        }

        updateSelectedCustomerMeta();
        updateDashboardCustomerActionButtons();

        autocomplete(searchInput, serverCustomers, function (selectedCustomer) {
            triggerCustomerSelection(selectedCustomer, "autocomplete-click");
        });

        autocomplete(invoiceInput, serverOrderReferences, function (selectedReference) {
            triggerInvoiceReferenceLookup(selectedReference);
        });

        searchInput.addEventListener("input", function () {
            if (isAutocompleteRefresh) {
                return;
            }

            var searchText = (this.value || "").trim();

            if (!searchText) {
                setCustomerSearchMessage("");
                return;
            }

            if (customerSearchRequest && customerSearchRequest.readyState !== 4) {
                customerSearchRequest.abort();
            }

            var searchRequestSeq = ++customerSearchRequestSeq;
            var searchTextLower = searchText.toLowerCase();

            customerSearchRequest = $.ajax({
                type: "GET",
                url: '@Url.Action("SearchCustomers", "Customer")',
                data: { searchText: searchText },
                success: function (data) {
                    if (searchRequestSeq !== customerSearchRequestSeq) {
                        return;
                    }

                    var latestInputValue = (searchInput && searchInput.value ? searchInput.value : "").trim().toLowerCase();
                    if (latestInputValue !== searchTextLower) {
                        return;
                    }

                    serverCustomers.length = 0;
                    $.each(data || [], function (_, item) {
                        serverCustomers.push(item);
                    });

                    setCustomerSearchMessage(serverCustomers.length === 0
                        ? 'No customer found for "' + searchText + '" in this store.'
                        : "");

                    isAutocompleteRefresh = true;
                    searchInput.dispatchEvent(new Event("input"));
                    isAutocompleteRefresh = false;
                },
                error: function (xhr, status) {
                    if (status === "abort") {
                        return;
                    }

                    if (searchRequestSeq !== customerSearchRequestSeq) {
                        return;
                    }

                    var latestInputValue = (searchInput && searchInput.value ? searchInput.value : "").trim().toLowerCase();
                    if (latestInputValue !== searchTextLower) {
                        return;
                    }

                    serverCustomers.length = 0;
                    setCustomerSearchMessage("Unable to search customers. Please try again.");
                    isAutocompleteRefresh = true;
                    searchInput.dispatchEvent(new Event("input"));
                    isAutocompleteRefresh = false;
                }
            });
        });

        $("#searchCustomers").on("keydown", function (e) {
            if (e.keyCode !== 13) {
                return;
            }

            e.preventDefault();
            executeCustomerSearch();
        });

        if (searchInput) {
            searchInput.addEventListener("change", function () {
                var selectedValue = (searchInput.value || "").trim();
                if (!selectedValue) {
                    return;
                }

                triggerCustomerSelection(selectedValue, "change-event");
            });

        }

        $("#search").on("click", function () {
            setSearchModeUi("customer");
        });

        $("#invoice").on("click", function () {
            setSearchModeUi("invoice");
        });

        $("#searchInvoiceText").on("keydown", function (e) {
            if (e.keyCode !== 13) {
                return;
            }

            e.preventDefault();
            executeInvoiceSearch();
        });

        if (invoiceInput) {
            invoiceInput.addEventListener("input", function () {
                if (isInvoiceAutocompleteRefresh) {
                    return;
                }

                var searchText = (this.value || "").trim();
                if (!searchText) {
                    serverOrderReferences.length = 0;
                    setInvoiceSearchMessage("");
                    return;
                }

                if (searchText.length < 3) {
                    setInvoiceSearchMessage("Type at least 3 characters to search Order/Invoice.");
                    return;
                }

                if (orderReferenceSearchRequest && orderReferenceSearchRequest.readyState !== 4) {
                    orderReferenceSearchRequest.abort();
                }

                orderReferenceSearchRequest = $.ajax({
                    type: "GET",
                    url: '@Url.Action("SearchOrderReferences", "Customer")',
                    data: { searchText: searchText, top: 20 },
                    success: function (data) {
                        serverOrderReferences.length = 0;
                        $.each(data || [], function (_, item) {
                            serverOrderReferences.push(item);
                        });

                        setInvoiceSearchMessage(serverOrderReferences.length === 0
                            ? 'No order/invoice found for "' + searchText + '" in this store.'
                            : "");

                        isInvoiceAutocompleteRefresh = true;
                        invoiceInput.dispatchEvent(new Event("input"));
                        isInvoiceAutocompleteRefresh = false;
                    },
                    error: function (xhr, status) {
                        if (status === "abort") {
                            return;
                        }

                        serverOrderReferences.length = 0;
                        setInvoiceSearchMessage("Unable to search order/invoice. Please try again.");
                        isInvoiceAutocompleteRefresh = true;
                        invoiceInput.dispatchEvent(new Event("input"));
                        isInvoiceAutocompleteRefresh = false;
                    }
                });
            });
        }
    });

    function DashboardTemplates()
    {
        localStorage.setItem("dashboard_name", $("#dashboard-name").val());
        window.location = "/Dashboard/TemplateList/";
    }

    function refreshLiveCounterDetails() {
        var now = new Date();
        var lastRefreshed = document.getElementById('lcLastRefreshed');
        if (lastRefreshed) {
            lastRefreshed.textContent = now.toLocaleTimeString();
        }
    }

    function setLiveCounterValue(elementId, value, fallbackValue) {
        var element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        if (value === null || value === undefined || value === "") {
            element.textContent = fallbackValue || "--";
            return;
        }

        element.textContent = value;
    }

    function setLiveCounterStatus(statusText) {
        var statusElement = document.getElementById("lcLiveStatus");
        if (!statusElement) {
            return;
        }

        statusElement.textContent = statusText;
    }

    function setStoreBoardValue(elementId, value, fallbackValue) {
        var element = document.getElementById(elementId);
        if (!element) {
            return;
        }

        if (value === null || value === undefined || value === "") {
            element.textContent = fallbackValue || "--";
            return;
        }

        element.textContent = value;
    }

    function formatDashboardCurrency(value) {
        try {
            return formatCurrency(asNumber(value));
        } catch (_) {
            return asNumber(value).toFixed(2);
        }
    }

    function formatDashboardCurrencyOrNa(value) {
        if (value === null || value === undefined || value === "") {
            return "N/A";
        }

        return formatDashboardCurrency(value);
    }

    function syncPaymentSummaryFromLiveCounters(response) {
        var paymentSummaryAvailable = response && response.paymentSummaryAvailable === true;
        var statusText = paymentSummaryAvailable ? "Live data" : "N/A";
        if (!paymentSummaryAvailable && response && response.paymentSummaryReason) {
            statusText = response.paymentSummaryReason;
        }

        setStoreBoardValue("lcPaymentSummaryStatus", statusText, "N/A");

        if (!paymentSummaryAvailable) {
            setStoreBoardValue("lcCashInHand", "N/A", "N/A");
            setStoreBoardValue("lcAmountCollectedToday", "N/A", "N/A");
            setStoreBoardValue("lcCashCollectedToday", "N/A", "N/A");
            setStoreBoardValue("lcUpiCollectedToday", "N/A", "N/A");
            setStoreBoardValue("lcCardCollectedToday", "N/A", "N/A");
            return;
        }

        setStoreBoardValue("lcCashInHand", formatDashboardCurrencyOrNa(response.cashInHand), "N/A");
        setStoreBoardValue("lcAmountCollectedToday", formatDashboardCurrencyOrNa(response.amountCollectedToday), "N/A");
        setStoreBoardValue("lcCashCollectedToday", formatDashboardCurrencyOrNa(response.cashCollectedToday), "N/A");
        setStoreBoardValue("lcUpiCollectedToday", formatDashboardCurrencyOrNa(response.upiCollectedToday), "N/A");
        setStoreBoardValue("lcCardCollectedToday", formatDashboardCurrencyOrNa(response.cardCollectedToday), "N/A");
    }

    function syncStoreBoardsFromLiveCounters(response) {
        if (isAdminDashboardUser) {
            return;
        }

        setStoreBoardValue("actReadyCount", asNumber(response.readyForDeliveryCount), "0");
        setStoreBoardValue("actPendingCount", asNumber(response.pendingProcessingCount), "0");
        setStoreBoardValue("actPendingPaymentCount", asNumber(response.pendingPaymentCount), "0");

        setStoreBoardValue("ownerTodayOrders", asNumber(response.todayOrders), "0");
        setStoreBoardValue("ownerReadyOrders", asNumber(response.readyForDeliveryCount), "0");
        setStoreBoardValue("ownerPendingAmount", formatDashboardCurrency(response.pendingPaymentAmount || 0), "0.00");
        setStoreBoardValue("ownerAvgTicket", "--", "--");

        setStoreBoardValue("lcPendingProcessing", asNumber(response.pendingProcessingCount), "0");
        setStoreBoardValue("lcPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(response.pendingPaymentAmount || 0), "Outstanding: 0.00");
        setStoreBoardValue("actPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(response.pendingPaymentAmount || 0), "Outstanding: 0.00");
    }

    function loadStoreImmediateAndOwnerSummary() {
        if (isAdminDashboardUser) {
            return;
        }

        fetch('@Url.Action("GetStoreWorkflowOrders", "Customer")?status=&searchText=&_ts=' + Date.now(), {
            method: 'GET',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function (response) { return response.json(); })
        .then(function (payload) {
            if (!payload || payload.success !== true) {
                return;
            }

            var orders = Array.isArray(payload.orders) ? payload.orders : [];
            var now = new Date();
            var todayKey = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0") + "-" + String(now.getDate()).padStart(2, "0");

            var readyCount = 0;
            var pendingProcessingCount = 0;
            var pendingPaymentCount = 0;
            var pendingAmount = 0;
            var todayOrders = 0;
            var todaySales = 0;

            orders.forEach(function (order) {
                var status = normalizeStatusValue(order && (order.Status || order.status || "received"));
                var amounts = resolveOrderAmounts(order);
                var pending = amounts.pendingAmount;
                var createdValue = (order && (order.CreatedDate || order.createdDate)) || "";
                var createdDate = new Date(createdValue);
                var amount = amounts.totalAmount;

                if (status === "ready" || status === "ready for delivery") {
                    readyCount += 1;
                }

                if (status === "received" || status === "processing" || status === "in process") {
                    pendingProcessingCount += 1;
                }

                if (pending > 0) {
                    pendingPaymentCount += 1;
                    pendingAmount += pending;
                }

                if (!isNaN(createdDate.getTime())) {
                    var createdKey = createdDate.getFullYear() + "-" + String(createdDate.getMonth() + 1).padStart(2, "0") + "-" + String(createdDate.getDate()).padStart(2, "0");
                    if (createdKey === todayKey) {
                        todayOrders += 1;
                        todaySales += amount;
                    }
                }
            });

            setStoreBoardValue("actReadyCount", readyCount, "0");
            setStoreBoardValue("actPendingCount", pendingProcessingCount, "0");
            setStoreBoardValue("actPendingPaymentCount", pendingPaymentCount, "0");
            setStoreBoardValue("actPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(pendingAmount), "Outstanding: 0.00");

            setStoreBoardValue("ownerTodayOrders", todayOrders, "0");
            setStoreBoardValue("ownerReadyOrders", readyCount, "0");
            setStoreBoardValue("ownerPendingAmount", formatDashboardCurrency(pendingAmount), "0.00");
            setStoreBoardValue("ownerAvgTicket", todayOrders > 0 ? formatDashboardCurrency(todaySales / todayOrders) : formatDashboardCurrency(0), "0.00");

            setStoreBoardValue("lcPendingProcessing", pendingProcessingCount, "0");
            setStoreBoardValue("lcPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(pendingAmount), "Outstanding: 0.00");
        })
        .catch(function () { });
    }

    function loadLiveCounterDashboardStats() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetLiveCounterDashboardStats", "Customer")?_ts=' + Date.now(),
            cache: false,
            success: function (response) {
                if (!response || response.success !== true) {
                    setLiveCounterStatus((response && response.message) ? response.message : "Unable to load counters");
                    return;
                }

                setLiveCounterValue("lcTodayOrders", response.todayOrders, "0");
                setLiveCounterValue("lcWalkins", response.walkinsToday, "0");
                setLiveCounterValue("lcAdvanceUsed", response.advanceUsedToday, "0");
                setLiveCounterValue("lcPendingPayment", response.pendingPaymentCount, "0");
                setLiveCounterValue("lcPendingProcessing", response.pendingProcessingCount, "0");

                var readyForDeliveryValue = response.readyForDeliveryCount;
                var pendingDeliveryValue = response.pendingDeliveryCount;

                setLiveCounterValue("lcReadyDelivery", readyForDeliveryValue, "N/A");
                setLiveCounterValue("lcPendingDelivery", pendingDeliveryValue, "N/A");

                syncStoreBoardsFromLiveCounters(response);
                syncPaymentSummaryFromLiveCounters(response);
                loadStoreImmediateAndOwnerSummary();

                var pendingAmount = response.pendingPaymentAmount || 0;
                setStoreBoardValue("lcPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(pendingAmount), "Outstanding: 0.00");
                setStoreBoardValue("actPendingPaymentAmount", "Outstanding: " + formatDashboardCurrency(pendingAmount), "Outstanding: 0.00");
                var statusText = "Live";
                if (response.readyPendingReason) {
                    statusText += " (Delivery status pending API)";
                }
                    try { statusText += " | Pending " + formatCurrency(pendingAmount); } catch(e) {
                    try {
                        var digits = (window.__currency && Number.isFinite(Number(window.__currency.decimalDigits))) ? Number(window.__currency.decimalDigits) : 2;
                        var sym = (window.__currency && window.__currency.symbol) ? window.__currency.symbol : '';
                        // If symbol exists, include it; otherwise show numeric value only (preserve numeric precision)
                        statusText += ' | Pending ' + (sym ? (sym + ' ' + Number(pendingAmount).toFixed(digits)) : Number(pendingAmount).toFixed(digits));
                    } catch (e2) {
                        // Last-resort fallback: show numeric value only with two decimals
                        statusText += ' | Pending ' + Number(pendingAmount).toFixed(2);
                    }
                }

                setLiveCounterStatus(statusText);
                refreshLiveCounterDetails();
            },
            error: function () {
                setLiveCounterStatus("Live counter API unavailable");
            }
        });
    }

    if (!isAdminDashboardUser) {
        loadLiveCounterDashboardStats();
        setInterval(loadLiveCounterDashboardStats, 30000);
    } else {
        initializeAdminInsights();
        var adminPrintSummaryBtn = document.getElementById("adminPrintSummaryBtn");
        if (adminPrintSummaryBtn) {
            adminPrintSummaryBtn.addEventListener("click", printAdminEbjSummary);
        }

        var adminEmailSummaryBtn = document.getElementById("adminEmailSummaryBtn");
        if (adminEmailSummaryBtn) {
            adminEmailSummaryBtn.addEventListener("click", emailAdminEbjSummary);
        }

        if (!isSuperAdminDashboardUser && typeof loadAdminInsightsDashboard === "function") {
            setTimeout(function () {
                if (!adminLastComputedMetrics) {
                    loadAdminInsightsDashboard("fallback");
                }
            }, 250);
        }
    }

    if (!window.jQuery) {
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializeAdminInsights);
        } else {
            initializeAdminInsights();
        }
    }
</script>
