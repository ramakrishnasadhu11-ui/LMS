                trendTitleEl.textContent = getAdminSelectedRangeKey() === "7d"
                    ? "Last 7 Days Orders"
                    : "Daily Orders – Month to Date";
            }

            var todayOrdersSupportEl = document.getElementById("adminKpiTodayOrdersSupport");
            if (todayOrdersSupportEl) {
                todayOrdersSupportEl.textContent = todayOrders > 0
                    ? ("Open today: " + (statusMap.Received + statusMap.Processing + statusMap.Ready))
                    : "Your daily orders will appear here once customers start placing orders.";
