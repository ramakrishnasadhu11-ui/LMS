        xhr.onreadystatechange = function () {
            if (xhr.readyState !== 4) {
                return;
            }

            if (xhr.status < 200 || xhr.status >= 300) {
                onLoadError(xhr.status || 0, "Unable to load store dashboard insights.");
                return;
            }

            var payload = null;
            try {
                payload = JSON.parse(xhr.responseText || "{}");
            } catch (e) {
                onLoadError(xhr.status || 0, "Invalid dashboard response.");
                return;
            }

            onLoadSuccess(payload);
        };
        xhr.onerror = function () {
            onLoadError(0, "Unable to load store dashboard insights.");
        };
        xhr.send(null);
    }

