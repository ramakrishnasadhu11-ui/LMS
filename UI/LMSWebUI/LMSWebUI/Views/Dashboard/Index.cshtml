            var autoRefreshCheckbox = document.getElementById("adminAutoRefreshChk");
            if (autoRefreshCheckbox && autoRefreshCheckbox.checked) {
                adminInsightsNextRefreshAt = new Date(Date.now() + adminInsightsIntervalMs);
                updateAdminNextRefreshLabel();
