    function toDateOnlyKey(dateValue) {
        var dt = new Date(dateValue);
        if (isNaN(dt.getTime())) {
            return "";
        }

        var month = String(dt.getMonth() + 1).padStart(2, '0');
        var day = String(dt.getDate()).padStart(2, '0');
        return dt.getFullYear() + '-' + month + '-' + day;
    }

    function renderAdminBarRows(containerId, rows, valueFormatter) {
        var container = document.getElementById(containerId);
        if (!container) {
            return;
        }

        if (!rows || rows.length === 0) {
            container.innerHTML = "<div class='admin-insights-empty'>No data available.</div>";
            return;
        }

        var maxValue = rows.reduce(function (acc, row) {
            return Math.max(acc, asNumber(row.value));
        }, 0);
        if (maxValue <= 0) {
            maxValue = 1;
        }

        container.innerHTML = rows.map(function (row) {
            var width = Math.max(4, Math.round((asNumber(row.value) / maxValue) * 100));
            return "<div class='admin-chart-row'>"
                + "<span class='admin-chart-label'>" + row.label + "</span>"
                + "<div class='admin-chart-track'><div class='admin-chart-fill' style='width:" + width + "%;'></div></div>"
                + "<span class='admin-chart-value'>" + valueFormatter(asNumber(row.value)) + "</span>"
                + "</div>";
        }).join("");
    }

    function renderAdminListRows(containerId, rows) {
