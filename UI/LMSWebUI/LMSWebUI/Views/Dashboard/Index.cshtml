            else if (canResumeOnboarding)
            {
                <p class="dashboard-header-subtitle">
                    Need a refresher?
                    <a href="@Url.Action("Onboarding", "Dashboard")" style="color:#fff;text-decoration:underline;font-weight:600;">Resume onboarding</a>
                </p>
            }
        </div>
        <div class="dashboard-body">
            @if (!isSuperAdminUser)
            {
                <section class="dashboard-store-identity-card" aria-labelledby="dashboardStoreIdentityTitle">
                    <div class="dashboard-store-identity-main">
                        <div class="dashboard-store-identity-eyebrow">Current business context</div>
                        <h3 id="dashboardStoreIdentityTitle" class="dashboard-store-identity-title">Store Identity</h3>
                        <p class="dashboard-store-identity-message">
                            You are currently viewing business data for <strong>@storeName</strong> (<strong>@tenantStore</strong>).
                        </p>
                        <div class="dashboard-store-identity-details">
                            <span class="admin-context-chip">Tenant Name/Email: <strong>@tenantName</strong></span>
                            <span class="admin-context-chip">Store Name: <strong>@storeName</strong></span>
                            <span class="admin-context-chip">Store Code: <strong>@tenantStore</strong></span>
                            <span class="admin-context-chip @(isStoreActive ? "context-active" : "context-inactive")">
                                Active Store: <strong>@(isStoreActive ? "Yes" : "No")</strong>
                            </span>
                        </div>
                    </div>
                    @if (hasMultipleActiveStores)
                    {
                        <form asp-controller="Dashboard" asp-action="SwitchStore" method="post" class="dashboard-store-switch-form">
                            @Html.AntiForgeryToken()
                            <label for="dashboardStoreSelector">Switch Store</label>
                            <div class="dashboard-store-switch-controls">
                                <select id="dashboardStoreSelector" name="storeCode" class="form-control" aria-label="Select active store">
                                    @foreach (var activeStore in activeDashboardStores)
                                    {
                                        <option value="@activeStore.StoreCode" selected="@(string.Equals(activeStore.StoreCode, tenantStore, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                            @activeStore.StoreName (@activeStore.StoreCode)
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary">Switch Store</button>
                            </div>
                        </form>
                    }
                </section>
            }
            @if (showSubscriptionBillingCard)
            {
                <div class="@subscriptionBillingCardClass" id="dashboardSubscriptionBillingCard" aria-live="polite">
                    <div class="subscription-billing-head">
                        <div>
                            <h3 class="subscription-billing-title">Tenant-wide Subscription &amp; Billing</h3>
                            <p class="subscription-billing-subtitle">@subscriptionBillingHeadline</p>
                            <p class="subscription-billing-subtitle">@subscriptionBillingMessage</p>
                        </div>
                    </div>

                    <div class="subscription-billing-grid">
                        <div class="subscription-billing-metric">
                            <span class="subscription-billing-label">Current Plan</span>
                            <span class="subscription-billing-value">@dashboardPlanText</span>
                        </div>
                        <div class="subscription-billing-metric">
                            <span class="subscription-billing-label">Subscription Status</span>
                            <span class="subscription-billing-value">@dashboardSubscriptionText</span>
                        </div>
                        <div class="subscription-billing-metric">
                            <span class="subscription-billing-label">Trial Days Remaining</span>
                            <span class="subscription-billing-value">@trialDaysRemainingText</span>
                        </div>
                        <div class="subscription-billing-metric">
                            <span class="subscription-billing-label">Expiry Date (UTC)</span>
                            <span class="subscription-billing-value">@subscriptionExpiryText</span>
                        </div>
                    </div>

                    @if (showSubscriptionTrialProgress)
                    {
                        <div class="subscription-billing-progress" id="dashboardSubscriptionTrialProgress">
                            <div class="subscription-billing-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@subscriptionTrialProgressClamped">
                                <div class="subscription-billing-progress-fill" style="width:@(subscriptionTrialProgressClamped)%"></div>
                            </div>
                            <div class="subscription-billing-progress-note">
                                @if (isTrialEndingSoonState)
                                {
                                    <text>Trial ending soon. Complete your upgrade to avoid interruptions.</text>
                                }
                                else
                                {
                                    <text>Trial progress: @subscriptionTrialProgressClamped% time remaining.</text>
                                }
                            </div>
                        </div>
                    }

                    @if (canManageSubscriptionBillingActions)
                    {
                        <div class="subscription-billing-actions">
                            <a class="subscription-billing-btn primary" href="@billingPrimaryCtaUrl">@billingPrimaryCtaText</a>
                            <a class="subscription-billing-btn" href="@plansAndTariffUrl">Manage Subscription</a>
                            <a class="subscription-billing-btn" href="@billingHistoryUrl">Payment History</a>
                            <a class="subscription-billing-btn" href="@billingRenewalUrl">Renewals</a>
                        </div>
                    }
                </div>
            }

            @if (!isAdminUser && subscriptionSpotlightVisible)
            {
                <div class="subscription-spotlight" id="subscriptionSpotlight">
                    <div class="subscription-spotlight-body">
                        <div>
                            <h3 class="subscription-spotlight-title">Grow your laundry business with the right plan.</h3>
                            <p class="subscription-spotlight-subtitle">Explore plans and features designed for your laundry business.</p>
                            <div class="subscription-spotlight-meta">
                                <span class="subscription-meta-pill">Current plan: @dashboardPlanText</span>
                                <span class="subscription-meta-pill status @subscriptionStatusClass">Status: @dashboardSubscriptionText</span>
                            </div>
                            <div class="subscription-spotlight-actions">
                                <a class="subscription-spotlight-cta" href="@plansAndTariffUrl">@subscriptionCtaText</a>
                                <button type="button" class="subscription-spotlight-dismiss" id="subscriptionSpotlightDismiss">Dismiss</button>
                            </div>
                        </div>
                        <div class="subscription-plans-grid" aria-label="Available plans">
                            <div class="subscription-plan-card">
                                <p class="subscription-plan-title">Standard</p>
                                <p class="subscription-plan-copy">For growing laundry operations that need reliable daily workflows.</p>
                            </div>
                            <div class="subscription-plan-card">
                                <p class="subscription-plan-title">Premium</p>
                                <p class="subscription-plan-copy">For advanced stores needing richer controls and scalability.</p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!isAdminUser)
            {
                <div class="subscription-entry-point" id="subscriptionEntryPoint" @(subscriptionSpotlightVisible ? "style=display:none;" : "style=display:flex;")>
                    <span>Review your subscription plans and tariff options.</span>
                    <a href="@plansAndTariffUrl">@subscriptionCtaText</a>
                </div>
            }

            @if (!isAdminUser)
            {
                <div class="live-counter-panel" id="liveCounterPanel">
                    <div class="live-counter-head">
                        <div>
                            <h3 class="live-counter-title">Operations Command Center</h3>
                            <p class="live-counter-subtitle">Real-time workflow, delivery and payment visibility for the current store.</p>
                        </div>
                    </div>
                    <div class="live-counter-grid">
                        <div class="live-counter-item">
                            <span class="live-counter-label">Today Orders</span>
                            <span class="live-counter-value" id="lcTodayOrders">--</span>
                            <span class="live-counter-support">Store orders logged today</span>
                        </div>
                        <div class="live-counter-item priority-processing">
                            <span class="live-counter-label">Pending Processing</span>
                            <span class="live-counter-value" id="lcPendingProcessing">--</span>
                            <span class="live-counter-support">Orders requiring immediate work</span>
                        </div>
                        <div class="live-counter-item priority-ready">
                            <span class="live-counter-label">Ready for Delivery</span>
                            <span class="live-counter-value" id="lcReadyDelivery">--</span>
                            <span class="live-counter-support">Prepared and ready to dispatch</span>
                        </div>
                        <div class="live-counter-item priority-delivery">
                            <span class="live-counter-label">Pending Delivery</span>
                            <span class="live-counter-value" id="lcPendingDelivery">--</span>
                            <span class="live-counter-support">Out for delivery / awaiting completion</span>
                        </div>
                        <div class="live-counter-item priority-payment">
                            <span class="live-counter-label">Pending Payment</span>
                            <span class="live-counter-value" id="lcPendingPayment">--</span>
                            <span class="live-counter-support" id="lcPendingPaymentAmount">Outstanding: --</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Walk-ins Today</span>
                            <span class="live-counter-value" id="lcWalkins">--</span>
                            <span class="live-counter-support">Walk-in customers served</span>
                        </div>
                        <div class="live-counter-item">
                            <span class="live-counter-label">Advance Used Today</span>
                            <span class="live-counter-value" id="lcAdvanceUsed">--</span>
                            <span class="live-counter-support">Advance credits adjusted today</span>
                        </div>
                    </div>
                    <div class="live-counter-meta">
                        <span class="live-meta-chip">Tenant: <strong>@tenantName</strong></span>
                        <span class="live-meta-chip">Store: <strong>@tenantStore</strong></span>
                        <span class="live-meta-chip">Role: <strong>@currentUserRole</strong></span>
                        <span class="live-meta-chip">Status: <strong id="lcLiveStatus">Initializing...</strong></span>
                        <span class="live-meta-chip">Refreshed: <strong id="lcLastRefreshed">--</strong></span>
                    </div>

                    <div class="payment-summary-panel" id="todayPaymentSummaryPanel">
                        <div class="payment-summary-header">
                            <div>
                                <h4 class="payment-summary-title">Today's Payment Summary</h4>
                                <p class="payment-summary-subtitle">Based on persisted payment transactions for @tenantStore.</p>
                            </div>
                            <span class="payment-summary-status" id="lcPaymentSummaryStatus">Loading...</span>
                        </div>
                        <div class="payment-summary-grid">
                            <div class="payment-summary-item primary">
                                <span class="payment-summary-label">Cash in Hand</span>
                                <span class="payment-summary-value" id="lcCashInHand">--</span>
                                <span class="payment-summary-note">Live cash position for current store</span>
                            </div>
                            <div class="payment-summary-item primary">
                                <span class="payment-summary-label">Amount Collected Today</span>
                                <span class="payment-summary-value" id="lcAmountCollectedToday">--</span>
                                <span class="payment-summary-note">Unique posted payment entries only</span>
                            </div>
                            <div class="payment-summary-item">
                                <span class="payment-summary-label">Cash Collected</span>
                                <span class="payment-summary-value" id="lcCashCollectedToday">--</span>
                                <span class="payment-summary-note">Cash-mode transactions today</span>
                            </div>
                            <div class="payment-summary-item">
                                <span class="payment-summary-label">UPI Collected</span>
                                <span class="payment-summary-value" id="lcUpiCollectedToday">--</span>
                                <span class="payment-summary-note">UPI-mode transactions today</span>
                            </div>
                            <div class="payment-summary-item">
                                <span class="payment-summary-label">Card Collected</span>
                                <span class="payment-summary-value" id="lcCardCollectedToday">--</span>
                                <span class="payment-summary-note">Card-mode transactions today</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="store-action-board" id="storeImmediateActions">
                    <div class="store-board-header">Immediate Actions for Store User</div>
                    <div class="store-action-grid">
                        <a class="store-action-card alert" href="@Url.Action("OrderWorkflow", "Customer")?status=Ready">
                            <div class="store-action-title">Ready for delivery</div>
                            <div class="store-action-value" id="actReadyCount">--</div>
                            <div class="store-action-note">Deliver now and close open pickups</div>
                        </a>
                        <a class="store-action-card warning" href="@Url.Action("OrderWorkflow", "Customer")?status=Received">
                            <div class="store-action-title">Pending processing</div>
                            <div class="store-action-value" id="actPendingCount">--</div>
                            <div class="store-action-note">Move quickly to avoid delays</div>
                        </a>
                        <a class="store-action-card alert" href="@Url.Action("OrderWorkflow", "Customer")?status=&searchText=" id="actUnpaidLink">
                            <div class="store-action-title">Pending payment cases</div>
                            <div class="store-action-value" id="actPendingPaymentCount">--</div>
                            <div class="store-action-note" id="actPendingPaymentAmount">Outstanding: --</div>
                        </a>
                    </div>
                </div>

                @if (canViewOwnerSummary)
                {
                    <div class="owner-summary-board" id="storeOwnerSummary">
                        <div class="store-board-header">Owner Summary Snapshot</div>
                        <div class="owner-summary-grid">
                            <div class="owner-summary-item">
                                <span class="owner-summary-label">Today Orders</span>
                                <span class="owner-summary-value" id="ownerTodayOrders">--</span>
                            </div>
                            <div class="owner-summary-item">
                                <span class="owner-summary-label">Ready for Delivery</span>
                                <span class="owner-summary-value" id="ownerReadyOrders">--</span>
                            </div>
                            <div class="owner-summary-item">
                                <span class="owner-summary-label">Pending Payment Amount</span>
                                <span class="owner-summary-value" id="ownerPendingAmount">--</span>
                            </div>
                            <div class="owner-summary-item">
                                <span class="owner-summary-label">Average Ticket (Today)</span>
                                <span class="owner-summary-value" id="ownerAvgTicket">--</span>
                            </div>
                        </div>
                    </div>
                }

                <div class="customer-lookup-panel" id="customerLookupPanel">
                    <h3 class="customer-lookup-title">Customer Lookup</h3>
                    <p class="customer-lookup-subtitle">Find a customer or invoice quickly, then continue with billing and workflow actions.</p>

                    <div class="search-mode" role="tablist" aria-label="Lookup mode">
                    <div class="search-option" id="searchOptionCustomer">
                        <input type="radio" id="search" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? null : "checked")" />
                        <label for="search">Search Customer (Name, Address, Mobile Number, Membership Id or Customer Code)</label>
                    </div>
                    <div class="search-option" id="searchOptionInvoice">
                        <input type="radio" id="invoice" name="search" checked="@(string.Equals(searchMode, "invoice", StringComparison.OrdinalIgnoreCase) ? "checked" : null)" />
                        <label for="invoice">Search Invoice</label>
                    </div>
                </div>

                <div id="searchradio" class="search-input-wrap autocomplete invoice-lookup-wrap">
                    <div class="lookup-row">
                        <span class="lookup-search-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                        <input type="text" id="searchCustomers" class="form-control" placeholder="Search customer..." autocomplete="off" />
                        <div class="lookup-filter-wrap">
                            <button class="btn btn-default dropdown-toggle lookup-filter-btn" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                Search All <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-right">
                                <li><a href="#">Name</a></li>
                                <li><a href="#">Address</a></li>
                                <li><a href="#">Mobile</a></li>
                                <li><a href="#">Membership Id</a></li>
                                <li><a href="#">Customer Code</a></li>
                            </ul>
                        </div>
                        <button type="button" class="btn btn-primary" id="customerSearchGoBtn">Search</button>
                    </div>
                    <div class="search-hint">Type to search. Use ↑/↓ to navigate suggestions and Enter to load customer history.</div>
                    <div id="customerSearchMessage" class="search-no-result"></div>
                </div>

                <div class="form-group search-input-wrap invoice-lookup-wrap autocomplete" id="searchInvoiceradio">
                    <h4 class="invoice-lookup-title">Find Order or Invoice</h4>
                    <div class="invoice-lookup-row">
                        <span class="invoice-lookup-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                        <input type="text" id="searchInvoiceText" class="form-control" placeholder="Enter Order No. / Invoice No." autocomplete="off" />
                        <button type="button" class="btn btn-primary" id="invoiceSearchGoBtn">Search</button>
                    </div>
                    <div class="invoice-lookup-info-row">Partial match supported. Press Enter to preview invoice details and open workflow.</div>
                    <div id="invoiceSearchMessage" class="search-no-result"></div>
                </div>
                </div>

                <div id="invoicePreviewPanel" class="invoice-preview-panel" style="display:none;">
                    <div class="invoice-preview-header" id="invoicePreviewHeader">Invoice details</div>
                    <div class="invoice-preview-body" id="invoicePreviewBody"></div>
                    <div class="invoice-preview-actions">
                        <button type="button" class="btn btn-primary" id="invoiceOpenWorkflowBtn">Open in Workflow</button>
                        <button type="button" class="btn btn-default" id="invoicePreviewClearBtn">Clear</button>
                    </div>
                </div>

                <div id="customerOrdersPanel" class="customer-orders-panel" style="display:none;">
                    <div id="customerOrdersHeader" class="customer-orders-header">Customer order history</div>
                    <div class="customer-history-filters" id="customerHistoryFilters" style="display:none;">
                        <div class="customer-history-quick-filters">
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="today">Today</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="last7">Last 7 days</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="thisMonth">This Month</button>
                            <button type="button" class="btn btn-default btn-xs customer-history-chip" data-range="clear">Clear Range</button>
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryStatus">Status</label>
                            <select id="customerHistoryStatus" class="form-control">
                                <option value="">All Status</option>
                                <option value="received">Received</option>
                                <option value="processing">Processing</option>
                                <option value="ready">Ready</option>
                                <option value="delivered">Delivered</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryFromDate">From Date</label>
                            <input type="date" id="customerHistoryFromDate" class="form-control" />
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistoryToDate">To Date</label>
                            <input type="date" id="customerHistoryToDate" class="form-control" />
                        </div>
                        <div>
                            <label class="sr-only" for="customerHistorySearchText">Search Order / Invoice</label>
                            <input type="text" id="customerHistorySearchText" class="form-control" placeholder="Order / Invoice" />
                        </div>
                        <div class="filter-actions">
                            <button type="button" id="customerHistoryApplyBtn" class="btn btn-default">Apply</button>
                            <button type="button" id="customerHistoryResetBtn" class="btn btn-link">Reset</button>
                        </div>
                    </div>
                    <div class="customer-orders-wrap">
                        <table class="customer-orders-table">
                            <thead>
                                <tr>
                                    <th>Order No</th>
                                    <th>Invoice No</th>
                                    <th>Date (UTC)</th>
                                    <th>Status</th>
                                    <th>Items</th>
                                    <th class="num">Pieces</th>
                                    <th class="num">Total Amount</th>
                                    <th class="num">Paid Amount</th>
                                    <th class="num">Pending Balance</th>
                                </tr>
                            </thead>
                            <tbody id="customerOrdersBody">
                                <tr><td colspan="9" class="customer-orders-state">Search and select a customer to view all orders.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (!isAdminUser)
            {
                <div class="customer-workbench">
                    <div class="selected-customer-panel" id="selectedCustomerPanel">
                        <p class="selected-customer-title">Selected Customer</p>
                        <div class="customer-workbench-meta" id="selectedCustomerMeta">Selected customer: None</div>
                        <div class="selected-customer-empty" id="selectedCustomerEmptyState">Select a customer to enable customer-specific actions.</div>
                    </div>
                    <div class="dashboard-actions">
                        <button type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Customer")'">
                            Add New Customer
                        </button>
                        <button type="button" class="btn" id="dashboardEditCustomerBtn" disabled>
                            <i class="fa fa-pencil" aria-hidden="true"></i>Edit Customer
                        </button>
                        <button type="button" class="btn btn-danger" id="dashboardDeleteCustomerBtn" disabled>
                            Delete Customer
                        </button>
                    </div>
                    <div id="customerActionMessage" class="customer-action-message" role="status" aria-live="polite"></div>
                </div>
                <div class="dashboard-actions" style="margin-top:10px;">
                    <button type="button" class="btn btn-default" id="dashboardClearCustomerBtn">
                        Clear Selected Customer
                    </button>
                    <button type="button" class="btn btn-default" id="dashboardRefreshCustomerOrdersBtn" disabled>
                        Refresh Customer Orders
                    </button>
                </div>
                <div class="store-dashboard-create-order-bottom">
                    <a class="btn btn-primary store-dashboard-create-order-button is-disabled" id="dashboardCreateOrderBtn" aria-disabled="true" tabindex="-1" href="#">
                        <i class="fa fa-plus" aria-hidden="true"></i>
                        <span>Create New Order</span>
                    </a>
                </div>
            }

            @if (!isAdminUser)
            {
                <div id="dashboardEditCustomerModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="dashboardEditCustomerModalLabel">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header edit-customer-modal-header">
                                <span class="edit-customer-modal-icon" aria-hidden="true"><i class="fa fa-user"></i></span>
                                <div class="edit-customer-modal-heading">
                                    <h4 class="modal-title edit-customer-modal-title" id="dashboardEditCustomerModalLabel">Edit Customer</h4>
                                    <p class="edit-customer-modal-subtitle">Update customer details while keeping their order history connected.</p>
                                </div>
                                <button type="button" class="close edit-customer-modal-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            </div>
                            <div class="modal-body edit-customer-modal-body">
                                <div class="edit-customer-fields">
                                    <div class="edit-customer-field">
                                        <label class="edit-customer-label" for="editCustomerName">
                                            <span>Customer Name <span class="edit-customer-required">*</span></span>
                                        </label>
                                        <input type="text" id="editCustomerName" class="form-control edit-customer-control" placeholder="Enter customer name" autocomplete="name" />
                                    </div>
                                    <div class="edit-customer-field">
                                        <label class="edit-customer-label" for="editCustomerEmail">
                                            <span>Email <span class="edit-customer-optional">Optional</span></span>
                                        </label>
                                        <input type="email" id="editCustomerEmail" class="form-control edit-customer-control" placeholder="name@example.com" autocomplete="email" />
                                    </div>
                                    <div class="edit-customer-field edit-customer-field--wide">
                                        <label class="edit-customer-label" for="editCustomerAddress">
                                            <span>Address <span class="edit-customer-required">*</span></span>
                                        </label>
                                        <input type="text" id="editCustomerAddress" class="form-control edit-customer-control" placeholder="Enter customer address" autocomplete="street-address" />
                                    </div>
                                    <div class="edit-customer-field">
                                        <label class="edit-customer-label" for="editCustomerPhone">
                                            <span>Phone Number <span class="edit-customer-optional">Optional</span></span>
                                        </label>
                                        <div class="edit-customer-phone-group">
                                            <select id="editCustomerPhoneCountry" class="form-control edit-customer-control edit-customer-phone-country" aria-label="Phone country" autocomplete="tel-country-code"></select>
                                            <input type="tel" id="editCustomerPhone" class="form-control edit-customer-control" placeholder="Enter phone number" autocomplete="tel" />
                                        </div>
                                        <div id="editCustomerPhoneGuidance" class="edit-customer-phone-guidance" role="note" aria-live="polite">
                                            <i class="fa fa-info-circle" aria-hidden="true"></i>
                                            <div class="edit-customer-phone-guidance-content">
                                                <span class="edit-customer-phone-guidance-summary">Phone number Optional; exactly 10 digits when provided.</span>
                                                <span id="editCustomerPhoneGuidanceCountry" class="edit-customer-phone-guidance-country"></span>
                                                <span id="editCustomerPhoneGuidanceText" class="edit-customer-phone-guidance-detail"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="editCustomerMessage" class="edit-customer-message search-no-result" style="display:none;" role="alert"></div>
                                </div>
                            </div>
