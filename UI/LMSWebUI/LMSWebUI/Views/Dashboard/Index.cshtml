        }

        var emptyMessagesByContainer = {
            adminActionQueueRows: "All orders are within the expected workflow.",
            adminRevenueRows: "Revenue details will appear when billing starts.",
            adminOperationsRows: "No operations backlog at the moment.",
            adminCustomerRows: "Customer insights will appear as your business grows.",
