            if (slaEmptyEl) {
                slaEmptyEl.style.display = totalSlaCount === 0 ? "block" : "none";
            }

            var slaHealthMessageEl = document.getElementById("adminSlaHealthMessage");
            if (slaHealthMessageEl) {
                if (totalSlaCount === 0) {
                    slaHealthMessageEl.textContent = "";
                } else if (sla24Plus > 0) {
                    slaHealthMessageEl.textContent = "Orders waiting over 24 hours need immediate attention.";
                } else {
                    slaHealthMessageEl.textContent = "SLA health is stable. Most orders are moving within the target time.";
                }
            }

            var summaryEl = document.getElementById("adminEbjSummaryText");
            if (summaryEl) {
                var priorityText = totalSlaCount === 0
                    ? ""
                    : (sla24Plus > 0
                        ? ("Immediate action: " + sla24Plus + " order(s) are above 24h SLA.")
                        : ("SLA is stable. Keep processing and ready queues within target."));
                summaryEl.textContent = totalSlaCount === 0
                    ? ""
                    : (priorityText + " Pending amount: " + formatCurrency(pendingAmount) + ".");
