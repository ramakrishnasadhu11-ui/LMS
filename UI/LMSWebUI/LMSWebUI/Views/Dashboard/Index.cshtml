        function inferEditCustomerPhoneCountry(phoneValue) {
            var value = (phoneValue || "").trim();
            if (!value || !value.startsWith("+")) {
                return getEditCustomerPhoneCountry() || "IN";
            }

            var matches = (Array.isArray(dashboardPhoneCountries) ? dashboardPhoneCountries : []).filter(function (country) {
                return country.CallingCode && value.startsWith(country.CallingCode);
            }).sort(function (left, right) {
                return (right.CallingCode || "").length - (left.CallingCode || "").length;
            });
            var match = matches[0];
            return match ? match.Iso2 : (getEditCustomerPhoneCountry() || "IN");
        }

        function validateEditCustomerPhone(phoneValue, countryIso2) {
            var value = (phoneValue || "").trim();
            if (!value) {
                return { isValid: true, normalizedNumber: "" };
            }

            var localValue = value;
            if ((countryIso2 || "").toUpperCase() === "IN" && value.startsWith("+91")) {
                localValue = value.substring(3);
            }

            if ((countryIso2 || "").toUpperCase() === "IN" && !/^[6-9][0-9]{9}$/.test(localValue)) {
                return { isValid: false, message: "Enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9." };
            }

            return { isValid: true, normalizedNumber: value };
        }

        function getEditCustomerLocalPhone(phoneValue, countryIso2) {
            var value = (phoneValue || "").trim();
