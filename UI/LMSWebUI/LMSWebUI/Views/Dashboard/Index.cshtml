    .subscription-spotlight {
        margin-bottom: 18px;
        border-radius: 18px;
        border: 1px solid rgba(227, 188, 92, 0.4);
        background: linear-gradient(130deg, #081a45 0%, #123b91 58%, #1f57b8 100%);
        box-shadow: 0 18px 38px rgba(8, 26, 69, 0.2);
        color: #fff;
        overflow: hidden;
        position: relative;
        animation: subscriptionFadeIn .45s ease;
    }

    .subscription-spotlight::after {
        content: "";
        position: absolute;
        right: -90px;
        top: -72px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(227, 188, 92, 0.25) 0%, rgba(227, 188, 92, 0) 70%);
        pointer-events: none;
    }

    .subscription-spotlight-body {
        padding: 22px;
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 18px;
    }

    .subscription-spotlight-title {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: .01em;
    }

    .subscription-spotlight-subtitle {
        margin: 10px 0 0;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.9);
    }

    .subscription-spotlight-meta {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .subscription-meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: rgba(255, 255, 255, 0.14);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        padding: 6px 12px;
    }

    .subscription-meta-pill.status.active {
        background: rgba(16, 185, 129, 0.2);
        border-color: rgba(16, 185, 129, 0.45);
    }

    .subscription-meta-pill.status.trial {
        background: rgba(59, 130, 246, 0.22);
        border-color: rgba(59, 130, 246, 0.46);
    }

    .subscription-meta-pill.status.suspended,
    .subscription-meta-pill.status.expired {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(239, 68, 68, 0.45);
    }

    .subscription-plans-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .subscription-plan-card {
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        padding: 10px 12px;
    }

    .subscription-plan-title {
        margin: 0;
        font-size: 13px;
        font-weight: 700;
        color: #f4d17f;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .subscription-plan-copy {
        margin: 4px 0 0;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.9);
    }

    .subscription-spotlight-actions {
        margin-top: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .subscription-spotlight-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: 1px solid #f0cc77;
        background: linear-gradient(180deg, #f6d786 0%, #e2b959 100%);
