    }

    #dashboardEditCustomerModal .edit-customer-phone-group {
        display: grid;
        grid-template-columns: minmax(145px, .9fr) minmax(0, 1.6fr);
        gap: 8px;
    }

    #dashboardEditCustomerModal .edit-customer-phone-country {
        min-width: 0;
        padding-right: 28px;
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        width: 100%;
        margin-top: 8px;
        padding: 9px 11px;
        border: 1px solid #dce8f4;
        border-radius: 9px;
        background: #f5f9fe;
        color: #526b84;
        font-size: 12px;
        line-height: 1.5;
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance i {
        flex: 0 0 auto;
        margin-top: 2px;
        color: var(--els-primary);
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance-summary {
        color: #294662;
        font-weight: 700;
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance-country {
        color: #526b84;
    }

    #dashboardEditCustomerModal .edit-customer-phone-guidance-detail {
        color: #71859a;
    }

    #dashboardEditCustomerModal .edit-customer-message {
        grid-column: 1 / -1;
        margin: 0;
        border: 1px solid #f1c8cc;
        border-radius: 10px;
        background: #fff6f6;
        color: #a23843;
        font-size: 13px;
        line-height: 1.45;
    }

    #dashboardEditCustomerModal .edit-customer-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 28px 24px;
        border: 0;
        background: #fbfdff;
    }

    #dashboardEditCustomerModal .edit-customer-action {
        min-width: 128px;
        min-height: 43px;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        transition: transform .15s ease, box-shadow .2s ease, background .2s ease;
    }

    #dashboardEditCustomerModal .edit-customer-action:hover {
        transform: translateY(-1px);
    }

    #dashboardEditCustomerModal .edit-customer-cancel {
        border: 1px solid #cbd8e6;
